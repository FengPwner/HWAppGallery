.class public Lcom/huawei/quickcard/framework/QuickCardField;
.super Ljava/lang/Object;
.source "SourceFile"


# annotations
.annotation build Lcom/huawei/quickcard/base/annotation/DoNotShrink;
.end annotation


# static fields
.field public static final ACTION_EVENT_KEY:Ljava/lang/String; = "$event"

.field public static final ACTION_OBJECT:Ljava/lang/String; = "$ActionObject"

.field public static final ACTION_PREFIX:Ljava/lang/String; = "$Action"

.field public static final ASSETS:Ljava/lang/String; = "assets"

.field public static final CONFIGURATION:Ljava/lang/String; = "$configuration"

.field public static final DATA:Ljava/lang/String; = "$data"

.field public static final EXPORT_OBJECT:Ljava/lang/String; = "$Export"

.field public static final EXTRA_CONTEXT_ID:Ljava/lang/String; = "$contextId"

.field public static final EXTRA_POINT:Ljava/lang/String; = "$extra."

.field public static final GLOBAL_DATA_MOUNT:Ljava/lang/String; = "$extra"

.field public static final HOST_PARAMS:Ljava/lang/String; = "$host"

.field public static final THIS_POINT:Ljava/lang/String; = "this."

.field public static final TURBO_MODE:Ljava/lang/String; = "$turbo"

.field public static final USER_GLOBAL_DATA:Ljava/lang/String; = "$globalData"


# direct methods
.method public constructor <init>()V
    .registers 1

    invoke-direct {p0}, Ljava/lang/Object;-><init>()V

    return-void
.end method
