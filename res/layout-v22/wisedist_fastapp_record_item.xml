<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/app_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            app:corner_type="appicon"
            app:round_type="all" />
        <ViewStub
            android:layout_gravity="end|bottom|center"
            android:id="@id/fastappicon"
            android:layout="@layout/wisedist_fastappicon_layout"
            android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
            android:layout_height="@dimen/hiappbase_card_fasticon_size_large" />
    </FrameLayout>
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textColor="@color/appgallery_text_color_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/appgallery_safety_margin_s"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_marginRight="@dimen/appgallery_safety_margin_s"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:maxLines="1"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/appgallery_safety_margin_s"
        android:layout_marginVertical="@dimen/appgallery_elements_margin_vertical_m"
        style="@style/AppGallery.TextAppearance.Card.TextBody4.Secondary" />
</LinearLayout>