<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="16.0dip"
        android:layout_above="@id/bottom_view">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/hiapp_img"
            android:background="@drawable/appicon_logo_oobe"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:layout_marginTop="48.0dip"
            android:layout_marginBottom="24.0dip" />
        <TextView
            android:textSize="@dimen/emui_primary_title_2"
            android:textColor="@color/appgallery_text_color_primary"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@id/oobe_protocol_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hiapp_oobe_privacy_title_v2_modified"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginStart="@dimen/hwcolumnsystem_cs_button_margin"
            android:layout_marginEnd="@dimen/hwcolumnsystem_cs_button_margin" />
        <ScrollView
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="32.0dip"
            android:layout_marginStart="@dimen/hwcolumnsystem_cs_button_margin"
            android:layout_marginEnd="@dimen/hwcolumnsystem_cs_button_margin">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:id="@id/oobe_protocol_content"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:lineSpacingMultiplier="1.4"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/bottom_view"
        android:layout_width="fill_parent"
        android:layout_height="48.0dip"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/hwcolumnsystem_cs_button_margin"
        android:layout_marginEnd="@dimen/hwcolumnsystem_cs_button_margin">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/back_button_layout"
            android:paddingLeft="@dimen/margin_m"
            android:paddingRight="@dimen/margin_m"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginEnd="@dimen/margin_m"
            android:paddingHorizontal="@dimen/margin_m">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/back_arrow"
                android:background="@drawable/oobe_ic_back"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:layout_gravity="center_vertical"
                android:id="@id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/oobe_back"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_marginStart="@dimen/margin_m" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/oobe_next_layout"
            android:paddingLeft="@dimen/margin_m"
            android:paddingRight="@dimen/margin_m"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/margin_m"
            android:paddingHorizontal="@dimen/margin_m">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:id="@id/oobe_next"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/oobe_next"
                android:layout_weight="1.0"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_marginEnd="@dimen/margin_m" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/next_arrow"
                android:background="@drawable/oobe_ic_next"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>