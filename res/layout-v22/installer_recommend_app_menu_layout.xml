<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="end|center"
    android:id="@id/menu_layout"
    android:background="@color/appgallery_color_sub_background"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:id="@id/menu_layout_area"
        android:layout_width="@dimen/appgallery_card_icon_size_middle"
        android:layout_height="@dimen/appgallery_card_icon_size_middle"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
        android:contentDescription="@string/card_more_btn"
        android:layout_marginEnd="@dimen/appgallery_default_card_space_vertical_l"
        android:layout_marginVertical="@dimen/appgallery_card_elements_margin_s">
        <ImageView
            android:id="@id/menu_icon"
            android:tag="css/.widget"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/aguikit_ic_public_more" />
    </LinearLayout>
</LinearLayout>