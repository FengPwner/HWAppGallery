<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/alert_dialog_card"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/interwork_16_dp"
    android:layoutDirection="locale"
    android:paddingStart="@dimen/interwork_24_dp"
    android:paddingEnd="@dimen/interwork_24_dp"
    android:layout_marginStart="@dimen/interwork_16_dp"
    android:layout_marginEnd="@dimen/interwork_16_dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/dialog_update_remind_layout"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/interwork_56_dp"
            android:layout_marginTop="@dimen/interwork_8_dp"
            android:layout_marginBottom="@dimen/interwork_10_dp"
            android:divider="@drawable/divider"
            android:layout_below="@id/text_update_user_agreement"
            android:showDividers="middle"
            android:dividerPadding="@dimen/interwork_16_dp">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:paddingEnd="@dimen/interwork_4_dp">
                <Button
                    android:textSize="@dimen/interwork_text_16_sp"
                    android:textColor="@color/emui_functional_blue"
                    android:id="@id/button_cancel"
                    android:background="@null"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:text="@string/update_cancel"
                    android:singleLine="true"
                    android:layout_centerVertical="true"
                    android:autoSizeStepGranularity="1.0sp"
                    android:autoSizeMinTextSize="@dimen/interwork_text_9_sp"
                    android:autoSizeMaxTextSize="@dimen/interwork_text_16_sp"
                    style="?android:borderlessButtonStyle" />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:paddingStart="@dimen/interwork_4_dp">
                <Button
                    android:textSize="@dimen/interwork_text_16_sp"
                    android:textColor="@color/emui_functional_blue"
                    android:id="@id/button_open"
                    android:background="@null"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:text="@string/update_confirm"
                    android:singleLine="true"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1.0sp"
                    android:autoSizeMinTextSize="@dimen/interwork_text_9_sp"
                    android:autoSizeMaxTextSize="@dimen/interwork_text_16_sp"
                    style="?android:borderlessButtonStyle" />
                <RelativeLayout
                    android:id="@id/waiting_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="@dimen/interwork_8_dp">
                    <TextView
                        android:textSize="@dimen/interwork_text_16_sp"
                        android:textColor="@color/emui_functional_blue"
                        android:gravity="center_vertical"
                        android:id="@id/wait_dialog_title"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:text="@string/update_confirm"
                        android:singleLine="true"
                        android:alpha="@dimen/emui_disabled_alpha"
                        android:textAllCaps="true"
                        android:fontFamily="@string/emui_text_font_family_medium"
                        android:layout_marginStart="@dimen/interwork_4_dp"
                        android:layout_toEndOf="@id/confirm_button_progress"
                        android:autoSizeStepGranularity="1.0sp"
                        android:autoSizeMinTextSize="@dimen/interwork_text_9_sp"
                        android:autoSizeMaxTextSize="@dimen/interwork_text_16_sp" />
                    <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
                        android:id="@id/confirm_button_progress"
                        android:layout_width="@dimen/interwork_24_dp"
                        android:layout_height="@dimen/interwork_24_dp"
                        android:indeterminateOnly="true"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:indeterminateTint="#99000000"
                        android:indeterminateTintMode="src_atop"
                        style="?android:progressBarStyle" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/interwork_text_16_sp"
            android:id="@id/text_bundle_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/dialog_title"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="@dimen/interwork_text_16_sp"
            android:id="@id/text_bundle_version_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/interwork_8_dp"
            android:text="@string/bundle_version"
            android:layout_below="@id/text_bundle_name"
            android:textDirection="locale"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="@dimen/interwork_text_16_sp"
            android:id="@id/text_bundle_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/interwork_8_dp"
            android:text="@string/bundle_size"
            android:layout_below="@id/text_bundle_version_label"
            android:textDirection="locale"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="@dimen/emui_text_size_caption"
            android:textColor="@color/emui_color_secondary"
            android:id="@id/text_update_user_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/interwork_16_dp"
            android:layout_below="@id/text_bundle_size_label"
            android:fontFamily="@string/emui_text_font_family_regular" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/interwork_text_20_sp"
            android:gravity="start|center"
            android:id="@id/dialog_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/interwork_56_dp"
            android:text="@string/found_new_version"
            android:layout_alignParentTop="true"
            android:fontFamily="@string/emui_text_font_family_medium"
            android:layout_alignParentStart="true"
            app:hwAutoSizeMinTextSize="15.0sp"
            app:hwAutoSizeStepGranularity="1.0sp" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/dialog_error_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@id/button_error_confirm">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@id/dialog_error_icon"
                    android:layout_width="@dimen/interwork_64_dp"
                    android:layout_height="@dimen/interwork_64_dp"
                    android:src="@drawable/error_dialog_icon"
                    android:scaleType="fitCenter"
                    android:layout_centerHorizontal="true" />
                <TextView
                    android:textSize="@dimen/emui_text_size_subtitle2"
                    android:textColor="@color/emui_text_primary"
                    android:gravity="center_horizontal"
                    android:id="@id/dialog_error_text"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/interwork_8_dp"
                    android:text="@string/update_error"
                    android:layout_below="@id/dialog_error_icon"
                    android:fontFamily="@string/emui_text_font_family_medium" />
                <TextView
                    android:textSize="@dimen/emui_text_size_subtitle3"
                    android:textColor="@color/emui_text_hint"
                    android:gravity="center_horizontal"
                    android:id="@id/dialog_error_reason"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/dialog_error_text"
                    android:fontFamily="@string/emui_text_font_family_medium" />
            </RelativeLayout>
        </RelativeLayout>
        <Button
            android:textSize="@dimen/interwork_text_16_sp"
            android:textColor="@color/emui_functional_blue"
            android:id="@id/button_error_confirm"
            android:background="@null"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/interwork_36_dp"
            android:layout_marginTop="@dimen/interwork_10_dp"
            android:layout_marginBottom="@dimen/interwork_10_dp"
            android:minWidth="0.0dip"
            android:minHeight="0.0dip"
            android:text="@string/confirm"
            android:layout_alignParentBottom="true"
            style="?android:borderlessButtonStyle" />
    </RelativeLayout>
</RelativeLayout>