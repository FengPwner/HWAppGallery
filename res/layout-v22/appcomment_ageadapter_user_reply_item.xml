<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/click_layout"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/appcoment_reply_click_layout"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <ImageView
            android:id="@id/reply_appicon"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/margin_l" />
        <RelativeLayout
            android:orientation="vertical"
            android:id="@id/content_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:layout_below="@id/reply_appicon"
            android:layout_centerInParent="true"
            android:layout_alignParentStart="true">
            <RelativeLayout
                android:id="@id/reply_audit_info_layout"
                android:background="@drawable/appcomment_usercomment_round_corner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="8.0dip"
                android:layout_below="@id/appcommet_reply_nick">
                <ImageView
                    android:id="@id/reply_item_tip"
                    android:background="@drawable/appcomment_user_comment_tip_icon"
                    android:clickable="true"
                    android:layout_width="12.0dip"
                    android:layout_height="12.0dip"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="2.0dip"
                    android:outlineSpotShadowColor="@color/appgallery_color_secondary" />
                <TextView
                    android:textSize="@dimen/emui_text_size_caption1"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:layout_gravity="center"
                    android:id="@id/reply_audit_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.0dip"
                    android:layout_marginBottom="1.0dip"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="2.0dip"
                    android:layout_marginEnd="8.0dip"
                    android:layout_toEndOf="@id/reply_item_tip" />
            </RelativeLayout>
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/appcommet_reply_nick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/appcommnet_reply_time"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:singleLine="true"
                android:layout_below="@id/reply_audit_info_layout"
                android:layout_centerVertical="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/appcommnet_reply_ip"
                android:tag="css/.title"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:singleLine="true"
                android:layout_below="@id/appcommnet_reply_time"
                android:layout_centerVertical="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@id/appzone_comment_info_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.appgallery.appcomment.ui.view.FoldTextView
            android:id="@id/appzone_comment_info"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_primary_activated"
            android:layout_gravity="end|bottom|center"
            android:id="@id/open_or_fold_tv"
            android:tag="css/.title"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/appcomment_user_open_content"
            android:fontFamily="@string/appgallery_text_font_family_medium" />
    </FrameLayout>
    <include
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appcomment_8_dp"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        layout="@layout/appcomment_shield_layout" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/appcoment_comment_layout"
        android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
        android:paddingTop="@dimen/appcomment_12_dp"
        android:paddingBottom="@dimen/appcomment_12_dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appcomment_12_dp"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/comment_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
    </LinearLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@id/appcommnet_reply_link_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="48.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/appcomment_app_layout"
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/margin_l"
            android:layout_toStartOf="@id/image_layout"
            android:layout_alignParentStart="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/app_icon"
                android:layout_width="@dimen/appcomment_16_dp"
                android:layout_height="@dimen/appcomment_16_dp"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                android:layout_marginEnd="@dimen/margin_m" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/image_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/appcomment_reply_approve_layout"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="48.0dip"
                android:layout_marginEnd="@dimen/margin_l">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/appcomment_reply_approve_icon_imageview"
                    android:background="@drawable/aguikit_ic_public_thumbsup"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:scaleType="centerCrop" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/appcomment_reply_approve_counts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/margin_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/appcomment_comment_reply_layout"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="48.0dip"
                android:contentDescription="@string/appcomment_reply_button">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/appcomment_comment_reply_icon_imageview"
                    android:background="@drawable/aguikit_ic_public_comments"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:scaleType="centerCrop" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/appcomment_comment_reply_counts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/margin_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/appzone_comment_delete_layout"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:visibility="visible"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:contentDescription="@string/card_more_btn"
                android:layout_marginStart="8.0dip"
                android:layout_marginEnd="12.0dip">
                <ImageView
                    android:id="@id/detail_delete_reply_icon_imageview"
                    android:background="@drawable/aguikit_ic_public_more_list"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:scaleType="centerCrop" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <include
        layout="@layout/appcomment_subheader_divider" />
</LinearLayout>