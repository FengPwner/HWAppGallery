<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <ScrollView
            android:id="@id/scroll_layout"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/divider"
                    android:background="@color/transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="16.0dip" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/name_layout"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_paragraph_margin_xs"
                    android:screenReaderFocusable="true">
                    <TextView
                        android:id="@id/name_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_name"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
                    <TextView
                        android:id="@id/name_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_m"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary.Medium" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/version_layout"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_paragraph_margin_xs"
                    android:screenReaderFocusable="true">
                    <TextView
                        android:id="@id/version_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_new_version"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
                    <TextView
                        android:id="@id/version_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_m"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary.Medium" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/size_layout"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                    android:screenReaderFocusable="true">
                    <TextView
                        android:id="@id/appsize_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_new_size"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
                    <TextView
                        android:id="@id/appsize_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_m"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary.Medium" />
                    <TextView
                        android:id="@id/allsize_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_m"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary.Medium" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/content_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@id/content_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/appgallery_text_paragraph_margin_xs"
                        android:text="@string/to_detail"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
                    <TextView
                        android:id="@id/content_textview"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.1"
                        android:textAlignment="viewStart"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Primary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_body3"
        android:id="@id/download_install_tip_textview"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:text="@string/ota_download_install_tip"
        style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Secondary" />
</LinearLayout>