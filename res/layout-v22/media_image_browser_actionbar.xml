<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/media_image_browse_actionbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@id/status_bar"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:id="@id/hiappbase_arrow_layout"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip"
            android:layout_centerVertical="true"
            android:contentDescription="@string/exit_cancel"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="4.0dip"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@id/up"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/aguikit_ic_public_cancel"
                android:tint="@color/appgallery_color_primary_translucent" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@id/hiappbase_right_title_layout"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip"
            android:layout_centerVertical="true"
            android:contentDescription="@string/exit_confirm"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_alignParentEnd="true">
            <CheckBox
                android:textSize="13.0dip"
                android:textColor="@color/emui_black"
                android:id="@id/img_checkbox"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/margin_s"
                style="@style/meida.checkbox.IconSelect" />
            <ImageView
                android:id="@id/select_img"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/aguikit_ic_public_ok"
                android:tint="@color/appgallery_color_primary_translucent"
                android:layout_centerVertical="true" />
        </LinearLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_master_title_1"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/title_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_centerVertical="true"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_toStartOf="@id/hiappbase_right_title_layout"
            android:layout_toEndOf="@id/hiappbase_arrow_layout"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="@dimen/res_textsize_1sp"
            android:autoSizeMinTextSize="@dimen/emui_master_body_2" />
    </RelativeLayout>
</LinearLayout>