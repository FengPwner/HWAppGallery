<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/btn_layout_carrier"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@id/oobe_permison_text_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/oobe_hwcolumn_margin_offset"
            android:paddingEnd="@dimen/oobe_hwcolumn_margin_offset"
            app:hwColumnType="content_type">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/permission_carrier"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_marginBottom="8.0dip"
                android:text=""
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/privacy_and_user_agreement"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                android:text=""
                android:layout_below="@id/permission_carrier"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginStart="@dimen/hwcolumnsystem_cs_button_margin"
            android:layout_marginEnd="@dimen/hwcolumnsystem_cs_button_margin">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/oobe_nothanks_layout"
                android:paddingLeft="@dimen/margin_m"
                android:paddingRight="@dimen/margin_m"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginEnd="@dimen/margin_m"
                android:paddingHorizontal="@dimen/margin_m">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/back_arrow"
                    android:background="@drawable/oobe_ic_back"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip" />
                <TextView
                    android:textSize="28.0dip"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:layout_gravity="center_vertical"
                    android:id="@id/back_button"
                    android:paddingTop="@dimen/margin_m"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/oobe_later_v2"
                    android:layout_weight="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="@dimen/margin_m" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/oobe_install_layout"
                android:paddingLeft="@dimen/margin_m"
                android:paddingRight="@dimen/margin_m"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/margin_m"
                android:paddingHorizontal="@dimen/margin_m">
                <TextView
                    android:textSize="28.0dip"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="end"
                    android:layout_gravity="center_vertical"
                    android:id="@id/oobe_install_button"
                    android:paddingTop="@dimen/margin_m"
                    android:paddingBottom="@dimen/margin_m"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/oobe_install"
                    android:layout_weight="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginEnd="@dimen/margin_m" />
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/next_arrow"
                    android:background="@drawable/oobe_ic_next"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>