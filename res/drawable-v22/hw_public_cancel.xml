<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:height="24.0dip"
        android:width="24.0dip">
        <shape
            android:shape="oval">
            <solid
                android:color="#ff9d9d9d" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="2.0dip"
        android:top="4.0dip"
        android:bottom="4.0dip">
        <rotate
            android:fromDegrees="315.0"
            android:pivotX="50.0%"
            android:pivotY="50.0%">
            <shape
                android:shape="rectangle">
                <solid
                    android:color="@color/hw_cloud_dialog_bg" />
                <corners
                    android:radius="0.19000006dip" />
            </shape>
        </rotate>
    </item>
    <item
        android:gravity="center"
        android:width="4.0dip"
        android:top="12.0dip"
        android:bottom="10.0dip"
        android:start="2.0dip">
        <rotate
            android:layout_height="wrap_content"
            android:fromDegrees="315.0"
            android:pivotX="50.0%"
            android:pivotY="50.0%">
            <shape
                android:shape="rectangle">
                <solid
                    android:color="#ff9d9d9d" />
            </shape>
        </rotate>
    </item>
    <item
        android:gravity="center"
        android:width="2.0dip"
        android:top="4.0dip"
        android:bottom="4.0dip">
        <rotate
            android:fromDegrees="45.0"
            android:pivotX="50.0%"
            android:pivotY="50.0%">
            <shape
                android:shape="rectangle">
                <solid
                    android:color="@color/hw_cloud_dialog_bg" />
                <corners
                    android:radius="0.19000006dip" />
            </shape>
        </rotate>
    </item>
</layer-list>