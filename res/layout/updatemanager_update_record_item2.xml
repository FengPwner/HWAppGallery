<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/update_main_layout"
        android:addStatesFromChildren="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@id/update_card_layout"
            android:background="@drawable/list_item_normal_selector"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_two_text_lines">
            <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                android:id="@id/update_icon_imageview"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:src="@color/transparent"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                maskview:corner_type="appicon"
                maskview:round_type="all" />
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/update_option_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28.0dip"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/middlepart_linearlayout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/updatemanager_updateview_desc_end_margin"
                android:layout_toStartOf="@id/update_option_button"
                android:layout_toEndOf="@id/update_icon_imageview">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_subtitle3"
                        android:ellipsize="end"
                        android:id="@id/update_item_name_imageview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/updatemanager_app_info_default"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                    <TextView
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@id/update_item_size_textview"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/updatemanager_app_info_default"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:textAllCaps="false"
                        style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/updatemanager_updateview_versionname_top_margin">
                    <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                        android:id="@id/no_adapter_icon"
                        android:visibility="gone"
                        android:layout_width="@dimen/ui_14_dp"
                        android:layout_height="@dimen/ui_14_dp"
                        android:layout_marginEnd="@dimen/appgallery_text_paragraph_margin_xs" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@id/updateitem_versionname_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/updatemanager_app_info_default"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:textAllCaps="false"
                        style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/update_short_desc"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginRight="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:text="@string/updatemanager_app_info_default"
            android:maxLines="1"
            android:lineSpacingMultiplier="@dimen/appgallery_text_line_space_s"
            android:textAllCaps="false"
            android:drawableEnd="@drawable/ic_public_arrow_down_900"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        <View
            android:id="@id/update_short_desc_margin"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:importantForAccessibility="no" />
        <View
            android:id="@id/update_split_line"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.Widget.Divider" />
        <RelativeLayout
            android:id="@id/expand_relativelayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <TextView
                android:gravity="center_vertical"
                android:id="@id/dayspublish_short_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/updatemanager_app_info_default"
                android:singleLine="true"
                android:textAllCaps="false"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <TextView
                android:gravity="center_vertical"
                android:id="@id/update_long_desc_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:text="@string/updatemanager_app_info_default"
                android:layout_below="@id/dayspublish_short_textview"
                android:lineSpacingMultiplier="@dimen/appgallery_text_line_space_s"
                android:textAllCaps="false"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@id/second_versionname_textview"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/updatemanager_app_info_default"
                android:drawablePadding="@dimen/padding_s"
                android:layout_below="@id/update_long_desc_textview"
                android:marqueeRepeatLimit="marquee_forever"
                android:textAllCaps="false"
                android:importantForAccessibility="yes"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/button_relativelayout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/size_48dp"
                android:layout_below="@id/update_long_desc_textview">
                <com.huawei.uikit.phone.hwbutton.widget.HwButton
                    android:gravity="start|center"
                    android:layout_gravity="start|center"
                    android:id="@id/item_delete_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_m"
                    android:layout_marginBottom="@dimen/margin_m"
                    android:text="@string/appinstall_uninstall_app_btn"
                    android:maxLines="1"
                    maskview:hwAutoSizeMinTextSize="9.0sp"
                    maskview:hwAutoSizeStepGranularity="1.0sp"
                    style="@style/AppGallery.Widget.Button.TextButton1" />
                <com.huawei.uikit.phone.hwbutton.widget.HwButton
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/app_update_ignore_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_m"
                    android:layout_marginBottom="@dimen/margin_m"
                    android:text="@string/updatemanager_ignore_update"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    maskview:hwAutoSizeMinTextSize="9.0sp"
                    maskview:hwAutoSizeStepGranularity="1.0sp"
                    style="@style/AppGallery.Widget.Button.TextButton1" />
            </LinearLayout>
            <ImageView
                android:id="@id/update_icon_up"
                android:background="@drawable/ic_public_arrow_up_900"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/button_relativelayout"
                android:layout_alignParentEnd="true" />
            <View
                android:id="@id/update_long_split_line"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_below="@id/button_relativelayout"
                style="@style/AppGallery.Widget.Divider" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>