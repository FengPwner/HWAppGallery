<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/AppListItem"
    android:background="@drawable/list_item_all_selector"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_card_height_two_text_lines"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:src="@color/transparent"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/appgallery_max_padding_start" />
    <com.huawei.uikit.hwswitch.widget.HwSwitch
        android:id="@id/hiappbase_filter_switch_id"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        android:layout_alignParentEnd="true"
        style="@style/Widget.Emui.HwSwitch" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
        android:layout_toStartOf="@id/hiappbase_filter_switch_id"
        android:layout_toEndOf="@id/appicon">
        <TextView
            android:ellipsize="end"
            android:id="@id/ItemTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/purchasehistory_app_info_default"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_limit_access"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
            <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                android:id="@id/iv_limit_access"
                android:layout_width="@dimen/cs_16_dp"
                android:layout_height="@dimen/cs_16_dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="@dimen/margin_s" />
            <TextView
                android:id="@id/tv_limit_access"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@id/divider_line"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="96.0dip"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>