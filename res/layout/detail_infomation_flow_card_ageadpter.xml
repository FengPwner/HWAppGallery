<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="@dimen/appgallery_card_top_margin_default"
    android:paddingBottom="@dimen/appgallery_card_top_margin_default"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/root_layout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16.0dip"
        android:layout_marginEnd="16.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/image_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xl"
            android:layout_weight="1.0">
            <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
                android:id="@id/image_list"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                bounceViews:bounceEnable="true" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/app_info_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_default_corner_radius_m"
            android:layout_marginStart="12.0dip"
            android:layout_marginEnd="12.0dip">
            <RelativeLayout
                android:id="@id/app_icon_layout"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:layout_marginTop="8.0dip"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l">
                <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                    android:id="@id/detail_app_icon"
                    android:focusable="false"
                    android:layout_width="@dimen/appgallery_card_icon_size_large"
                    android:layout_height="@dimen/appgallery_card_icon_size_large"
                    android:src="@drawable/icon_default_bg"
                    android:scaleType="fitCenter"
                    bounceViews:corner_type="appicon"
                    bounceViews:round_type="all" />
                <ImageView
                    android:id="@id/detail_head_fast_app_icon_imageview"
                    android:layout_width="@dimen/component_detail_fasticon_size"
                    android:layout_height="@dimen/component_detail_fasticon_size"
                    android:src="@color/transparent"
                    android:scaleType="fitCenter"
                    android:layout_alignBottom="@id/detail_app_icon"
                    android:layout_alignEnd="@id/detail_app_icon" />
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_title_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:layout_centerVertical="true">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/detail_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:paddingEnd="4.0dip"
                    style="@style/AppGallery.TextAppearance.Card.SubTitle1" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/jump_detail"
                    android:background="@drawable/detail_information_flow_jump_bg"
                    android:paddingTop="2.0dip"
                    android:paddingBottom="2.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="16.0dip"
                    android:paddingStart="4.0dip">
                    <TextView
                        android:textSize="@dimen/emui_text_size_caption1"
                        android:textColor="@color/appgallery_text_color_primary_activated"
                        android:ellipsize="end"
                        android:id="@id/jump_detail_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/component_detail_to_detail"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        style="@style/AppGallery.TextAppearance.Card.SubTitle1" />
                    <ImageView
                        android:id="@id/detail_information_flow_right"
                        android:layout_width="6.0dip"
                        android:layout_height="12.0dip"
                        android:src="@drawable/detail_information_flow_right"
                        android:layout_marginStart="2.0dip"
                        android:layout_marginEnd="2.0dip" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/normal_app_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/detail_app_intro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:layout_below="@id/detail_app_name"
                    android:layout_toEndOf="@id/app_icon_layout">
                    <ImageView
                        android:id="@id/detail_star_icon"
                        android:layout_width="10.0dip"
                        android:layout_height="10.0dip"
                        android:src="@drawable/detail_star_small"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/detail_app_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="2.0dip"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    <View
                        android:id="@id/detail_app_divider"
                        android:background="@color/appgallery_list_divider"
                        android:layout_width="1.0dip"
                        android:layout_height="9.0dip"
                        android:layout_marginStart="6.0dip"
                        android:layout_marginEnd="6.0dip" />
                    <ImageView
                        android:id="@id/detail_download_icon"
                        android:layout_width="10.0dip"
                        android:layout_height="10.0dip"
                        android:src="@drawable/detail_download_small" />
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/detail_app_down_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="2.0dip"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                </LinearLayout>
                <TextView
                    android:ellipsize="end"
                    android:id="@id/detail_app_memo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_below="@id/detail_app_intro"
                    android:layout_toEndOf="@id/app_icon_layout"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/host_app_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/detail_app_dev_name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                <TextView
                    android:ellipsize="none"
                    android:id="@id/other_appinfos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="@dimen/component_detail_margin_bottom"
            android:minHeight="@dimen/component_detail_bottom_button_height_v3"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip">
            <com.huawei.appgallery.detail.detailbase.api.DetailBigDownloadButton
                android:textSize="16.0dip"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/detail_download_button"
                android:background="@drawable/corner_button_download_v3"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/component_detail_bottom_button_height_v3"
                android:text="@string/card_install_btn"
                android:singleLine="true"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                bounceViews:downloadFixedWidth="true"
                bounceViews:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                style="@style/detail_big_download_button" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>