<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@id/back_d"
    android:tag="css/.body"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/wisedist_big_title_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/ui_16_dp"
        android:paddingEnd="8.0dip">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_headline7"
            android:textColor="@color/appgallery_text_color_primary"
            android:id="@id/wisedist_bigtitle_id"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:alpha="0.0"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_alignParentStart="true" />
        <LinearLayout
            android:id="@id/wisedist_app_bar_search_id"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_marginTop="@dimen/wisedist_bigtitle_search_btn_touch_margin"
                android:layout_marginBottom="@dimen/wisedist_bigtitle_search_btn_touch_margin"
                android:src="@drawable/aguikit_ic_public_search"
                android:contentDescription="@string/search_btn_click"
                android:layout_marginStart="@dimen/wisedist_bigtitle_search_btn_touch_margin"
                android:layout_marginEnd="@dimen/wisedist_bigtitle_search_btn_touch_margin" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>