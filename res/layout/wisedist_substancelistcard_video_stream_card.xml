<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    app:clip_background="true"
    app:round_corner="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="@dimen/appgallery_card_stroke_width"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/flow_big_imageview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true" />
    <ImageView
        android:layout_width="16.0dip"
        android:layout_height="16.0dip"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:src="@drawable/ic_midcard_label_video"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal" />
    <View
        android:id="@id/flow_bg_view"
        android:layout_width="fill_parent"
        android:layout_height="80.0dip"
        android:layout_alignParentBottom="true" />
    <RelativeLayout
        android:id="@id/flow_content_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.huawei.appgallery.pageframe.view.DownloadButtonV2
            android:id="@id/flow_btn"
            android:layout_width="56.0dip"
            android:layout_height="28.0dip"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_toStartOf="@id/flow_btn"
            android:layout_alignParentStart="true">
            <TextView
                android:ellipsize="end"
                android:id="@id/flow_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_gravity="center_vertical"
                    android:id="@id/promotion_sign"
                    android:background="@drawable/promotion_sign_bg"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                    style="@style/promotion_sign_style" />
                <TextView
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@id/flow_body"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>