<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/aguikit_round_rectangle_bg"
    app:round_corner="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/appicon_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true" />
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/biloba_text_layout"
        android:background="@color/appgallery_color_card_panel_bg"
        android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appicon_layout"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <TextView
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/ItemTitle"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="@integer/horizonhomecard_intro_max_lines"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
            <com.huawei.appmarket.framework.widget.PromotionSignTextView
                android:layout_gravity="center_vertical"
                android:id="@id/promotion_sign"
                android:tag="css/.title"
                android:background="@drawable/promotion_sign_bg"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/promotion_sign_style" />
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:layout_gravity="center_vertical"
                android:id="@id/ItemInfo"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="@integer/horizonhomecard_intro_max_lines"
                android:includeFontPadding="false"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/ItemSubTitle"
            android:tag="css/.subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="@integer/horizonhomecard_intro_max_lines"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
    </LinearLayout>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>