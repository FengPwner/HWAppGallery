<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/AppListItem"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
        android:src="@color/transparent"
        android:scaleType="fitCenter" />
    <View
        android:id="@id/view"
        android:background="@color/transparent"
        android:layout_width="@dimen/wisedist_serial_number_textview_layout_width"
        android:layout_height="0.0dip"
        android:layout_toRightOf="@id/appicon"
        android:layout_alignTop="@id/appicon"
        android:layout_alignBottom="@id/appicon"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_subtitle2"
        android:gravity="center"
        android:id="@id/rank_number_textview"
        android:tag="css/.title"
        android:layout_width="20.0dip"
        android:layout_height="17.0dip"
        android:maxLines="1"
        android:layout_alignTop="@id/view"
        android:layout_alignBottom="@id/view"
        android:layout_alignStart="@id/view"
        app:hwAutoSizeMinTextSize="15.0sp"
        app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
        style="@style/AppGallery.TextAppearance.Card.TextBody1.Fixed.Regular" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_subtitle2"
        android:gravity="center"
        android:id="@id/appSerial"
        android:tag="css/.title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignTop="@id/view"
        android:layout_alignBottom="@id/view"
        android:layout_centerInParent="true"
        android:layout_alignStart="@id/view"
        app:hwAutoSizeMinTextSize="15.0sp"
        app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
        style="@style/AppGallery.TextAppearance.Card.TextBody1.Fixed.Regular" />
    <RelativeLayout
        android:id="@id/right_middle_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_below="@id/appicon"
        android:layout_centerVertical="true"
        android:layout_alignStart="@id/appicon">
        <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/title_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
            android:layout_alignParentStart="true">
            <TextView
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/ItemTitle"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="textStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/item_text_rl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/title_layout"
            android:layout_alignStart="@id/title_layout"
            android:layout_alignEnd="@id/title_layout">
            <TextView
                android:ellipsize="end"
                android:id="@id/ItemText"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
        <LinearLayout
            android:gravity="start"
            android:id="@id/third_line"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_text_rl"
            android:layout_alignStart="@id/item_text_rl">
            <TextView
                android:ellipsize="end"
                android:id="@id/memo"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="textStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </RelativeLayout>
    <com.huawei.gamebox.service.cloudgame.TryPlayButton
        android:textSize="14.0sp"
        android:id="@id/trybtn"
        android:tag="css/.download-button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:minWidth="64.0dip"
        android:minHeight="28.0dip"
        android:layout_below="@id/right_middle_layout"
        app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
        style="@style/Widget.Emui.HwButton.Small" />
    <View
        android:id="@id/devider_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@id/appicon"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>