<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/personal_user_info_card_v5_container_relativelayout"
        android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
        android:padding="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
        android:layout_marginEnd="@dimen/appgallery_column_system_content_margin">
        <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
            android:id="@id/personal_user_info_card_v5_head_imageview"
            android:background="@android:color/transparent"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:src="@drawable/placeholder_base_account_header"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true" />
        <LinearLayout
            android:gravity="start|center"
            android:orientation="vertical"
            android:id="@id/personal_user_info_card_v5_defcontainer_linearlayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_max_padding_end"
            android:layout_marginEnd="8.0dip"
            android:layout_toStartOf="@id/personal_user_info_card_v5_right_arrow"
            android:layout_toEndOf="@id/personal_user_info_card_v5_head_imageview">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/personal_user_info_card_v5_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:alpha="1.0"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_secondary"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@id/personal_user_info_card_v5_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:maxLines="1"
                android:alpha="1.0"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
        <ImageView
            android:id="@id/personal_user_info_card_v5_right_arrow"
            android:tag="css/.arrow"
            android:background="@drawable/ic_public_arrow_right_900"
            android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
            android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>