<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/radio_layout"
    android:background="@drawable/aguikit_round_rectangle_card_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/content_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="0.0dip"
        android:layout_alignParentStart="true"
        style="@style/AppGallery.Widget.List.TwoTextLines">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center"
                android:layout_gravity="center_vertical"
                android:tag="title"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/buttonLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.uikit.phone.hwradiobutton.widget.HwRadioButton
                    android:layout_gravity="center_vertical"
                    android:tag="radionbutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    style="@style/Widget.Emui.HwRadioButton" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:tag="content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
    <ImageView
        android:tag="divider"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>