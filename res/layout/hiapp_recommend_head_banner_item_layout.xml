<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="yes"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/head_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:id="@id/banner_image_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:translationZ="0.0dip"
            app:clip_background="true"
            app:round_corner_top_left="@dimen/appgallery_default_corner_radius_l"
            app:round_corner_top_right="@dimen/appgallery_default_corner_radius_l"
            app:stroke_width="0.0dip">
            <com.huawei.appmarket.framework.widget.RecommendHeadImageView
                android:id="@id/bigImg"
                android:background="@android:color/transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:scaleType="matrix"
                android:contentDescription="@string/wisedist_image" />
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_8_dp"
            android:layout_marginStart="@dimen/ui_12_dp"
            android:layout_marginEnd="@dimen/ui_12_dp"
            android:translationZ="1.0dip">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/emui_text_primary_inverse"
                android:ellipsize="end"
                android:id="@id/subtitle_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/recommend_banner_title_size"
                android:textColor="@color/emui_text_primary_inverse"
                android:ellipsize="end"
                android:id="@id/title_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/refs_app_container"
        android:background="@drawable/aguikit_card_panel_bg_bottom_corner"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="139.0dip"
        android:paddingStart="@dimen/ui_12_dp"
        android:paddingEnd="@dimen/ui_12_dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/app_icon_container_id"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_4_dp"
            android:minHeight="72.0dip">
            <ImageView
                android:id="@id/appicon"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:src="@color/transparent"
                android:scaleType="fitCenter" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/app_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/ui_16_dp"
                android:layout_marginEnd="@dimen/ui_16_dp">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:id="@id/app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:importantForAccessibility="no"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body3"
                    android:textColor="@color/appgallery_text_color_tertiary"
                    android:ellipsize="end"
                    android:id="@id/app_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@id/download_desc_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@id/score_star"
                        android:tag="css/.widget"
                        android:layout_width="10.0dip"
                        android:layout_height="10.0dip"
                        android:src="@drawable/ic_recomend_banner_star"
                        android:adjustViewBounds="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@id/download_icon"
                        android:tag="css/.widget"
                        android:layout_width="10.0dip"
                        android:layout_height="10.0dip"
                        android:src="@drawable/ic_recommend_banner_downloads"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="6.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/split_id"
                        app:layout_constraintTop_toTopOf="parent" />
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/split_id"
                        android:background="@color/transparent"
                        android:layout_width="1.0dip"
                        android:layout_height="10.0dip"
                        android:layout_marginStart="6.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/score_id"
                        app:layout_constraintTop_toTopOf="parent">
                        <View
                            android:layout_gravity="bottom"
                            android:background="@color/recommend_head_banner_split_color"
                            android:layout_width="1.0dip"
                            android:layout_height="9.0dip" />
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_text_color_tertiary"
                        android:id="@id/score_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/score_star"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_text_color_tertiary"
                        android:id="@id/download_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/download_icon"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/app_downbtn_id"
                android:tag="css/.download-button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:minWidth="64.0dip"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
        </LinearLayout>
        <View
            android:id="@id/devider_line"
            android:tag="css/.split-line"
            android:layout_width="fill_parent"
            android:layout_marginTop="4.0dip"
            style="@style/AppGallery.Widget.Divider" />
        <FrameLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/desc_container_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4.0dip"
                android:minHeight="54.0dip"
                android:layout_weight="1.0">
                <ImageView
                    android:id="@id/memo_start_quote"
                    android:layout_width="15.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/hiapp_fa_recommend_quote_datail"
                    android:rotation="180.0"
                    android:layout_marginEnd="8.0dip" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@id/intro_desc_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_weight="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
                <ImageView
                    android:id="@id/memo_end_quote"
                    android:layout_width="15.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/hiapp_fa_recommend_quote_datail"
                    android:layout_marginStart="8.0dip" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/recommend_app_list"
        android:background="@drawable/aguikit_card_panel_bg_bottom_corner"
        android:paddingTop="@dimen/ui_12_dp"
        android:paddingBottom="@dimen/ui_12_dp"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="139.0dip"
        android:paddingStart="@dimen/recommend_banner_app_item_padding"
        android:paddingEnd="@dimen/recommend_banner_app_item_padding" />
</LinearLayout>