<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/wish_page_title"
        layout="@layout/wish_page_title_layout" />
    <include
        android:id="@id/wishactivity_layout_loading"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        layout="@layout/loading_fragment" />
    <com.huawei.uikit.hwviewpager.widget.HwViewPager
        android:id="@id/wish_page_viewpager"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</LinearLayout>