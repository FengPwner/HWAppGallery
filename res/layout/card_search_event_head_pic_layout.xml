<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:layout_gravity="center_horizontal"
        android:id="@id/image"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:corner_radius="@dimen/emui_corner_radius_mediums" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ViewStub
            android:layout_gravity="center_vertical"
            android:id="@id/promotion_sign_viewstub"
            android:layout="@layout/promotion_sign_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/search_ui_40_dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
    </LinearLayout>
</LinearLayout>