<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_gravity="bottom|center"
    android:id="@id/rl_root"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@id/title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fa_margin_top"
            android:layout_marginStart="@dimen/hap_detail_card_desc_margin_top_pad"
            android:layout_marginEnd="@dimen/fa_button_margin">
            <RelativeLayout
                android:background="@drawable/fa_app_name_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/fa_min_gap">
                <ImageView
                    android:id="@id/fa_img"
                    android:layout_width="@dimen/fa_margin_top"
                    android:layout_height="@dimen/fa_margin_top"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:ellipsize="end"
                    android:id="@id/fa_app_name"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/fa_text_max_width"
                    android:maxLines="1"
                    android:importantForAccessibility="yes"
                    android:layout_marginStart="@dimen/variable_dots_page_indicator_dot_size"
                    android:layout_toEndOf="@id/fa_img" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/close_layout"
                android:background="@drawable/fa_close_button_background"
                android:clickable="true"
                android:layout_width="@dimen/fa_form_added_size_in_pad"
                android:layout_height="@dimen/fa_form_added_size_in_pad"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/close_button"
                    android:layout_width="@dimen/hap_detail_card_desc_margin_top_pad"
                    android:layout_height="@dimen/hap_detail_card_desc_margin_top_pad"
                    android:layout_centerInParent="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/downloadfa_close" />
            </RelativeLayout>
        </RelativeLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="20.0sp"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/fa_card_title"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fa_scrollview_top_margin"
            android:text="@string/downloadfa_fa_add_confirm_title"
            android:maxLines="1"
            android:importantForAccessibility="yes"
            android:layout_marginStart="@dimen/hap_detail_card_desc_margin_top_pad"
            android:layout_marginEnd="@dimen/hap_detail_card_desc_margin_top_pad"
            style="@style/AppGallery.TextAppearance.Card.Title" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="16.0sp"
            android:textColor="@color/fa_recommend_text"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/fa_recommend_desc"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:maxLines="1"
            android:importantForAccessibility="yes"
            android:layout_marginStart="@dimen/hap_detail_card_desc_margin_top_pad"
            android:layout_marginEnd="@dimen/hap_detail_card_desc_margin_top_pad" />
        <ScrollView
            android:id="@id/scroll_layout"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@id/pager_content"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/hap_detail_viewpager_height_other"
                    android:layout_marginTop="@dimen/fa_top_margin">
                    <com.huawei.appgallery.downloadfa.impl.ui.fareminder.VariableDotsPageIndicator
                        android:id="@id/vertical_dots_indicator"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="@dimen/hap_detail_card_desc_margin_top_pad"
                        android:layout_alignParentEnd="true"
                        app:selectedDotColor="@color/emui_activated"
                        app:unselectedDotColor="@color/emui_control_normal" />
                    <com.huawei.uikit.hwviewpager.widget.HwViewPager
                        android:layout_gravity="center"
                        android:id="@id/viewPager"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:importantForAccessibility="no" />
                </RelativeLayout>
                <com.huawei.uikit.phone.hwdotspageindicator.widget.HwDotsPageIndicator
                    android:layout_gravity="center_horizontal"
                    android:id="@id/horizal_dots_indicator"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="36.0dip"
                    android:importantForAccessibility="no"
                    app:selectedDotColor="@color/emui_activated"
                    app:unselectedDotColor="@color/emui_control_normal" />
            </LinearLayout>
        </ScrollView>
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:layout_gravity="center_horizontal"
            android:id="@id/confirm_button"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/hwbutton_default_height"
            android:layout_marginTop="@dimen/fa_top_margin"
            android:layout_marginBottom="@dimen/hap_detail_card_desc_margin_top_pad"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/hap_detail_card_desc_margin_top_pad"
            android:layout_marginEnd="@dimen/hap_detail_card_desc_margin_top_pad"
            app:hwAutoSizeMinTextSize="9.0sp"
            app:hwAutoSizeStepGranularity="1.0sp"
            style="@style/Widget.Emui.HwButton.Emphasize" />
    </LinearLayout>
</RelativeLayout>