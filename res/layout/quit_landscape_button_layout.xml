<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginLeft="16.0dip"
    android:layout_marginTop="8.0dip"
    android:layout_marginRight="16.0dip"
    android:layout_marginBottom="16.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <View
            android:id="@id/line"
            android:background="#33ffffff"
            android:layout_width="1.0px"
            android:layout_height="24.0dip"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
        <TextView
            android:textSize="16.0dip"
            android:textColor="@drawable/quit_btntext_bg"
            android:gravity="center"
            android:id="@id/tv_quit_cancel"
            android:background="@drawable/quit_normal_bg"
            android:padding="8.0dip"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:text="@string/cloud_game_cancel"
            android:layout_centerInParent="true"
            android:layout_marginEnd="8.0dip"
            android:layout_toStartOf="@id/line" />
    </RelativeLayout>
    <TextView
        android:textSize="16.0dip"
        android:textColor="@drawable/quit_btntext_bg"
        android:gravity="center"
        android:id="@id/tv_quit_exit"
        android:background="@drawable/quit_normal_bg"
        android:padding="8.0dip"
        android:layout_width="0.0dip"
        android:layout_height="40.0dip"
        android:layout_marginLeft="12.0dip"
        android:layout_marginRight="8.0dip"
        android:text="@string/cloud_game_dialog_button_exit"
        android:layout_weight="1.0" />
    <TextView
        android:textSize="16.0dip"
        android:textColor="#ffe5e5e5"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/tv_quit_exit_install"
        android:background="@drawable/quit_install_bg"
        android:padding="9.0dip"
        android:layout_width="0.0dip"
        android:layout_height="40.0dip"
        android:layout_marginLeft="8.0dip"
        android:layout_marginRight="4.0dip"
        android:text="@string/cloud_game_dialog_exit_and_install"
        android:maxLines="1"
        android:layout_weight="1.0" />
</LinearLayout>