<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@drawable/list_item_normal_selector"
    android:paddingLeft="@dimen/appgallery_column_system_content_margin"
    android:paddingRight="@dimen/appgallery_column_system_content_margin"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/item_linearlayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20.0dip">
                <ImageView
                    android:gravity="center_vertical"
                    android:id="@id/item_label_imageview"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/placeholder_base_circle" />
                <TextView
                    android:id="@id/item_label_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                <ImageView
                    android:textColor="@color/emui_white"
                    android:id="@id/item_red_dot_imageview"
                    android:visibility="gone"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:src="@drawable/tab_red_dot"
                    android:layout_marginStart="@dimen/appgallery_text_margin_horizontal" />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:layout_marginStart="@dimen/appgallery_card_icon_size_small">
            <TextView
                android:id="@id/order_count_textview"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/appgallery_horizontal_icon_card_space"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
            <TextView
                android:id="@id/order_desc_textview"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/appgallery_horizontal_icon_card_space"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
            <ImageView
                android:id="@id/arrow_imageview"
                android:visibility="visible"
                android:layout_width="12.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_public_arrow_right_900"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_m"
                android:layout_alignParentEnd="true" />
            <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
                android:id="@id/progressBar"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_s"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@id/vertical_divide_line_imageview"
        android:layout_width="fill_parent"
        android:layout_marginStart="40.0dip"
        style="@style/AppGallery.Widget.Divider" />
</FrameLayout>