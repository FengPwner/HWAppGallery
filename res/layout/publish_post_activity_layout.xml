<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appgallery.forum.option.post.view.SoftInputMeasureLayout
    android:fitsSystemWindows="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/post_title"
        layout="@layout/publish_post_title_layout" />
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@id/bottom_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_vertical_l">
            <TextView
                android:textSize="@dimen/emui_master_caption_2"
                android:textColor="@color/emui_functional_red"
                android:id="@id/img_limit_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_horizontal_m"
                android:text="@string/forum_option_img_reach_limit"
                android:layout_alignParentStart="true" />
            <TextView
                android:textSize="@dimen/emui_master_caption_2"
                android:textColor="@color/emui_functional_red"
                android:id="@id/content_count_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_horizontal_m"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout
            android:paddingTop="4.0dip"
            android:paddingBottom="4.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="32.0dip"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end">
            <CheckBox
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_color_secondary"
                android:id="@id/insert_ai_checkbox"
                android:background="@null"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/insert_img_layout_container"
            android:background="@color/appgallery_color_toolbar_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/hwappbarpattern_split_menu_height"
            android:layout_marginStart="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_vertical_l">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <com.huawei.appgallery.forum.option.post.view.PostToolbar
                    android:gravity="center"
                    android:id="@id/insert_img_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:type="image" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <com.huawei.appgallery.forum.option.post.view.PostToolbar
                    android:gravity="center"
                    android:id="@id/insert_emoji_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:type="emoji" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/insert_vote_layout_container"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <com.huawei.appgallery.forum.option.post.view.PostToolbar
                    android:gravity="center"
                    android:id="@id/insert_vote_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:type="vote" />
            </LinearLayout>
        </LinearLayout>
        <com.huawei.uikit.phone.hwviewpager.widget.HwViewPager
            android:id="@id/vp_emoji"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="160.0dip"
            android:layout_marginTop="4.0dip"
            android:layout_marginBottom="4.0dip" />
        <com.huawei.uikit.phone.hwdotspageindicator.widget.HwDotsPageIndicator
            android:id="@id/indicator_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="32.0dip" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@id/nsv_publish_moment"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipChildren="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/bottom_layout"
        android:layout_below="@id/post_title">
        <FrameLayout
            android:orientation="vertical"
            android:id="@id/container_publish_moment"
            android:clipChildren="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </androidx.core.widget.NestedScrollView>
    <ScrollView
        android:id="@id/publish_scroll_layout"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true"
        android:layout_above="@id/bottom_layout"
        android:layout_below="@id/post_title"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/appgallery_input_box_default_height">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginBottom="10.0dip"
                    android:minHeight="36.0dip"
                    android:layout_centerVertical="true">
                    <com.huawei.uikit.hwedittext.widget.HwEditText
                        android:textSize="@dimen/appgallery_text_size_body1"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:textColorHint="@color/appgallery_text_color_hint"
                        android:id="@id/title_edit_text"
                        android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/forum_option_post_title_hint"
                        android:maxLength="60"
                        android:inputType="textMultiLine"
                        android:imeOptions="flagNoExtractUi|flagNoFullscreen"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        style="@style/Widget.Emui.HwEditText.Linear" />
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/emui_master_caption_2"
                android:textColor="@color/emui_color_gray_5"
                android:gravity="end"
                android:id="@id/title_count_text"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_s" />
            <com.huawei.appgallery.forum.option.post.view.RichTextEditor
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:textColorHint="@color/appgallery_text_color_hint"
                android:id="@id/content_edit_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <View
                android:id="@id/span_view"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </ScrollView>
</com.huawei.appgallery.forum.option.post.view.SoftInputMeasureLayout>