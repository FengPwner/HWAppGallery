<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/card_link_layout"
    android:background="@drawable/forum_post_card_link_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/link_icon"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:src="@drawable/forum_post_card_link"
        android:layout_centerVertical="true"
        android:layout_marginStart="8.0dip" />
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_color_primary"
        android:id="@id/link_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="8.0dip"
        android:singleLine="true"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="8.0dip"
        android:layout_marginEnd="10.0dip"
        android:layout_toEndOf="@id/link_icon" />
</RelativeLayout>