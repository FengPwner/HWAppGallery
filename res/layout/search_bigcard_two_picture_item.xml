<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/img_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
            android:layout_gravity="center"
            android:id="@id/wisedist_searchbigcard_first_icon"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
        <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
            android:layout_gravity="center"
            android:id="@id/wisedist_searchbigcard_second_icon"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
    </LinearLayout>
    <include
        android:id="@id/bigcard_des_layout"
        layout="@layout/search_bigcard_des_include" />
</LinearLayout>