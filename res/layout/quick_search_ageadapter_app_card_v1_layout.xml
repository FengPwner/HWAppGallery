<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/app_icon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:layout_marginTop="16.0dip"
        android:layout_marginBottom="8.0dip"
        android:layout_marginStart="@dimen/appgallery_max_padding_start" />
    <RelativeLayout
        android:id="@id/app_right_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/app_icon"
        android:layout_alignStart="@id/app_icon">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/app_name_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@id/first_line_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1.0"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/info_appquality_imageview"
                    android:visibility="gone"
                    android:layout_width="@dimen/search_appquality_icon_size"
                    android:layout_height="@dimen/search_appquality_icon_size"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_m" />
                <ViewStub
                    android:layout_gravity="center_vertical"
                    android:id="@id/info_cloud_game_imageview_viewstub"
                    android:layout="@layout/cloud_game_imageview_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip">
                <ViewStub
                    android:layout_gravity="center_vertical"
                    android:id="@id/promotion_sign_viewstub"
                    android:layout="@layout/promotion_sign_ageadapter_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m" />
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/app_flag_rect"
                    android:visibility="gone"
                    android:layout_width="28.0sp"
                    android:layout_height="16.0sp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="@dimen/margin_m" />
                <TextView
                    android:ellipsize="end"
                    android:id="@id/app_desc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_button"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="16.0dip"
            android:layout_below="@id/app_name_layout">
            <com.huawei.appgallery.search.api.view.AutoSearchDownloadButton
                android:layout_gravity="center"
                android:id="@id/dl_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <TextView
                android:textColor="@color/appgallery_text_color_tertiary"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@id/original_price_textview"
                android:tag="css/.subtitle"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.TextCaption" />
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@id/bottom_divider_line"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@id/app_icon"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>