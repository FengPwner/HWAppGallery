<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="16.0dip"
    android:layout_marginEnd="16.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_sort_all"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_elements_margin_horizontal_l"
        android:paddingEnd="@dimen/appgallery_elements_margin_horizontal_l">
        <RelativeLayout
            android:gravity="bottom"
            android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/appgallery_list_height_single_text_line">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:id="@id/reply_count_all"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@id/ll_sort_nor"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="bottom"
            android:id="@id/sort_layout"
            android:paddingTop="@dimen/margin_l"
            android:paddingBottom="@dimen/margin_s"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end">
            <LinearLayout
                android:gravity="bottom"
                android:paddingBottom="@dimen/margin_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">
                <TextView
                    android:id="@id/reply_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/BuoySortCardTitle" />
            </LinearLayout>
            <com.huawei.appgallery.forum.cards.widget.SortSpinner
                android:gravity="bottom"
                android:id="@id/reply_spinner_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                app:hwListShadowEnabled="true"
                style="@style/BuoySpinner" />
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>