<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/audiokit_audio_notification_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/title_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s">
        <ImageView
            android:id="@id/notification_icon"
            android:layout_width="@dimen/audiokit_audio_notification_small_icon_size"
            android:layout_height="@dimen/audiokit_audio_notification_small_icon_size" />
        <TextView
            android:textColor="@color/audiokit_audio_text_color_primary"
            android:id="@id/notification_title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2" />
        <ImageView
            android:id="@id/close"
            android:padding="@dimen/appgallery_card_elements_margin_m"
            android:layout_width="@dimen/audiokit_audio_notification_control_button_size"
            android:layout_height="@dimen/audiokit_audio_notification_control_button_size"
            android:src="@drawable/aguikit_ic_public_cancel" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title_layout"
        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m">
        <ImageView
            android:id="@id/audio_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_middle"
            android:layout_height="@dimen/appgallery_card_icon_size_middle" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/audiokit_audio_notification_margin">
            <TextView
                android:textColor="@color/audiokit_audio_text_color_primary"
                android:ellipsize="end"
                android:id="@id/audio_title"
                android:padding="0.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody2" />
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/audiokit_audio_text_color_secondary"
                    android:id="@id/audio_play_time"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2" />
                <ImageView
                    android:id="@id/play_prev"
                    android:padding="@dimen/appgallery_card_elements_margin_s"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/audiokit_audio_notification_control_button_size"
                    android:layout_height="@dimen/audiokit_audio_notification_control_button_size"
                    android:src="@drawable/audiokit_audio_prev_btn_selector"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l" />
                <ImageView
                    android:id="@id/play_prev_disable"
                    android:padding="@dimen/appgallery_card_elements_margin_s"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="@dimen/audiokit_audio_notification_control_button_size"
                    android:layout_height="@dimen/audiokit_audio_notification_control_button_size"
                    android:src="@drawable/audiokit_audio_prev_disable_selector"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l" />
                <ImageView
                    android:id="@id/play"
                    android:padding="@dimen/appgallery_card_elements_margin_s"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/audiokit_audio_notification_control_button_size"
                    android:layout_height="@dimen/audiokit_audio_notification_control_button_size"
                    android:src="@drawable/ic_notification_pause"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
                <ImageView
                    android:id="@id/play_next"
                    android:padding="@dimen/appgallery_card_elements_margin_s"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/audiokit_audio_notification_control_button_size"
                    android:layout_height="@dimen/audiokit_audio_notification_control_button_size"
                    android:src="@drawable/audiokit_audio_next_btn_selector" />
                <ImageView
                    android:id="@id/play_next_disable"
                    android:padding="@dimen/appgallery_card_elements_margin_s"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="@dimen/audiokit_audio_notification_control_button_size"
                    android:layout_height="@dimen/audiokit_audio_notification_control_button_size"
                    android:src="@drawable/audiokit_audio_next_disable_selector"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>