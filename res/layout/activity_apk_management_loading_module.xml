<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.phone.hwprogressbar.widget.HwProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@id/loadingBar"
        android:layout_width="@dimen/loading_large"
        android:layout_height="@dimen/loading_large"
        style="@style/Widget.Emui.HwProgressBar.Large" />
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apkmanagement_loading"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
    <TextView
        android:gravity="center"
        android:id="@id/loading_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
        android:lines="2"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
</LinearLayout>