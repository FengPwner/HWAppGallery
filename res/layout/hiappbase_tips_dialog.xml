<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/hiappbase_tip_container"
    android:background="@color/transparent"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentStart="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.phone.hwbubblelayout.widget.HwBubbleLayout
        android:id="@id/bubble_layout_popup"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:hwArrowDirection="top"
        app:hwArrowPosition="0.0dip"
        app:hwArrowStartLocation="positive"
        app:hwBubbleColor="@color/appgallery_color_card_panel_bg"
        app:hwShadowEnabled="false"
        app:hwShadowSize="medium"
        app:hwWidgetStyle="light"
        style="@style/Widget.Emui.HwBubbleLayout.Light">
        <LinearLayout
            android:enabled="true"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:enabled="true"
                android:orientation="vertical"
                android:id="@id/bubble_title_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/bubble_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.0dip"
                    android:text="@string/hiappbase_ad_title"
                    android:maxLines="2"
                    android:importantForAccessibility="yes"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="@dimen/appgallery_dialog_margin_start"
                    android:layout_marginEnd="@dimen/appgallery_dialog_margin_end"
                    style="@style/AppGallery.TextAppearance.Card.SubTitle2" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textColor="@color/emui_color_text_secondary"
                    android:ellipsize="end"
                    android:id="@id/bubble_subTitle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:layout_marginBottom="8.5dip"
                    android:text="@string/hiappbase_ad_subtitle"
                    android:maxLines="2"
                    android:importantForAccessibility="yes"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="@dimen/appgallery_dialog_margin_start"
                    android:layout_marginEnd="@dimen/appgallery_dialog_margin_end"
                    style="@style/AppGallery.TextAppearance.Card.SubTitle3" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <com.huawei.uikit.phone.hwrecyclerview.widget.HwRecyclerView
                    android:id="@id/ad_list"
                    android:scrollbars="vertical"
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_safety_margin_s"
                    app:hwScrollTopEnable="false" />
            </FrameLayout>
        </LinearLayout>
    </com.huawei.uikit.phone.hwbubblelayout.widget.HwBubbleLayout>
</RelativeLayout>