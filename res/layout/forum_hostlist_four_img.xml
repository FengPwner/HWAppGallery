<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@id/forum_hotlist_imageview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_centerInParent="true"
        app:shapeAppearance="@style/AppGallery.ShapeAppearance.Rounded.Small" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textColor="@color/appgallery_text_color_primary_inverse"
        android:gravity="center"
        android:id="@id/forum_hotlist_layer_count_textview"
        android:background="@drawable/forum_hotlist_layer_bg"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Primary" />
</RelativeLayout>