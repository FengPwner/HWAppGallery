<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/agguard_card_item_pressed_inset_bg"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12.0dip"
    android:paddingEnd="12.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:layout_gravity="start"
        android:id="@id/version_updated_item_icon"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:layout_marginTop="12.0dip"
        android:importantForAccessibility="no"
        app:corner_type="appicon"
        app:round_type="all" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textColor="@color/appgallery_text_color_primary"
        android:ellipsize="end"
        android:id="@id/version_updated_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:maxLines="1"
        android:textDirection="locale"
        style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/version_updated_item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/version_updated_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/margin_m"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
        android:id="@id/item_download_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="@dimen/ui_12_dp"
        android:minHeight="28.0dip"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
    <View
        android:id="@id/version_updated_item_divider"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>