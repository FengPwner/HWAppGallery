<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@id/updatemanager_header"
    android:background="@drawable/aguikit_round_rectangle_card_item_bg"
    android:paddingTop="@dimen/appgallery_card_panel_inner_margin_vertical"
    android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_column_system_content_margin"
    android:paddingEnd="@dimen/appgallery_column_system_content_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="start|center"
        android:id="@id/updatemanager_updateview_title_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/updatemanager_ageadapter_updateview_title_min_height"
        android:text="@string/updatemanager_app_updates"
        style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@id/updatemanager_updateview_img_rlyt"
        android:paddingTop="@dimen/updatemanager_ageadapter_updateview_head_padding_top"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/updatemanager_updateview_v1_update_icon1_imageview"
            android:layout_width="@dimen/updatemanager_ageadapter_updateview_icon"
            android:layout_height="@dimen/updatemanager_ageadapter_updateview_icon"
            android:src="@color/transparent"
            android:layout_marginEnd="@dimen/appgallery_safety_margin_s" />
        <ImageView
            android:id="@id/updatemanager_updateview_v1_update_icon2_imageview"
            android:layout_width="@dimen/updatemanager_ageadapter_updateview_icon"
            android:layout_height="@dimen/updatemanager_ageadapter_updateview_icon"
            android:src="@color/transparent"
            android:layout_marginEnd="@dimen/appgallery_safety_margin_s"
            android:layout_toEndOf="@id/updatemanager_updateview_v1_update_icon1_imageview" />
        <ImageView
            android:id="@id/updatemanager_updateview_v1_update_icon3_imageview"
            android:layout_width="@dimen/updatemanager_ageadapter_updateview_icon"
            android:layout_height="@dimen/updatemanager_ageadapter_updateview_icon"
            android:src="@color/transparent"
            android:layout_marginEnd="@dimen/appgallery_safety_margin_s"
            android:layout_toEndOf="@id/updatemanager_updateview_v1_update_icon2_imageview" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body1_fixed"
            android:textColor="@color/appgallery_text_color_primary_inverse"
            android:gravity="center"
            android:id="@id/updatemanager_update_num"
            android:background="@drawable/updatemanager_ageadapter_updateview_update_num_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/updatemanager_ageadapter_updateview_updatenum"
            android:includeFontPadding="false"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:paddingStart="@dimen/updatemanager_updateview_updatenum_padding"
            android:paddingEnd="@dimen/updatemanager_updateview_updatenum_padding"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
            android:layout_toEndOf="@id/updatemanager_updateview_v1_update_icon3_imageview" />
        <ImageView
            android:id="@id/update_arrow_imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_public_arrow_right_900"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>