<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:transitionGroup="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/forum_msg_img_layout"
        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
        android:layout_width="48.0dip"
        android:layout_height="56.0dip"
        android:layout_centerVertical="true"
        android:contentDescription="@string/market_mine_notice"
        android:layout_marginEnd="@dimen/margin_m"
        android:layout_alignParentEnd="true"
        android:transitionGroup="false">
        <RelativeLayout
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:layout_centerInParent="true"
            android:transitionGroup="false">
            <ImageView
                android:id="@id/forum_msg_img"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/aguikit_ic_public_ring" />
        </RelativeLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="10.0dip"
            android:textColor="@color/forum_search_msg_number"
            android:gravity="center"
            android:id="@id/msg_text"
            android:background="@drawable/forum_msgremind_single_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cs_14_dp"
            android:layout_marginTop="14.0dip"
            android:minWidth="@dimen/cs_14_dp"
            android:maxLines="1"
            android:paddingStart="4.0dip"
            android:paddingEnd="4.0dip"
            android:layout_marginStart="20.0dip"
            app:hwAutoSizeMinTextSize="9.0dip"
            app:hwAutoSizeStepGranularity="1.0dip" />
    </RelativeLayout>
    <com.huawei.appmarket.framework.widget.FixedSearchView
        android:id="@id/search_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/margin_s"
        android:layout_toStartOf="@id/forum_msg_img_layout"
        android:layout_alignParentStart="true" />
</RelativeLayout>