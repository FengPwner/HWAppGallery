<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/setting_card_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    style="@style/AppGallery.Widget.List.TwoTextLines"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="end|center"
        android:orientation="horizontal"
        android:id="@id/arrow_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_below="@id/content_ll">
        <TextView
            android:gravity="start|center"
            android:layout_gravity="start|center"
            android:id="@id/setlockContent"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1.0"
            android:textAlignment="viewStart"
            android:layout_marginStart="0.0dip"
            style="@style/AppGallery.Widget.List.RightText" />
        <ImageView
            android:layout_gravity="end|center"
            android:id="@id/arrowlayout"
            android:layout_marginStart="@dimen/margin_s"
            style="@style/AppGallery.Widget.List.RightArrow" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/content_ll"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:id="@id/setItemTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
        <TextView
            android:gravity="center_vertical"
            android:id="@id/setItemContent"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:lineSpacingMultiplier="1.3"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
</RelativeLayout>