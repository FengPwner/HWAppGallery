<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/forum_user_home_title_layout"
        layout="@layout/forum_user_home_title" />
    <RelativeLayout
        android:id="@id/user_home_loading_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/forum_user_home_title_layout" />
    <RelativeLayout
        android:id="@id/user_homepage_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/forum_user_home_title_layout" />
    <com.huawei.appgallery.forum.user.menu.UserActionBar
        android:layout_gravity="top"
        android:id="@id/forum_user_center_custombar"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />
</RelativeLayout>