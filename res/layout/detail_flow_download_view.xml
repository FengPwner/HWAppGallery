<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/detail_flow_download_view_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/detail_flow_download_view_layout"
        android:background="@drawable/detail_bottom_round_rect_card_bg"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="6.0dip"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/detail_flow_download_card_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="72.0dip">
            <ImageView
                android:id="@id/detail_app_icon"
                android:layout_width="56.0dip"
                android:layout_height="56.0dip"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/detail_app_description"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="@dimen/cs_8_dp"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="8.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/detail_download_button"
                app:layout_constraintStart_toEndOf="@id/detail_app_icon"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/detail_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    app:layout_constraintBottom_toTopOf="@id/detail_rating_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1" />
                <com.huawei.appmarket.service.appdetail.view.widget.FixedLeftLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/detail_rating_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@id/detail_app_memo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detail_app_title">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@id/detail_rating_icon"
                            android:layout_width="12.0dip"
                            android:layout_height="12.0dip"
                            android:src="@drawable/detail_star_small"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="2.0dip" />
                        <TextView
                            android:ellipsize="end"
                            android:id="@id/detail_rating_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    </LinearLayout>
                    <View
                        android:id="@id/detail_rating_split"
                        android:background="@color/appgallery_text_color_tertiary"
                        android:layout_width="1.0dip"
                        android:layout_height="9.0dip"
                        android:layout_marginStart="6.0dip"
                        android:layout_marginEnd="6.0dip" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@id/detail_download_icon"
                            android:layout_width="12.0dip"
                            android:layout_height="12.0dip"
                            android:src="@drawable/detail_download_small"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="2.0dip" />
                        <TextView
                            android:ellipsize="end"
                            android:id="@id/detail_download_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    </LinearLayout>
                </com.huawei.appmarket.service.appdetail.view.widget.FixedLeftLinearLayout>
                <TextView
                    android:ellipsize="end"
                    android:id="@id/detail_app_memo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detail_rating_container"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/host_app_info"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/detail_rating_container">
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/detail_app_dev_name"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    <TextView
                        android:ellipsize="none"
                        android:id="@id/other_appinfos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/detail_download_button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</FrameLayout>