<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginLeft="@dimen/padding_xl"
        android:layout_marginTop="@dimen/margin_xl"
        android:layout_marginRight="@dimen/padding_xl"
        android:layout_weight="1.0"
        android:layout_marginStart="@dimen/padding_xl"
        android:layout_marginEnd="@dimen/padding_xl">
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_body1"
                android:textColor="@color/emui_color_text_primary"
                android:id="@id/content_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/c_shortcut_dlg_content"
                android:lineSpacingExtra="5.0dip"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </ScrollView>
    <com.huawei.uikit.hwcheckbox.widget.HwCheckBox
        android:textSize="@dimen/emui_text_size_body2"
        android:textColor="@color/emui_color_text_primary"
        android:id="@id/not_remind_checkbox"
        android:paddingLeft="@dimen/c_shortcut_checkbox_padding_start"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/c_shortcut_checkbox_margin_start"
        android:layout_marginTop="@dimen/c_shortcut_checkbox_margin_top"
        android:layout_marginRight="@dimen/padding_xl"
        android:checked="false"
        android:text="@string/c_shortcut_checkbox_not_remind"
        android:fontFamily="sans-serif"
        android:paddingStart="@dimen/c_shortcut_checkbox_padding_start"
        android:layout_marginStart="@dimen/c_shortcut_checkbox_margin_start"
        android:layout_marginEnd="@dimen/padding_xl" />
</LinearLayout>