<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/blank_view"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="32.0dip"
            android:paddingBottom="32.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <ImageView
                android:src="@drawable/forum_ic_empty_no_record"
                style="@style/AppGallery.ImageSize.NoData" />
            <TextView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:text="@string/forum_user_homepage_reply_empty"
                style="@style/AppGallery.TextAppearance.NoData" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/comment_user_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/padding_m">
        <com.huawei.appgallery.forum.cards.widget.NickNameFakeView
            android:textColor="@color/forum_post_emui_white_30"
            android:id="@id/comment_user_name_top_fake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/comment_user_name_layout"
            android:layout_alignBottom="@id/comment_user_name_layout" />
        <com.huawei.appgallery.forum.cards.widget.UserHeadImageView
            android:id="@id/comment_user_image"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
        <RelativeLayout
            android:id="@id/comment_user_name_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/comment_user_image">
            <com.huawei.appgallery.forum.cards.widget.UserInfoTextView
                android:gravity="center_vertical"
                android:id="@id/comment_user_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/comment_floor"
                style="@style/BuoyCardTextBody2_Regular" />
            <TextView
                android:id="@id/comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/comment_user_name"
                android:layout_marginEnd="@dimen/margin_m"
                style="@style/BuoyCardTextBody2_Regular" />
            <TextView
                android:id="@id/comment_floor"
                android:paddingTop="1.0sp"
                android:paddingBottom="1.0sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/comment_user_name"
                android:layout_centerInParent="true"
                android:layout_marginEnd="@dimen/margin_m"
                android:layout_toStartOf="@id/comment_more_layout"
                style="@style/BuoyCardTextBody2_Regular" />
            <RelativeLayout
                android:id="@id/comment_more_layout"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:paddingTop="@dimen/padding_xs"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_alignParentTop="true"
                android:contentDescription="@string/forum_post_more_btn"
                android:paddingStart="@dimen/padding_m"
                android:paddingEnd="@dimen/padding_m"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/comment_more_image"
                    android:layout_width="8.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/ic_buoy_public_more_small"
                    android:layout_alignParentTop="true" />
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/comment_reply_click_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/comment_user_layout"
        android:paddingStart="@dimen/comment_image_padding"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/forum_post_text_color_secondary"
            android:id="@id/comment_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textAlignment="viewStart" />
        <com.huawei.appgallery.forum.cards.widget.ForumLineImageView
            android:id="@id/comment_image"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m"
            app:has_touch_drawable="false"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="@dimen/appgallery_subheader_default_height_single_text_line">
            <RelativeLayout
                android:id="@id/comment_opr_layout"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:contentDescription="@string/forum_post_reply"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/comment_reply_count_img"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/buoy_forum_ic_com_comment_black"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_s" />
                <TextView
                    android:id="@id/comment_reply_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/comment_reply_count_img"
                    style="@style/BuoyCaptionTextBody" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/comment_like_layout"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:contentDescription="@string/forum_post_like"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/comment_opr_layout">
                <ImageView
                    android:id="@id/comment_reply_like_img"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/buoy_forum_ic_com_praise_actived"
                    android:layout_centerVertical="true" />
                <TextView
                    android:id="@id/comment_like_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/margin_s"
                    android:layout_toEndOf="@id/comment_reply_like_img"
                    style="@style/BuoyCaptionTextBody" />
            </RelativeLayout>
            <com.huawei.appgallery.forum.posts.view.PostCommentTriangleView
                android:id="@id/comment_triangle_view"
                android:visibility="gone"
                android:layout_width="20.0dip"
                android:layout_height="8.0dip"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="9.0dip"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/comment_reply_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/comment_reply_bg_layout"
                android:background="@drawable/buoy_post_comment_bg_selector"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:paddingEnd="@dimen/appgallery_elements_margin_horizontal_l">
                <com.huawei.appgallery.forum.cards.widget.BuoyReplyTextView
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:textColor="@color/forum_post_emui_white_30"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/comment_reply_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                    android:maxLines="2"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textDirection="locale"
                    android:textAlignment="viewStart" />
                <com.huawei.appgallery.forum.cards.widget.BuoyReplyTextView
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:textColor="@color/forum_post_emui_white_30"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/comment_reply_2"
                    android:paddingTop="@dimen/margin_xs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.0dip"
                    android:maxLines="2"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textDirection="locale"
                    android:textAlignment="viewStart" />
                <RelativeLayout
                    android:id="@id/comment_reply_more_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.0dip"
                    android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="@color/emui_functional_blue"
                        android:id="@id/comment_reply_more_text"
                        android:background="@drawable/buoy_post_comment_bg_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@plurals/forum_post_comment_more"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>