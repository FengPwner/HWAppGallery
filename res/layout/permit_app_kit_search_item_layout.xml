<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/item_container_layout"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_card_height_three_text_lines"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/appinfo_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@id/appinfo_right_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical">
            <ImageView
                android:id="@id/item_appicon"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:src="@drawable/transparent"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/appinfo_right_content_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/item_app_get_btn"
                android:layout_toEndOf="@id/item_appicon">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/item_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:singleLine="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/item_app_intro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                        android:id="@id/nonadapt_imageview"
                        android:tag="css/.title"
                        android:visibility="gone"
                        android:layout_width="18.0dip"
                        android:layout_height="fill_parent"
                        android:scaleType="fitCenter"
                        android:paddingEnd="@dimen/appgallery_text_paragraph_margin_xs" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/item_app_link"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                </LinearLayout>
            </LinearLayout>
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/item_app_get_btn"
                android:tag="css/.download-button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/permit_app_kit_ui_64_dp"
                android:minHeight="@dimen/permit_app_kit_ui_28_dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/more_links_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:layout_below="@id/appinfo_right_layout"
            android:layout_marginStart="72.0dip">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permit_app_kit_more_links"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <ImageView
                android:id="@id/expand_icon"
                android:background="@drawable/permit_app_kit_ic_arrow_down"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:layout_marginStart="@dimen/margin_s" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/expand_frame_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_marginStart="72.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/more_links_expand_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <View
        android:id="@id/item_divider_line"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_marginStart="72.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>