<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/wisedist_buoy_purchase_history_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="56.0dip"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <ImageView
            android:layout_width="@dimen/ui_24_dp"
            android:layout_height="@dimen/ui_24_dp"
            android:src="@drawable/ic_cart"
            android:contentDescription="@string/purchase_title"
            android:alpha="0.6"
            android:layout_marginEnd="@dimen/margin_l" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/emui_text_primary_inverse"
            android:id="@id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchase_title" />
    </LinearLayout>
    <RelativeLayout
        android:id="@id/view_history_detail"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:contentDescription="@string/enter_detail"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_toEndOf="@id/title_layout"
        android:layout_alignParentEnd="true">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body3"
            android:textColor="@color/emui_text_secondary_inverse"
            android:id="@id/hiappbase_subheader_more_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enter_detail"
            android:layout_centerVertical="true"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginEnd="@dimen/ui_4_dp"
            android:layout_toStartOf="@id/hiappbase_subheader_more_arrow" />
        <ImageView
            android:id="@id/hiappbase_subheader_more_arrow"
            android:background="@drawable/wisedist_buoy_arrow"
            android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
            android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</RelativeLayout>