            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_name"
            app:srcCompat="@drawable/app_icon_default_bg" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="16.0sp"
            android:textColor="@color/appgallery_text_color_primary"
            android:id="@id/tv_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:textAlignment="viewStart"
            android:layout_marginStart="52.0dip"
            android:layout_marginEnd="12.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="14.0sp"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/tv_certDesc"
