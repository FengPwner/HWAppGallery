<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/AppListItem"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/main_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_card_height_three_text_lines"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <ImageView
            android:id="@id/icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:src="@color/transparent"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true" />
        <RelativeLayout
            android:id="@id/right_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toEndOf="@id/icon">
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/downbtn"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/title_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/downbtn">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:layout_gravity="start|center"
                    android:id="@id/item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/item_desc_container"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <ViewStub
                        android:layout_gravity="center_vertical"
                        android:id="@id/promotion_sign_viewstub"
                        android:layout="@layout/promotion_sign_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:id="@id/item_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
            </LinearLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/item_memo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@id/title_layout"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </RelativeLayout>
    </RelativeLayout>
    <ImageView
        android:id="@id/item_divider_line"
        android:layout_width="fill_parent"
        android:layout_below="@id/main_layout"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Divider" />
    <View
        android:id="@id/bottom_blank_view"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_below="@id/item_divider_line" />
</RelativeLayout>