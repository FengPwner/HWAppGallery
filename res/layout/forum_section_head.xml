<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/forum_section_bg_img"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scaleType="centerCrop" />
    <View
        android:id="@id/forum_section_bg_color"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@id/forum_section_layout"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_l"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <ImageView
            android:id="@id/forum_section_icon"
            android:layout_width="64.0dip"
            android:layout_height="64.0dip"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_l"
            android:layout_alignParentStart="true" />
        <RelativeLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_toEndOf="@id/forum_section_icon">
            <TextView
                android:textSize="18.0dip"
                android:textColor="@color/forum_section_head_name_color"
                android:ellipsize="end"
                android:id="@id/forum_section_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_alignParentTop="true"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toStartOf="@id/forum_section_follow"
                android:layout_alignParentStart="true" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/forum_post_and_follow_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xs"
                android:layout_below="@id/forum_section_name">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/forum_post_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_l">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3_fixed"
                        android:textColor="@color/forum_section_subhead_name_color"
                        android:ellipsize="end"
                        android:id="@id/forum_post"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginEnd="@dimen/margin_s" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/forum_followed_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_l">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3_fixed"
                        android:textColor="@color/forum_section_subhead_name_color"
                        android:ellipsize="end"
                        android:id="@id/forum_followed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginEnd="@dimen/margin_s" />
                </LinearLayout>
            </LinearLayout>
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="13.0dip"
                android:textColor="@color/forum_section_head_name_color"
                android:gravity="center"
                android:id="@id/forum_section_follow"
                android:background="@drawable/hwbutton_default_small_emui_translucent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64.0dip"
                android:minHeight="28.0dip"
                android:maxLines="1"
                android:layout_alignParentTop="true"
                android:textAllCaps="true"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_alignParentEnd="true"
                app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small_fixed"
                app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity_fixed"
                style="@style/Widget.Emui.HwButton.Small" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_below="@id/forum_post_and_follow_layout">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/forum_contribution_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_l">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3_fixed"
                        android:textColor="@color/forum_section_subhead_name_color"
                        android:ellipsize="end"
                        android:id="@id/forum_contribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_below="@id/forum_section_name"
                        android:layout_marginEnd="@dimen/margin_s" />
                    <ImageView
                        android:layout_width="8.0dip"
                        android:layout_height="16.0dip"
                        android:src="@drawable/forum_ic_arrow_white" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/forum_claim_welfare_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3_fixed"
                        android:textColor="@color/forum_section_subhead_name_color"
                        android:ellipsize="end"
                        android:id="@id/forum_claim_welfare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forum_claim_welfare"
                        android:maxLines="1"
                        android:layout_marginEnd="@dimen/margin_s" />
                    <ImageView
                        android:layout_width="8.0dip"
                        android:layout_height="16.0dip"
                        android:src="@drawable/forum_ic_arrow_white" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>