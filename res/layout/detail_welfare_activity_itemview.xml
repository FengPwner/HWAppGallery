<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@id/welfare_relative_layout"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="86.0dip"
        android:paddingStart="@dimen/appgallery_card_elements_margin_m"
        android:paddingEnd="@dimen/appgallery_card_elements_margin_m">
        <ImageView
            android:id="@id/welfare_icon"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:src="@drawable/ic_detail_activity"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8.0dip" />
        <LinearLayout
            android:id="@id/participation_ll"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8.0dip"
            android:layout_alignParentEnd="true">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="@dimen/appgallery_text_size_button2"
                android:textColor="@color/hwbutton_selector_text_normal_emui"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/participation_button"
                android:tag="css/.download-button"
                android:background="@drawable/hwbutton_default_small_emui"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:maxWidth="90.0dip"
                android:minWidth="64.0dip"
                android:text="@string/welfare_acitivity_participation"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
                app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="48.0dip"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/participation_ll"
            android:layout_toEndOf="@id/welfare_icon">
            <LinearLayout
                android:layout_gravity="start|center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/welfare_activity_title"
                    android:tag="css/.title"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1.0"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/welfare_newcomer_logo_text"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@id/newcomer_logo"
                    android:tag="css/.title"
                    android:background="@drawable/newcomer_logo_text_bg"
                    android:padding="1.0px"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welfare_newcomer_exclusive"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:paddingStart="4.0dip"
                    android:paddingEnd="4.0dip"
                    android:layout_marginStart="4.0dip" />
            </LinearLayout>
            <TextView
                android:ellipsize="end"
                android:id="@id/welfare_subtitle"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/welfare_subtitle1"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@id/divide_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_below="@id/welfare_relative_layout"
        android:layout_marginStart="48.0dip"
        android:layout_marginEnd="8.0dip"
        android:layout_alignStart="@id/welfare_relative_layout"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>