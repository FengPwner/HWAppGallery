<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:paddingBottom="@dimen/component_detail_report_item_common_margin_vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/component_detail_report_item_common_margin_horizontal"
    android:paddingEnd="@dimen/component_detail_report_item_common_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/item_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@id/iv_star_must_input"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:layout_width="@dimen/component_detail_report_star_height_and_width"
            android:layout_height="@dimen/component_detail_report_star_height_and_width"
            android:layout_marginTop="@dimen/component_detail_report_second_title_star_margin_top"
            android:src="@drawable/ic_detail_report_star"
            android:contentDescription="@string/component_detail_star"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_contact_information" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:id="@id/tv_contact_information"
            android:paddingTop="@dimen/component_detail_report_second_title_padding_top"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line"
            android:text="@string/component_detail_report_contact_information"
            android:maxLines="2"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
            app:layout_constraintStart_toEndOf="@id/iv_star_must_input"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@id/container"
        android:background="@drawable/shape_report_contact_input_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        app:layout_constraintTop_toBottomOf="@id/item_title">
        <com.huawei.uikit.hwedittext.widget.HwEditText
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_primary"
            android:textColorHint="@color/appgallery_text_color_hint"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/et_contact_information"
            android:background="@drawable/selector_report_detail_contact_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_card_icon_size_small"
            android:hint="@string/component_detail_report_contact_information_hint"
            android:inputType="text"
            android:imeOptions="flagNoFullscreen"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textDirection="locale"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/Widget.Emui.HwEditText.Space" />
    </FrameLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_caption"
        android:textColor="@color/appgallery_color_error"
        android:id="@id/tv_contact_error_hint"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_m"
        android:text="@string/component_detail_report_contract_info_error_hint"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/component_detail_report_margin_l"
        app:layout_constraintTop_toBottomOf="@id/container" />
</androidx.constraintlayout.widget.ConstraintLayout>