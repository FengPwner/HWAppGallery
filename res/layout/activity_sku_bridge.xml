<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_gravity="bottom|center"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/sku_bridge_bg"
        android:background="@color/sku_bridge_bg_color_bg"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:layout_gravity="bottom|center"
        android:orientation="vertical"
        android:id="@id/rl_root"
        android:background="@drawable/sku_bridge_bg"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_xl"
        android:paddingEnd="@dimen/margin_xl">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/ll_arrow_down"
            android:layout_width="96.0dip"
            android:layout_height="@dimen/ui_24_dp"
            android:contentDescription="@string/click_back">
            <ImageView
                android:id="@id/iv_arrow_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_down" />
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@id/iv_icon"
            android:focusable="false"
            android:layout_width="@dimen/appgallery_card_icon_size_xl"
            android:layout_height="@dimen/appgallery_card_icon_size_xl"
            android:layout_marginTop="@dimen/ui_32_dp"
            android:src="@drawable/icon_default_bg"
            android:scaleType="fitCenter" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@id/tv_sku_name"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_safety_margin_l"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.MainTitle.BottomOfCard" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@id/tv_app_name"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Secondary" />
        <com.huawei.appmarket.service.appdetail.view.widget.DetailRelativeLayout
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36.0dip"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@id/download_framelayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="176.0dip"
                android:layout_centerHorizontal="true">
                <LinearLayout
                    android:background="@drawable/corner_button_download_v3"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/component_detail_bottom_button_height_v3">
                    <com.huawei.appmarket.service.skubridge.SkuBridgeDownloadButton
                        android:textSize="16.0dip"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@id/sku_bridge_download_button"
                        android:visibility="visible"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:minHeight="@dimen/component_detail_bottom_button_height_v3"
                        android:text="@string/wisedist_sku_bridge_install_btn"
                        android:singleLine="true"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        wapbutton:downloadFixedWidth="true"
                        wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                        style="@style/sku_bridge_download_button" />
                </LinearLayout>
            </LinearLayout>
        </com.huawei.appmarket.service.appdetail.view.widget.DetailRelativeLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@id/tv_bottom_des"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="@dimen/margin_xl"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
</FrameLayout>