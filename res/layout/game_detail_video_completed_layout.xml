<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/game_detail_video_completed"
    android:background="#4c000000"
    android:visibility="gone"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/game_video_replay"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:contentDescription="@string/component_detail_game_player_replay"
            android:layout_marginStart="8.0dip"
            android:layout_marginEnd="8.0dip">
            <ImageView
                android:id="@id/game_video_replay_image"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_replay" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary_inverse"
                android:gravity="center_horizontal"
                android:id="@id/game_video_replay_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="@string/component_detail_game_player_replay"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/game_video_share"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:contentDescription="@string/component_detail_game_player_share"
            android:layout_marginStart="8.0dip"
            android:layout_marginEnd="8.0dip">
            <ImageView
                android:id="@id/game_video_share_image"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_share_video" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary_inverse"
                android:gravity="center_horizontal"
                android:id="@id/game_video_share_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="@string/component_detail_game_player_share"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>