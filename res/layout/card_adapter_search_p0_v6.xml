<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/list_item_all_selector"
        android:paddingTop="@dimen/appgallery_safety_margin_s"
        android:paddingBottom="@dimen/appgallery_safety_margin_s"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/appinfo_layout"
            android:paddingTop="@dimen/appgallery_card_elements_margin_l"
            android:paddingBottom="@dimen/appgallery_card_elements_margin_l"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@id/appicon"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/titleName"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                android:singleLine="true"
                android:textAlignment="viewStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/appicon"
                app:layout_constraintTop_toBottomOf="@id/appicon"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/memo"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:singleLine="true"
                android:textAlignment="viewStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/titleName"
                app:layout_constraintTop_toBottomOf="@id/titleName"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/adFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="0.0dip"
                app:layout_constraintBottom_toBottomOf="@id/down_info"
                app:layout_constraintStart_toStartOf="@id/titleName"
                app:layout_constraintTop_toTopOf="@id/down_info"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/down_info"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/adFlag"
                app:layout_constraintTop_toBottomOf="@id/memo"
                app:layout_goneMarginStart="0.0dip"
                app:layout_goneMarginTop="@dimen/appgallery_card_elements_margin_xs"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <com.huawei.appgallery.search.api.view.AutoSearchDownloadButton
                android:id="@id/downbtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                android:minHeight="28.0dip"
                app:layout_constraintStart_toStartOf="@id/titleName"
                app:layout_constraintTop_toBottomOf="@id/down_info"
                style="@style/Search.Widget.P0cardV1.DownloadBtn" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>