<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/loading"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
            android:focusable="false"
            android:layout_width="@dimen/videokit_tv_loading_width"
            android:layout_height="@dimen/videokit_tv_loading_width" />
    </LinearLayout>
    <View
        android:id="@id/focus_view"
        android:layout_width="1.0px"
        android:layout_height="1.0px" />
    <RelativeLayout
        android:id="@id/bottom"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:id="@id/online_title_layout"
            android:background="@drawable/tv_play_back_title_gradient"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/videokit_play_back_stroke_height">
            <RelativeLayout
                android:gravity="center_vertical"
                android:focusable="false"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/videokit_ui_48_dp"
                android:layout_marginTop="@dimen/emui_dimens_element_vertical_middle">
                <TextView
                    android:textSize="@dimen/emui_tv_text_size_subtitle1"
                    android:textColor="@color/videokit_detail_time_text"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@id/course_title"
                    android:focusable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:fontFamily="@string/emui_text_font_family_medium"
                    android:layout_marginStart="@dimen/videokit_ui_48_dp"
                    android:layout_marginEnd="@dimen/videokit_tv_title_subtitle_margin"
                    android:layout_toStartOf="@id/course_subtitle" />
                <FrameLayout
                    android:orientation="horizontal"
                    android:id="@id/course_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/videokit_ui_48_dp"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@id/land_control"
            android:background="@drawable/tv_play_back_gradient"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/videokit_play_back_stroke_height"
            android:layout_alignParentBottom="true">
            <RelativeLayout
                android:layout_gravity="bottom"
                android:focusable="false"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/videokit_play_back_land_control_height"
                android:layout_marginBottom="@dimen/videokit_ui_24_dp">
                <ImageView
                    android:id="@id/land_play"
                    android:focusable="true"
                    android:layout_width="@dimen/videokit_ui_24_dp"
                    android:layout_height="@dimen/videokit_ui_24_dp"
                    android:layout_marginBottom="12.0dip"
                    android:src="@drawable/tv_ic_public_play_button"
                    android:layout_above="@id/seek"
                    android:layout_marginStart="@dimen/videokit_ui_48_dp"
                    android:layout_alignParentStart="true" />
                <SeekBar
                    android:id="@id/seek"
                    android:focusable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/videokit_play_back_seek_height"
                    android:max="1000"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/tv_seekbar_track"
                    android:thumb="@null"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/videokit_play_back_seek_margin"
                    android:layout_marginEnd="@dimen/videokit_play_back_seek_margin"
                    style="?android:progressBarStyleHorizontal" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/videokit_play_back_bottom_margin"
                    android:layout_above="@id/seek"
                    android:layout_marginEnd="@dimen/videokit_ui_48_dp"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:textSize="@dimen/emui_text_size_body3"
                        android:textColor="@color/videokit_play_back_duration_text"
                        android:id="@id/position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/emui_text_font_family_regular" />
                    <TextView
                        android:textSize="@dimen/emui_text_size_body3"
                        android:textColor="@color/videokit_play_back_duration_text"
                        android:id="@id/division"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/"
                        android:fontFamily="@string/emui_text_font_family_regular"
                        android:layout_marginStart="@dimen/videokit_play_back_division_margin"
                        android:layout_marginEnd="@dimen/videokit_play_back_division_margin" />
                    <TextView
                        android:textSize="@dimen/emui_text_size_body3"
                        android:textColor="@color/videokit_play_back_duration_text"
                        android:id="@id/duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/emui_text_font_family_regular" />
                </LinearLayout>
            </RelativeLayout>
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>