<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:transitionGroup="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@id/explore_big_image_subhead_layout"
        android:paddingBottom="@dimen/margin_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:minHeight="32.0dip">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="start|bottom|center"
                android:id="@id/hiappbase_subheader_title_left"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/AppGallery.Widget.SubHeader.ListTitle" />
        </LinearLayout>
    </LinearLayout>
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:layout_gravity="center_horizontal"
        android:id="@id/explore_big_image_layout"
        android:paddingTop="@dimen/appgallery_card_elements_margin_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:round_corner="@dimen/appgallery_default_corner_radius_l"
        app:stroke_width="1.0px">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/iv_explore_big_image"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_type="medium"
            app:round_type="all" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption_fixed"
            android:textColor="@color/appgallery_text_color_primary_inverse"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/tv_explore_big_image_tag"
            android:background="@drawable/explore_card_big_image_card_tag_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_safety_margin_l"
            android:minWidth="24.0dip"
            android:minHeight="14.0dip"
            android:maxLines="1"
            android:paddingStart="4.0dip"
            android:paddingEnd="4.0dip"
            android:layout_marginEnd="@dimen/appgallery_safety_margin_l"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.TextAppearance.TextCaption" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/appInfo_container"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/appInfo_icon"
                android:layout_width="52.0dip"
                android:layout_height="52.0dip"
                android:src="@drawable/transparent"
                android:scaleType="fitCenter" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@id/appInfo_name"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:maxWidth="75.0dip"
                android:maxLines="1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.HorizontalCard.Item.Title" />
            <com.huawei.appgallery.pageframe.view.DownloadButtonV2
                android:id="@id/appInfo_dl_btn"
                android:layout_width="54.0dip"
                android:layout_height="28.0dip"
                android:layout_marginTop="8.0dip"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/explore_big_image_bottom_layout"
            android:paddingBottom="@dimen/appgallery_safety_margin_l"
            android:layout_width="fill_parent"
            android:layout_height="128.0dip"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/appgallery_safety_margin_l"
            android:paddingEnd="@dimen/appgallery_safety_margin_l">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <com.huawei.appgallery.explorecard.explorecard.widget.ExploreCardHeadCountDownLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@id/explore_big_image_head_countdown_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="@color/appgallery_text_color_primary_inverse"
                    android:ellipsize="end"
                    android:id="@id/explore_big_image_title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:textAlignment="viewStart" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body3_fixed"
                    android:textColor="@color/appgallery_text_color_secondary_inverse"
                    android:ellipsize="end"
                    android:id="@id/explore_big_image_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textAlignment="viewStart" />
            </LinearLayout>
        </RelativeLayout>
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
</LinearLayout>