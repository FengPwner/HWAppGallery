<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout
        android:id="@id/fa_form_host_view_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        app:shadowColor="#ff333333"
        app:shadowCornerRadius="16.0dip"
        app:shadowLimit="@dimen/appgallery_shadow_layout_default_limit_width">
        <com.huawei.appgallery.detail.detailcard.card.fadetailcard.view.FaInterceptTouchCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription=""
            android:importantForAccessibility="no"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="16.0dip"
            app:hwAdvancedCardViewClickAnimationEnable="false">
            <com.huawei.appgallery.detail.detailcard.card.fadetailcard.view.FaTouchCardView
                android:layout_gravity="center"
                android:id="@id/fa_form_contentview"
                android:background="@drawable/aguikit_card_panel_bg"
                android:focusableInTouchMode="true"
                android:visibility="visible"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:importantForAccessibility="yes">
                <RelativeLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/fa_form_defaultview"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <ImageView
                        android:gravity="center"
                        android:id="@id/fa_form_defaultimage"
                        android:layout_width="72.0dip"
                        android:layout_height="72.0dip"
                        android:src="@drawable/ic_fa_default"
                        android:layout_centerInParent="true" />
                </RelativeLayout>
            </com.huawei.appgallery.detail.detailcard.card.fadetailcard.view.FaTouchCardView>
        </com.huawei.appgallery.detail.detailcard.card.fadetailcard.view.FaInterceptTouchCardView>
    </com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout>
</RelativeLayout>