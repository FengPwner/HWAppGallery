<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/no_network_layout"
        android:tag="css/.body"
        android:background="@color/appgallery_color_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@id/setting_content">
            <RelativeLayout
                android:id="@id/no_wifi_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@id/no_wifi"
                    android:tag="css/.widget"
                    android:background="@drawable/ic_no_wifi_disable"
                    android:layout_centerHorizontal="true"
                    style="@style/AppGallery.ImageSize.NoData" />
                <TextView
                    android:gravity="center_horizontal"
                    android:id="@id/title"
                    android:tag="css/.subtitle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_m"
                    android:layout_below="@id/no_wifi"
                    android:layout_marginStart="@dimen/appgallery_max_padding_start"
                    android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                    style="@style/AppGallery.TextAppearance.NoData" />
            </RelativeLayout>
        </RelativeLayout>
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/setting_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:hwColumnType="button_type">
            <com.huawei.appmarket.framework.widget.RenderButton
                android:gravity="center"
                android:id="@id/setting"
                android:tag="css/.title"
                android:layout_width="0.0dip"
                android:text="@string/setting_network_prompt_title"
                android:layout_weight="1.0"
                app:hwAutoSizeMinTextSize="9.0sp"
                app:hwAutoSizeStepGranularity="1.0sp"
                style="@style/AppGallery.Widget.Button.BottomButton" />
            <com.huawei.appmarket.framework.widget.RenderButton
                android:gravity="center"
                android:id="@id/go_to_net_diagnose"
                android:tag="css/.title"
                android:layout_width="0.0dip"
                android:text="@string/netdiagnose_button_text"
                android:layout_weight="1.0"
                android:layout_marginStart="16.0dip"
                app:hwAutoSizeMinTextSize="9.0sp"
                app:hwAutoSizeStepGranularity="1.0sp"
                style="@style/AppGallery.Widget.Button.BottomButton" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
    </RelativeLayout>
</LinearLayout>