<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/faq_sdk_white_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.phoneservice.faq.widget.FaqSdkSearchInput
        android:id="@id/faq_sdk_searchinput"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:gravity="center"
        android:id="@id/faq_sdk_category_menu"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="2.0"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwColumnType="button_type">
        <Button
            android:id="@id/faq_sdk_category_feedback"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/faq_sdk_ui_16_dip"
            android:layout_marginBottom="@dimen/faq_sdk_ui_24_dip"
            android:layout_weight="1.0"
            style="@style/Widget.Emui.HwButton" />
        <View
            android:id="@id/faq_sdk_category_gap"
            android:visibility="gone"
            android:layout_width="@dimen/faq_sdk_ui_12_dip"
            android:layout_height="0.0dip" />
        <Button
            android:id="@id/faq_sdk_category_online"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/faq_sdk_ui_16_dip"
            android:layout_marginBottom="@dimen/faq_sdk_ui_24_dip"
            android:text="@string/faq_sdk_menu_online_service"
            android:layout_weight="1.0"
            style="@style/Widget.Emui.HwButton.Emphasize" />
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
    <com.huawei.phoneservice.faq.widget.FaqBaseScrollView
        android:id="@id/faq_sdk_category_scroll_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/faq_sdk_category_menu"
        android:layout_below="@id/faq_sdk_searchinput">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/faq_content_ll"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@id/faq_type_ll"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/emui_dimens_max_start"
                    android:layout_marginEnd="@dimen/emui_dimens_max_end">
                    <ImageView
                        android:gravity="bottom"
                        android:layout_width="@dimen/faq_sdk_ui_16_dip"
                        android:layout_height="@dimen/faq_sdk_ui_16_dip"
                        android:layout_marginBottom="8.0dip"
                        android:src="@drawable/faq_sdk_icon_type_q" />
                    <TextView
                        android:textSize="@dimen/emui_text_size_body2"
                        android:textColor="@color/emui_color_secondary"
                        android:gravity="bottom"
                        android:id="@id/faq_type_tv"
                        android:paddingBottom="8.0dip"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:minHeight="48.0dip"
                        android:text="@string/faq_sdk_problem_type"
                        android:layout_weight="1.0"
                        android:fontFamily="@string/emui_text_font_family_medium"
                        android:layout_marginStart="@dimen/faq_sdk_ui_8_dip"
                        android:layout_marginEnd="@dimen/faq_sdk_ui_16_dip" />
                    <LinearLayout
                        android:gravity="bottom"
                        android:id="@id/faq_sdk_category_more_host"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <Button
                            android:textSize="@dimen/emui_text_size_body2"
                            android:textColor="@color/emui_color_secondary"
                            android:gravity="end|bottom|center"
                            android:id="@id/faq_sdk_category_more"
                            android:background="@null"
                            android:paddingBottom="8.0dip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/faq_sdk_0dp"
                            android:minHeight="48.0dip"
                            android:text="@string/faq_sdk_more"
                            android:paddingEnd="4.0dip" />
                        <ImageView
                            android:id="@id/hot_img"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5.0dip"
                            android:src="@drawable/faq_sdk_arrow_right" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@id/faq_other_ll"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/emui_dimens_max_start"
                    android:layout_marginStart="@dimen/emui_dimens_max_start">
                    <ImageView
                        android:gravity="bottom"
                        android:layout_width="@dimen/faq_sdk_ui_16_dip"
                        android:layout_height="@dimen/faq_sdk_ui_16_dip"
                        android:layout_marginBottom="8.0dip"
                        android:src="@drawable/faq_sdk_icon_type_q" />
                    <TextView
                        android:textSize="@dimen/emui_text_size_body2"
                        android:textColor="@color/emui_color_secondary"
                        android:gravity="bottom"
                        android:id="@id/faq_other_tv"
                        android:paddingBottom="8.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48.0dip"
                        android:text="@string/faq_sdk_problem_other"
                        android:fontFamily="@string/emui_text_font_family_medium"
                        android:paddingStart="@dimen/faq_sdk_ui_8_dip" />
                </LinearLayout>
                <View
                    android:id="@id/split_line"
                    android:background="@drawable/faq_sdk_list_divider_color_drawable"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/faq_sdk_line_height"
                    android:layout_marginStart="@dimen/faq_sdk_list_item_padding_start"
                    android:layout_marginEnd="@dimen/faq_sdk_list_item_padding_start" />
            </LinearLayout>
            <com.huawei.phoneservice.faq.widget.FaqListGridView
                android:id="@id/list_type"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/faq_sdk_ui_8_dip"
                android:listSelector="@android:color/transparent"
                android:divider="@null"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end"
                app:faqsdkhideBottomDivider="false"
                app:faqsdkmaxNumColumns="6"
                app:faqsdkpaddingClipDivider="false" />
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@id/faq_hot_ll"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/emui_dimens_element_vertical_middle"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_start">
                <ImageView
                    android:gravity="bottom"
                    android:layout_width="@dimen/faq_sdk_ui_16_dip"
                    android:layout_height="@dimen/faq_sdk_ui_16_dip"
                    android:layout_marginBottom="8.0dip"
                    android:src="@drawable/faq_sdk_icon_hot_q" />
                <TextView
                    android:textSize="@dimen/emui_text_size_body2"
                    android:textColor="@color/emui_color_secondary"
                    android:gravity="bottom"
                    android:paddingBottom="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48.0dip"
                    android:text="@string/faq_sdk_hot_issues"
                    android:fontFamily="@string/emui_text_font_family_medium"
                    android:paddingStart="@dimen/faq_sdk_ui_8_dip" />
            </LinearLayout>
            <com.huawei.phoneservice.faq.widget.FaqInScrollListView
                android:id="@id/hot_list"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0.0dip"
                android:overScrollMode="never" />
            <com.huawei.phoneservice.faq.widget.FaqInScrollListView
                android:id="@id/other_list"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0.0dip" />
        </LinearLayout>
    </com.huawei.phoneservice.faq.widget.FaqBaseScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/faq_sdk_mask"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/faq_sdk_searchinput" />
    <View
        android:id="@id/view_floating_layer"
        android:background="@color/faq_sdk_mask"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/faq_sdk_searchinput" />
    <com.huawei.phoneservice.faq.widget.FaqNoticeView
        android:id="@id/faq_error_noticeView"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:faqsdkNoticeViewType="faqsdkprogress"
        app:faqsdknoticeAutoFitCenterYInLandScape="true"
        app:faqsdknoticeLoadingText="@string/faq_sdk_common_loading" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/faq_sdk_noKnowledge_ll"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:layout_width="@dimen/faq_sdk_loading_empty_icon_size"
            android:layout_height="@dimen/faq_sdk_loading_empty_icon_size"
            android:layout_marginBottom="@dimen/faq_sdk_ui_2_dip"
            android:src="@drawable/faq_sdk_ic_no_search_result" />
        <TextView
            android:textSize="@dimen/faq_sdk_notice_view_text_size"
            android:textColor="@color/faq_sdk_notice_view_default_text_color"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/faq_sdk_service_help_prepare"
            android:paddingStart="@dimen/faq_sdk_0dp"
            android:paddingEnd="@dimen/faq_sdk_0dp" />
    </LinearLayout>
</RelativeLayout>