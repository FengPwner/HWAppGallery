<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <com.huawei.uikit.hwrecyclerview.widget.HwRecyclerView
            android:id="@id/app_list_rv"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </FrameLayout>
    <com.huawei.uikit.phone.hwcheckbox.widget.HwCheckBox
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_text_color_primary"
        android:orientation="vertical"
        android:id="@id/not_remind_checkbox"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/size_48dp"
        android:text="@string/downloading_exit_select_new"
        android:textAlignment="viewStart"
        style="@style/Widget.Emui.HwCheckBox.Normal" />
</LinearLayout>