                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/ll_queue_test_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_lineup_complete" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_text_color_secondary_inverse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_game_network_test"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginStart="6.0dip" />
                </LinearLayout>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@id/line_queue_test_speed"
                    android:background="@color/appgallery_text_color_secondary_inverse"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/divider_horizontal_height_emui"
                    android:layout_weight="1.0"
                    android:layout_marginStart="6.0dip" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_lineup_complete"
                        android:layout_marginStart="6.0dip" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_text_color_secondary_inverse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_game_line_up"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginStart="6.0dip" />
                </LinearLayout>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@color/appgallery_text_color_secondary_inverse"
                    android:layout_width="0.0dip"
                    android:layout_height="@dimen/divider_horizontal_height_emui"
                    android:layout_weight="1.0"
                    android:layout_marginStart="6.0dip" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_lineup_wait"
                        android:layout_marginStart="6.0dip" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_text_color_secondary_inverse"
                        android:gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_game_load"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginStart="6.0dip" />
                </LinearLayout>
