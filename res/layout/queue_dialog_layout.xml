                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="@color/appgallery_text_color_secondary_inverse"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/network_disable_id"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_game_tested_failed"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body1"
                        android:textColor="@color/appgallery_text_color_primary_inverse"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/network_type_id"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/appgallery_text_font_family_medium" />
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24.0dip">
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_subtitle1"
                            android:textColor="@color/appgallery_text_color_primary_inverse"
                            android:layout_gravity="center_horizontal"
                            android:id="@id/test_speed_text_id"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@string/appgallery_text_font_family_medium" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body3"
                            android:textColor="@color/appgallery_text_color_secondary_inverse"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.0dip"
                            android:text="@string/cloud_game_network_speed"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                    </LinearLayout>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@color/appgallery_text_color_secondary_inverse"
                        android:layout_width="2.0px"
                        android:layout_height="24.0dip"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip" />
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_subtitle1"
                            android:textColor="@color/appgallery_text_color_primary_inverse"
                            android:layout_gravity="center_horizontal"
                            android:id="@id/time_delay_text_id"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@string/appgallery_text_font_family_medium" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body3"
                            android:textColor="@color/appgallery_text_color_secondary_inverse"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.0dip"
                            android:text="@string/cloud_game_delay_time"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24.0dip"
                    android:weightSum="1.0">
                    <Button
                        android:textColor="@color/appgallery_text_color_primary_inverse"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/cancel_test_speed"
                        android:background="@drawable/hwbutton_default_small_emui_dark"
                        android:layout_width="0.0dip"
                        android:layout_height="28.0dip"
                        android:text="@string/exit_cancel"
                        android:singleLine="true"
                        android:layout_weight="0.6"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        app:autoSizeMaxTextSize="@dimen/appgallery_text_size_body2"
                        app:autoSizeMinTextSize="@dimen/emui_master_caption_1"
                        app:autoSizeStepGranularity="@dimen/res_textsize_1sp"
                        app:autoSizeTextType="uniform" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/queue_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
