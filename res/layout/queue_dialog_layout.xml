                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@id/game_loading_layout_content"
                android:tag="css/.body"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
                        android:layout_gravity="center_horizontal"
                        android:id="@id/loadingBar"
                        android:layout_width="@dimen/loading_large"
                        android:layout_height="@dimen/loading_large"
                        style="@style/Widget.Emui.HwProgressBar.Large" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>