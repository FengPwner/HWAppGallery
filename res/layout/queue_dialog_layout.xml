                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@id/queue_layout_content"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.appgallery.cloudgame.gamedist.view.QueueCircle
                        android:layout_gravity="center"
                        android:id="@id/queueCircle"
                        android:layout_width="162.0dip"
                        android:layout_height="162.0dip"
                        android:layout_marginTop="@dimen/banner_commodity_margin_12"
                        app:hwAutoSizeMinTextSize="1.0dip"
                        app:hwAutoSizeStepGranularity="1.0dip" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body1"
                        android:textColor="@color/appgallery_text_color_primary_inverse"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/cloud_game_name_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:fontFamily="@string/appgallery_text_font_family_medium" />
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip">
                        <Button
                            android:textColor="@color/appgallery_text_color_primary_inverse"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:id="@id/cancel_queue"
                            android:background="@drawable/hwbutton_default_small_emui_dark"
                            android:layout_width="0.0dip"
                            android:layout_height="28.0dip"
                            android:text="@string/cloud_game_cancel_queue"
                            android:singleLine="true"
                            android:layout_weight="1.0"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            app:autoSizeMaxTextSize="@dimen/appgallery_text_size_body2"
                            app:autoSizeMinTextSize="@dimen/emui_master_caption_1"
                            app:autoSizeStepGranularity="@dimen/res_textsize_1sp"
                            app:autoSizeTextType="uniform" />
