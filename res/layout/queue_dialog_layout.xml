                            android:layout_width="0.0dip"
                            android:layout_height="28.0dip"
                            android:text="@string/cloud_game_small_window_queue"
                            android:singleLine="true"
                            android:layout_weight="1.0"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
                            app:autoSizeMaxTextSize="@dimen/appgallery_text_size_body2"
                            app:autoSizeMinTextSize="@dimen/emui_master_caption_1"
