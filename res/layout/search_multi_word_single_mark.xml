<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/single_mark_view_container"
    android:clickable="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@id/mark_margin_view"
        android:layout_width="@dimen/hot_world_mark_space"
        android:layout_height="@dimen/hot_world_mark_space" />
    <ImageView
        android:id="@id/mark_view"
        android:layout_width="@dimen/hot_world_mark_size"
        android:layout_height="@dimen/hot_world_mark_size" />
</LinearLayout>