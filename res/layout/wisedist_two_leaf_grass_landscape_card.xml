<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/root_view"
        android:paddingTop="@dimen/appgallery_card_elements_margin_m"
        android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/appgallery_card_elements_margin_l"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <include
            android:id="@id/imageView1"
            layout="@layout/wisedist_two_leaf_grass_landscape_single_item_card" />
        <Space
            android:layout_width="@dimen/appgallery_card_elements_margin_xl"
            android:layout_height="fill_parent"
            android:importantForAccessibility="no" />
        <include
            android:id="@id/imageView2"
            layout="@layout/wisedist_two_leaf_grass_landscape_single_item_card" />
    </LinearLayout>
    <include
        android:visibility="gone"
        android:importantForAccessibility="no"
        layout="@layout/wisedist_interac_container" />
</LinearLayout>