<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:background="@color/emui_color_gray_1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:id="@id/hiappbase_arrow_layout"
        android:background="@drawable/bm_selector_actionbar_ic_bg"
        android:layout_width="48.0dip"
        android:layout_height="48.0dip"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="4.0dip">
        <ImageView
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/bm_ic_actionbar_ic" />
    </LinearLayout>
    <TextView
        android:textSize="@dimen/emui_master_title_1"
        android:textColor="@color/emui_color_gray_10"
        android:ellipsize="end"
        android:gravity="start|center"
        android:id="@id/title_text"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:singleLine="true"
        android:layout_weight="1.0"
        android:layout_marginStart="@dimen/margin_s" />
</LinearLayout>