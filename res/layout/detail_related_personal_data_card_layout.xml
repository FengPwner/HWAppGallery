<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/linear_personal_data"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/AppGallery.Widget.SubHeader.ViewGroup">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/txt_related_personal_data_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/AppGallery.Widget.SubHeader.Title" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/txt_related_personal_data_subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            style="@style/detail_card_item_data_subTitle" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/recycler_related_personal_data_items"
        android:background="@drawable/aguikit_card_panel_bg"
        android:padding="24.0dip"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:numColumns="2"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
</LinearLayout>