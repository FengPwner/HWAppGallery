<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/comment_ref_top_rlayout"
    android:background="@drawable/forum_comment_reference_layout_selector"
    android:paddingTop="@dimen/padding_m"
    android:paddingBottom="@dimen/margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/margin_m"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/sub_ref_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="start|center"
            android:id="@id/sub_ref_icon"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:src="@drawable/forum_message_default_user_icon"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_m"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_alignParentStart="true" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/emui_color_gray_10"
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/sub_ref_title"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:maxLines="1" />
    </LinearLayout>
    <TextView
        android:textSize="@dimen/emui_master_body_2"
        android:textColor="@color/emui_color_gray_10"
        android:ellipsize="end"
        android:id="@id/sub_ref_content"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:maxLines="2"
        android:layout_below="@id/sub_ref_head"
        android:fontFamily="Regular"
        android:textAlignment="viewStart"
        android:paddingStart="@dimen/margin_m" />
</RelativeLayout>