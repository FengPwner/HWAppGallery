<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/setting_card_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    style="@style/AppGallery.Widget.List.TwoTextLines"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center"
                android:id="@id/setItemTitle"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <ImageView
                android:layout_gravity="end|center"
                android:id="@id/arrowlayout"
                android:layout_marginStart="@dimen/emui_dimens_element_horizontal_large"
                style="@style/AppGallery.Widget.List.RightArrow" />
        </LinearLayout>
        <TextView
            android:gravity="start|center"
            android:id="@id/setItemContent"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
</RelativeLayout>