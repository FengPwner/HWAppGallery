<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/selectableApp_rootView"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@id/selectableApp_icon_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start|bottom|center"
            android:id="@id/selectableApp_iconIV"
            android:layout_width="@dimen/round_icon_width"
            android:layout_height="@dimen/round_icon_width" />
        <com.huawei.uikit.phone.hwcheckbox.widget.HwCheckBox
            android:layout_gravity="end|center|top"
            android:id="@id/selectableApp_selectedCB"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            style="@style/Emui.CheckBox.IconSelect" />
    </FrameLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_body3"
        android:textColor="@color/appgallery_text_color_primary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@id/selectableApp_titleTV"
        android:layout_width="56.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:baselineAligned="false"
        android:text="HiApp"
        android:maxLines="2"
        android:singleLine="false"
        android:fontFamily="@string/appgallery_text_font_family_medium" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/selectableApp_FreeIndicatorView_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@id/adText"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            style="@style/AdTextViewBlackStyle" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@id/selectableApp_FreeIndicatorView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/oobe_free"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
    </LinearLayout>
</LinearLayout>