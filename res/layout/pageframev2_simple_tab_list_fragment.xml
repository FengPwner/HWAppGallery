<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@id/pageframev2_title_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.huawei.appgallery.foundation.ui.framework.fragment.widget.SwitchTabListView
            android:id="@id/applistview"
            android:tag="css/.body"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:drawSelectorOnTop="true"
            android:divider="@null"
            android:dividerHeight="0.0dip" />
        <ViewStub
            android:id="@id/nodata_viewstub"
            android:layout="@layout/hiappbase_nodata_warn_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <FrameLayout
            android:id="@id/pageframev2_loading_layout_id"
            android:background="@color/backgound_fcfcfc"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </FrameLayout>
</LinearLayout>