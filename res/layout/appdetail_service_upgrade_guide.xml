<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_l"
    android:paddingEnd="@dimen/padding_l"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/empty_in_maintenance"
        android:tag="css/.widget"
        android:background="@drawable/ic_empty_in_maintenance"
        android:layout_width="@dimen/component_detail_head_image_layout_height"
        android:layout_height="@dimen/component_detail_head_image_layout_height"
        android:layout_marginTop="@dimen/ui_8_dp"
        android:layout_marginBottom="@dimen/ui_8_dp"
        android:scaleType="center"
        app:layout_constraintBottom_toTopOf="@id/text_service_upgrade_guide_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@id/text_service_upgrade_guide_description"
        android:tag="css/.subtitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/service_upgrade_guide_description"
        app:layout_constraintBottom_toTopOf="@id/go_developer_help_center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/empty_in_maintenance"
        style="@style/AppGallery.TextAppearance.NoData" />
    <TextView
        android:textSize="@dimen/appgallery_text_size_body3"
        android:textColor="@color/hwbutton_selector_text_normal_emui"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@id/go_developer_help_center"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/developer_help_center_url"
        android:singleLine="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        app:layout_constraintBottom_toTopOf="@id/go_search_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_service_upgrade_guide_description" />
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/go_search_btn"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/detail_ageadapter_head_ag_margin_bottom"
        android:layout_marginBottom="@dimen/ui_24_dp"
        android:text="@string/go_search"
        app:hwAutoSizeMinTextSize="9.0sp"
        app:hwAutoSizeStepGranularity="1.0sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="@dimen/search_ui_40_dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/go_developer_help_center"
        app:layout_constraintWidth_max="@dimen/detail_card_ui_448_dp"
        app:layout_constraintWidth_min="0.0dip"
        style="@style/AppGallery.Widget.Button.BottomButton" />
</androidx.constraintlayout.widget.ConstraintLayout>