<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="@dimen/appcomment_empty_comment_card_padding"
    android:paddingBottom="@dimen/appcomment_empty_comment_card_padding"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@id/appcomment_no_data_icon"
        android:tag="css/.widget"
        android:focusable="false"
        android:src="@drawable/appcomment_empty_comment"
        style="@style/AppGallery.ImageSize.NoData" />
    <TextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@id/appcomment_no_data_text"
        android:tag="css/.title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:text="@string/appcomment_comment_empty"
        android:layout_marginStart="@dimen/margin_xl"
        android:layout_marginEnd="@dimen/margin_xl"
        style="@style/AppGallery.TextAppearance.NoData" />
</LinearLayout>