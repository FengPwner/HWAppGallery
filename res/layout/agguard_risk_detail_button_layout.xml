<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:tag="layout/agguard_risk_detail_button_layout_0"
    android:paddingTop="@dimen/appgallery_card_elements_margin_xl"
    android:paddingBottom="@dimen/appgallery_card_elements_margin_xl"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/agguard_ageadapter_button_layout_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@id/agguard_risk_detail_btn_layout"
        android:tag="binding_1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:orientation="horizontal"
            android:tag="binding_2"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:hwColumnType="button_type">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="@dimen/appgallery_text_size_button1"
                android:layout_gravity="center_vertical"
                android:id="@id/agguard_risk_detail_btn_security_control"
                android:tag="binding_3"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                app:hwAutoSizeMinTextSize="7.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                style="@style/Widget.Emui.HwButton" />
            <View
                android:layout_width="12.0dip"
                android:layout_height="0.0dip" />
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="@dimen/appgallery_text_size_button1"
                android:gravity="center"
                android:id="@id/agguard_risk_detail_btn_uninstall"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/agguard_uninstall_btn"
                android:layout_weight="1.0"
                app:hwAutoSizeMinTextSize="7.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                style="@style/Widget.Emui.HwButton" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:hwColumnType="button_type">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="@dimen/appgallery_text_size_button1"
                android:layout_gravity="center_horizontal"
                android:id="@id/agguard_risk_detail_single_btn_uninstall"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/agguard_uninstall_btn"
                app:hwAutoSizeMinTextSize="7.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                style="@style/Widget.Emui.HwButton" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@id/agguard_risk_detail_btn_uninstalling_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:hwColumnType="button_type">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:enabled="false"
                android:textSize="@dimen/appgallery_text_size_button1"
                android:id="@id/agguard_risk_detail_btn_uninstalling"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/appinstall_uninstall_app_uninstalling"
                app:hwAutoSizeMinTextSize="7.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                style="@style/Widget.Emui.HwButton" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:tag="binding_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:hwColumnType="button_type">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="@dimen/appgallery_text_size_button1"
                android:id="@id/agguard_risk_detail_btn_uninstall_finish"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/agguard_done"
                app:hwAutoSizeMinTextSize="7.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                style="@style/Widget.Emui.HwButton" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
    </RelativeLayout>
</RelativeLayout>