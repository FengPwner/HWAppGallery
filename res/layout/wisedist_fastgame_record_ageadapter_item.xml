<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/wisedist_horizontal_dl_item_width"
        android:layout_height="@dimen/wisedist_horizontal_dl_item_width"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:corner_type="appicon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_type="all" />
    <ViewStub
        android:id="@id/fastappicon"
        android:layout="@layout/wisedist_fastappicon_layout"
        android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
        android:layout_height="@dimen/hiappbase_card_fasticon_size_large"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/appicon"
        app:layout_constraintEnd_toEndOf="@id/appicon" />
    <TextView
        android:textSize="11.0sp"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@id/itemTitle"
        android:tag="css/.title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="agadgdgdagsdhgsdfgs"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/margin_l"
        app:layout_constraintBottom_toBottomOf="@id/appicon"
        app:layout_constraintStart_toEndOf="@id/appicon"
        app:layout_constraintTop_toTopOf="@id/appicon"
        style="@style/AppGallery.TextAppearance.HorizontalCard.Item.Title" />
</androidx.constraintlayout.widget.ConstraintLayout>