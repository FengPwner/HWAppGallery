<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/detail_desc_layout_linearlayout"
    android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="start|center"
        android:id="@id/detail_watch_label_linearlayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_xl">
        <ImageView
            android:id="@id/watch_image"
            android:tag="css/.widget"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/aguikit_ic_public_watch"
            android:layout_marginEnd="@dimen/margin_s" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/watch_label"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/component_detail_watch"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center"
        android:id="@id/detail_vr_label_linearlayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/vr_image"
            android:tag="css/.widget"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/aguikit_ic_public_vr"
            android:layout_marginEnd="@dimen/margin_s" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/vr_label"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_vr_glass"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
    </LinearLayout>
</LinearLayout>