<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <RelativeLayout
        android:id="@id/content_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:id="@id/top_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xl"
            android:layout_marginBottom="@dimen/emui_dimens_element_vertical_middle"
            android:text="@string/contentrestrict_restrict_intro"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
        <TextView
            android:id="@id/top_des"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xl"
            android:text="@string/contentrestrict_restrict_des"
            android:layout_below="@id/top_title"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
        <ScrollView
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@id/botton_btn_layout"
            android:layout_below="@id/top_des">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/grade_root_layout"
                android:background="@drawable/aguikit_card_panel_bg"
                android:paddingTop="@dimen/appgallery_card_elements_margin_s"
                android:paddingBottom="@dimen/appgallery_card_elements_margin_s"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
        </ScrollView>
        <RelativeLayout
            android:id="@id/botton_btn_layout"
            android:background="@color/appgallery_color_sub_background"
            android:paddingTop="@dimen/appgallery_default_padding_bottom_fixed"
            android:paddingBottom="@dimen/appgallery_default_padding_bottom_fixed"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.huawei.appgallery.foundation.ui.framework.widget.BottomButton
                android:id="@id/bottom_btn"
                android:text="@string/exit_confirm"
                android:layout_centerInParent="true"
                app:hwAutoSizeMinTextSize="9.0sp"
                app:hwAutoSizeStepGranularity="1.0sp"
                style="@style/AppGallery.Widget.Button.BottomButton" />
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>