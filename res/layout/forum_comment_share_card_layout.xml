<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@id/share_fragment_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/share_card_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="368.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/user_info_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:paddingStart="24.0dip"
            android:paddingEnd="24.0dip">
            <com.huawei.appgallery.forum.cards.widget.UserHeadImageView
                android:id="@id/forum_reply_user_icon"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:contentDescription="@string/hiappbase_user_avatar" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8.0dip">
                <com.huawei.appgallery.forum.cards.widget.ShareUserInfoTextView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/post_user_info_view"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_color_secondary"
                        android:id="@id/app_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:textAlignment="viewStart" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:id="@id/user_post_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="16.0dip" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/post_content_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip" />
        <ImageView
            android:id="@id/forum_reply_comment_img"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.0dip"
            android:layout_marginStart="24.0dip"
            android:layout_marginEnd="24.0dip" />
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:background="@color/community_share_fragment_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.0dip"
            android:paddingStart="24.0dip"
            android:paddingEnd="24.0dip"
            app:clip_background="true"
            app:round_corner="@dimen/appgallery_default_corner_radius_m"
            app:stroke_width="0.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/forum_post_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.appgallery.forum.cards.widget.PostTitleTextView
                    android:textSize="10.0sp"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:id="@id/forum_reply_post_title"
                    android:paddingTop="12.0dip"
                    android:paddingBottom="12.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:textAlignment="viewStart"
                    android:paddingStart="16.0dip"
                    android:paddingEnd="16.0dip" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@color/appgallery_color_secondary"
                    android:ellipsize="end"
                    android:id="@id/forum_reply_post_text"
                    android:paddingBottom="12.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textAlignment="viewStart"
                    android:paddingStart="16.0dip"
                    android:paddingEnd="16.0dip" />
            </LinearLayout>
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    </LinearLayout>
</LinearLayout>