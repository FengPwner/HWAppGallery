<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/title"
        layout="@layout/agguard_common_title_layout" />
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/agguard_app_scan_layout"
                android:background="@drawable/aguikit_card_panel_bg"
                android:paddingTop="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.Widget.List.TwoTextLines">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/item_layout"
                    android:paddingTop="@dimen/appgallery_card_elements_margin_xl"
                    android:paddingBottom="@dimen/appgallery_card_elements_margin_xl"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/setTextContainer"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:gravity="start|center"
                            android:id="@id/setItemTitle"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/agguard_start_scanning_title"
                            android:layout_weight="1.0"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <com.huawei.uikit.hwswitch.widget.HwSwitch
                            android:id="@id/switchBtn"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16.0dip"
                            style="@style/Widget.Emui.HwSwitch" />
                    </LinearLayout>
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:gravity="start|center"
                        android:id="@id/setItemContent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        android:text="@string/agguard_start_scanning_show"
                        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                </LinearLayout>
                <View
                    android:id="@id/item_divider_line"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_below="@id/item_layout"
                    style="@style/AppGallery.Widget.Divider" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/agguard_enhance_risk_app_detect_layout"
                    android:paddingTop="@dimen/appgallery_card_elements_margin_xl"
                    android:paddingBottom="@dimen/appgallery_card_elements_margin_xl"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/agguard_risk_app_detect_textContainer"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:gravity="start|center"
                            android:id="@id/agguard_risk_app_detect_itemTitle"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/agguard_enhance_risk_app_detect_item_title"
                            android:layout_weight="1.0"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <com.huawei.uikit.hwswitch.widget.HwSwitch
                            android:id="@id/agguard_risk_app_detect_switchBtn"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16.0dip"
                            style="@style/Widget.Emui.HwSwitch" />
                    </LinearLayout>
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:gravity="start|center"
                        android:id="@id/agguard_risk_app_detect_itemContent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        android:text="@string/agguard_enhance_risk_app_detect_item_content"
                        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/agguard_pure_enhanced_mode_layout"
                android:background="@drawable/aguikit_card_panel_bg"
                android:paddingTop="@dimen/agguard_ageadapter_card_padding_size"
                android:paddingBottom="@dimen/agguard_ageadapter_card_padding_size"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
                android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.Widget.List.TwoTextLines">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/agguard_pure_enhanced_mode_setTextContainer"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:gravity="start|center"
                        android:id="@id/agguard_pure_enhanced_mode_title"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/agguard_pure_enhanced_mode_item_title"
                        android:layout_weight="1.0"
                        style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                    <com.huawei.uikit.hwswitch.widget.HwSwitch
                        android:id="@id/agguard_pure_enhanced_mode_switchBtn"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16.0dip"
                        style="@style/Widget.Emui.HwSwitch" />
                </LinearLayout>
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:gravity="start|center"
                    android:id="@id/agguard_pure_enhanced_mode_content"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                    android:text="@string/agguard_pure_enhanced_mode_item_content"
                    style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/appgallery_text_color_link"
                    android:gravity="center_vertical"
                    android:id="@id/agguard_pure_enhanced_mode_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_paragraph_margin_s"
                    android:text="@string/agguard_know_more"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </LinearLayout>
            <View
                android:layout_width="fill_parent"
                android:layout_height="@dimen/appgallery_card_elements_margin_l" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>