<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/receive_prize_info_layout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:paddingTop="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/mine_telephone_layout"
            android:background="@drawable/aguikit_round_rectangle_card_item_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_default_corner_radius_m"
            android:paddingEnd="@dimen/appgallery_default_corner_radius_m"
            style="@style/AppGallery.Widget.List.SingleTextLine">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_info_telephone"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/phone_num"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/nick_name_unsetting"
                    android:singleLine="true"
                    android:layout_weight="1.0"
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                <ImageView
                    android:layout_gravity="end|center"
                    android:id="@id/right_arrow"
                    android:layout_marginStart="@dimen/margin_l"
                    style="@style/AppGallery.Widget.List.RightArrow" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@id/divide_line"
            android:layout_width="fill_parent"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            style="@style/AppGallery.Widget.Divider" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/mine_address_layout"
            android:background="@drawable/aguikit_round_rectangle_card_item_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_default_corner_radius_m"
            android:paddingEnd="@dimen/appgallery_default_corner_radius_m"
            style="@style/AppGallery.Widget.List.SingleTextLine">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_receive_addr"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                <TextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/address"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/nick_name_unsetting"
                    android:singleLine="true"
                    android:layout_weight="1.0"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                <ImageView
                    android:layout_gravity="end|center"
                    android:layout_marginStart="@dimen/margin_l"
                    style="@style/AppGallery.Widget.List.RightArrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.BottomButton
        android:id="@id/clear_button"
        android:layout_marginTop="@dimen/appgallery_default_padding_bottom_fixed"
        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
        android:text="@string/settings_clear_receive_prize"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwAutoSizeMinTextSize="9.0sp"
        app:hwAutoSizeStepGranularity="1.0sp"
        style="@style/AppGallery.Widget.Button.BottomButton" />
</RelativeLayout>