<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/detail_head_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/appdetail_head_view_app_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/appdetail_head_view_app_icon" />
    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/detail_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appdetail_head_view_app_icon">
        <TextView
            android:textSize="26.0sp"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/detail_head_app_name_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textDirection="locale"
            android:textAlignment="viewStart" />
    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
    <TextView
        android:textSize="@dimen/res_textsize_16sp"
        android:textColor="@color/appgallery_text_color_secondary"
        android:id="@id/detail_head_install_times_and_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        android:text="TextView"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_app_name" />
    <TextView
        android:textSize="@dimen/res_textsize_16sp"
        android:textColor="@color/appgallery_text_color_secondary"
        android:ellipsize="end"
        android:id="@id/developer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        android:text="TextView"
        android:maxLines="2"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:textDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_head_install_times_and_score" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/developer">
        <TextView
            android:textSize="@dimen/res_textsize_16sp"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:id="@id/text_versionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:maxLines="2"
            android:textDirection="locale" />
        <TextView
            android:textSize="@dimen/res_textsize_16sp"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:id="@id/other_appinfos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:text="TextView"
            android:textDirection="locale" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>