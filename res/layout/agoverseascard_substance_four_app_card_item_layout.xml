<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="@dimen/agoverseas_substance_four_app_card_item_width"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:corner_type="appicon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_type="all" />
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/itemtitle"
        android:layout_width="@dimen/agoverseas_substance_four_app_card_item_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:singleLine="true"
        android:importantForAccessibility="no"
        android:textAlignment="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appicon"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Primary.Regular" />
    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
        android:id="@id/downbtn"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="28.0dip"
        android:layout_marginTop="@dimen/margin_m"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemtitle"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
</androidx.constraintlayout.widget.ConstraintLayout>