<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/image_divider"
        android:tag="css/.split-line"
        android:background="@drawable/appgallery_comment_reply_divider"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <com.huawei.appgallery.appcomment.ui.view.ReplyRelativeLayout
        android:id="@id/reply_relayout"
        android:tag="css/.split-line"
        android:background="@drawable/appcomment_reply_bg"
        android:paddingTop="@dimen/margin_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_l">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/detail_reply_nickname_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
            android:paddingStart="@dimen/padding_l"
            android:paddingEnd="@dimen/padding_l">
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_comment_list_reply_item_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/detail_comment_list_reply_item_user_textview"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                <com.huawei.appgallery.appcomment.widget.CommentLabelTextView
                    android:textSize="@dimen/appcomment_8_dp"
                    android:textColor="@color/emui_accent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@id/detail_comment_list_reply_item_role_textview"
                    android:tag="css/.title"
                    android:background="@drawable/appcomment_comment_label_bg"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/appcomment_14_dp"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:paddingStart="@dimen/margin_m"
                    android:paddingEnd="@dimen/margin_m"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_xs" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/reply_divider_icon"
                android:tag="css/.widget"
                android:background="@drawable/appcomment_comment_reply"
                android:layout_width="@dimen/appcomment_16_dp"
                android:layout_height="@dimen/appcomment_16_dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_xs"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_xs" />
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:layout_gravity="center_vertical"
                android:id="@id/detail_comment_list_replied_textview"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
        </LinearLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/detail_comment_list_reply_item_content_textview"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginBottom="@dimen/margin_m"
            android:maxLines="5"
            android:layout_below="@id/detail_reply_nickname_layout"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/padding_l"
            android:paddingEnd="@dimen/padding_l"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
        <TextView
            android:id="@id/detail_comment_reply_more"
            android:tag="css/.title"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:paddingTop="4.0dip"
            android:paddingBottom="4.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_m"
            android:maxLines="1"
            android:layout_below="@id/detail_comment_list_reply_item_content_textview"
            android:textAllCaps="true"
            android:paddingStart="@dimen/appcomment_8_dp"
            android:paddingEnd="@dimen/appcomment_8_dp"
            android:layout_marginStart="@dimen/margin_m"
            android:layout_marginEnd="@dimen/margin_m"
            style="@style/AppGallery.TextAppearance.TextLink" />
    </com.huawei.appgallery.appcomment.ui.view.ReplyRelativeLayout>
</LinearLayout>