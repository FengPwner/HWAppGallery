<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/horizon_video_full_screen_bottom_item"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/port_bottom_desc"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/slide_video_port_item_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_type="appicon"
            app:round_type="all" />
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/app_download_button_port"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary_inverse"
                android:ellipsize="end"
                android:id="@id/slide_video_port_item_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@id/app_download_button_port" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_secondary_inverse"
                android:ellipsize="end"
                android:id="@id/slide_video_port_item_memo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:singleLine="true"
                android:layout_below="@id/slide_video_port_item_name"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart"
                android:layout_toStartOf="@id/app_download_button_port" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/land_bottom_desc"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/slide_video_full_item_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_type="appicon"
            app:round_type="all" />
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary_inverse"
                android:ellipsize="end"
                android:id="@id/slide_video_full_item_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_secondary_inverse"
                android:ellipsize="end"
                android:id="@id/slide_video_full_item_memo"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:singleLine="true"
                android:layout_below="@id/slide_video_full_item_name"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>