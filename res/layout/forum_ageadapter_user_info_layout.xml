<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:ellipsize="end"
        android:id="@id/forum_section_post_user_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs">
        <ImageView
            android:id="@id/forum_section_post_user_flag"
            android:layout_width="@dimen/appgallery_default_padding_top"
            android:layout_height="@dimen/appgallery_default_padding_top"
            android:layout_marginStart="@dimen/margin_s" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body3"
            android:ellipsize="end"
            android:id="@id/forum_section_post_user_duties"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/margin_s"
            android:layout_marginEnd="@dimen/margin_s"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/forum_section_post_user_stamp"
            android:paddingLeft="@dimen/margin_s"
            android:paddingRight="@dimen/margin_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/appgallery_subheader_item_double_min_height"
            android:maxLines="1"
            android:fontFamily="@string/appgallery_text_font_family_medium" />
    </LinearLayout>
</merge>