<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:ellipsize="end"
        android:id="@id/appdetail_head_label_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        style="@style/detail_head_label" />
    <com.huawei.appgallery.detail.detailbase.common.ArrowImageView
        android:id="@id/detail_head_lable_folding_textview"
        android:tag="css/.arrow"
        android:background="@drawable/ic_public_arrow_down_900"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs" />
</LinearLayout>