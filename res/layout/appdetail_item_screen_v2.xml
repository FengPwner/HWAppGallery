<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@id/tvDetailScreenCardV2Title"
            android:focusable="true"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m"
            android:layout_weight="1.0"
            android:importantForAccessibility="yes"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/detail_card_title" />
        <com.huawei.appgallery.detail.detailbase.common.RenderMachineImageView
            android:id="@id/detail_desc_translate_img"
            android:tag="css/.widget"
            android:padding="@dimen/appgallery_card_elements_margin_m"
            android:visibility="gone"
            android:layout_width="@dimen/detail_translate_switch_hot_zone"
            android:layout_height="@dimen/detail_translate_switch_hot_zone"
            android:layout_marginTop="@dimen/margin_m"
            android:scaleType="centerCrop"
            android:contentDescription="@string/component_detail_translate_btn_label"
            android:layout_marginEnd="@dimen/margin_m" />
    </LinearLayout>
    <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
        android:id="@id/AppListItem"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m"
        bounceViews:bounceEnable="true" />
</LinearLayout>