<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/linear_item_sub_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/lay_content"
        android:focusable="true"
        android:clickable="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/txt_card_item_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/txt_card_item_subTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
    <ImageView
        android:id="@id/view_divider"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_marginTop="6.0dip"
        android:layout_marginBottom="12.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>