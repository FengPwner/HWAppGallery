<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ViewStub
        android:id="@id/buoy_video_player_view_stub"
        android:layout="@layout/forum_section_buoy_post_video_banner_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <RelativeLayout
        android:id="@id/tabContainer"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip">
        <RelativeLayout
            android:gravity="center"
            android:id="@id/back_icon"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_centerVertical="true"
            android:contentDescription="@string/click_back"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="4.0dip"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@id/back_imageview"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/aguikit_ic_public_back"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/expansion_layout_id"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="gone"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/menu_layout_id">
            <ImageView
                android:id="@id/expansion_imageview"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/aguikit_ic_public_enlarge" />
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/menu_layout_id"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="gone"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_centerVertical="true"
            android:contentDescription="@string/forum_post_more_btn"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/more_imageview"
                android:layout_width="12.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/ic_toolbar_more_white_normal" />
        </RelativeLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_master_title_1"
            android:textColor="@color/buoy_emui_primary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@id/title_textview"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/forum_post_detail_title"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginEnd="4.0dip"
            android:layout_toStartOf="@id/expansion_layout_id"
            android:layout_toEndOf="@id/back_icon"
            app:hwAutoSizeMinTextSize="@dimen/appgallery_text_size_body2"
            app:hwAutoSizeStepGranularity="@dimen/res_textsize_1sp" />
    </RelativeLayout>
</RelativeLayout>