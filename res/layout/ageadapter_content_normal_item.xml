<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/AppListItem"
    android:background="@drawable/aguikit_round_rectangle_card_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/icon"
        android:layout_width="96.0dip"
        android:layout_height="133.0dip"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:scaleType="centerCrop"
        app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/content_item_right_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_below="@id/icon">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@id/score_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_l">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/ScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.SubTitle2.Regular" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/ScoreUnitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score_unit"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.SubTitle2.Regular" />
        </LinearLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/item_desc_0"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/item_desc_1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/item_desc_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
    <ImageView
        android:id="@id/item_divider_line"
        android:layout_width="fill_parent"
        android:layout_below="@id/content_item_right_layout"
        android:layout_alignStart="@id/content_item_right_layout"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>