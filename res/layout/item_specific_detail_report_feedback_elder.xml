<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/component_detail_report_item_common_margin_horizontal"
    android:paddingEnd="@dimen/component_detail_report_item_common_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/item_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@id/iv_star"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="@dimen/component_detail_report_star_height_and_width"
            android:layout_height="@dimen/component_detail_report_star_height_and_width"
            android:src="@drawable/ic_detail_report_star"
            android:contentDescription="@string/component_detail_star"
            app:layout_constraintBottom_toBottomOf="@id/tv_problem_feedback"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_problem_feedback" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/tv_problem_feedback"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/component_detail_report_des_title_height"
            android:text="@string/component_detail_report_problem_feedback"
            android:maxLines="2"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
            app:layout_constraintStart_toEndOf="@id/iv_star"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@id/rl_types"
        android:background="@drawable/aguikit_card_panel_bg"
        android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_detail_report_margin_m"
        android:minHeight="@dimen/appgallery_list_height_single_text_line"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        app:layout_constraintTop_toBottomOf="@id/item_title">
        <TextView
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/tv_problem_type"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_detail_report_second_title_padding_top"
            android:minHeight="@dimen/appgallery_list_height_single_text_line"
            android:text="@string/component_detail_report_problem_type"
            android:maxLines="2"
            android:importantForAccessibility="yes"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
        <com.huawei.uikit.hwrecyclerview.widget.HwRecyclerView
            android:id="@id/rv_problem_type"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_detail_report_margin_xl"
            android:layout_marginBottom="-4.0dip"
            android:minHeight="@dimen/component_detail_report_problem_type_min_height"
            android:layout_below="@id/tv_problem_type" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/tv_problem_reason"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_s"
            android:minHeight="@dimen/appgallery_list_height_single_text_line"
            android:text="@string/component_detail_report_specific_reason"
            android:maxLines="2"
            android:layout_below="@id/rv_problem_type"
            android:importantForAccessibility="yes"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
        <com.huawei.uikit.hwrecyclerview.widget.HwRecyclerView
            android:id="@id/rv_problem_reason"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="-4.0dip"
            android:minHeight="@dimen/component_detail_report_problem_type_min_height"
            android:layout_below="@id/tv_problem_reason" />
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_caption"
        android:textColor="@color/appgallery_color_error"
        android:id="@id/tv_tips"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        app:layout_constraintTop_toBottomOf="@id/rl_types" />
</androidx.constraintlayout.widget.ConstraintLayout>