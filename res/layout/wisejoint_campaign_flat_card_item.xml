<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:id="@id/AppListItem"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_weight="1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/icon"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/middle_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_marginBottom="@dimen/margin_l"
        android:layout_below="@id/icon">
        <TextView
            android:ellipsize="end"
            android:id="@id/ItemTitle"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
        <TextView
            android:ellipsize="end"
            android:id="@id/ItemText"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
        <TextView
            android:ellipsize="end"
            android:id="@id/timeText"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
    </LinearLayout>
</RelativeLayout>