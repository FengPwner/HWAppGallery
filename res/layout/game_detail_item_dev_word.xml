<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@id/detail_desc_dev_word_layout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:paddingTop="@dimen/ui_12_dp"
        android:paddingBottom="@dimen/ui_12_dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@id/detail_desc_dev_word_content_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/appgallery_text_font_family_regular">
            <TextView
                android:id="@id/detail_desc_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/detail_card_title" />
            <com.huawei.appgallery.detail.detailbase.common.FoldingTextView
                android:ellipsize="end"
                android:id="@id/detail_desc_dev_word_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/component_detail_card_elements_margin_s"
                style="@style/detail_card_introduce_content" />
        </LinearLayout>
        <com.huawei.appgallery.detail.detailbase.common.ArrowImageView
            android:layout_gravity="end|bottom|center"
            android:id="@id/detail_dev_word_folding_imageview"
            android:background="@drawable/ic_public_arrow_down_900"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>