<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appgallery.purchasehistory.ui.widget.CardRelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_list_height_two_text_lines"
    android:paddingStart="@dimen/appgallery_list_preferred_item_padding_start"
    android:paddingEnd="@dimen/appgallery_list_preferred_item_padding_start"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/arrow_right"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        style="@style/AppGallery.Widget.List.RightArrow" />
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@id/left_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
        android:layout_toStartOf="@id/arrow_right"
        android:layout_alignParentStart="true">
        <TextView
            android:ellipsize="end"
            android:id="@id/ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_for_layout"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
        <TextView
            android:id="@id/ItemText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:text="@string/placeholder_for_layout"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@id/right_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
        android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:layout_below="@id/left_layout"
        android:layout_toStartOf="@id/arrow_right">
        <TextView
            android:ellipsize="end"
            android:id="@id/ItemTitleRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_for_layout"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Primary" />
        <TextView
            android:id="@id/ItemTextRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:text="@string/placeholder_for_layout"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
    <View
        android:id="@id/divide_line"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        style="@style/AppGallery.Widget.Divider" />
</com.huawei.appgallery.purchasehistory.ui.widget.CardRelativeLayout>