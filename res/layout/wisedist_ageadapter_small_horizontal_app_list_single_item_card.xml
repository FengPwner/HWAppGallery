<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/AppListItem"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_card_height_two_text_lines"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_middle"
        android:layout_height="@dimen/appgallery_card_icon_size_middle"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:src="@color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@id/view"
        android:background="@color/transparent"
        android:layout_width="@dimen/wisedist_serial_number_textview_layout_width"
        android:layout_height="0.0dip"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
        app:layout_constraintBottom_toBottomOf="@id/appicon"
        app:layout_constraintStart_toEndOf="@id/appicon"
        app:layout_constraintTop_toTopOf="@id/appicon" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_subtitle2"
        android:gravity="center|top"
        android:id="@id/rank_number_textview"
        android:tag="css/.title"
        android:layout_width="@dimen/wisedist_serial_number_textview_layout_width"
        android:layout_height="@dimen/ranking_medal_image_size"
        android:maxLines="1"
        app:hwAutoSizeMinTextSize="15.0sp"
        app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
        app:layout_constraintBottom_toBottomOf="@id/view"
        app:layout_constraintStart_toStartOf="@id/view"
        app:layout_constraintTop_toTopOf="@id/view"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_subtitle2"
        android:gravity="center"
        android:id="@id/appSerial"
        android:tag="css/.title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:hwAutoSizeMinTextSize="15.0sp"
        app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
        app:layout_constraintBottom_toBottomOf="@id/view"
        app:layout_constraintStart_toStartOf="@id/view"
        app:layout_constraintTop_toTopOf="@id/view"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
    <com.huawei.appgallery.pageframe.view.DownloadButtonV2
        android:id="@id/downbtn"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:minHeight="28.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/appicon"
        app:layout_constraintTop_toBottomOf="@id/item_text_rl"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/title_layout"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/appicon"
        app:layout_constraintTop_toBottomOf="@id/appicon">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/ItemTitle"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/info_watch_imageview"
                android:tag="css/.widget"
                android:visibility="gone"
                android:layout_width="14.0dip"
                android:layout_height="14.0dip"
                android:src="@drawable/aguikit_ic_public_watch"
                android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/info_vr_imageview"
                android:tag="css/.widget"
                android:visibility="gone"
                android:layout_width="14.0dip"
                android:layout_height="14.0dip"
                android:src="@drawable/aguikit_ic_public_vr"
                android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs" />
        </LinearLayout>
    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/item_text_rl"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
        app:layout_constraintEnd_toEndOf="@id/title_layout"
        app:layout_constraintStart_toStartOf="@id/title_layout"
        app:layout_constraintTop_toBottomOf="@id/title_layout">
        <com.huawei.appmarket.framework.widget.PromotionSignTextView
            android:layout_gravity="center_vertical"
            android:id="@id/promotion_sign"
            android:tag="css/.title"
            android:background="@drawable/promotion_sign_bg"
            android:layout_marginEnd="@dimen/appgallery_text_margin_horizontal"
            style="@style/promotion_sign_ageadapter_style" />
        <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
            android:id="@id/nonadapt_imageview"
            android:tag="css/.title"
            android:visibility="gone"
            android:layout_width="18.0dip"
            android:layout_height="@dimen/ui_14_dp"
            android:scaleType="fitCenter"
            android:paddingEnd="@dimen/appgallery_text_paragraph_margin_xs" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:id="@id/memo"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <TextView
            android:id="@id/ItemText_star"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/appgallery_text_margin_horizontal"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
    <ImageView
        android:id="@id/appflag"
        android:visibility="gone"
        android:layout_width="@dimen/activity_flag_size"
        android:layout_height="@dimen/activity_flag_size"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@id/devider_line"
        android:tag="css/.split-line"
        android:layout_width="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/title_layout"
        app:layout_constraintStart_toStartOf="@id/appicon"
        style="@style/AppGallery.Widget.Divider" />
</androidx.constraintlayout.widget.ConstraintLayout>