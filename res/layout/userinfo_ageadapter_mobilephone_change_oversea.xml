<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_horizontal"
    android:background="@color/appgallery_color_sub_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/change_submit_btn"
        android:layout_alignParentTop="true">
        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/userinfo_mobilephone_layout"
                    android:background="@drawable/aguikit_card_panel_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/appgallery_max_padding_start"
                    android:layout_marginEnd="@dimen/appgallery_max_padding_end">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/select_phone_country_code_layout"
                        android:paddingTop="@dimen/padding_l"
                        android:paddingBottom="@dimen/padding_m"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
                        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:ellipsize="end"
                            android:gravity="start|center"
                            android:layout_gravity="start|center"
                            android:id="@id/country_region_tag"
                            android:paddingRight="@dimen/padding_s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_and_region"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:paddingEnd="@dimen/padding_s"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:id="@id/user_phone_country_code_click_area"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                            <ImageView
                                android:id="@id/nickname_arrow_oversea"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                style="@style/AppGallery.Widget.List.RightArrow" />
                            <TextView
                                android:textSize="@dimen/appgallery_text_size_body2"
                                android:textColor="@color/appgallery_text_color_secondary"
                                android:ellipsize="end"
                                android:gravity="start|center"
                                android:id="@id/user_phone_country_code_oversea"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:maxLines="1"
                                android:layout_centerVertical="true"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                android:textAlignment="viewStart"
                                android:layout_toStartOf="@id/nickname_arrow_oversea"
                                style="@style/AppGallery.TextAppearance.List.TextBody1" />
                        </RelativeLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingTop="@dimen/padding_l"
                        android:paddingBottom="@dimen/padding_l"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
                        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
                        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:gravity="start|center"
                            android:id="@id/country_code_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_info_receive_telephone_remind_v2"
                            android:layout_centerVertical="true"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                        <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:textColorHint="@color/appgallery_text_color_hint"
                            android:ellipsize="end"
                            android:gravity="start|center"
                            android:id="@id/mobile_phone_number"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                            android:hint="@string/mine_info_phone_oversea_enter_remind_hint"
                            android:maxLines="1"
                            android:maxLength="50"
                            android:layout_centerVertical="true"
                            android:inputType="phone"
                            android:imeOptions="actionNone"
                            android:textCursorDrawable="@drawable/ic_cursor"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:textAlignment="viewStart"
                            android:layout_toEndOf="@id/country_code_symbol"
                            style="@style/Widget.Emui.HwEditText.Space" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:gravity="start|center|top"
                        android:layout_gravity="bottom"
                        android:id="@id/check_box_prize_collect_tips_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_prize_collect_num_tips"
                        android:layout_centerHorizontal="true"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="@dimen/appgallery_max_padding_start"
                        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                        style="style/AppGallery.TextAppearance.Paragraph.TextBody2" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:id="@id/change_submit_btn"
        android:paddingTop="@dimen/padding_m"
        android:paddingBottom="@dimen/padding_m"
        android:layout_width="300.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
        android:text="@string/detail_comment_submit"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwAutoSizeMinTextSize="9.0sp"
        app:hwAutoSizeStepGranularity="1.0sp"
        style="@style/Widget.Emui.HwButton.Emphasize" />
</RelativeLayout>