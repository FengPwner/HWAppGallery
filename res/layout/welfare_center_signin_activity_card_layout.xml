<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xl"
        android:layout_marginRight="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1_fixed"
                android:textColor="@color/appgallery_color_primary"
                android:ellipsize="end"
                android:id="@id/title_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2_fixed"
                android:textColor="@color/appgallery_color_secondary"
                android:ellipsize="end"
                android:id="@id/sign_in_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:enabled="true"
            android:textSize="@dimen/appgallery_text_size_body3_fixed"
            android:textColor="@color/white"
            android:layout_gravity="end"
            android:id="@id/check_in_btn"
            android:background="@drawable/welfare_center_checkin_btn_bg"
            android:layout_width="72.0dip"
            android:layout_height="wrap_content"
            android:text="@string/welfare_center_card_checkin_btn"
            android:maxLines="4"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
            style="@style/Widget.Emui.HwButton.Small" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/daily_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_marginRight="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xl" />
</LinearLayout>