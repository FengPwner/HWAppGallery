<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:tag="@string/bannerImage"
    android:background="@drawable/aguikit_card_panel_bg"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/appList_ItemTitle_layout"
        layout="@layout/wisedist_multi_subheader_title_more" />
    <ViewStub
        android:id="@id/bubble_viewstub"
        android:layout="@layout/wisedist_layout_multi_bubble"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
        android:id="@id/AppListItem"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4.0dip"
        app:bounceEnable="true" />
    <ViewStub
        android:id="@id/interac_viewstub"
        android:layout="@layout/wisedist_interac_container"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/wisedist_interactive_container_height" />
    <ViewStub
        android:id="@id/download_expand_viewstub"
        android:layout="@layout/wisedist_layout_download_expend"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
</LinearLayout>