<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/agguard_guide_layout"
    android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
    android:paddingBottom="12.0dip"
    android:focusable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/agguard_guide_head_title"
        android:paddingTop="8.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:minHeight="@dimen/appgallery_subheader_default_height_single_text_line">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="start|center"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="3.0">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="start|center"
                android:id="@id/agguard_guide_text"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agguard_records_title"
                android:maxLines="2"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/agguard_guide_red_dot"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AppGallery.Widget.SubHeader.Title" />
            <LinearLayout
                android:id="@id/agguard_guide_red_dot"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toEndOf="@id/agguard_guide_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/item_red_dot_imageview"
                    android:visibility="gone"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:src="@drawable/tab_red_dot"
                    android:layout_marginStart="@dimen/appgallery_text_margin_horizontal" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@id/agguard_guide_arrow_imageView"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/margin_m">
            <ImageView
                android:id="@id/agguard_scan_guide_more_arrow"
                android:tag="css/.arrow"
                android:layout_centerVertical="true"
                android:layout_marginStart="0.0dip"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/appgallery_color_tertiary"
                style="@style/AppGallery.Widget.List.RightArrow" />
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@id/agguard_guide_scan_result_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/agguard_guide_head_title">
        <RelativeLayout
            android:id="@id/agguard_guide_result_icon_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/agguard_tab_view_icon_size"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@id/agguard_guide_result_icon"
                android:visibility="gone"
                android:layout_width="@dimen/appgallery_card_icon_size_middle"
                android:layout_height="@dimen/appgallery_card_icon_size_middle"
                android:layout_centerVertical="true" />
            <include
                android:id="@id/agguard_guide_rate_progress_layout"
                android:visibility="gone"
                layout="@layout/agguard_scan_guide_rate_layout" />
            <include
                android:id="@id/agguard_guide_loading_circle_layout"
                android:visibility="gone"
                layout="@layout/agguard_scan_guide_loading_circle_layout" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/agguard_guide_result_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
            android:layout_toStartOf="@id/agguard_guide_scan_button_layout"
            android:layout_toEndOf="@id/agguard_guide_result_icon_layout">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="14.0sp"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/agguard_guide_scan_result_tips_title"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/aggaurd_tab_scan_safe_tip"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="viewStart" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textStyle="normal"
                android:id="@id/agguard_guide_scan_result_tips_desc"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:layout_below="@id/agguard_guide_scan_result_tips_title"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="14.0sp"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="center_vertical"
                android:id="@id/agguard_guide_scaning_text"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/agguard_str_scanning"
                android:layout_centerVertical="true"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/agguard_guide_scan_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
            android:layout_alignParentEnd="true">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:ellipsize="end"
                android:id="@id/agguard_guide_scan_button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:maxWidth="90.0dip"
                android:minWidth="64.0dip"
                android:text="@string/agguard_rescan_title"
                android:maxLines="1"
                app:hwAutoSizeMinTextSize="9.0sp"
                app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
                style="@style/AppGallery.Widget.Button.Small" />
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:ellipsize="end"
                android:id="@id/agguard_guide_one_click_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:maxWidth="90.0dip"
                android:minWidth="64.0dip"
                android:text="@string/agguard_one_click_button_text"
                android:maxLines="1"
                app:hwAutoSizeMinTextSize="9.0sp"
                app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
                style="@style/AppGallery.Widget.Button.Small" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>