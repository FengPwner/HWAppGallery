<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/large_appwidget_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/large_appwidget_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/hiapp_large_appwidget_card_height"
        android:src="@drawable/hiapp_appwidget_panel_bg"
        android:scaleType="fitXY" />
    <RelativeLayout
        android:padding="@dimen/appgallery_default_padding_start"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/hiapp_large_appwidget_card_height">
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginStart="@dimen/appgallery_default_padding_start"
            android:layout_toEndOf="@id/large_appwidget_topic">
            <GridView
                android:id="@id/large_appwidget_gridview"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:listSelector="@android:color/transparent"
                android:horizontalSpacing="@dimen/appgallery_card_elements_margin_m"
                android:verticalSpacing="@dimen/appgallery_card_elements_margin_m"
                android:numColumns="2"
                android:overScrollMode="never" />
            <include
                android:id="@id/empty_view"
                layout="@layout/hiapp_appwidget_grid_view_empty" />
        </FrameLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@id/large_appwidget_topic"
            android:layout_width="@dimen/hiapp_large_appwidget_topic_card_size"
            android:layout_height="@dimen/hiapp_large_appwidget_topic_card_size"
            android:src="@drawable/hiapp_appwidget_placeholder_img"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/wisejoin_image" />
    </RelativeLayout>
</RelativeLayout>