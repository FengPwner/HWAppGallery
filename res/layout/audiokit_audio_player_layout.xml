<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/aguikit_card_panel_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/audiokit_audio_imageview"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:src="@drawable/audiokit_audio_play"
        android:layout_centerVertical="true"
        android:contentDescription="@string/audiokit_video_play_or_pause"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_toEndOf="@id/audiokit_audio_imageview">
        <TextView
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/audio_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            style="@style/AppGallery.TextAppearance.Card.TextBody2" />
        <LinearLayout
            android:id="@id/progress_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/appgallery_text_color_primary"
                android:layout_gravity="center_vertical"
                android:id="@id/audiokit_audio_current_time_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.Card.TextBody4" />
            <com.huawei.uikit.hwseekbar.widget.HwSeekBar
                android:id="@id/audiokit_audio_seekbar"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressDrawable="@drawable/hwseekbar_track_enable_emui"
                android:layout_weight="1.0"
                style="@style/Widget.Emui.HwSeekBar" />
            <TextView
                android:textColor="@color/appgallery_text_color_primary"
                android:layout_gravity="center_vertical"
                android:id="@id/audiokit_audio_totle_time_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.Card.TextBody4" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>