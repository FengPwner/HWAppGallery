<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/emui_master_body_2"
        android:textColor="@color/emui_color_gray_10"
        android:id="@id/batch_per_item_groupdesc"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20.0dip" />
    <LinearLayout
        android:id="@id/batch_per_item_layout"
        android:paddingTop="@dimen/padding_s"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20.0dip">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/margin_l"
            android:layout_height="@dimen/margin_l"
            android:src="@drawable/wisedist_apppermission_point" />
        <TextView
            android:textSize="@dimen/emui_master_body_2"
            android:textColor="@color/emui_color_gray_7"
            android:id="@id/batch_per_item"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_s" />
    </LinearLayout>
    <ImageView
        android:id="@id/batch_per_image"
        android:background="@color/divider_horizontal_color_emui"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/divider_horizontal_height_emui"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginEnd="@dimen/ui_20_dp" />
</LinearLayout>