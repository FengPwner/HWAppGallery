<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="14.0dip"
        android:id="@id/guide_rate_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    <com.huawei.uikit.phone.hwprogressindicator.widget.HwProgressIndicator
        android:id="@id/guide_rate_circle"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/agguard_tab_view_icon_size"
        android:layout_height="@dimen/agguard_tab_view_icon_size"
        android:layout_centerInParent="true"
        app:hwSizeMode="small" />
</RelativeLayout>