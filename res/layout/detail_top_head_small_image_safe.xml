<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/head_safe_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appgallery.detail.detailbase.view.ExposureImageView
        android:id="@id/head_safe_image_view"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:contentDescription="@string/component_detail_accessibility_publicize_image"
        android:importantForAccessibility="yes" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/safe_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/head_safe_image_view"
        android:layout_alignBottom="@id/head_safe_image_view">
        <TextView
            android:textSize="20.0sp"
            android:textColor="#e5000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/safe_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/banner_bg_margin_16" />
    </LinearLayout>
</RelativeLayout>