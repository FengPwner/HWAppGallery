<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/item_container_layout"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_card_height_three_text_lines"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/item_appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:src="@drawable/transparent"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
    <RelativeLayout
        android:id="@id/appinfo_right_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/item_appicon">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/appinfo_right_content_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toStartOf="@id/item_app_get_btn">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/item_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/item_app_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
        <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
            android:id="@id/item_app_get_btn"
            android:layout_width="wrap_content"
            android:layout_height="28.0dip"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/appinfo_right_content_layout">
            <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                android:id="@id/nonadapt_imageview"
                android:tag="css/.title"
                android:visibility="gone"
                android:layout_width="18.0dip"
                android:layout_height="fill_parent"
                android:scaleType="fitCenter"
                android:paddingEnd="@dimen/appgallery_text_paragraph_margin_xs" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/item_app_link"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@id/item_divider_line"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_below="@id/appinfo_right_layout"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@id/appinfo_right_layout"
        android:layout_alignEnd="@id/appinfo_right_layout"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>