<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/feedback_sdk_dialog_bg_shape"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/feedback_sdk_common_24_dip">
        <TextView
            android:textSize="@dimen/feedback_sdk_common_ui_sp_16"
            android:textColor="@color/feedback_sdk_common_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_sdk_delete_history_dialog_title"
            android:layout_centerInParent="true" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/feedback_sdk_common_16_dip"
        android:layout_marginStart="@dimen/feedback_sdk_common_24_dip"
        android:layout_marginEnd="@dimen/feedback_sdk_common_24_dip">
        <TextView
            android:textSize="@dimen/feedback_sdk_common_ui_sp_16"
            android:textColor="@color/emui_activated"
            android:gravity="center"
            android:id="@id/delete_history_dialog_cancel"
            android:paddingTop="@dimen/feedback_sdk_common_10_dip"
            android:paddingBottom="@dimen/feedback_sdk_common_10_dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/feedback_sdk_common_cancel"
            android:layout_weight="1.0"
            android:textAllCaps="true"
            android:fontFamily="HwChinese-medium" />
        <View
            android:background="@color/feedback_toggle_item_bg_color"
            android:layout_width="@dimen/feedback_sdk_divider_height"
            android:layout_height="@dimen/feedback_sdk_common_24_dip"
            android:layout_marginStart="@dimen/feedback_sdk_common_8_dip"
            android:layout_marginEnd="@dimen/feedback_sdk_common_8_dip" />
        <TextView
            android:textSize="@dimen/feedback_sdk_common_ui_sp_16"
            android:textColor="@color/feedback_sdk_delete_text_color"
            android:gravity="center"
            android:id="@id/delete_history_dialog_delete"
            android:paddingTop="@dimen/feedback_sdk_common_10_dip"
            android:paddingBottom="@dimen/feedback_sdk_common_10_dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/feedback_sdk_delete"
            android:layout_weight="1.0"
            android:textAllCaps="true"
            android:fontFamily="HwChinese-medium" />
    </LinearLayout>
</LinearLayout>