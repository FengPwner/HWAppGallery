<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.service.substance.BlurFlowBackground
    android:layout_gravity="bottom"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/wisedist_recommend_imageview"
        android:layout_width="@dimen/appgallery_card_icon_size_middle"
        android:layout_height="@dimen/appgallery_card_icon_size_middle"
        android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
        android:scaleType="centerCrop"
        android:layout_alignParentStart="true" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/hiappbase_flow_card_title_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_below="@id/wisedist_recommend_imageview"
        android:importantForAccessibility="no"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:ellipsize="end"
            android:id="@id/wisedist_recommend_title_textview"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <TextView
            android:ellipsize="end"
            android:id="@id/wisedist_recommend_sutitle_textview"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:maxLines="1"
            android:importantForAccessibility="yes"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
        android:id="@id/wisedist_recommend_downbutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:minWidth="64.0dip"
        android:minHeight="28.0dip"
        android:layout_below="@id/hiappbase_flow_card_title_layout"
        android:layout_alignParentStart="true"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
</com.huawei.appmarket.service.substance.BlurFlowBackground>