<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/welfare_item_layout"
    android:background="@drawable/aguikit_card_panel_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_vertical"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/welfare_app_layout"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:minHeight="80.0dip"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/appgallery_card_elements_margin_m"
        android:paddingEnd="@dimen/appgallery_card_elements_margin_m">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/appgallery_card_icon_size_middle"
            android:layout_height="@dimen/appgallery_card_icon_size_middle"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
            android:src="@color/transparent"
            android:scaleType="fitCenter"
            android:layout_alignParentTop="true" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/welfare_app_detail_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_below="@id/appicon">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/welfare_app_title"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/third_line"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs">
                <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/non_adapter_icon"
                    android:tag="css/.title"
                    android:visibility="gone"
                    android:layout_width="18.0dip"
                    android:layout_height="@dimen/ui_14_dp"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:id="@id/welfare_app_detail"
                    android:tag="css/.subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
        </LinearLayout>
        <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
            android:id="@id/welfare_downloadBtn"
            android:tag="css/.download-button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:minWidth="64.0dip"
            android:minHeight="28.0dip"
            android:layout_below="@id/welfare_app_detail_layout"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/welfare_app_first_sub_layout"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
        android:layout_below="@id/welfare_app_layout"
        android:paddingStart="@dimen/appgallery_card_elements_margin_m"
        android:paddingEnd="@dimen/appgallery_card_elements_margin_m"
        android:layout_alignStart="@id/welfare_app_layout">
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:id="@id/first_welfare_icon_layout"
            android:layout_width="@dimen/appgallery_card_icon_size_xs"
            android:layout_height="@dimen/appgallery_card_icon_size_xs"
            android:adjustViewBounds="true"
            android:layout_alignTop="@id/first_welfare_title"
            android:layout_alignBottom="@id/first_welfare_title"
            app:clip_background="true"
            app:round_corner="@dimen/appgallery_default_corner_radius_s"
            app:stroke_color="@color/transparent">
            <ImageView
                android:id="@id/first_welfare_icon"
                android:layout_width="@dimen/appgallery_card_icon_size_xs"
                android:layout_height="@dimen/appgallery_card_icon_size_xs"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true" />
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/first_welfare_title"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_toEndOf="@id/first_welfare_icon_layout"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:id="@id/first_welfare_detail"
            android:tag="css/.subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:singleLine="true"
            android:layout_below="@id/first_welfare_title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@id/first_welfare_title"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <View
            android:id="@id/first_devider_line"
            android:tag="css/.split-line"
            android:layout_width="fill_parent"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/welfare_app_second_sub_layout"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
        android:layout_below="@id/welfare_app_first_sub_layout"
        android:paddingStart="@dimen/appgallery_card_elements_margin_m"
        android:paddingEnd="@dimen/appgallery_card_elements_margin_m"
        android:layout_alignStart="@id/welfare_app_first_sub_layout"
        android:layout_alignParentEnd="true">
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:id="@id/second_welfare_icon_layout"
            android:layout_width="@dimen/appgallery_card_icon_size_xs"
            android:layout_height="@dimen/appgallery_card_icon_size_xs"
            android:adjustViewBounds="true"
            android:layout_alignTop="@id/second_welfare_title"
            android:layout_alignBottom="@id/second_welfare_title"
            android:layout_centerVertical="true"
            app:clip_background="true"
            app:round_corner="@dimen/appgallery_default_corner_radius_s"
            app:stroke_color="@color/transparent">
            <ImageView
                android:id="@id/second_welfare_icon"
                android:layout_width="@dimen/appgallery_card_icon_size_xs"
                android:layout_height="@dimen/appgallery_card_icon_size_xs"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true" />
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/second_welfare_title"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_toEndOf="@id/second_welfare_icon_layout"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:id="@id/second_welfare_detail"
            android:tag="css/.subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:singleLine="true"
            android:layout_below="@id/second_welfare_title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@id/second_welfare_title"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <View
            android:id="@id/second_devider_line"
            android:tag="css/.split-line"
            android:layout_width="fill_parent"
            android:layout_alignStart="@id/second_welfare_title"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/welfare_app_third_sub_layout"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
        android:layout_below="@id/welfare_app_second_sub_layout"
        android:paddingStart="@dimen/appgallery_card_elements_margin_m"
        android:paddingEnd="@dimen/appgallery_card_elements_margin_m"
        android:layout_alignStart="@id/welfare_app_first_sub_layout"
        android:layout_alignParentEnd="true">
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:id="@id/third_welfare_icon_layout"
            android:layout_width="@dimen/appgallery_card_icon_size_xs"
            android:layout_height="@dimen/appgallery_card_icon_size_xs"
            android:adjustViewBounds="true"
            android:layout_alignTop="@id/third_welfare_title"
            android:layout_alignBottom="@id/third_welfare_title"
            android:layout_centerVertical="true"
            app:clip_background="true"
            app:round_corner="@dimen/appgallery_default_corner_radius_s"
            app:stroke_color="@color/transparent">
            <ImageView
                android:id="@id/third_welfare_icon"
                android:layout_width="@dimen/appgallery_card_icon_size_xs"
                android:layout_height="@dimen/appgallery_card_icon_size_xs"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true" />
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/third_welfare_title"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_toEndOf="@id/third_welfare_icon_layout"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:id="@id/third_welfare_detail"
            android:tag="css/.subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:singleLine="true"
            android:layout_below="@id/third_welfare_title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@id/third_welfare_title"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <View
            android:id="@id/third_devider_line"
            android:tag="css/.split-line"
            android:layout_width="fill_parent"
            android:layout_alignStart="@id/third_welfare_title"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/welfare_lookDetail_layout"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:minHeight="@dimen/appgallery_list_height_single_text_line"
        android:layout_below="@id/welfare_app_third_sub_layout"
        android:layout_centerHorizontal="true">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_button2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:gravity="start|center"
            android:layout_gravity="center_vertical"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welfare_enter_detail"
            android:singleLine="true"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textAlignment="viewStart" />
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/detail_familysharing_right_arrow"
            android:tag="css/.arrow"
            android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
            android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
            android:src="@drawable/ic_public_arrow_right_900"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/welfare_center_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
        android:minWidth="@dimen/welfare_center_min_width"
        android:minHeight="@dimen/welfare_center_min_height"
        android:layout_below="@id/welfare_app_second_sub_layout"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:src="@drawable/wisedist_novice_giftpack_04" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
            android:text="@string/welfare_gift_center"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
</RelativeLayout>