<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@id/top_divide_line"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        style="@style/permit_app_kit_Widget.subheader.Divider" />
    <include
        android:id="@id/title_layout"
        layout="@layout/permit_app_kit_layout_subheader_no_botton_title_more_v1" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:gravity="start|center"
        android:id="@id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Button.TextButton2" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/item_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <View
        android:id="@id/bottom_divide_line"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        style="@style/permit_app_kit_Widget.subheader.Divider" />
</LinearLayout>