<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/upgrade_recommend_v1_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/upgrade_recommend_v1_bg"
        android:background="@color/upgrade_bg_color_bg"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:layout_gravity="bottom|center"
        android:orientation="vertical"
        android:id="@id/upgrade_recommend_v1_container"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="660.0dip">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@id/ll_arrow_down"
            android:layout_width="96.0dip"
            android:layout_height="@dimen/upgrade_recommendation_ui_24_dp"
            android:contentDescription="@string/click_back">
            <ImageView
                android:id="@id/iv_arrow_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_down" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <include
                    layout="@layout/ageadapter_upgrade_recommend_v1_title" />
                <com.huawei.appgallery.upgraderecommendation.ui.v1.ScrollDirViewPager
                    android:id="@id/upgrade_recommend_v1_pager"
                    android:background="@null"
                    android:paddingBottom="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="320.0dip"
                    android:layout_marginTop="24.0dip"
                    android:overScrollMode="never" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.huawei.uikit.hwdotspageindicator.widget.HwDotsPageIndicator
            android:layout_gravity="center_horizontal"
            android:id="@id/hwdotspageindicator"
            android:layout_width="wrap_content"
            android:layout_height="32.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="8.0dip"
            android:importantForAccessibility="no"
            app:hwIsShowAsDot="true"
            app:hwSelectedDotColor="@color/emui_accent"
            app:hwUnselectedDotColor="@color/emui_control_normal"
            style="@style/Widget.Emui.HwDotsPageIndicator.Translucent" />
        <include
            layout="@layout/ageadapter_upgrade_recommend_v1_button" />
        <View
            android:layout_width="fill_parent"
            android:layout_height="24.0dip" />
    </LinearLayout>
</FrameLayout>