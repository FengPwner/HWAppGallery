<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/res_textsize_14sp"
        android:textColor="@color/appgallery_text_color_hint"
        android:id="@id/tv_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/appcommon_fa_add_title"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/res_textsize_14sp"
        android:textColor="@color/appgallery_text_color_hint"
        android:id="@id/tv_subtitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:text="@string/appcommon_fa_add_subtitle"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />
    <com.huawei.appmarket.service.settings.view.widget.VerticalRadioViewGroup
        android:orientation="vertical"
        android:id="@id/radio_layout_settings"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cs_36_dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle">
        <com.huawei.appmarket.service.settings.view.widget.VerticalRadioView
            android:id="@id/radio_intel_recommend"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
            android:minHeight="64.0dip"
            android:text="@string/appcommon_settings_fa_recommend_desc"
            android:title="@string/appcommon_settings_fa_auto_recommend" />
        <com.huawei.appmarket.service.settings.view.widget.VerticalRadioView
            android:id="@id/radio_remind"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="64.0dip"
            android:text="@string/appcommon_settings_fa_remind_desc"
            android:title="@string/appcommon_settings_fa_remind" />
        <com.huawei.appmarket.service.settings.view.widget.VerticalRadioView
            android:id="@id/radio_shutdown"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
            android:minHeight="64.0dip"
            android:text="@string/appcommon_settings_fa_close_desc"
            android:title="@string/settings_video_autoplay_close" />
    </com.huawei.appmarket.service.settings.view.widget.VerticalRadioViewGroup>
</androidx.constraintlayout.widget.ConstraintLayout>