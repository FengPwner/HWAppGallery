<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@id/loadingBar"
        android:layout_width="@dimen/loading_large"
        android:layout_height="@dimen/loading_large"
        style="@style/Widget.Emui.HwProgressBar.Large" />
    <TextView
        android:layout_gravity="center_horizontal"
        android:id="@id/loadingTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_loading_prompt"
        android:contentDescription="@string/str_loading_prompt"
        android:importantForAccessibility="yes"
        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
</LinearLayout>