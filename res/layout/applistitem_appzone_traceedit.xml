<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/cardLayout"
    android:background="@drawable/list_item_all_selector"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/AppListItem"
        android:background="@drawable/list_item_all_selector"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_card_height_two_text_lines">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/icon_linear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_max_padding_start">
            <ImageView
                android:id="@id/appicon"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true" />
            <ViewStub
                android:layout_gravity="center"
                android:id="@id/horizon_line"
                android:layout="@layout/aguikit_horizontal_line_layout"
                android:layout_width="@dimen/ui_40_dp"
                android:layout_height="1.5dip"
                android:layout_marginTop="4.0dip"
                android:layout_below="@id/localpackage_item_icon_view" />
        </LinearLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toEndOf="@id/icon_linear">
            <com.huawei.uikit.phone.hwcheckbox.widget.HwCheckBox
                android:id="@id/button_check_box"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                android:layout_alignParentEnd="true"
                style="@style/Widget.Emui.HwCheckBox.Normal" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/button_check_box">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/ItemTitle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_info_default"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                        android:id="@id/not_adapt_icon"
                        android:tag="css/.title"
                        android:layout_width="18.0dip"
                        android:layout_height="@dimen/ui_14_dp"
                        android:scaleType="fitCenter"
                        android:paddingEnd="@dimen/padding_s" />
                    <TextView
                        android:id="@id/ItemText"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <TextView
                        android:id="@id/appzone_trace_price"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <ImageView
            android:id="@id/divider_line"
            android:layout_width="fill_parent"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="96.0dip"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
</LinearLayout>