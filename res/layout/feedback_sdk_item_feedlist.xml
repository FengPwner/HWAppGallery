<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.phoneservice.faq.base.widget.ListItemRelativeLayout
        android:id="@id/feed_item_rl"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.phoneservice.feedback.widget.ItemView
            android:id="@id/item_view"
            android:layout_width="@dimen/emui_dimens_max_start"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@id/iv_question_state"
                android:visibility="invisible"
                android:layout_width="@dimen/feedback_sdk_common_8_dip"
                android:layout_height="@dimen/feedback_sdk_common_8_dip"
                android:src="@drawable/feedback_sdk_question_list_tip"
                android:layout_centerHorizontal="true" />
        </com.huawei.phoneservice.feedback.widget.ItemView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_item"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feedback_sdk_common_14_dip"
            android:layout_marginBottom="@dimen/feedback_sdk_common_14_dip"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@id/feed_list_select_host"
            android:layout_toEndOf="@id/item_view">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/feedback_sdk_common_ui_sp_16"
                    android:textColor="@color/feedback_sdk_bar_black"
                    android:ellipsize="end"
                    android:id="@id/feed_title"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1.0"
                    android:fontFamily="@string/emui_text_font_family_medium"
                    android:textAlignment="viewStart"
                    android:layout_marginEnd="@dimen/feedback_sdk_common_12_dip" />
                <TextView
                    android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                    android:textColor="@color/feedback_sdk_permission_content_color"
                    android:id="@id/feed_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView
                android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                android:textColor="@color/feedback_sdk_permission_content_color"
                android:ellipsize="end"
                android:id="@id/feed_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_sdk_common_2_dip"
                android:fontFamily="@string/emui_text_font_family_medium" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/feed_list_select_host"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/emui_dimens_max_end"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/feed_list_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/feedback_sdk_common_16_dip" />
        </LinearLayout>
        <com.huawei.phoneservice.faq.base.widget.ListItemRelativeLayout
            android:id="@id/feedback_split_line"
            android:background="@drawable/feedback_sdk_list_divider_color_drawable"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/feedback_sdk_divider_height"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/emui_dimens_max_start"
            android:layout_toStartOf="@id/feed_list_select_host" />
    </com.huawei.phoneservice.faq.base.widget.ListItemRelativeLayout>
</RelativeLayout>