<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/AppGallery.Widget.SubHeader.ViewGroup">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="start|center"
            android:id="@id/hiappbase_subheader_title_left"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_for_layout"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/AppGallery.Widget.SubHeader.Title" />
    </LinearLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:id="@id/comment_stars_desc_textview"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
    <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
        android:id="@id/AppListItem"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:paddingStart="@dimen/margin_m"
        android:paddingEnd="@dimen/margin_m"
        app:bounceEnable="true" />
</LinearLayout>