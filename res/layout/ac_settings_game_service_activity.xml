<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />
    <com.huawei.appgallery.foundation.ui.framework.widget.BottomButton
        android:textColor="@color/hwbutton_selector_text_normal_emui"
        android:gravity="center"
        android:id="@id/game_service_button"
        android:background="@drawable/hwbutton_default_emui"
        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
        android:text="@string/game_service_open"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwAutoSizeMinTextSize="9.0sp"
        app:hwAutoSizeStepGranularity="1.0sp"
        style="@style/AppGallery.Widget.Button.BottomButton" />
    <com.huawei.appmarket.service.settings.view.widget.IntroduceRelativeLayout
        android:gravity="center"
        android:id="@id/image_view"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title">
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:src="@drawable/appcommon_game_service"
            android:scaleType="fitCenter" />
    </com.huawei.appmarket.service.settings.view.widget.IntroduceRelativeLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/game_service_button"
        android:layout_below="@id/image_view">
        <ScrollView
            android:orientation="vertical"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="24.0dip"
            android:layout_marginBottom="16.0dip"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/game_service_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_service_title"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    style="@style/AppGallery.TextAppearance.Paragraph.SubTitle1" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:id="@id/game_service_intro_first"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:id="@id/game_service_intro_second"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/game_service_content_second_new"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:id="@id/game_service_intro_third"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/game_service_content_thrid_new"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:id="@id/game_service_intro_forth"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/game_service_content_forth_new"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:id="@id/game_service_intro_fifth"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/game_service_content_sixth_new"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>