<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    style="@style/AppGallery.Widget.SubHeader.ViewGroup"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="start|bottom|center"
            android:id="@id/hiappbase_subheader_title_left"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/AppGallery.Widget.SubHeader.ListTitle" />
    </LinearLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:layout_gravity="start|bottom|center"
        android:id="@id/hiappbase_subheader_action_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
        android:maxLines="2"
        style="@style/AppGallery.Widget.SubHeader.Action" />
</LinearLayout>