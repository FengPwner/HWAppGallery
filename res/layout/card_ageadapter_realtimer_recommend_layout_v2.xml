<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:tag="@string/bannerImage"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/card_container"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/main_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/title_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
                <LinearLayout
                    android:layout_gravity="start|center"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:layout_gravity="start|center"
                        android:id="@id/hiappbase_subheader_title_left"
                        android:tag="css/.title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/placeholder_for_layout"
                        android:maxLines="2"
                        style="@style/AppGallery.Widget.SubHeader.ListTitle" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center"
                android:orientation="horizontal"
                android:id="@id/hiappbase_subheader_install_all_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical"
                android:contentDescription="@string/wisedist_app_install_all"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textColor="@color/hwbutton_selector_text_normal_emui"
                    android:id="@id/install_all_button_title"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/wisedist_youmaylikecard_icon_width"
                    android:text="@string/wisedist_app_install_all"
                    style="@style/AppGallery.Widget.SubHeader.ListTitle" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/realtimer_card_container_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_default_padding_end"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@id/hiappbase_subheader_more_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
                android:contentDescription="@string/youmaylike_refresh">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/refresh_button_icon"
                    android:tag="css/.widget"
                    android:layout_width="@dimen/wisedist_youmaylikecard_icon_width"
                    android:layout_height="@dimen/wisedist_youmaylikecard_icon_width"
                    android:src="@drawable/ic_change_v2"
                    android:contentDescription="@string/youmaylike_refresh"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:id="@id/refresh_button_title"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/wisedist_youmaylikecard_icon_width"
                    android:text="@string/youmaylike_refresh"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
                <com.huawei.uikit.phone.hwprogressbar.widget.HwProgressBar
                    android:layout_gravity="center"
                    android:id="@id/refresh_button_loading"
                    android:visibility="gone"
                    android:layout_width="@dimen/wisedist_youmaylikecard_icon_width"
                    android:layout_height="@dimen/wisedist_youmaylikecard_icon_width"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                    style="@style/Widget.Emui.HwProgressBar" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_button2"
                    android:textColor="?android:textColorSecondary"
                    android:id="@id/refresh_loading_title"
                    android:tag="css/.title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/wisedist_youmaylikecard_icon_width"
                    android:text="@string/str_loading_prompt"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>