<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/appgallery_default_card_space_vertical"
        android:paddingBottom="@dimen/appgallery_default_card_space_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
            android:id="@id/appIcon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:scaleType="fitCenter"
            app:corner_radius="@dimen/appgallery_large_icon_default_corner_radius" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/appName"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:ellipsize="end"
            android:id="@id/cacelAuthBtn"
            android:layout_width="wrap_content"
            android:layout_height="28.0dip"
            android:maxWidth="90.0dip"
            android:text="@string/cancel_game_service_button"
            android:maxLines="1"
            app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
            app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
            style="@style/AppGallery.Widget.Button.Small" />
    </LinearLayout>
    <ImageView
        android:id="@id/authapp_item_divider"
        android:tag="divider"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/appgallery_list_height_two_text_lines_with_icon"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>