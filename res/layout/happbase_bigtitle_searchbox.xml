<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/hiappbase_big_title_layout_id"
        android:clipChildren="false"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip">
        <com.huawei.appgallery.foundation.ui.framework.cardframe.widget.AgHwIconSubTabWidget
            android:id="@id/hiappbase_tablayout_id"
            android:background="@color/appgallery_color_subtab_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8.0dip"
            android:layout_alignParentStart="true"
            app:hwSubTabIndicatorHeight="0.0dip"
            style="@style/Widget.Emui.HwSubTabBar.Headline" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_headline7"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/hiappbase_bigtitle_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
            android:layout_alignParentStart="true" />
        <ImageView
            android:id="@id/hiappbase_bigtitle_enhance_id"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
            android:layout_alignParentStart="true" />
        <LinearLayout
            android:id="@id/hiappbase_appbar_channel_ic_id"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/hwsubtab_icon_margin_bottom"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/hiappbase_more_channels_title"
            android:layout_toStartOf="@id/hiappbase_app_bar_container">
            <ImageView
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="8.0dip"
                android:src="@drawable/aguikit_ic_public_appbar_more"
                android:layout_marginStart="8.0dip"
                android:layout_marginEnd="8.0dip" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/hiappbase_appbar_wish_ic_id"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/hwsubtab_icon_margin_bottom"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/hiappbase_wish_activity_title"
            android:layout_toStartOf="@id/hiappbase_app_bar_container">
            <ImageView
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="8.0dip"
                android:src="@drawable/ic_wish_appbar"
                android:layout_marginStart="8.0dip"
                android:layout_marginEnd="8.0dip" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/forum_msg_img_layout"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="gone"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_marginBottom="@dimen/hwsubtab_icon_margin_bottom"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@id/hiappbase_app_bar_container"
            android:transitionGroup="false">
            <RelativeLayout
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_centerInParent="true"
                android:transitionGroup="false">
                <ImageView
                    android:id="@id/forum_msg_img"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip" />
            </RelativeLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_caption_fixed"
                android:textColor="@color/appgallery_text_color_primary_inverse"
                android:gravity="center"
                android:id="@id/msg_text"
                android:background="@drawable/hiappbase_bigtitle_clicked_corner_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16.0dip"
                android:layout_marginTop="6.0dip"
                android:minWidth="16.0dip"
                android:maxLines="1"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip"
                android:layout_marginStart="15.0dip"
                app:hwAutoSizeMinTextSize="9.0dip"
                app:hwAutoSizeStepGranularity="1.0dip" />
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/hiappbase_app_bar_container"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4.0dip"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:id="@id/hiappbase_app_bar_search_id"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/hiappbase_search_btn">
                <ImageView
                    android:id="@id/hiappbase_app_bar_search_icon_id"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:layout_marginTop="12.0dip"
                    android:layout_marginBottom="12.0dip"
                    android:src="@drawable/aguikit_ic_public_search"
                    android:layout_marginStart="12.0dip"
                    android:layout_marginEnd="12.0dip" />
            </LinearLayout>
            <LinearLayout
                android:id="@id/hiappbase_app_bar_game_id"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/hiappbase_app_bar_game_icon_id"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:layout_marginTop="12.0dip"
                    android:layout_marginBottom="12.0dip"
                    android:src="@drawable/ic_scan_ic_scan"
                    android:layout_marginStart="12.0dip"
                    android:layout_marginEnd="12.0dip" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/hiappbase_search_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_column_system_content_margin"
        android:paddingEnd="@dimen/appgallery_column_system_content_margin" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/hiappbase_app_bar_game_id1"
        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/hiappbase_app_bar_game_icon_id1"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:layout_marginTop="12.0dip"
            android:layout_marginBottom="12.0dip"
            android:src="@drawable/ic_scan_ic_scan"
            android:layout_marginStart="12.0dip"
            android:layout_marginEnd="12.0dip" />
    </LinearLayout>
</LinearLayout>