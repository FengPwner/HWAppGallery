<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="horizontal"
    android:id="@id/card_follow_user_root_view"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_card_height_three_text_lines"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.forum.cards.widget.UserHeadImageView
        android:gravity="start|center"
        android:id="@id/follow_user_card_user_icon"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:src="@drawable/placeholder_base_account_header"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:contentDescription="@string/hiappbase_user_avatar"
        android:layout_marginEnd="@dimen/margin_l"
        android:layout_alignParentStart="true" />
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:gravity="center"
        android:id="@id/card_follow_btn_follow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64.0dip"
        android:minHeight="28.0dip"
        android:text="@string/forum_operation_unfollow"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
        app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
        style="@style/AppGallery.Widget.Button.Small" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/card_follow_user_info_layout"
        android:paddingTop="@dimen/padding_m"
        android:paddingBottom="@dimen/padding_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
        android:layout_toStartOf="@id/card_follow_btn_follow"
        android:layout_toEndOf="@id/follow_user_card_user_icon">
        <com.huawei.appgallery.forum.cards.widget.UserInfoTextView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/card_follow_userinfo"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:ellipsize="end"
            android:id="@id/user_follow_followers_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        <TextView
            android:ellipsize="end"
            android:id="@id/user_follow_section_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
    </LinearLayout>
    <View
        android:id="@id/follow_devider_line_bottom"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="56.0dip"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>