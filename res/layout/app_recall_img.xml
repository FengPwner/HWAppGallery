<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/app_detail_recall_app_img"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="21:9"
        app:layout_constraintTop_toTopOf="parent" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="8.0dip"
        android:textColor="@color/emui_color_white_origin"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/prefixAppIntro"
        android:background="@drawable/substancelistcard_chip_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:minWidth="24.0dip"
        android:minHeight="14.0dip"
        android:maxLines="1"
        android:maxEms="9"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:paddingStart="8.0dip"
        android:paddingEnd="8.0dip"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/app_detail_recall_img_container"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="42:9"
        app:layout_constraintStart_toStartOf="parent">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/app_detail_recall_app_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
            app:layout_constraintEnd_toStartOf="@id/dl_btn"
            app:layout_constraintStart_toEndOf="@id/app_detail_recall_app_icon"
            app:layout_constraintTop_toTopOf="@id/app_detail_recall_app_icon"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/app_detail_recall_app_desc"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
            app:layout_constraintBottom_toBottomOf="@id/app_detail_recall_app_icon"
            app:layout_constraintEnd_toStartOf="@id/dl_btn"
            app:layout_constraintStart_toEndOf="@id/app_detail_recall_app_icon"
            app:layout_constraintTop_toBottomOf="@id/app_detail_recall_app_name"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/app_detail_recall_app_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:corner_type="appicon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:round_type="all" />
        <com.huawei.appgallery.pageframe.view.DownloadButtonV2
            android:id="@id/dl_btn"
            android:layout_width="wrap_content"
            android:layout_height="28.0dip"
            android:maxWidth="90.0dip"
            android:minWidth="64.0dip"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="@id/app_detail_recall_app_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/app_detail_recall_app_icon"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>