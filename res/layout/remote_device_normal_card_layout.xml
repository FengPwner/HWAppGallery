<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/AppListItem"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:id="@id/appinfo_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="72.0dip"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/downbtn"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/appicon"
            app:layout_constraintTop_toTopOf="parent">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/ItemTitle"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1.0"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/info_watch_imageview"
                android:visibility="gone"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/aguikit_ic_public_watch"
                android:layout_marginStart="@dimen/margin_s" />
        </LinearLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="start|center"
            android:layout_gravity="start|center"
            android:id="@id/intro_down_count_text"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/downbtn"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/title_layout"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/memo"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:singleLine="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/downbtn"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/intro_down_count_text"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        <com.huawei.appgallery.remotedevice.api.download.RemoteDeviceInstallButton
            android:id="@id/downbtn"
            android:tag="css/.download-button"
            android:layout_width="wrap_content"
            android:layout_height="28.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
        <View
            android:id="@id/divider_line"
            android:tag="css/.split-line"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/appicon"
            style="@style/AppGallery.Widget.Divider" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>