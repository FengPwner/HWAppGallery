<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/inner_container"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_card_elements_margin_m">
            <RelativeLayout
                android:id="@id/forum_rank_number_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0dip"
                    android:gravity="center"
                    android:id="@id/forum_rank_withicon_textview"
                    android:tag="css/.title"
                    android:visibility="invisible"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_height"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                    android:layout_marginTop="13.0dip"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <com.huawei.appgallery.forum.cards.widget.NoFontPaddingTextView
                    android:textSize="14.0dip"
                    android:gravity="center|top"
                    android:id="@id/forum_rank_number_textview"
                    android:tag="css/.title"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.0dip"
                    android:minWidth="@dimen/appgallery_list_item_right_arrow_height"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            </RelativeLayout>
            <include
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                layout="@layout/forum_hotlist_card_content" />
        </LinearLayout>
        <include
            android:id="@id/forum_hostlist_bottom_view"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/forum_hotlist_bottom_linearlayout_height"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            layout="@layout/forum_hotlist_post_info_layout" />
    </LinearLayout>
</merge>