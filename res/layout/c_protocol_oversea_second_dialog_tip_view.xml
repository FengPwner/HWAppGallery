<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/internet_permission_layout"
    android:paddingTop="@dimen/appgallery_text_paragraph_margin_xs"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/oversea_agreement_image"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/ac_protocol_oversea_dot" />
        <TextView
            android:textSize="@dimen/res_textsize_13sp"
            android:textStyle="bold"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/oversea_agreement_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginStart="@dimen/ui_4_dp" />
    </LinearLayout>
    <TextView
        android:textSize="@dimen/res_textsize_10sp"
        android:textColor="@color/appgallery_text_color_secondary"
        android:id="@id/oversea_agreement_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:paddingStart="20.0dip" />
</LinearLayout>