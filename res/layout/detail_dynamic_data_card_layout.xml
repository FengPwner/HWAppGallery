<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="@dimen/component_detail_card_item_height_l"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwhorizontalscrollview.widget.HwHorizontalScrollView
        android:id="@id/horizontal_scrollview"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8.0dip"
            android:paddingBottom="8.0dip"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/component_detail_card_element_height_l"
            android:layout_marginBottom="12.0dip">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/ll_system_info"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_start">
                <com.huawei.uikit.hwimageview.widget.HwImageView
                    android:id="@id/iv_system_info"
                    android:layout_width="72.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@id/tv_system_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/detail_card_data_content_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/ll_device_info"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_start">
                <com.huawei.uikit.hwimageview.widget.HwImageView
                    android:id="@id/iv_device_info"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@id/tv_device_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/detail_card_data_content_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/ll_score_info"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="1.0"
                android:importantForAccessibility="yes"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_start">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@id/tv_data_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="2.0dip"
                        style="@style/detail_card_data_content" />
                    <com.huawei.appgallery.detail.detailbase.card.appdetaildatacard.RenderMidRatingBar
                        android:layout_gravity="center_vertical"
                        android:id="@id/ratingbar_detail_data_app_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/banner_bg_margin_16"
                        android:indeterminateOnly="false"
                        android:indeterminateDrawable="@drawable/ratingbar_mid"
                        android:progressDrawable="@drawable/ratingbar_mid"
                        android:numStars="5"
                        android:rating="0.0"
                        android:isIndicator="true"
                        android:importantForAccessibility="no"
                        style="@style/midRatingBar" />
                </LinearLayout>
                <TextView
                    android:id="@id/tv_detail_data_scoredBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    style="@style/detail_card_data_content_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/ll_downloads_info"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_start">
                <TextView
                    android:id="@id/tv_data_downloads_times"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/detail_card_data_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_data_install"
                    style="@style/detail_card_data_content_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/ll_min_age"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_start">
                <TextView
                    android:id="@id/tv_data_minAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/detail_card_data_content" />
                <TextView
                    android:id="@id/tv_data_minAge_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/detail_card_data_content_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/detail_safe_entrance_layout"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_weight="1.0"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_end">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/detail_data_safe_entrance_icon"
                        android:focusable="false"
                        android:visibility="gone"
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip" />
                    <TextView
                        android:id="@id/detail_data_safe_entrance_text_top"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_data_safe_entrance_top"
                        style="@style/detail_card_data_content" />
                </LinearLayout>
                <TextView
                    android:id="@id/detail_data_safe_entrance_text_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_data_safe_entrance_sub"
                    style="@style/detail_card_data_content_s" />
            </LinearLayout>
        </LinearLayout>
    </com.huawei.uikit.hwhorizontalscrollview.widget.HwHorizontalScrollView>
    <View
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_start"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>