<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center"
            android:id="@id/lefticon"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_marginStart="@dimen/margin_s"
            android:layout_marginEnd="@dimen/margin_s">
            <ImageView
                android:id="@id/up"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/aguikit_ic_public_cancel" />
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center"
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:id="@id/num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                style="@style/AppGallery.Widget.Toolbar.Title" />
        </LinearLayout>
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/righticon_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginEnd="@dimen/margin_s">
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/btn_delete"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                app:popupTitle="@string/appinstall_btn_uninstall">
                <ImageView
                    android:id="@id/iv_delete"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/aguikit_ic_public_delete" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/img_select_all"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                app:popupTitle="@string/appinstall_btn_selectall">
                <ImageView
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/aguikit_ic_public_select_all"
                    android:layout_marginStart="@dimen/margin_l"
                    android:layout_marginEnd="@dimen/margin_l" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/img_unselect_all"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:visibility="gone"
                android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                app:popupTitle="@string/appinstall_btn_unselectall">
                <ImageView
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/aguikit_ic_public_deselect_filled"
                    android:layout_marginStart="@dimen/margin_l"
                    android:layout_marginEnd="@dimen/margin_l" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/btn_install"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                app:popupTitle="@string/card_install_btn">
                <ImageView
                    android:id="@id/iv_install"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/aguikit_ic_install"
                    android:layout_marginStart="@dimen/margin_l"
                    android:layout_marginEnd="@dimen/margin_l" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
    </LinearLayout>
</LinearLayout>