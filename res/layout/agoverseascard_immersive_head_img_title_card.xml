<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/AppListItem"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minHeight="28.0dip"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/desc_layout"
        android:clickable="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:importantForAccessibility="yes">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@id/title_item"
            android:paddingTop="12.0dip"
            android:paddingBottom="24.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/content_sub_title"
                android:tag="css/.subtitle"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2.0dip"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/content_title"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.Title" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>