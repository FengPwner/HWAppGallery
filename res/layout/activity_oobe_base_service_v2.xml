<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/hwappbarpattern_title_item_layout" />
    <ScrollView
        android:id="@id/private_policy_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/webview_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@id/webview_progressbar"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="2.0dip"
                android:max="100"
                android:progressDrawable="@drawable/webview_progressbar"
                style="@android:style/Widget.ProgressBar.Horizontal" />
            <WebView
                android:id="@id/uri_webview"
                android:paddingLeft="18.0dip"
                android:paddingRight="18.0dip"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layerType="none"
                android:paddingStart="18.0dip"
                android:paddingEnd="18.0dip" />
            <WebView
                android:id="@id/wvTerms"
                android:paddingLeft="18.0dip"
                android:paddingRight="18.0dip"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layerType="none"
                android:paddingStart="18.0dip"
                android:paddingEnd="18.0dip" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>