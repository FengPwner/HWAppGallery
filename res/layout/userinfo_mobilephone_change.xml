<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_horizontal"
    android:background="@color/appgallery_color_sub_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/check_box_prize_collect_tips"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:id="@id/userinfo_mobilephone_layout"
            android:background="@drawable/aguikit_card_panel_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:textColorHint="@color/appgallery_text_color_hint"
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/mobile_phone_number"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="50"
                android:layout_centerVertical="true"
                android:inputType="phone"
                android:textCursorDrawable="@drawable/ic_cursor"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart"
                android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s"
                style="@style/Widget.Emui.HwEditText.Space" />
        </RelativeLayout>
    </ScrollView>
    <com.huawei.uikit.phone.hwcheckbox.widget.HwCheckBox
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_text_color_primary"
        android:gravity="top"
        android:id="@id/check_box_prize_collect_tips"
        android:paddingTop="2.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
        android:text="@string/settings_prize_collect_num_tips"
        android:includeFontPadding="false"
        android:layout_above="@id/change_submit_btn"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:paddingStart="@dimen/padding_m"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/Widget.Emui.HwCheckBox.Normal" />
    <com.huawei.appgallery.foundation.ui.framework.widget.BottomButton
        android:id="@id/change_submit_btn"
        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
        android:text="@string/detail_comment_submit"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwAutoSizeMinTextSize="9.0sp"
        app:hwAutoSizeStepGranularity="1.0sp"
        style="@style/AppGallery.Widget.Button.BottomButton" />
</RelativeLayout>