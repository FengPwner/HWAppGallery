<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/AppListItem"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/campaign_section_container"
        android:paddingBottom="1.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <ImageView
            android:id="@id/icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
            android:src="@drawable/bg_perch_icon"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/middle_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/icon">
            <RelativeLayout
                android:id="@id/right_middle_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/ItemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:layout_toStartOf="@id/arrow_img"
                    android:layout_alignParentStart="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <ImageView
                    android:id="@id/arrow_img"
                    android:layout_width="12.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_public_arrow_right_900"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView
                android:ellipsize="end"
                android:id="@id/ItemText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:maxLines="1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@id/bootom_line"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>