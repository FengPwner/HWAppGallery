<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:tag="@string/bannerImage"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_top_margin_default"
        android:layout_marginBottom="@dimen/appgallery_card_bottom_margin_default"
        android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
        android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l">
        <ViewStub
            android:id="@id/appList_ItemTitle_layout"
            android:layout="@layout/wisedist_layout_subheader_titlev3_more"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <ViewStub
            android:id="@id/bubble_viewstub"
            android:layout="@layout/wisedist_layout_horizon_bubble"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
            android:id="@id/AppListItem"
            android:scrollbars="none"
            android:clipChildren="false"
