<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/appList_ItemTitle_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/subheader_viewgroup_style">
        <TextView
            android:ellipsize="end"
            android:id="@id/ranking_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/subheader_title_style" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/more_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
            <TextView
                android:textSize="@dimen/emui_master_body_2"
                android:textColor="@color/emui_functional_blue"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/ranking_login"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gift_login_show_player_level"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <TextView
                android:textSize="@dimen/emui_master_body_2"
                android:textColor="@color/emui_functional_blue"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/ranking_link"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gift_forum_rank_list"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>