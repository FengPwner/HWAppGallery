<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/head_big_imageview"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="centerCrop"
        app:corner_radius="@dimen/appgallery_default_corner_radius_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_type="all"
        app:touch_drawable="@drawable/wisedist_substancelistcard_stoke_corner_radius_l" />
    <TextView
        android:textSize="8.0dip"
        android:textColor="@color/emui_color_white_origin"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/head_desc_textview"
        android:background="@drawable/substancelistcard_chip_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:minWidth="24.0dip"
        android:minHeight="14.0dip"
        android:maxLines="1"
        android:maxEms="9"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:paddingStart="@dimen/padding_m"
        android:paddingEnd="@dimen/padding_m"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:id="@id/head_title_layout"
        android:background="@color/emui_color_gray_1"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:clip_background="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/app_zone_layout"
        app:round_corner_bottom_left="@dimen/appgallery_default_corner_radius_l"
        app:round_corner_bottom_right="@dimen/appgallery_default_corner_radius_l"
        app:stroke_width="0.0dip" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/app_zone_layout"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@id/margin_view"
            android:background="@color/transparent"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/margin_m" />
        <TextView
            android:ellipsize="end"
            android:id="@id/head_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/fixed_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@id/promotion_sign"
                android:background="@drawable/promotion_sign_bg"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/promotion_sign_style" />
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/head_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>