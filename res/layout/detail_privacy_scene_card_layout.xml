<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/linear_scene_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        style="@style/AppGallery.Widget.SubHeader.ViewGroup">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/txt_privacy_scene_card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            style="@style/AppGallery.Widget.SubHeader.Title" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/recycler_privacy_scene_card_items"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:numColumns="1"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
</LinearLayout>