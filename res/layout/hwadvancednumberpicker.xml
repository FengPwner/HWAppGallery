<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <View
            android:id="@id/hwadvancednumberpicker_increment"
            android:background="#00ffffff"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:maxHeight="72.0dip"
            android:layout_weight="1.0"
            android:contentDescription="increase" />
        <View
            android:id="@id/hwadvancednumberpicker_textview"
            android:background="@drawable/hwadvancednumberpicker_state_middle_selector"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:layout_marginLeft="@dimen/hwadvancednumberpicker_selected_view_margin_horizontal"
            android:layout_marginTop="@dimen/hwadvancednumberpicker_selected_view_margin_vertical"
            android:layout_marginRight="@dimen/hwadvancednumberpicker_selected_view_margin_horizontal"
            android:layout_marginBottom="@dimen/hwadvancednumberpicker_selected_view_margin_vertical" />
        <View
            android:id="@id/hwadvancednumberpicker_decrement"
            android:background="#00ffffff"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:maxHeight="72.0dip"
            android:layout_weight="1.0"
            android:contentDescription="decrease" />
    </LinearLayout>
    <TextView
        android:textSize="22.0dip"
        android:gravity="center_horizontal"
        android:id="@id/hwadvancednumberpicker_input"
        android:background="@null"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/hwadvancednumberpicker_input_high" />
</merge>