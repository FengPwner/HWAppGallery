<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/report_title"
        layout="@layout/forum_operation_report_title_layout" />
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/forum_report_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="56.0dip"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_end">
                <ImageView
                    android:id="@id/forum_report_user_icon"
                    android:background="@android:color/transparent"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:src="@drawable/placeholder_base_account_header"
                    android:scaleType="centerCrop" />
                <TextView
                    android:id="@id/forum_report_user_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                    android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_vertical_l"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
            </LinearLayout>
            <com.huawei.appgallery.forum.cards.widget.FoldTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/forum_report_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart"
                android:paddingStart="72.0dip"
                android:paddingEnd="@dimen/appgallery_max_padding_end" />
            <RelativeLayout
                android:id="@id/forum_report_images_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                android:paddingStart="72.0dip"
                android:paddingEnd="@dimen/appgallery_max_padding_end">
                <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                    android:id="@id/forum_report_img_single"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/forum_report_small_images_container"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                        android:id="@id/forum_report_small_image_left"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:layout_weight="1.0"
                        app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
                    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                        android:id="@id/forum_report_small_image_mid"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:layout_weight="1.0"
                        android:layout_marginStart="@dimen/margin_xs"
                        app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
                    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                        android:id="@id/forum_report_small_image_right"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:layout_weight="1.0"
                        android:layout_marginStart="@dimen/margin_xs"
                        app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
                </LinearLayout>
            </RelativeLayout>
            <include
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                layout="@layout/hiappbase_layout_subheader_spliter" />
            <include
                android:id="@id/subTitle"
                layout="@layout/hiappbase_layout_subheader_list_title_action" />
            <com.huawei.appgallery.forum.operation.report.view.widget.NoScrollListView
                android:id="@id/report_type_list"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:divider="@null" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>