<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/aguikit_subheader_title_description" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_options"
        android:paddingTop="8.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/forum_divider_roting_option"
        android:showDividers="middle" />
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@id/container_add"
        android:background="@drawable/forum_vote_opption_add_bg"
        android:paddingLeft="12.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="12.0dip"
        android:paddingBottom="8.0dip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_marginBottom="8.0dip">
        <ImageView
            android:id="@id/iv_add"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/forum_ic_public_add" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_primary_activated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forum_vote_add_option"
            android:textAllCaps="true"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textAlignment="viewStart"
            android:layout_marginStart="4.0dip" />
    </LinearLayout>
</merge>