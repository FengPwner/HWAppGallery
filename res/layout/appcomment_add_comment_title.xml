<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
    android:gravity="start|center"
    android:orientation="horizontal"
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:id="@id/add_comment_title_back"
        android:background="@drawable/hwappbarpattern_selector_item_bg"
        android:clickable="true"
        android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_height"
        android:contentDescription="@string/click_back"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="4.0dip">
        <ImageView
            android:id="@id/up"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/aguikit_ic_public_back" />
    </LinearLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:gravity="start|center"
        android:id="@id/add_comment_title_text"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:layout_weight="1.0"
        style="@style/AppGallery.Widget.Toolbar.Title" />
    <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
        android:gravity="center"
        android:id="@id/add_comment_icon_layout"
        android:background="@drawable/hwappbarpattern_selector_item_bg"
        android:clickable="true"
        android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
        android:contentDescription="@string/appcomment_comment_submit"
        android:layout_marginEnd="@dimen/margin_s"
        app:popupTitle="@string/appcomment_activity_title">
        <ImageView
            android:id="@id/add_comment_icon"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/aguikit_ic_public_email_send" />
    </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
</com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>