<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/download_manager_item_main_layout"
    android:tag="layout/webview_lite_external_download_list_item_0"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_card_height_two_text_lines">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/download_manager_item_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:src="@drawable/webview_lite_ic_download_manager_app_default"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/download_manager_item_info_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            android:layout_toEndOf="@id/download_manager_item_icon">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/download_manager_item_middle_layout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:ellipsize="middle"
                    android:id="@id/download_task_item_name"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <TextView
                        android:textStyle="normal"
                        android:id="@id/download_task_item_size"
                        android:tag="binding_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@id/download_task_item_date"
                        android:tag="binding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_marginStart="@dimen/margin_m"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.appgallery.webviewlite.dldmgr.view.ExternalDownloadManagerButton
                    android:id="@id/download_task_action_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28.0dip"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    style="@style/AppGallery.Widget.DownloadButton.Normal" />
            </RelativeLayout>
        </LinearLayout>
        <ImageView
            android:id="@id/app_installed_split_line"
            android:tag="binding_4"
            android:layout_width="fill_parent"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            android:layout_alignStart="@id/download_manager_item_info_layout"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
</LinearLayout>