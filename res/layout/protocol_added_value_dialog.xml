<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/tv_value_added_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hiapp_value_added_dialog_desc"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/tv_recommend_title"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:text="@string/hiapp_value_added_dialog_recommend_title"
                        style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/tv_recommend_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        android:text="@string/hiapp_value_added_dialog_recommend_switch_desc"
                        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                </LinearLayout>
                <com.huawei.uikit.hwswitch.widget.HwSwitch
                    android:layout_gravity="center_vertical"
                    android:id="@id/switch_recommand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    style="@style/Widget.Emui.HwSwitch" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/tv_recommend_ad_title"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:text="@string/hiapp_value_added_dialog_recommend_ad_title"
                        style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/tv_recommend_ad_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        android:text="@string/hiapp_value_added_dialog_recommend_ad_switch_desc"
                        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                </LinearLayout>
                <com.huawei.uikit.hwswitch.widget.HwSwitch
                    android:layout_gravity="center_vertical"
                    android:id="@id/switch_ad_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    style="@style/Widget.Emui.HwSwitch" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>