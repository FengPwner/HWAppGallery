<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appgallery.wishlist.widget.WishLinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="48.0dip">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:padding="4.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/wishlist_wish_add_star"
                android:layout_marginEnd="@dimen/margin_s" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/wishlist_textview_appname_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@id/wishlist_textview_wish_app_name_layout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
        <com.huawei.uikit.hwedittext.widget.HwEditText
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_primary"
            android:textColorHint="@color/appgallery_text_color_hint"
            android:layout_gravity="center"
            android:id="@id/wishlist_textview_wish_app_name"
            android:background="@drawable/wish_add_et_selector"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
            android:hint="@string/wishlist_wish_input_appname"
            android:maxLength="48"
            android:inputType="text"
            android:imeOptions="flagNoFullscreen"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textDirection="locale"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/Widget.Emui.HwEditText.Space" />
    </FrameLayout>
</com.huawei.appgallery.wishlist.widget.WishLinearLayout>