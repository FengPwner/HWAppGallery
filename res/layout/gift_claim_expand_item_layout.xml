<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/vertical_gift_item_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l">
        <ImageView
            android:id="@id/gifts_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:src="@drawable/bg_perch_icon"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
        <RelativeLayout
            android:id="@id/gifts_right_middle_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/gifts_icon"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/gifts_icon">
            <com.huawei.appmarket.service.gift.widget.GiftDownloadButton
                android:id="@id/gifts_btn"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:maxWidth="90.0dip"
                android:minWidth="64.0dip"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/right_top_layout"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_toStartOf="@id/gifts_btn">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/gifts_title_text"
                    android:tag="css/.title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/gifts_stock_show"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gift_stock_show"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/gifts_level_show"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gift_level_show"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="@dimen/appgallery_text_margin_horizontal"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@id/detail_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/vertical_gift_item_container">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_fold_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:id="@id/gifts_code"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:minHeight="24.0dip"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="center" />
            <com.huawei.appmarket.service.gift.widget.EndSpaceTextView
                android:id="@id/gifts_describe"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_expand_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:id="@id/gifts_code_expand"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:minHeight="24.0dip"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="center" />
            <TextView
                android:id="@id/gifts_describe_expand"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="start"
                android:id="@id/gifts_usage_title"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
                android:text="@string/gift_usage"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart" />
            <com.huawei.appmarket.service.gift.widget.EndSpaceTextView
                android:id="@id/gifts_usage"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="start"
                android:id="@id/gifts_time_title"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
                android:text="@string/gift_expiration_date_title"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart" />
            <com.huawei.appmarket.service.gift.widget.EndSpaceTextView
                android:id="@id/gifts_time"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
        <com.huawei.appmarket.framework.widget.ArrowImageView
            android:layout_gravity="end|bottom|center"
            android:id="@id/gifts_describe_arrow"
            android:tag="css/.arrow"
            android:background="@drawable/ic_public_arrow_down_900"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l" />
    </FrameLayout>
    <View
        android:layout_gravity="center_vertical"
        android:id="@id/devider_line"
        android:tag="css/.split-line"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>