<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:layout_gravity="center_vertical"
        android:id="@id/spotlight_module_img"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:scaleX="-1.0"
        app:corner_radius="@dimen/appgallery_default_corner_radius_l"
        app:round_type="all"
        app:touch_drawable="@drawable/hiappbase_line_image_selector_stoke_corner_radius_l" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/spotlight_module_title_container_ll"
        android:paddingTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:paddingStart="@dimen/appgallery_card_elements_margin_l">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="18.0dip"
            android:ellipsize="end"
            android:id="@id/spotlight_module_title_tv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textAlignment="viewStart" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body3_fixed"
            android:ellipsize="end"
            android:id="@id/spotlight_module_subtitle_tv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textAlignment="viewStart" />
        <com.huawei.appgallery.pageframe.view.DownloadButtonV2
            android:id="@id/spotlight_module_down_btn"
            android:layout_width="60.0dip"
            android:layout_height="28.0dip"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:textSize="@dimen/appgallery_text_size_button2"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/spotlight_module_more_btn"
            android:background="@drawable/ic_button_tran_normal"
            android:paddingTop="0.0dip"
            android:paddingBottom="0.0dip"
            android:layout_width="60.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
            android:text="@string/card_more_btn"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
            app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
            style="@style/Widget.Emui.HwButton.Small" />
    </LinearLayout>
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_caption_fixed"
        android:textColor="#ffffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/spotlight_module_topic_tv"
        android:background="@drawable/hiapp_spotlight_module_card_topic_bg"
        android:paddingLeft="8.0dip"
        android:paddingRight="8.0dip"
        android:layout_width="wrap_content"
        android:layout_height="20.0dip"
        android:layout_marginTop="@dimen/appgallery_safety_margin_l"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_alignEnd="@id/spotlight_module_img" />
</RelativeLayout>