<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/country_name_and_phone_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48.0dip"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/emui_dimens_element_horizontal_large">
        <LinearLayout
            android:id="@id/country_name_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/emui_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="start|center"
                android:layout_gravity="center_vertical"
                android:id="@id/country_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="Country name"
                android:layout_weight="1.0"
                android:textAlignment="viewStart" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/country_choose_status"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/aguikit_ic_public_ok"
                android:tint="@color/emui_color_primary" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:layout_below="@id/country_name_container">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/plus_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_centerVertical="true"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/country_phone_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Country phone code"
                android:layout_centerVertical="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_toEndOf="@id/plus_flag" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:id="@id/phone_line"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <include
            layout="@layout/hwsubheader_spliter" />
    </LinearLayout>
</LinearLayout>