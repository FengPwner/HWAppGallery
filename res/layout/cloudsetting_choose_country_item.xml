<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@id/phone_line"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/emui_color_subheader_divider"
            android:layout_width="fill_parent"
            android:layout_height="8.0dip" />
    </LinearLayout>
    <include
        android:id="@id/cloudsetting_choose_country_head_layout"
        android:visibility="gone"
        layout="@layout/cloudsetting_choose_country_head_item" />
    <RelativeLayout
        android:id="@id/choose_country_phone_content"
        android:background="@drawable/list_item_all_selector"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/appgallery_max_padding_end"
        android:minHeight="48.0dip"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <ImageView
            android:id="@id/country_choose_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/emui_dimens_element_horizontal_middle"
            android:src="@drawable/aguikit_ic_public_ok"
            android:tint="@color/emui_color_primary"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/emui_dimens_element_horizontal_middle"
            android:layout_alignParentEnd="true" />
        <RelativeLayout
            android:id="@id/country_name_and_phone_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/appgallery_max_padding_start"
            android:layout_marginRight="@dimen/emui_dimens_element_horizontal_large"
            android:minHeight="48.0dip"
            android:layout_toLeftOf="@id/country_choose_status"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/emui_dimens_element_horizontal_large"
            android:layout_toStartOf="@id/country_choose_status"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/emui_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/country_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Country name"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/plus_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:text="+"
                android:layout_toRightOf="@id/country_name"
                android:layout_centerVertical="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="16.0dip"
                android:layout_toEndOf="@id/country_name" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/country_phone_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Country phone code"
                android:layout_toRightOf="@id/plus_flag"
                android:layout_centerVertical="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_toEndOf="@id/plus_flag" />
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>