<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/search_app_shrink_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/search_app_shrink_title_layout"
        android:background="@drawable/list_item_all_selector"
        android:paddingTop="@dimen/appgallery_card_elements_margin_s"
        android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start|center"
            android:id="@id/shrink_container_imageview"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip" />
        <TextView
            android:ellipsize="end"
            android:gravity="start|center"
            android:layout_gravity="center_vertical"
            android:id="@id/shrink_container_title_textview"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1.0"
            android:importantForAccessibility="yes"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
            android:layout_marginEnd="@dimen/margin_xs"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary.Medium" />
        <ImageView
            android:layout_gravity="end|center"
            android:id="@id/shrink_container_switch_view"
            android:background="@drawable/ic_public_arrow_down_900"
            android:clickable="false"
            android:layout_width="@dimen/ui_24_dp"
            android:layout_height="@dimen/ui_12_dp"
            android:importantForAccessibility="yes" />
    </LinearLayout>
    <ViewStub
        android:id="@id/search_app_shrink_content_container"
        android:layout="@layout/search_app_shrink_content_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_below="@id/search_app_shrink_title_layout" />
    <View
        android:id="@id/shrink_container_divider"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>