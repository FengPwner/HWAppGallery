<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appgallery.detail.detailbase.common.RenderToggleButton
        android:textSize="@dimen/appgallery_text_size_caption_fixed"
        android:textColor="@color/appgallery_text_color_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/toggle_item"
        android:background="@drawable/detail_round_corner_button_shape"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/appgallery_card_icon_size_xs"
        android:minHeight="@dimen/appgallery_card_elements_margin_l"
        android:maxLines="1"
        android:textAllCaps="false"
        android:fontFamily="@string/emui_text_font_family_regular"
        android:paddingStart="@dimen/appgallery_card_elements_margin_m"
        android:paddingEnd="@dimen/appgallery_card_elements_margin_m" />
</LinearLayout>