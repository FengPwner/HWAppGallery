<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/forum_section_bottom_operation" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/operation_layout"
        android:layout_alignParentStart="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/forum_feed_post_bottom_section_icon"
            android:visibility="gone"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginEnd="@dimen/margin_s" />
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/forum_feed_post_bottom_user_icon"
            android:visibility="gone"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginEnd="@dimen/margin_s" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/forum_section_post_read_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingMultiplier="1.2"
            style="@style/AppGallery.TextAppearance.Card.TextBody4.Tertiary" />
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/forum_section_post_bottom_user_flag"
            android:visibility="gone"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginStart="@dimen/margin_s" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/forum_section_post_time_bottom"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_vertical_m"
            style="@style/AppGallery.TextAppearance.Card.TextBody4.Tertiary" />
    </LinearLayout>
</RelativeLayout>