<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@id/errorIcon"
        android:src="@drawable/ic_no_wifi_disable"
        android:scaleType="centerCrop"
        style="@style/AppGallery.ImageSize.NoData" />
    <TextView
        android:id="@id/errorTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_loading_prompt"
        android:importantForAccessibility="yes"
        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
</LinearLayout>