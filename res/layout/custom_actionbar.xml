<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/tab_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/status_bar"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <RelativeLayout
        android:id="@id/tabContainer"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_hwtoolbar_height">
        <RelativeLayout
            android:gravity="center"
            android:id="@id/close_icon"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:visibility="visible"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_height"
            android:layout_centerVertical="true"
            android:contentDescription="@string/click_back"
            android:layout_marginStart="@dimen/margin_s"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@id/close_imageview"
                android:tag="css/.widget"
                android:background="@drawable/aguikit_ic_public_back"
                android:visibility="visible"
                android:layout_width="@dimen/search_icon_landscape_width"
                android:layout_height="@dimen/search_icon_landscape_width"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
            android:orientation="horizontal"
            android:id="@id/right_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/menu_extend_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_marginEnd="@dimen/ui_12_dp" />
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/share_icon"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:visibility="visible"
                android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                android:contentDescription="@string/share_friend_title"
                app:popupDrawable="@drawable/aguikit_ic_public_share"
                app:popupTitle="@string/share_friend_title">
                <ImageView
                    android:id="@id/share_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_share"
                    android:layout_width="@dimen/search_icon_landscape_width"
                    android:layout_height="@dimen/search_icon_landscape_width" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/subscribe_icon"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:visibility="visible"
                android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                android:contentDescription="@string/subscribe_title"
                app:popupDrawable="@drawable/ic_appabr_subscription"
                app:popupTitle="@string/subscribe_title">
                <ImageView
                    android:id="@id/subscribe_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/ic_appabr_subscription"
                    android:layout_width="@dimen/search_icon_landscape_width"
                    android:layout_height="@dimen/search_icon_landscape_width" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/search_icon"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:visibility="visible"
                android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                android:contentDescription="@string/title_activity_search"
                app:popupDrawable="@drawable/aguikit_ic_public_search"
                app:popupTitle="@string/title_activity_search">
                <com.huawei.appmarket.framework.widget.CssImageView
                    android:id="@id/search_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_search"
                    android:layout_width="@dimen/search_icon_landscape_width"
                    android:layout_height="@dimen/search_icon_landscape_width" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                android:gravity="center"
                android:id="@id/collapse_menu"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:visibility="gone"
                android:layout_width="36.0dip"
                android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
                android:contentDescription="@string/card_more_btn"
                app:popupDrawable="@drawable/aguikit_ic_public_more"
                app:popupTitle="@string/card_more_btn">
                <com.huawei.appmarket.framework.widget.CssImageView
                    android:id="@id/collapse_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_more"
                    android:layout_width="@dimen/ui_24_dp"
                    android:layout_height="@dimen/ui_24_dp" />
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@id/title_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/right_layout"
            android:layout_toEndOf="@id/close_icon">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:gravity="center_vertical"
                android:id="@id/title_textview"
                android:tag="css/.title"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_app_detail"
                android:alpha="0.0"
                android:layout_marginEnd="@dimen/margin_s"
                style="@style/AppGallery.Widget.Toolbar.Title" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>