<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/reply_relayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/user_relayout"
            android:paddingTop="@dimen/margin_m"
            android:paddingBottom="@dimen/margin_m"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_max_padding_start">
            <com.huawei.appgallery.appcomment.ui.view.HeadImageView
                android:id="@id/detail_comment_user_icon_imageview"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:src="@drawable/placeholder_base_account_header"
                android:contentDescription="@string/hiappbase_user_avatar"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_alignParentStart="true" />
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/reply_menu_layout"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_middle"
                android:contentDescription="@string/card_more_btn"
                android:layout_alignParentEnd="true">
                <com.huawei.appgallery.appcomment.ui.view.FavoriteImageView
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_more_list"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="centerCrop" />
            </LinearLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@id/user_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appcomment_8_dp"
                android:layout_below="@id/detail_comment_user_icon_imageview"
                android:layout_marginEnd="@dimen/appcomment_16_dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/reply_info_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/reply_nick_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/appgallery_text_margin_vertical">
                        <TextView
                            android:ellipsize="end"
                            android:gravity="start|center"
                            android:id="@id/detail_comment_user_textview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:singleLine="true"
                            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                        <TextView
                            android:textSize="@dimen/appcomment_8_dp"
                            android:textColor="@color/emui_accent"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@id/detail_comment_user_role_textview"
                            android:background="@drawable/appcomment_comment_label_bg"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/appcomment_14_dp"
                            android:singleLine="true"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            android:paddingStart="@dimen/margin_m"
                            android:paddingEnd="@dimen/margin_m"
                            android:layout_marginStart="@dimen/appgallery_card_elements_margin_xs" />
                        <ImageView
                            android:id="@id/reply_divider_icon"
                            android:tag="css/.widget"
                            android:background="@drawable/appcomment_comment_reply"
                            android:layout_width="@dimen/appcomment_16_dp"
                            android:layout_height="@dimen/appcomment_16_dp"
                            android:layout_marginLeft="@dimen/appgallery_card_elements_margin_xs"
                            android:layout_marginRight="@dimen/appgallery_card_elements_margin_xs"
                            android:scaleType="centerCrop" />
                        <TextView
                            android:ellipsize="end"
                            android:gravity="start|center"
                            android:id="@id/detail_reply_user_textview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:singleLine="true"
                            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                    </LinearLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:gravity="center_vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appcomment_8_dp">
                        <TextView
                            android:ellipsize="end"
                            android:gravity="start|center"
                            android:id="@id/detail_comment_user_client_textview"
                            android:tag="css/.subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                        <TextView
                            android:ellipsize="end"
                            android:gravity="end|center"
                            android:id="@id/detail_comment_time_textview"
                            android:tag="css/.title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:singleLine="true"
                            android:layout_centerVertical="true"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/detail_comment_user_client_textview"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                        <TextView
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@id/detail_comment_ip_textview"
                            android:tag="css/.subtitle"
                            android:visibility="gone"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dip"
                            android:singleLine="true"
                            android:layout_centerVertical="true"
                            android:textAlignment="viewStart"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/detail_comment_time_textview"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
        <TextView
            android:id="@id/detail_comment_content_textview"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/user_relayout"
            android:lineSpacingMultiplier="1.1"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
        <include
            android:id="@id/appcomment_shield"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:layout_below="@id/detail_comment_content_textview"
            layout="@layout/appcomment_shield_layout" />
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@id/detail_reply_app_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appcomment_12_dp"
            android:minHeight="@dimen/appgallery_list_height_single_text_line"
            android:layout_below="@id/appcomment_shield"
            android:layout_marginStart="@dimen/appgallery_max_padding_end"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/detail_reply_link_layout"
                android:tag="css/.report-button"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="24.0dip"
                android:layout_alignParentTop="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="yes"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toStartOf="@id/detail_comment_add_reply_layout_linearlayout">
                <com.huawei.appgallery.appcomment.ui.view.ApproveImageView
                    android:id="@id/detail_reply_disagree_icon_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_thumbsup"
                    android:layout_width="@dimen/appcomment_16_dp"
                    android:layout_height="@dimen/appcomment_16_dp"
                    android:scaleType="centerCrop" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_caption_fixed"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_reply_disagree_counts_textview"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:importantForAccessibility="no"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="@dimen/margin_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_comment_add_reply_layout_linearlayout"
                android:tag="css/.report-button"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="24.0dip"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/detail_reply_reply_icon_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_comments"
                    android:layout_width="@dimen/appcomment_16_dp"
                    android:layout_height="@dimen/appcomment_16_dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/appcomment_reply" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_caption_fixed"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_comment_reply_button_textview"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="@dimen/margin_s" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>