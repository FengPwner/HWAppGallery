<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/appgallery_elements_margin_horizontal_m"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/forum_hotspot_icon_name_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/appgallery_elements_margin_horizontal_m">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/forum_hottopic_forumicon_imageview"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s"
            app:corner_type="appicon"
            app:round_type="all" />
        <TextView
            android:ellipsize="end"
            android:id="@id/forum_hottopic_forumname_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
        android:layout_gravity="center_vertical"
        android:paddingTop="@dimen/appgallery_elements_margin_horizontal_m"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:textColor="@color/appgallery_text_color_tertiary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@id/hottopic_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
        <LinearLayout
            android:gravity="start|center"
            android:orientation="horizontal"
            android:id="@id/forum_hotspot_forum_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/hottopic_authimg"
                android:layout_width="12.0dip"
                android:layout_height="12.0dip"
                android:layout_marginStart="@dimen/margin_xs" />
            <View
                android:id="@id/hottopic_first_dots"
                android:background="@drawable/forum_hotspot_dots_bg"
                android:layout_width="2.0dip"
                android:layout_height="2.0dip"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/appgallery_text_color_tertiary"
                android:id="@id/hottopic_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <View
                android:id="@id/hottopic_second_dots"
                android:background="@drawable/forum_hotspot_dots_bg"
                android:layout_width="2.0dip"
                android:layout_height="2.0dip"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/appgallery_text_color_tertiary"
                android:id="@id/hottopic_reply_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
</LinearLayout>