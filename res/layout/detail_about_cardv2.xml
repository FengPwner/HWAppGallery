<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_desc_layout_linearlayout"
    android:paddingBottom="@dimen/margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_about"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@id/subtitle"
            android:layout="@layout/detail_about_cardv2_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <ViewStub
            android:id="@id/ageadapter_subtitle"
            android:layout="@layout/hiappbase_layout_ageadapter_subheader_title_more"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_develop"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="start|center"
                android:id="@id/tv_develop"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:importantForAccessibility="yes"
                style="@style/detail_card_introduce_content" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/ll_link"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hiappbase_divider_height"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:layout_gravity="start|center"
            android:id="@id/tv_grade_desc"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="12.0dip"
            style="@style/detail_card_about_v2" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:layout_gravity="start|center"
            android:id="@id/tv_privacy_name"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="12.0dip"
            style="@style/detail_card_about_v2" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:layout_gravity="start|center"
            android:id="@id/tv_permission_name"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="12.0dip"
            style="@style/detail_card_about_v2" />
    </LinearLayout>
</LinearLayout>