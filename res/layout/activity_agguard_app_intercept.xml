<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tooltype="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/title"
        layout="@layout/agguard_title_with_delete_layout" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/agguard_app_intercept_empty"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@id/agguard_app_intercept_empty_icon"
            android:background="@drawable/agguard_app_intercept_empty"
            style="@style/AppGallery.ImageSize.NoData" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/agguard_app_intercept_empty_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:text="@string/agguard_app_intercept_empty"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.TextAppearance.NoData" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/agguard_app_intercept_content_layout"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:layout_above="@id/option_bottom_layout"
        android:layout_below="@id/title"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.uikit.phone.hwrecyclerview.widget.HwRecyclerView
            android:id="@id/agguard_app_intercept_recyclerView"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/option_bottom_layout"
        android:background="@color/appgallery_color_toolbar_bg"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_hwtoolbar_split_menu_height"
        android:layout_alignParentBottom="true">
        <com.huawei.appgallery.foundation.ui.framework.widget.toolbar.ToolBarIcon
            android:gravity="center"
            android:id="@id/agguard_app_intercept_delete"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            tooltype:tooltype="clean" />
    </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
</RelativeLayout>