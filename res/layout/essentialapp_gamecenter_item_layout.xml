<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@id/essentialapp_item_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/app_icon"
            android:layout_width="@dimen/item_icon_size"
            android:layout_height="@dimen/item_icon_size"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginEnd="@dimen/item_icon_margin_end" />
        <ImageView
            android:id="@id/gift_icon"
            android:visibility="gone"
            android:layout_width="@dimen/gamecenter_item_gift_icon_width"
            android:layout_height="@dimen/gamecenter_item_gift_icon_height"
            android:layout_marginTop="@dimen/margin_m"
            android:src="@drawable/gift"
            android:scaleType="fitStart" />
        <com.huawei.uikit.hwcheckbox.widget.HwCheckBox
            android:gravity="end|center|top"
            android:layout_gravity="end|center|top"
            android:id="@id/check_img"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Emui.CheckBox.IconSelect" />
    </FrameLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_body3"
        android:textColor="@color/appgallery_text_color_primary"
        android:ellipsize="end"
        android:id="@id/app_name"
        android:layout_width="@dimen/item_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:maxLines="2"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:layout_marginEnd="@dimen/item_icon_margin_end" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="@dimen/item_icon_size"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_icon_margin_end">
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/app_intro"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="@integer/horizonhomecard_intro_max_lines"
            android:includeFontPadding="false"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
    </LinearLayout>
</LinearLayout>