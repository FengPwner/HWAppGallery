<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/root_harmony_upgrade_card"
    android:background="@drawable/bg_card_harmony_upgrade"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.service.harmonyupgrade.HarmonyUpgradeGradientTextView
        android:textSize="@dimen/emui_text_size_headline4"
        android:textStyle="bold"
        android:textColor="@color/hiapp_harmony_upgrade_card_comment_middle_color"
        android:id="@id/tv_score_upgrades_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cs_4_dp"
        android:text="--"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/cs_12_dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body3_fixed"
        android:textStyle="bold"
        android:textColor="@color/hiapp_harmony_upgrade_card_score_character_color"
        android:gravity="center"
        android:id="@id/tv_score_character"
        android:background="@drawable/shape_score_character"
        android:layout_width="20.0dip"
        android:layout_height="20.0dip"
        android:layout_marginBottom="@dimen/cs_12_dp"
        android:text="分"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/cs_4_dp"
        app:layout_constraintBottom_toBottomOf="@id/tv_score_upgrades_points"
        app:layout_constraintStart_toEndOf="@id/tv_score_upgrades_points" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body3_fixed"
        android:textColor="@color/hiapp_harmony_upgrade_card_comment_middle_color"
        android:ellipsize="end"
        android:id="@id/tv_harmony_upgrade_card_title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginEnd="8.0dip"
        app:layout_constraintEnd_toStartOf="@id/btn_upgrade_immediately"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/tv_score_upgrades_points"
        app:layout_constraintTop_toBottomOf="@id/tv_score_upgrades_points" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body3_fixed"
        android:textColor="@color/hiapp_harmony_upgrade_card_comment_middle_color"
        android:ellipsize="end"
        android:id="@id/tv_harmony_upgrade_card_sub_title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cs_16_dp"
        android:maxLines="1"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginEnd="8.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_upgrade_immediately"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/tv_harmony_upgrade_card_title"
        app:layout_constraintTop_toBottomOf="@id/tv_harmony_upgrade_card_title" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/cs_14_dp"
        android:textColor="#e6000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/btn_upgrade_immediately"
        android:background="@drawable/bg_btn_harmony_card"
        android:layout_width="wrap_content"
        android:layout_height="28.0dip"
        android:text="@string/hiapp_exchange_new_device"
        android:maxLines="1"
        android:textAllCaps="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:paddingStart="8.0dip"
        android:paddingEnd="8.0dip"
        android:layout_marginEnd="12.0dip"
        app:layout_constraintBottom_toBottomOf="@id/tv_harmony_upgrade_card_sub_title"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>