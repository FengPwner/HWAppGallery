<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/app_detail_video_stub"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:contentDescription="@string/component_detail_accessibility_publicize_video"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/loading"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
            android:layout_width="40.0dip"
            android:layout_height="40.0dip" />
    </LinearLayout>
    <RelativeLayout
        android:id="@id/bottom"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:id="@id/port_control"
            android:layout_width="fill_parent"
            android:layout_height="80.0dip"
            android:layout_marginBottom="16.0dip"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/padding_l"
            android:paddingEnd="@dimen/padding_s">
            <ImageView
                android:id="@id/port_play"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/videokit_ic_public_play_big"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16.0dip"
                android:layout_alignParentStart="true" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/port_end_control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/port_mute"
                    android:padding="12.0dip"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:src="@drawable/aguikit_ic_public_sound_off" />
                <ImageView
                    android:id="@id/port_full_screen"
                    android:padding="12.0dip"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:src="@drawable/aguikit_ic_public_enlarge" />
            </LinearLayout>
            <com.huawei.uikit.hwseekbar.widget.HwSeekBar
                android:id="@id/port_seek"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:indeterminate="false"
                android:layout_centerVertical="true"
                android:contentDescription="@string/component_detail_accessibility_play_progress"
                android:layout_marginEnd="2.0dip"
                android:layout_toStartOf="@id/port_end_control"
                android:layout_toEndOf="@id/port_play"
                style="@style/Widget.Emui.HwSeekBar" />
            <RelativeLayout
                android:id="@id/port_time_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/component_detail_vedio_time_margin_bottom"
                android:layout_alignParentBottom="true"
                android:layout_alignStart="@id/port_seek"
                android:layout_alignEnd="@id/port_seek">
                <TextView
                    android:textSize="@dimen/emui_master_caption_2"
                    android:textColor="@android:color/white"
                    android:id="@id/port_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true" />
                <TextView
                    android:textSize="@dimen/emui_master_caption_2"
                    android:textColor="@android:color/white"
                    android:id="@id/port_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <ImageView
                android:id="@id/center_control"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_centerInParent="true" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/land_control"
            android:background="@drawable/ic_video_bg"
            android:visibility="invisible"
            android:layout_width="fill_parent"
            android:layout_height="80.0dip"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/padding_l"
            android:paddingEnd="@dimen/padding_s">
            <ImageView
                android:id="@id/land_play"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/ic_public_play_button"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16.0dip"
                android:layout_alignParentStart="true" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/land_end_control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/land_mute"
                    android:padding="12.0dip"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:src="@drawable/aguikit_ic_public_sound_off" />
                <ImageView
                    android:id="@id/land_full_screen"
                    android:padding="12.0dip"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:src="@drawable/aguikit_ic_public_enlarge" />
            </LinearLayout>
            <com.huawei.uikit.hwseekbar.widget.HwSeekBar
                android:id="@id/seek"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:indeterminate="false"
                android:layout_centerVertical="true"
                android:layout_marginEnd="2.0dip"
                android:layout_toStartOf="@id/land_end_control"
                android:layout_toEndOf="@id/land_play"
                style="@style/Widget.Emui.HwSeekBar" />
            <RelativeLayout
                android:id="@id/time_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/seek"
                android:layout_alignStart="@id/seek"
                android:layout_alignEnd="@id/seek">
                <TextView
                    android:textSize="@dimen/emui_master_caption_2"
                    android:textColor="@android:color/white"
                    android:id="@id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true" />
                <TextView
                    android:textSize="@dimen/emui_master_caption_2"
                    android:textColor="@android:color/white"
                    android:id="@id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>