<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/comment_root_view"
    android:focusable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@id/detail_comment_user_info"
        android:paddingTop="@dimen/padding_m"
        android:paddingBottom="@dimen/padding_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="0.0dip">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/detail_comment_collect_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:visibility="visible"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_middle"
            android:layout_alignTop="@id/detail_comment_user_layout"
            android:layout_alignBottom="@id/detail_comment_user_layout"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/card_more_btn"
            android:layout_alignParentEnd="true">
            <com.huawei.appgallery.appcomment.ui.view.FavoriteImageView
                android:layout_gravity="center_vertical"
                android:tag="css/.widget"
                android:background="@drawable/aguikit_ic_public_more_list"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:scaleType="centerCrop" />
        </LinearLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/detail_comment_user_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/detail_comment_collect_layout"
            android:layout_toEndOf="@id/detail_comment_user_icon_imageview">
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/comment_nick_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical">
                <TextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/detail_comment_user_textview"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                <com.huawei.appgallery.appcomment.widget.CommentLabelTextView
                    android:textSize="10.0dip"
                    android:textColor="@color/emui_accent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_comment_user_role_textview"
                    android:tag="css/.title"
                    android:background="@drawable/appcomment_comment_label_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14.0dip"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:paddingStart="8.0dip"
                    android:paddingEnd="8.0dip"
                    android:layout_marginStart="4.0dip" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        </RelativeLayout>
        <com.huawei.appgallery.appcomment.ui.view.HeadImageView
            android:id="@id/detail_comment_user_icon_imageview"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:layout_alignTop="@id/detail_comment_user_layout"
            android:layout_alignBottom="@id/detail_comment_user_layout"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/hiappbase_user_avatar"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_alignParentStart="true" />
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/detail_comment_user_client_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_below="@id/detail_comment_user_layout"
            android:importantForAccessibility="no"
            android:layout_toEndOf="@id/detail_comment_user_icon_imageview">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@id/detail_comment_user_client_textview"
                android:tag="css/.subtitle"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/appcomment_user_client_tv_maxwidth"
                android:singleLine="true"
                android:layout_marginEnd="@dimen/appgallery_max_padding_start"
                android:layout_alignParentStart="true"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@id/detail_comment_time_textview"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/detail_comment_user_client_textview"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/detail_comment_ip_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_below="@id/detail_comment_user_client_layout"
            android:importantForAccessibility="no"
            android:layout_toEndOf="@id/detail_comment_user_icon_imageview">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@id/detail_comment_ip_textview"
                android:tag="css/.subtitle"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:textAlignment="viewStart"
                android:layout_marginEnd="16.0dip"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/appcomment_comment_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <RelativeLayout
            android:id="@id/detail_comment_version_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m">
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/appgallery_text_color_secondary"
                android:ellipsize="end"
                android:id="@id/detail_comment_version_textview"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="@dimen/margin_l"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toEndOf="@id/detail_comment_stars_ratingbar" />
            <com.huawei.appgallery.foundation.ui.framework.widget.RenderRatingBar
                android:id="@id/detail_comment_stars_ratingbar"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="12.0dip"
                android:maxHeight="12.0dip"
                android:indeterminateOnly="false"
                android:indeterminateDrawable="@drawable/appcomment_ratingbar_list"
                android:progressDrawable="@drawable/appcomment_ratingbar_list"
                android:minHeight="12.0dip"
                android:thumb="@null"
                android:numStars="5"
                android:rating="0.0"
                android:isIndicator="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="noHideDescendants" />
            <View
                android:id="@id/detail_comment_start_ratingbar_conceal_view"
                android:background="@null"
                android:layout_width="1.0dip"
                android:layout_height="1.0dip" />
        </RelativeLayout>
        <FrameLayout
            android:id="@id/detail_comment_content_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appgallery.appcomment.ui.view.FoldTextView
                android:id="@id/detail_comment_content_textview"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:layout_gravity="end|bottom|center"
                android:id="@id/open_or_fold_tv"
                android:tag="css/.title"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appcomment_user_open_content"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </FrameLayout>
        <ViewStub
            android:id="@id/appcomment_shield"
            android:layout="@layout/appcomment_comment_shield_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m" />
        <RelativeLayout
            android:id="@id/detail_comment_app_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/detail_comment_add_approve_layout_linearlayout"
                android:tag="css/.report-button"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toStartOf="@id/detail_comment_step_layout_linearlayout">
                <com.huawei.appgallery.appcomment.ui.view.ApproveImageView
                    android:id="@id/detail_comment_approve_icon_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_thumbsup"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:scaleType="centerCrop" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_comment_approve_counts_textview"
                    android:tag="css/.title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="@dimen/margin_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/detail_comment_step_layout_linearlayout"
                android:tag="css/.report-button"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toStartOf="@id/detail_comment_add_reply_layout_linearlayout">
                <com.huawei.appgallery.appcomment.ui.view.DissImageView
                    android:id="@id/detail_comment_diss_icon_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/appcomment_step_on"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:scaleType="centerCrop" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_comment_diss_counts_textview"
                    android:tag="css/.title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="@dimen/margin_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_comment_add_reply_layout_linearlayout"
                android:tag="css/.report-button"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignWithParentIfMissing="true"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toStartOf="@id/detail_comment_share_layout_linearlayout">
                <ImageView
                    android:id="@id/detail_comment_reply_icon_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_comments"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/appcomment_reply_button" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_comment_reply_button_textview"
                    android:tag="css/.title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="@dimen/margin_s" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_comment_share_layout_linearlayout"
                android:tag="css/.report-button"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="24.0dip"
                android:layout_centerVertical="true"
                android:contentDescription="@string/share_app_title"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/detail_comment_share_icon_imageview"
                    android:tag="css/.widget"
                    android:background="@drawable/aguikit_ic_public_share"
                    android:layout_width="@dimen/appcomment_share_icon_width"
                    android:layout_height="16.0dip"
                    android:scaleType="centerCrop" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <ViewStub
        android:id="@id/detail_comment_list_reply_layout"
        android:layout="@layout/appcomment_list_item_reply"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ImageView
        android:id="@id/comment_list_divider_imageview"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_marginStart="72.0dip"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>