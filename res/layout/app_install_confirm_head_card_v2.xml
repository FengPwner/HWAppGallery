<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/head_card_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:contentDescription=""
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:hwColumnType="content_type">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.NoFeedbackMaskImageView
                android:id="@id/head_app_icon"
                android:layout_width="@dimen/appgallery_card_icon_size_12_column"
                android:layout_height="@dimen/appgallery_card_icon_size_12_column"
                android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
                android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_alignParentStart="true"
                app:corner_type="appicon"
                app:round_type="all" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_safety_margin_l"
                android:layout_toEndOf="@id/head_app_icon">
                <TextView
                    android:textSize="@dimen/emui_text_size_headline8"
                    android:id="@id/head_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/install_dist_market_name"
                    style="@style/install_head_app_name_style" />
                <TextView
                    android:id="@id/head_app_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_safety_margin_s"
                    android:text="@string/install_dist_text_installer_resource"
                    style="@style/install_confirm_normal_tips_card_tips_style" />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@id/install_confirm_normal_loading_group"
            android:paddingTop="@dimen/appgallery_default_card_space_vertical_l"
            android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.phone.hwprogressbar.widget.HwProgressBar
                android:layout_gravity="center"
                android:id="@id/head_check_progressbar"
                android:layout_width="@dimen/appgallery_list_item_right_arrow_height"
                android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                android:layout_marginEnd="@dimen/appgallery_safety_margin_m"
                style="@style/Widget.Emui.HwProgressBar.Large" />
            <TextView
                android:layout_gravity="center"
                android:id="@id/install_confirm_normal_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_install_checking_v2_3"
                style="@style/install_head_app_progress_style" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@id/install_confirm_status_success_group"
            android:paddingTop="@dimen/appgallery_default_card_space_vertical_l"
            android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@id/install_confirm_status_left_icon"
                android:layout_width="@dimen/appgallery_list_item_right_arrow_height"
                android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                android:src="@drawable/install_dist_ic_tips_installation_security2"
                android:layout_marginEnd="@dimen/appgallery_safety_margin_m" />
            <TextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/install_success_tip_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/install_dist_install_success"
                style="@style/install_head_app_install_success_style" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/install_fail_group"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:importantForAccessibility="no">
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@id/install_fail_title_layout"
                android:paddingTop="@dimen/appgallery_default_card_space_vertical_l"
                android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
                android:focusable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/install_fail_icon"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_height"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                    android:src="@drawable/install_dist_ic_tips_installation_security3"
                    android:layout_marginEnd="@dimen/appgallery_safety_margin_m" />
                <TextView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/install_fail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/install_dist_install_failed_result"
                    style="@style/AppGallery.Widget.SubHeader.Title" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/install_fail_tips_group"
                android:background="@drawable/app_permission_bg"
                android:paddingTop="@dimen/margin_s"
                android:paddingBottom="@dimen/margin_s"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
                android:importantForAccessibility="no"
                android:paddingStart="@dimen/appgallery_default_card_space_vertical_l"
                android:paddingEnd="@dimen/appgallery_default_card_space_vertical_l">
                <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/app_install_fail_layout"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/appgallery_subheader_item_double_min_height"
                    android:importantForAccessibility="yes">
                    <TextView
                        android:id="@id/app_install_fail_reason_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        style="@style/AppGallery.Widget.SubHeader.Title" />
                    <TextView
                        android:id="@id/app_install_fail_content"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout>
                <View
                    android:id="@id/dividerLine"
                    android:layout_width="fill_parent"
                    style="@style/AppGallery.Widget.Divider" />
                <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/app_install_handle_suggest_layout"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/appgallery_subheader_item_double_min_height"
                    android:importantForAccessibility="yes">
                    <TextView
                        android:id="@id/app_install_handle_suggest_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        style="@style/AppGallery.Widget.SubHeader.Title" />
                    <TextView
                        android:id="@id/app_install_handle_suggest_content"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@id/install_confirm_tip_add_restrict"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l" />
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
</LinearLayout>