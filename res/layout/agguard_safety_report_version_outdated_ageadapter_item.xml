<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/agguard_card_item_pressed_inset_bg"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12.0dip"
    android:paddingEnd="12.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/version_outdated_item_card_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:layout_gravity="start"
            android:id="@id/version_outdated_item_icon"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="12.0dip"
            android:importantForAccessibility="no"
            app:corner_type="appicon"
            app:round_type="all" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/version_outdated_item_name"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:maxLines="1"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/version_outdated_item_size"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:maxLines="1"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/version_outdated_item_version"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
            android:id="@id/item_download_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:minHeight="28.0dip"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/version_outdated_item_desc_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/version_outdated_item_short_desc"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1.0"
            android:lineSpacingMultiplier="@dimen/appgallery_text_line_space_s"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        <ImageView
            android:layout_gravity="bottom"
            android:id="@id/version_outdated_item_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_public_arrow_down_900" />
    </LinearLayout>
    <RelativeLayout
        android:id="@id/expand_relativelayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <TextView
            android:gravity="center_vertical"
            android:id="@id/dayspublish_short_textview"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/updatemanager_app_info_default"
            android:singleLine="true"
            android:textAllCaps="false"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dayspublish_short_textview">
            <TextView
                android:gravity="start|center"
                android:id="@id/update_long_desc_textview"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:text="@string/updatemanager_app_info_default"
                android:layout_weight="1.0"
                android:lineSpacingMultiplier="@dimen/appgallery_text_line_space_s"
                android:textAllCaps="false"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <ImageView
                android:layout_gravity="bottom"
                android:id="@id/update_icon_up"
                android:background="@drawable/ic_public_arrow_up_900"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@id/version_outdated_item_divider"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>