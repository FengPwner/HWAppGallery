<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/main_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:minHeight="@dimen/appgallery_card_height_three_text_lines"
        android:layout_weight="1.0">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:src="@color/transparent"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_default_padding_end" />
        <RelativeLayout
            android:id="@id/right_middle_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/appicon">
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/downbtn"
                android:tag="css/.download-button"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="28.0dip"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/title_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                android:layout_toStartOf="@id/downbtn"
                android:layout_alignParentStart="true">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/ItemTitle"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/info_watch_imageview"
                        android:tag="css/.widget"
                        android:visibility="gone"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/aguikit_ic_public_watch"
                        android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs" />
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/info_vr_imageview"
                        android:tag="css/.widget"
                        android:visibility="gone"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/aguikit_ic_public_vr"
                        android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs" />
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/info_appquality_imageview"
                        android:visibility="gone"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/second_line"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/appgallery_card_elements_margin_xl"
                android:layout_below="@id/title_layout"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                android:layout_toStartOf="@id/downbtn"
                android:layout_alignParentStart="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/second_line_tags"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
                <RelativeLayout
                    android:id="@id/score_layout"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:id="@id/score"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_centerVertical="true"
                        android:textAlignment="viewStart"
                        android:layout_alignParentStart="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:id="@id/score_star"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                        android:layout_toEndOf="@id/score"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <ImageView
                        android:id="@id/classify_star"
                        android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
                        android:layout_height="@dimen/hiappbase_card_fasticon_size_large"
                        android:src="@drawable/ic_classify_star"
                        android:scaleType="fitCenter"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                        android:layout_toEndOf="@id/score" />
                </RelativeLayout>
            </LinearLayout>
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/install_num"
                android:tag="css/.subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:singleLine="true"
                android:layout_below="@id/title_layout"
                android:textAlignment="viewStart"
                android:layout_alignStart="@id/title_layout"
                android:layout_alignEnd="@id/title_layout"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/third_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/second_line">
                <com.huawei.appmarket.framework.widget.PromotionSignTextView
                    android:layout_gravity="center_vertical"
                    android:id="@id/promotion_sign"
                    android:tag="css/.title"
                    android:background="@drawable/promotion_sign_bg"
                    android:visibility="gone"
                    android:layout_marginEnd="@dimen/appgallery_text_margin_horizontal"
                    style="@style/promotion_sign_style" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/desc_textview"
                    android:tag="css/.subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@id/devider_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_marginStart="68.0dip"
        style="@style/AppGallery.Widget.Divider" />
    <include
        android:id="@id/cornerbutton"
        android:visibility="gone"
        layout="@layout/wisedist_round_corner_button" />
</LinearLayout>