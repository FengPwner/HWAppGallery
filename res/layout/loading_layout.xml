<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/loadingBar_layout"
        android:tag="css/.body"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.phone.hwprogressbar.widget.HwProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@id/loadingBar"
                android:visibility="visible"
                android:layout_width="@dimen/loading_large"
                android:layout_height="@dimen/loading_large"
                style="@style/Widget.Emui.HwProgressBar.Large" />
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@id/loadingTip"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_loading_prompt"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>