<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/normal_card_height"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/normalCard_item"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/normal_card_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@id/view"
                android:background="@color/transparent"
                android:layout_width="33.0dip"
                android:layout_height="0.0dip"
                app:layout_constraintBottom_toBottomOf="@id/appicon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/appicon" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:gravity="center"
                android:id="@id/rank_number_textview"
                android:tag="css/.title"
                android:layout_width="29.0dip"
                android:layout_height="@dimen/ranking_medal_image_size"
                android:maxLines="1"
                android:layout_marginEnd="4.0dip"
                app:hwAutoSizeMinTextSize="14.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                app:layout_constraintEnd_toEndOf="@id/view"
                app:layout_constraintStart_toStartOf="@id/view"
                app:layout_constraintTop_toTopOf="@id/view"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Fixed.Regular" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:gravity="center"
                android:id="@id/appSerial"
                android:tag="css/.title"
                android:layout_width="29.0dip"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="4.0dip"
                app:hwAutoSizeMinTextSize="12.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                app:layout_constraintEnd_toEndOf="@id/view"
                app:layout_constraintStart_toStartOf="@id/view"
                app:layout_constraintTop_toTopOf="@id/view"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Fixed.Regular" />
            <ImageView
                android:id="@id/appicon"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/view"
                app:layout_constraintTop_toTopOf="parent" />
            <ViewStub
                android:id="@id/fastappicon"
                android:layout="@layout/wisedist_fastappicon_layout"
                android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
                android:layout_height="@dimen/hiappbase_card_fasticon_size_large"
                app:layout_constraintBottom_toBottomOf="@id/appicon"
                app:layout_constraintEnd_toEndOf="@id/appicon" />
            <ViewStub
                android:id="@id/horizon_line"
                android:layout="@layout/aguikit_horizontal_line_layout"
                android:inflatedId="@id/horizon_line"
                android:layout_width="@dimen/ui_40_dp"
                android:layout_height="1.5dip"
                android:layout_marginTop="4.0dip"
                app:layout_constraintEnd_toEndOf="@id/appicon"
                app:layout_constraintStart_toStartOf="@id/appicon"
                app:layout_constraintTop_toBottomOf="@id/appicon" />
            <com.huawei.appgallery.pageframe.view.DownloadButtonV2
                android:id="@id/downbtn"
                android:tag="css/.download-button"
                android:layout_width="0.0dip"
                android:layout_height="28.0dip"
                app:layout_constraintBottom_toTopOf="@id/original_price_textview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <TextView
                android:textColor="@color/appgallery_text_color_tertiary"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@id/original_price_textview"
                android:tag="css/.subtitle"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/downbtn"
                app:layout_constraintStart_toStartOf="@id/downbtn"
                app:layout_constraintTop_toBottomOf="@id/downbtn"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppGallery.TextAppearance.TextCaption" />
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/title_layout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                app:layout_constraintBottom_toTopOf="@id/item_text_rl"
                app:layout_constraintEnd_toStartOf="@id/downbtn"
                app:layout_constraintStart_toEndOf="@id/appicon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_goneMarginStart="@dimen/appgallery_elements_margin_horizontal_l">
                <TextView
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@id/ItemTitle"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/info_watch_imageview"
                        android:tag="css/.widget"
                        android:visibility="gone"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/aguikit_ic_public_watch"
                        android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs" />
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/info_vr_imageview"
                        android:tag="css/.widget"
                        android:visibility="gone"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/aguikit_ic_public_vr"
                        android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs" />
                </LinearLayout>
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/item_text_rl"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                app:layout_constraintBottom_toTopOf="@id/memo"
                app:layout_constraintEnd_toStartOf="@id/downbtn"
                app:layout_constraintStart_toStartOf="@id/title_layout"
                app:layout_constraintTop_toBottomOf="@id/title_layout">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/mark_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/appgallery_text_size_body2_fixed"
                    android:layout_height="@dimen/appgallery_text_size_body2_fixed"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s" />
                <com.huawei.appmarket.framework.widget.PromotionSignTextView
                    android:layout_gravity="center_vertical"
                    android:id="@id/promotion_sign"
                    android:tag="css/.title"
                    android:background="@drawable/promotion_sign_bg"
                    android:layout_marginEnd="@dimen/appgallery_text_margin_horizontal"
                    style="@style/promotion_sign_style" />
                <TextView
                    android:id="@id/adText"
                    android:tag="css/.subtitle"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginEnd="@dimen/ui_8_dp"
                    style="@style/AdTextViewStyle" />
                <com.huawei.appmarket.service.appdetail.view.widget.FixedLeftLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/sec_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:id="@id/label_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@id/app_flag_rect"
                            android:visibility="gone"
                            android:layout_width="28.0sp"
                            android:layout_height="16.0sp"
                            android:src="@color/transparent"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="@dimen/margin_m" />
                        <TextView
                            android:textSize="@dimen/emui_text_size_caption1"
                            android:textColor="@color/normal_card_label_text_color"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@id/prefixAppIntro"
                            android:background="@drawable/title_text_label_bg"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="16.0sp"
                            android:maxLines="1"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:paddingStart="@dimen/ui_4_dp"
                            android:paddingEnd="@dimen/ui_4_dp"
                            android:layout_marginEnd="@dimen/margin_m" />
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@id/ItemText"
                            android:tag="css/.subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                        <TextView
                            android:id="@id/ItemText_star"
                            android:tag="css/.subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/appgallery_text_margin_horizontal"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    </LinearLayout>
                </com.huawei.appmarket.service.appdetail.view.widget.FixedLeftLinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@id/lable_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/memo"
                app:layout_constraintStart_toStartOf="@id/item_text_rl"
                app:layout_constraintTop_toBottomOf="@id/item_text_rl"
                app:layout_constraintTop_toTopOf="@id/memo">
                <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                    android:id="@id/nonadapt_imageview"
                    android:tag="css/.title"
                    android:visibility="gone"
                    android:layout_width="18.0dip"
                    android:layout_height="@dimen/ui_14_dp"
                    android:scaleType="fitCenter"
                    android:paddingEnd="@dimen/appgallery_text_paragraph_margin_xs" />
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/ad_info_icon"
                    android:background="@drawable/hiappbase_info_icon"
                    android:visibility="gone"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:contentDescription="@string/hiappbase_one_click_control_more_info"
                    android:layout_marginEnd="@dimen/appgallery_text_paragraph_margin_xs" />
            </LinearLayout>
            <TextView
                android:ellipsize="end"
                android:id="@id/memo"
                android:tag="css/.subtitle"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/downbtn"
                app:layout_constraintStart_toEndOf="@id/lable_icon"
                app:layout_constraintTop_toBottomOf="@id/item_text_rl"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <View
                android:id="@id/devider_line"
                android:tag="css/.split-line"
                android:layout_width="0.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/downbtn"
                app:layout_constraintStart_toStartOf="@id/title_layout"
                style="@style/AppGallery.Widget.Divider" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@id/one_pic_layout"
        android:layout="@layout/applistitem_normal_one_pic_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ViewStub
        android:id="@id/two_pic_layout"
        android:layout="@layout/applistitem_normal_two_pic_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
</LinearLayout>