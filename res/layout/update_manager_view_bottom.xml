<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/updatemanager_empty_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/no_game_image"
        android:src="@drawable/updatemanager_ic_manage_update_empty"
        android:layout_centerInParent="true"
        style="@style/AppGallery.ImageSize.NoData" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/updatemanager_update_manager_noupdate"
        android:layout_below="@id/no_game_image"
        android:layout_centerHorizontal="true"
        style="@style/AppGallery.TextAppearance.NoData" />
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/setting_content"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwColumnType="button_type">
        <com.huawei.appmarket.framework.widget.RenderButton
            android:gravity="center"
            android:id="@id/setting"
            android:tag="css/.title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:minHeight="36.0dip"
            android:text="@string/setting_network_prompt_title"
            android:layout_weight="1.0"
            app:hwAutoSizeMinTextSize="9.0sp"
            app:hwAutoSizeStepGranularity="1.0sp"
            style="@style/AppGallery.Widget.Button.BottomButton" />
        <com.huawei.appmarket.framework.widget.RenderButton
            android:gravity="center"
            android:id="@id/go_to_net_diagnose"
            android:tag="css/.title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:minHeight="36.0dip"
            android:text="@string/netdiagnose_button_text"
            android:layout_weight="1.0"
            android:layout_marginStart="16.0dip"
            app:hwAutoSizeMinTextSize="9.0sp"
            app:hwAutoSizeStepGranularity="1.0sp"
            style="@style/AppGallery.Widget.Button.BottomButton" />
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
</RelativeLayout>