<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:paddingTop="@dimen/component_detail_report_proof_add_size"
    android:paddingBottom="@dimen/component_detail_report_proof_add_size"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/component_detail_report_item_common_margin_horizontal"
    android:paddingEnd="@dimen/component_detail_report_item_common_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/iv_star"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_detail_report_star"
        app:layout_constraintBottom_toBottomOf="@id/tv_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_description" />
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_text_color_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/component_detail_report_des_title_height"
        android:text="@string/component_detail_report_problem_description"
        android:maxLines="2"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
        app:layout_constraintBottom_toTopOf="@id/container"
        app:layout_constraintStart_toEndOf="@id/iv_star"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/container"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_detail_report_item_common_margin_vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_description">
        <com.huawei.appgallery.detail.detailbase.common.widget.EditTextWithListView
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_primary"
            android:textColorHint="@color/appgallery_text_color_hint"
            android:gravity="start"
            android:id="@id/et_specific_report_desc"
            android:background="@drawable/selector_detail_report_et"
            android:paddingTop="@dimen/appgallery_card_elements_margin_m"
            android:paddingBottom="@dimen/component_detail_report_des_input_padding_elder"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/component_detail_report_des_input_height_elder"
            android:hint="@string/component_detail_report_description_hint"
            android:includeFontPadding="false"
            android:imeOptions="flagNoFullscreen"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textDirection="locale"
            android:paddingStart="@dimen/appgallery_card_elements_margin_l"
            android:paddingEnd="@dimen/appgallery_card_elements_margin_l"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="@dimen/emui_text_size_caption1"
            android:textColor="@color/appgallery_text_color_tertiary"
            android:gravity="bottom"
            android:id="@id/tv_specific_report_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_caption"
        android:textColor="@color/appgallery_color_error"
        android:id="@id/tv_desc_limit_text_view"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/component_detail_report_margin_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container" />
</androidx.constraintlayout.widget.ConstraintLayout>