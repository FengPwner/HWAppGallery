<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/appcommon_personal_header_view"
    android:background="@color/personal_mine_info_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
        android:layout_gravity="center_horizontal"
        android:id="@id/personal_def_info_head_image_view"
        android:background="@android:color/transparent"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:layout_marginTop="@dimen/personal_head_margin_top"
        android:src="@drawable/placeholder_base_account_header"
        android:scaleType="centerCrop"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/hiappbase_user_avatar" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/personal_definfo_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xl"
        android:minHeight="@dimen/appgallery_card_icon_size_large"
        android:layout_below="@id/personal_def_info_head_image_view"
        android:layout_centerHorizontal="true">
        <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/appcommon_personal_info_account_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserInfoTextView
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/personal_definfo_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        <TextView
            android:textSize="@dimen/appgallery_text_size_body3"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:id="@id/personal_deftip_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/personal_login_for_game_privileges"
            android:maxLines="1"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@id/personal_info_linear_layout"
        android:paddingBottom="20.0dip"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/personal_definfo_layout"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/appgallery_card_elements_margin_xl"
        android:layout_marginEnd="@dimen/appgallery_card_elements_margin_xl">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/personal_info_left_linear_layout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textStyle="bold"
                android:textColor="@color/appgallery_text_color_secondary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/personal_info_left_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:alpha="1.0"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:paddingStart="@dimen/ui_12_dp"
                android:paddingEnd="@dimen/ui_12_dp" />
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_body3"
                    android:textColor="@color/appgallery_text_color_tertiary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/personal_info_left_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:alpha="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:paddingStart="@dimen/ui_10_dp" />
                <ImageView
                    android:id="@id/personal_info_left_red_dot"
                    android:visibility="invisible"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:src="@drawable/tab_red_dot"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_gravity="center"
            android:id="@id/personal_divider"
            android:background="@color/personal_black_20_percent"
            android:layout_width="1.0dip"
            android:layout_height="24.0dip" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/personal_info_right_linear_layout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textStyle="bold"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/personal_info_right_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:alpha="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:paddingStart="@dimen/ui_12_dp"
                    android:paddingEnd="2.0dip" />
                <ImageView
                    android:id="@id/personal_info_right_red_dot"
                    android:visibility="invisible"
                    android:layout_width="6.0dip"
                    android:layout_height="6.0dip"
                    android:src="@drawable/tab_red_dot"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
            </LinearLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_tertiary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/personal_info_right_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:alpha="1.0"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:paddingStart="@dimen/ui_10_dp"
                android:paddingEnd="@dimen/ui_10_dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>