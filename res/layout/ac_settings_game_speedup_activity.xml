<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ScrollView
        android:orientation="vertical"
        android:paddingBottom="@dimen/padding_xl"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/game_speedup_selection_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@id/battery_warn"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xl"
                android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xl"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
            <com.huawei.appmarket.service.settings.view.widget.VerticalRadioViewGroup
                android:orientation="vertical"
                android:id="@id/game_speedup_choose_layout"
                android:background="@drawable/aguikit_card_panel_bg"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end">
                <com.huawei.uikit.phone.hwradiobutton.widget.HwRadioButton
                    android:textSize="@dimen/appgallery_text_size_subtitle2"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:id="@id/radio_speedup_yes"
                    android:background="@drawable/aguikit_round_rectangle_card_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
                    android:button="@null"
                    android:minHeight="48.0dip"
                    android:text="@string/appcommon_game_speedup_auto_download"
                    android:drawableEnd="@drawable/hwradiobutton_selector_emui"
                    android:fontFamily="@string/emui_text_font_family_medium"
                    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal" />
                <ImageView
                    android:tag="divider"
                    android:layout_width="fill_parent"
                    android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    style="@style/AppGallery.Widget.Divider" />
                <com.huawei.uikit.phone.hwradiobutton.widget.HwRadioButton
                    android:textSize="@dimen/appgallery_text_size_subtitle2"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:id="@id/radio_speedup_no"
                    android:background="@drawable/aguikit_round_rectangle_card_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
                    android:checked="true"
                    android:button="@null"
                    android:minHeight="48.0dip"
                    android:text="@string/appcommon_game_speedup_no_download"
                    android:drawableEnd="@drawable/hwradiobutton_selector_emui"
                    android:fontFamily="@string/emui_text_font_family_medium"
                    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal" />
            </com.huawei.appmarket.service.settings.view.widget.VerticalRadioViewGroup>
        </LinearLayout>
    </ScrollView>
</LinearLayout>