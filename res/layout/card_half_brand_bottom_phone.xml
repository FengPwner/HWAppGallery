<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/card_half_brand_bottom_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/app_icon"
            android:layout_width="80.0dip"
            android:layout_height="80.0dip"
            android:layout_marginStart="12.0dip"
            app:corner_type="appicon"
            app:round_type="all" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="12.0dip">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_headline8"
                android:id="@id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/app_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
        android:textSize="14.0dip"
        android:ellipsize="end"
        android:id="@id/dl_button"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="28.0dip"
        android:layout_marginTop="18.0dip"
        android:layout_marginBottom="@dimen/appgallery_max_padding_start"
        android:text="@string/card_install_btn"
        android:singleLine="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip"
        app:downloadFixedWidth="true" />
</LinearLayout>