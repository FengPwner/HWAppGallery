<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto"
    xmlns:toolbartype="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_hwtoolbar_height"
        android:layout_alignParentTop="true"
        layout="@layout/family_share_apps_title_emui_layout" />
    <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/btnlayout"
        android:background="@color/appgallery_color_toolbar_bg"
        android:visibility="gone"
        android:addStatesFromChildren="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/hwappbarpattern_split_menu_height"
        android:layout_alignParentBottom="true">
        <com.huawei.appgallery.purchasehistory.ui.widget.ToolBarIcon
            android:gravity="center"
            android:id="@id/actionbar_install_button"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            toolbartype:toolbartype="intallbatch" />
    </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/btnlayout"
        android:layout_below="@id/title">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/column_parent_layout"
            android:background="@color/appgallery_color_sub_background"
            android:focusableInTouchMode="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwsubtab.widget.HwSubTabWidget
                android:id="@id/getscore_navigator"
                android:background="@color/appgallery_color_sub_background"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/hwsubtab_height"
                style="@style/Widget.Emui.HwSubTabBar" />
        </LinearLayout>
        <com.huawei.uikit.hwviewpager.widget.HwViewPager
            android:id="@id/score_pages"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            toolbartype:bounceEnable="true" />
    </LinearLayout>
</RelativeLayout>