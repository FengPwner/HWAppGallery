<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/apk_management_parent_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <ImageView
            android:id="@id/localpackage_item_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_alignParentStart="true" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/localpackage_item_middle"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_below="@id/localpackage_item_icon"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/localpackage_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <ImageView
                        android:id="@id/error_icon"
                        android:visibility="gone"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/aguikit_ic_public_error"
                        android:layout_marginEnd="@dimen/margin_s" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@id/localpackage_item_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <TextView
                        android:id="@id/localpackage_item_blank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
                <TextView
                    android:id="@id/localpackage_item_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:ellipsize="end"
                android:id="@id/localpackage_delete_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/apkmanagement_deleteapk"
                android:maxLines="1"
                app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
                app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
                style="@style/Widget.Emui.HwButton.Small" />
        </LinearLayout>
        <ImageView
            android:id="@id/apk_management_split_line"
            android:layout_width="fill_parent"
            android:layout_marginTop="4.0dip"
            android:layout_below="@id/localpackage_item_middle"
            android:layout_alignParentBottom="true"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
</RelativeLayout>