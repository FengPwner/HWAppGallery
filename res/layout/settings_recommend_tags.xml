<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/setting_card_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="27.5dip"
        android:layout_marginBottom="9.5dip"
        android:layout_marginStart="@dimen/emui_dimens_default_end"
        android:layout_marginEnd="@dimen/emui_dimens_default_end">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_body2"
            android:textColor="@color/emui_color_text_secondary"
            android:id="@id/settings_recommend_tag_management_textview"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_recommend_tag_management"
            android:importantForAccessibility="yes"
            android:fontFamily="@string/emui_text_font_family_regular"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/recommend_tags_bg"
        android:paddingTop="@dimen/ui_14_dp"
        android:paddingBottom="@dimen/emui_dimens_default_end"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/emui_dimens_default_end"
        android:paddingEnd="@dimen/emui_dimens_default_end">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_body1"
            android:textColor="@color/emui_text_primary"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_recommend_my_tag"
            android:importantForAccessibility="yes"
            android:fontFamily="@string/emui_text_font_family_medium" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_body2"
            android:textColor="@color/emui_color_text_secondary"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xs"
            android:layout_marginBottom="@dimen/margin_xs"
            android:text="@string/settings_recommend_content_basis"
            android:importantForAccessibility="yes"
            android:fontFamily="@string/emui_text_font_family_regular" />
        <com.huawei.appmarket.service.settings.view.widget.RecommendTagsViewGroup
            android:id="@id/my_tags_view"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/not_my_tags_image"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_16_dp">
            <com.huawei.uikit.hwimageview.widget.HwImageView
                android:background="@drawable/recommend_not_tags"
                android:layout_width="120.0dip"
                android:layout_height="120.0dip" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_body2"
                android:textColor="@color/emui_color_text_tertiary"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_8_dp"
                android:text="@string/settings_not_my_tag"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/emui_text_font_family_regular" />
        </LinearLayout>
        <com.huawei.uikit.hwimageview.widget.HwImageView
            android:background="@color/line_view_range"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginTop="@dimen/ui_8_dp" />
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/ui_10_dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_body1"
                android:textColor="@color/emui_text_primary"
                android:focusable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_deactivated_tag"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/emui_text_font_family_medium" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_body2"
                android:textColor="@color/emui_color_text_secondary"
                android:focusable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xs"
                android:layout_marginBottom="@dimen/margin_xs"
                android:text="@string/settings_add_my_tag"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/emui_text_font_family_regular" />
            <com.huawei.appmarket.service.settings.view.widget.RecommendTagsViewGroup
                android:id="@id/not_tags_view"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes" />
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/not_disabled_tags_image"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_16_dp">
                <com.huawei.uikit.hwimageview.widget.HwImageView
                    android:background="@drawable/recommend_not_tags"
                    android:layout_width="120.0dip"
                    android:layout_height="120.0dip" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body2"
                    android:textColor="@color/emui_color_text_tertiary"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_8_dp"
                    android:text="@string/settings_not_disabled_tag"
                    android:importantForAccessibility="yes"
                    android:fontFamily="@string/emui_text_font_family_regular" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>