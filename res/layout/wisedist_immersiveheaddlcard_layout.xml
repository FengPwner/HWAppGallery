<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_centerHorizontal="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@id/immersiveheaddlcard_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_centerHorizontal="true">
        <com.huawei.appmarket.framework.widget.RenderImageView
            android:id="@id/immersiveheaddlcard_big_imageview"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true" />
        <RelativeLayout
            android:id="@id/immersiveheaddlcard_dl_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_card_height_two_text_lines"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/immersiveheaddlcard_btn"
                android:tag="css/.download-button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:minWidth="64.0dip"
                android:layout_centerVertical="true"
                android:layout_marginEnd="2.0dip"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <ImageView
                android:id="@id/immersiveheaddlcard_icon_imageview"
                android:layout_width="@dimen/appgallery_card_icon_size_middle"
                android:layout_height="@dimen/appgallery_card_icon_size_middle"
                android:scaleType="centerCrop"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/immersiveheaddlcard_btn"
                android:layout_toEndOf="@id/immersiveheaddlcard_icon_imageview">
                <TextView
                    android:textColor="@color/emui_white"
                    android:ellipsize="end"
                    android:id="@id/immersiveheaddlcard_title"
                    android:tag="css/.title"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <TextView
                    android:textColor="@color/emui_white"
                    android:ellipsize="end"
                    android:id="@id/immersiveheaddlcard_subtitle"
                    android:tag="css/.subtitle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>