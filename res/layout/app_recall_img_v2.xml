<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    app:clip_background="true"
    app:round_corner="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/img_container_layout_v2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/img_layout_v2"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@id/app_detail_recall_app_img"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="21:9"
                app:layout_constraintTop_toTopOf="parent" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="8.0dip"
                android:textColor="@color/emui_text_primary_inverse"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/prefixAppIntro"
                android:background="@drawable/substancelistcard_round_chip_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:minWidth="24.0dip"
                android:minHeight="16.0dip"
                android:maxLines="1"
                android:maxEms="9"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:paddingStart="8.0dip"
                android:paddingEnd="8.0dip"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/app_detail_recall_img_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_64_dp"
            app:layout_constraintDimensionRatio="42:9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_layout_v2">
            <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                android:id="@id/app_detail_recall_app_icon"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:corner_type="appicon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:round_type="all" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/app_detail_recall_app_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/wisedist_horizontal_big_card_icon_layout_margin_end"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
                app:layout_constraintBottom_toTopOf="@id/app_detail_recall_app_desc"
                app:layout_constraintEnd_toStartOf="@id/dl_btn"
                app:layout_constraintStart_toEndOf="@id/app_detail_recall_app_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/app_detail_recall_app_desc"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/wisedist_horizontal_big_card_icon_layout_margin_end"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/dl_btn"
                app:layout_constraintStart_toEndOf="@id/app_detail_recall_app_icon"
                app:layout_constraintTop_toBottomOf="@id/app_detail_recall_app_name"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <com.huawei.appgallery.pageframe.view.DownloadButtonV2
                android:id="@id/dl_btn"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:maxWidth="90.0dip"
                android:minWidth="64.0dip"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:layout_constraintBottom_toBottomOf="@id/app_detail_recall_app_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/app_detail_recall_app_icon" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>