<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/joint_service_layout"
        android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
        android:paddingTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_8_dp"
        android:layout_below="@id/title"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.List.SingleTextLine">
        <TextView
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/joint_operation_services_title"
            android:layout_weight="1.0"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
        <LinearLayout
            android:gravity="end|center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_text_margin_horizontal">
            <ImageView
                android:layout_marginStart="@dimen/margin_s"
                style="@style/AppGallery.Widget.List.RightArrow" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/list_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/joint_service_layout">
        <TextView
            android:id="@id/cacel_subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_20_dp"
            android:text="@string/joint_operation_services_managment"
            android:layout_below="@id/joint_service_layout"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.Widget.SubHeader.ListTitle" />
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_gravity="center_horizontal"
            android:id="@id/recycle_view"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_8_dp"
            android:layout_below="@id/cacel_subtitle"
            android:fadeScrollbars="false"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
    </LinearLayout>
    <include
        android:id="@id/joint_service_layout_loading"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/title_layout"
        layout="@layout/loading_fragment" />
</RelativeLayout>