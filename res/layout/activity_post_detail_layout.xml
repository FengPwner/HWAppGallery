<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/main_view"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/post_detail_container"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/post_comment_bottom_container"
        android:layout_below="@id/titlebar" />
    <RelativeLayout
        android:id="@id/section_layout"
        android:background="@drawable/forum_post_section_selector"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line"
        android:layout_below="@id/titlebar"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <ImageView
            android:id="@id/section_icon"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/section_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toStartOf="@id/section_enter"
            android:layout_toEndOf="@id/section_icon" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:id="@id/section_enter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forum_post_section_enter"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/section_arrow" />
        <ImageView
            android:id="@id/section_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_public_arrow_right_900"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/margin_s"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <include
        android:id="@id/titlebar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/activity_post_detail_title_layout" />
    <RelativeLayout
        android:id="@id/post_comment_bottom_container"
        android:background="@color/appgallery_color_toolbar_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/post_comment_bottom"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:alpha="0.95">
            <RelativeLayout
                android:id="@id/post_comment_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="56.0dip">
                <RelativeLayout
                    android:id="@id/post_comment_start_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <View
                        android:id="@id/post_comment_start_view"
                        android:layout_width="@dimen/appgallery_elements_margin_horizontal_l"
                        android:layout_height="1.0px" />
                    <RelativeLayout
                        android:id="@id/post_comment_addimage_layout"
                        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                        android:visibility="gone"
                        android:layout_width="48.0dip"
                        android:layout_height="48.0dip"
                        android:contentDescription="@string/forum_option_insert_img"
                        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                        android:layout_toEndOf="@id/post_comment_start_view">
                        <ImageView
                            android:id="@id/post_comment_addimage_image"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@drawable/aguikit_ic_public_picture"
                            android:layout_centerInParent="true" />
                    </RelativeLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/post_comment_end_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                    android:layout_alignParentEnd="true">
                    <RelativeLayout
                        android:id="@id/post_comment_icon_layout"
                        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                        android:layout_width="48.0dip"
                        android:layout_height="48.0dip"
                        android:contentDescription="@string/forum_post_comment_edittext_hint">
                        <ImageView
                            android:id="@id/post_comment_icon_image"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@drawable/aguikit_ic_public_comments"
                            android:layout_centerInParent="true" />
                        <TextView
                            android:textSize="8.0dip"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:id="@id/post_comment_count"
                            android:layout_width="wrap_content"
                            android:layout_height="10.0dip"
                            android:layout_marginTop="8.0dip"
                            android:minWidth="20.0dip"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:textAlignment="viewStart"
                            android:paddingStart="1.5dip"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/post_comment_like_layout"
                        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                        android:layout_width="48.0dip"
                        android:layout_height="48.0dip"
                        android:contentDescription="@string/forum_post_like">
                        <ImageView
                            android:id="@id/post_comment_like_image"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@drawable/aguikit_ic_public_thumbsup"
                            android:layout_centerInParent="true" />
                        <TextView
                            android:textSize="8.0dip"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:id="@id/post_like_count"
                            android:layout_width="wrap_content"
                            android:layout_height="10.0dip"
                            android:layout_marginTop="8.0dip"
                            android:minWidth="20.0dip"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:textAlignment="viewStart"
                            android:paddingStart="1.5dip"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/post_comment_share_layout"
                        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                        android:layout_width="48.0dip"
                        android:layout_height="48.0dip"
                        android:contentDescription="@string/share_app_title">
                        <ImageView
                            android:id="@id/post_comment_share_image"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@drawable/aguikit_ic_public_share"
                            android:layout_centerInParent="true" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@id/post_comment_publish_layout"
                        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                        android:visibility="gone"
                        android:layout_width="48.0dip"
                        android:layout_height="48.0dip"
                        android:contentDescription="@string/forum_post_reply">
                        <ImageView
                            android:id="@id/post_comment_publish_image"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:src="@drawable/aguikit_ic_public_email_send"
                            android:layout_centerInParent="true" />
                        <ProgressBar
                            android:id="@id/post_comment_loading_image"
                            android:visibility="gone"
                            android:layout_width="24.0dip"
                            android:layout_height="24.0dip"
                            android:layout_centerInParent="true" />
                    </RelativeLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@id/comment_input_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:layout_marginBottom="8.0dip"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                    android:layout_toStartOf="@id/post_comment_end_layout"
                    android:layout_toEndOf="@id/post_comment_start_layout">
                    <com.huawei.uikit.hwedittext.widget.HwCounterTextLayout
                        android:id="@id/comment_publish_content_layout"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layoutDirection="locale"
                        app:hwMaxLength="500"
                        app:hwShapeMode="bubble">
                        <com.huawei.uikit.hwedittext.widget.HwEditText
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:textColorHint="@color/appgallery_text_color_hint"
                            android:id="@id/post_comment_text"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                    </com.huawei.uikit.hwedittext.widget.HwCounterTextLayout>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/post_comment_image_layout"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.appgallery.forum.cards.widget.ForumLineImageView
                    android:id="@id/post_comment_select_image"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginTop="18.0dip"
                    android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
                    android:layout_marginStart="16.0dip"
                    app:corner_radius="@dimen/appgallery_default_corner_radius_s"
                    app:touch_drawable="@drawable/forum_post_comment_select_image" />
                <RelativeLayout
                    android:id="@id/post_comment_delete_image"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                    android:contentDescription="@string/forum_operation_delete"
                    android:layout_marginStart="46.0dip">
                    <ImageView
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/ic_details_cancel_dialogs"
                        android:layout_centerInParent="true" />
                </RelativeLayout>
                <RelativeLayout
                    android:paddingTop="4.0dip"
                    android:paddingBottom="4.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32.0dip"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="18.0dip"
                    android:layout_toEndOf="@id/post_comment_select_image">
                    <CheckBox
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="@color/appgallery_color_secondary"
                        android:id="@id/insert_ai_checkbox"
                        android:background="@null"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forum_option_insert_image_contains_ai"
                        android:layout_centerVertical="true"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>