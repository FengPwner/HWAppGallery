<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/click_layout"
    android:paddingBottom="@dimen/margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/click_card_title_relativelayout"
        layout="@layout/hiappbase_layout_subheader_title_more" />
    <TextView
        android:ellipsize="end"
        android:id="@id/first_content_textview"
        android:background="@drawable/list_item_normal_selector"
        android:paddingBottom="@dimen/appgallery_text_margin_vertical"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end"
        style="@style/detail_card_introduce_content" />
    <TextView
        android:ellipsize="end"
        android:id="@id/second_content_textview"
        android:background="@drawable/list_item_normal_selector"
        android:paddingBottom="@dimen/appgallery_text_margin_vertical"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end"
        style="@style/detail_card_introduce_content" />
    <TextView
        android:ellipsize="end"
        android:id="@id/third_content_textview"
        android:background="@drawable/list_item_normal_selector"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end"
        style="@style/detail_card_introduce_content" />
</LinearLayout>