<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:id="@id/app_recall_popup_container"
    android:background="@drawable/aguikit_card_panel_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
    app:clip_background="true"
    app:round_corner="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/content_container_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/img_video_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@id/top_img"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="21:9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.huawei.appgallery.videokit.api.WiseVideoView
                android:id="@id/video_player"
                android:tag="@string/properties_video_contentDescription"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                app:layout_constraintDimensionRatio="21:9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:media_type="0"
                app:view_type="0" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@id/close_popup"
            android:layout_width="@dimen/appgallery_horizontal_icon_card_space_ring_device"
            android:layout_height="@dimen/appgallery_horizontal_icon_card_space_ring_device"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
            android:src="@drawable/ic_popup_window_close"
            android:contentDescription="@string/wisedist_close"
            android:layout_marginEnd="@dimen/appgallery_default_card_space_vertical_l"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/appgallery_color_card_stroke_on_clicked" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="8.0dip"
            android:textColor="@color/emui_text_primary_inverse"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/top_label"
            android:background="@drawable/substancelistcard_round_chip_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:minWidth="24.0dip"
            android:minHeight="16.0dip"
            android:maxLines="1"
            android:maxEms="9"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/app_detail_recall_img_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_64_dp"
            app:layout_constraintDimensionRatio="42:9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_video_layout">
            <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                android:id="@id/app_icon"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
                android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <com.huawei.appgallery.pageframe.view.DownloadButtonV2
                android:id="@id/dl_btn"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:maxWidth="90.0dip"
                android:minWidth="64.0dip"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:layout_constraintBottom_toBottomOf="@id/app_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/app_icon"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/app_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/wisedist_horizontal_big_card_icon_layout_margin_end"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
                app:layout_constraintBottom_toTopOf="@id/app_desc"
                app:layout_constraintEnd_toStartOf="@id/dl_btn"
                app:layout_constraintStart_toEndOf="@id/app_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/app_desc"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/wisedist_horizontal_big_card_icon_layout_margin_end"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/dl_btn"
                app:layout_constraintStart_toEndOf="@id/app_icon"
                app:layout_constraintTop_toBottomOf="@id/app_name"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:gravity="start|center"
            android:id="@id/recall_invite"
            android:layout_width="fill_parent"
            android:layout_height="26.0dip"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_detail_recall_img_container"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textStyle="bold"
            android:textColor="@color/appgallery_text_primary"
            android:id="@id/tv_use_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recall_invite"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:orientation="vertical"
        android:id="@id/scroll_use_content"
        android:paddingTop="@dimen/appgallery_card_elements_margin_xs"
        android:paddingBottom="@dimen/appgallery_shadow_card_space_vertical"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_below="@id/content_container_layout"
        android:overScrollMode="never"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/tv_use_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
    </ScrollView>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>