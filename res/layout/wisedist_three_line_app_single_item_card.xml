<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/AppListItem"
    android:background="@drawable/aguikit_round_rectangle_card_item_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="80.0dip"
    android:paddingStart="@dimen/appgallery_card_elements_margin_s"
    android:paddingEnd="@dimen/appgallery_card_elements_margin_m"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_middle"
        android:layout_height="@dimen/appgallery_card_icon_size_middle"
        android:src="@color/transparent"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/view"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@id/view"
        android:background="@color/transparent"
        android:layout_width="@dimen/wisedist_serial_number_textview_layout_width"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="@id/appicon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/appicon" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:gravity="center|top"
        android:id="@id/rank_number_textview"
        android:tag="css/.title"
        android:layout_width="@dimen/wisedist_serial_number_textview_layout_width"
        android:layout_height="@dimen/ranking_medal_image_size"
        android:maxLines="1"
        app:hwAutoSizeMinTextSize="15.0dip"
        app:hwAutoSizeStepGranularity="1.0dip"
        app:layout_constraintEnd_toEndOf="@id/view"
        app:layout_constraintStart_toStartOf="@id/view"
        app:layout_constraintTop_toTopOf="@id/view"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:gravity="center"
        android:id="@id/aliasname"
        android:tag="css/.title"
        android:layout_width="@dimen/wisedist_serial_number_textview_layout_width"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:hwAutoSizeMinTextSize="15.0dip"
        app:hwAutoSizeStepGranularity="1.0dip"
        app:layout_constraintEnd_toEndOf="@id/view"
        app:layout_constraintStart_toStartOf="@id/view"
        app:layout_constraintTop_toTopOf="@id/view"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
    <com.huawei.appgallery.pageframe.view.DownloadButtonV2
        android:id="@id/downbtn"
        android:tag="css/.download-button"
        android:layout_width="0.0dip"
        android:layout_height="28.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1.0"
        app:layout_constraintTop_toTopOf="@id/ItemTitle"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@id/ItemTitle"
        android:tag="css/.title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toTopOf="@id/item_text_rl"
        app:layout_constraintEnd_toStartOf="@id/downbtn"
        app:layout_constraintStart_toEndOf="@id/appicon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:id="@id/item_text_rl"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/memo"
        app:layout_constraintEnd_toEndOf="@id/ItemTitle"
        app:layout_constraintStart_toStartOf="@id/ItemTitle"
        app:layout_constraintTop_toBottomOf="@id/ItemTitle">
        <com.huawei.appmarket.framework.widget.PromotionSignTextView
            android:layout_gravity="center_vertical"
            android:id="@id/promotion_sign"
            android:tag="css/.title"
            android:background="@drawable/promotion_sign_bg"
            android:layout_marginEnd="@dimen/appgallery_text_margin_horizontal"
            style="@style/promotion_sign_style" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/ItemText"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
    <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
        android:id="@id/nonadapt_imageview"
        android:visibility="gone"
        android:layout_width="18.0dip"
        android:layout_height="@dimen/ui_14_dp"
        android:scaleType="fitCenter"
        android:paddingEnd="@dimen/appgallery_text_paragraph_margin_xs"
        app:layout_constraintBottom_toBottomOf="@id/memo"
        app:layout_constraintStart_toStartOf="@id/item_text_rl"
        app:layout_constraintTop_toTopOf="@id/memo" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:id="@id/memo"
        android:tag="css/.subtitle"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nonadapt_imageview"
        app:layout_constraintTop_toBottomOf="@id/item_text_rl"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
</androidx.constraintlayout.widget.ConstraintLayout>