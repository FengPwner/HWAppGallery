<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/comment_detail_app_info"
    android:paddingTop="@dimen/padding_s"
    android:paddingBottom="@dimen/padding_l"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_l"
    android:paddingEnd="@dimen/padding_l"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="@dimen/appgallery_card_icon_size_xl"
        android:layout_height="@dimen/appgallery_card_icon_size_xl"
        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l">
        <ImageView
            android:id="@id/comment_detail_app_icon_imageview"
            android:focusable="false"
            android:layout_width="@dimen/appcomment_80_dp"
            android:layout_height="@dimen/appcomment_80_dp"
            android:src="@drawable/app_icon_default_bg"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@id/comment_head_fast_app_icon_imageview"
            android:visibility="gone"
            android:layout_width="@dimen/appcomment_fasticon_size"
            android:layout_height="@dimen/appcomment_fasticon_size"
            android:src="@color/transparent"
            android:scaleType="fitCenter"
            android:layout_alignBottom="@id/comment_detail_app_icon_imageview"
            android:layout_alignEnd="@id/comment_detail_app_icon_imageview" />
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@id/comment_detail_app_name"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/appcomment_head_app_name" />
        <TextView
            android:id="@id/comment_detail_developer"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/appcomment_head_developer" />
    </LinearLayout>
</LinearLayout>