<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/forum_report_item_container"
    android:background="@drawable/list_item_normal_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_list_height_single_text_line"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwcheckbox.widget.HwCheckBox
        android:id="@id/forum_report_type_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingStart="0.0dip"
        android:paddingEnd="0.0dip"
        android:layout_alignParentEnd="true"
        style="@style/Widget.Emui.HwCheckBox.Normal" />
    <TextView
        android:textSize="@dimen/appgallery_text_size_body1"
        android:textColor="@color/appgallery_text_color_primary"
        android:gravity="start"
        android:id="@id/forum_report_type_content"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
        android:layout_toStartOf="@id/forum_report_type_check" />
</RelativeLayout>