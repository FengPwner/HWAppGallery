<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/hwappbarpattern_height"
        layout="@layout/hwappbarpattern_title_item_layout" />
    <ScrollView
        android:id="@id/intro_scroll"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/rl_container"
        android:layout_below="@id/title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/ui_48_dp"
                android:layout_height="@dimen/ui_48_dp"
                android:layout_marginTop="@dimen/ui_12_dp"
                android:src="@drawable/hiapp_introduce_page_logo" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_headline6"
                android:textColor="@color/appgallery_text_primary"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_12_dp"
                android:text="AppGallery"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <ImageView
                android:layout_gravity="center"
                android:id="@id/intro_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_48_dp"
                android:src="@drawable/hiapp_introduce_page_icon" />
            <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:hwColumnEnabled="true"
                app:hwColumnType="content_type">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_subtitle2"
                    android:textColor="@color/appgallery_text_primary"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_24_dp"
                    android:text="@string/hiapp_guide_introduce_subtitle"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body3"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/intro_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_8_dp"
                    android:text="@string/hiapp_guide_introduce_intro_text"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@id/rl_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_16_dp"
        android:layout_marginBottom="@dimen/ui_12_dp"
        android:layout_above="@id/button_got_it_container">
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:orientation="vertical"
            android:id="@id/button_experience_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:hwColumnEnabled="true"
            app:hwColumnType="button_type">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@id/button_experience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/hwbutton_default_height"
                android:text="@string/hiapp_guide_introduce_intro_button_text"
                android:maxLines="1"
                android:singleLine="true"
                android:textAllCaps="true"
                app:hwAutoSizeMinTextSize="9.0sp"
                app:hwAutoSizeStepGranularity="1.0sp"
                style="@style/Widget.Emui.HwButton.Emphasize" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:orientation="vertical"
            android:id="@id/button_experience_normal_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:hwColumnType="button_type">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@id/button_experience_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/hwbutton_default_height"
                android:text="@string/hiapp_guide_introduce_intro_button_text"
                android:maxLines="1"
                android:singleLine="true"
                android:textAllCaps="true"
                app:hwAutoSizeMinTextSize="9.0sp"
                app:hwAutoSizeStepGranularity="1.0sp"
                style="@style/Widget.Emui.HwButton.Borderless" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
    </RelativeLayout>
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:orientation="vertical"
        android:id="@id/button_got_it_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ui_24_dp"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        app:hwColumnType="button_type">
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@id/button_got_it"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/hwbutton_default_height"
            android:text="@string/iknow"
            android:maxLines="1"
            android:singleLine="true"
            android:textAllCaps="true"
            app:hwAutoSizeMinTextSize="9.0sp"
            app:hwAutoSizeStepGranularity="1.0sp"
            style="@style/Widget.Emui.HwButton.Borderless" />
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
</RelativeLayout>