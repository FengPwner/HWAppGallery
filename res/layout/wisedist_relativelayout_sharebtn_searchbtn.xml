<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:tag="css/.body"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/wisedist_title_relativelayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_hwtoolbar_height">
        <LinearLayout
            android:gravity="center"
            android:id="@id/wisedist_arrow_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_height"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="4.0dip">
            <ImageView
                android:id="@id/up"
                android:tag="css/.widget"
                android:layout_width="@dimen/ui_24_dp"
                android:layout_height="@dimen/ui_24_dp"
                android:src="@drawable/aguikit_ic_public_back" />
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center"
            android:orientation="vertical"
            android:id="@id/wisedist_content_linearlayout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginEnd="4.0dip" />
        <FrameLayout
            android:id="@id/container_half_search_box"
            android:focusableInTouchMode="true"
            android:visibility="visible"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/wisedist_menu_extend_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ui_12_dp" />
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
            android:gravity="center"
            android:id="@id/wisedist_title_subscribe_btn_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            app:popupDrawable="@drawable/ic_appabr_subscription"
            app:popupTitle="@string/subscribe_title">
            <ImageView
                android:id="@id/wisedist_title_subscribe_btn_imageview"
                android:tag="css/.widget"
                android:layout_width="@dimen/ui_24_dp"
                android:layout_height="@dimen/ui_24_dp"
                android:src="@drawable/ic_appabr_subscription"
                android:layout_centerVertical="true" />
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
            android:gravity="center"
            android:id="@id/wisedist_title_sharebtn_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            app:popupDrawable="@drawable/aguikit_ic_public_share"
            app:popupTitle="@string/share_friend_title">
            <ImageView
                android:id="@id/wisedist_title_sharebtn_imageview"
                android:tag="css/.widget"
                android:layout_width="@dimen/ui_24_dp"
                android:layout_height="@dimen/ui_24_dp"
                android:src="@drawable/aguikit_ic_public_share"
                android:layout_centerVertical="true" />
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
            android:gravity="center"
            android:id="@id/wisedist_title_searchbtn_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            app:popupDrawable="@drawable/aguikit_ic_public_search"
            app:popupTitle="@string/title_activity_search">
            <ImageView
                android:id="@id/menu_search"
                android:tag="css/.widget"
                android:layout_width="@dimen/ui_24_dp"
                android:layout_height="@dimen/ui_24_dp"
                android:src="@drawable/aguikit_ic_public_search"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_l"
                android:layout_marginEnd="@dimen/margin_l" />
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
            android:gravity="center"
            android:id="@id/wisedist_menu_collapse_layout"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:layout_width="36.0dip"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:contentDescription="@string/card_more_btn"
            app:popupDrawable="@drawable/aguikit_ic_public_more"
            app:popupTitle="@string/card_more_btn">
            <ImageView
                android:id="@id/collapse_icon"
                android:tag="css/.widget"
                android:layout_width="@dimen/ui_24_dp"
                android:layout_height="@dimen/ui_24_dp"
                android:src="@drawable/aguikit_ic_public_more" />
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
        <View
            android:id="@id/title_right_icon_margin"
            android:layout_width="@dimen/margin_s"
            android:layout_height="48.0dip" />
    </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
</LinearLayout>