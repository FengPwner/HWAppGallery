<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.4">
            <ScrollView
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:fillViewport="true"
                android:layout_weight="1.0"
                android:overScrollMode="never">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@id/topLayout"
                        android:scrollbars="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:fadeScrollbars="false"
                        app:hwColumnType="content_type">
                        <ImageView
                            android:id="@id/privacy_app_icon"
                            android:layout_width="@dimen/banner_commodity_width_72"
                            android:layout_height="@dimen/banner_commodity_width_72"
                            android:layout_marginBottom="@dimen/ui_24_dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true" />
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:textSize="@dimen/appgallery_text_size_body2"
                            android:id="@id/privacy_welcome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/cs_2_dp"
                            android:layout_below="@id/privacy_app_icon"
                            android:layout_centerHorizontal="true"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:textSize="30.0dip"
                            android:gravity="center"
                            android:id="@id/privacy_app_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/cs_2_dp"
                            android:layout_below="@id/privacy_welcome"
                            android:layout_centerHorizontal="true"
                            android:fontFamily="@string/appgallery_text_font_family_medium" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body2"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:id="@id/privacy_app_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cs_2_dp"
                            android:layout_below="@id/privacy_app_name"
                            android:layout_centerHorizontal="true"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:textAlignment="center" />
                    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <com.huawei.appgallery.agreementimpl.impl.protocol.ProtocolScrollView
                android:scrollbarSize="4.0dip"
                android:scrollbarThumbVertical="@color/appgallery_shadow_card_text_shadow_color_black"
                android:scrollbarStyle="outsideOverlay"
                android:layout_gravity="bottom"
                android:id="@id/checkBoxScrollLayout"
                android:scrollbars="vertical"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_marginLeft="@dimen/cs_2_dp"
                android:layout_marginRight="@dimen/cs_2_dp"
                android:fillViewport="true"
                android:layout_weight="1.0"
                android:overScrollMode="never">
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingLeft="18.0sp"
                    android:paddingTop="20.0sp"
                    android:paddingRight="18.0sp"
                    android:paddingBottom="0.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@id/privacy_security_icon"
                        android:layout_width="@dimen/cs_24_dp"
                        android:layout_height="@dimen/cs_24_dp"
                        android:layout_marginBottom="@dimen/res_textsize_11dp" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/dialog_subtitle_size"
                        android:textStyle="bold"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:gravity="center_horizontal"
                        android:id="@id/agreement_mz_putitle"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5.0dip"
                        android:layout_marginBottom="@dimen/cs_2_dp"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:id="@id/agreement_mz_pucontent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/dialog_subtitle_size"
                        android:textStyle="bold"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:gravity="center_horizontal"
                        android:id="@id/agreement_mz_privacy"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:layout_marginBottom="@dimen/cs_2_dp"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:id="@id/agreement_mz_privacycontent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/bottomLayout"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true">
                        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                            android:layout_gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:paddingTop="@dimen/ui_24_dp"
                            android:paddingBottom="@dimen/ui_24_dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            app:hwColumnType="content_type">
                            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                                android:gravity="center"
                                android:id="@id/privacy_negative_button"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/c_exit_cancel"
                                android:layout_weight="1.0"
                                android:textAllCaps="true"
                                app:hwAutoSizeMinTextSize="9.0sp"
                                app:hwAutoSizeStepGranularity="@dimen/res_textsize_1sp"
                                style="@style/Widget.Emui.HwButton" />
                            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                                android:gravity="center"
                                android:id="@id/privacy_positive_button"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/c_protocol_agree_btn"
                                android:layout_weight="1.0"
                                android:textAllCaps="true"
                                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                                app:hwAutoSizeMinTextSize="9.0sp"
                                app:hwAutoSizeStepGranularity="@dimen/res_textsize_1sp"
                                style="@style/Widget.Emui.HwButton" />
                        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.huawei.appgallery.agreementimpl.impl.protocol.ProtocolScrollView>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>