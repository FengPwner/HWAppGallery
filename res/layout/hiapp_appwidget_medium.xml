<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/medium_appwidget_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/medium_appwidget_topic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/hiapp_appwidget_panel_bg"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:maxWidth="@dimen/hiapp_medium_appwidget_card_size"
        android:maxHeight="@dimen/hiapp_medium_appwidget_card_size"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/wisejoin_image" />
</RelativeLayout>