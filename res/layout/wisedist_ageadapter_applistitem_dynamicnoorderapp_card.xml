<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:orientation="vertical"
    android:id="@id/ll_testapp_item"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_card_height_three_text_lines"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/iv_appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
        android:src="@color/transparent"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
        app:layout_constraintStart_toEndOf="@id/view"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@id/view"
        android:background="@color/transparent"
        android:layout_width="84.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="@id/iv_appicon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_appicon" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/wisedist_ageadapter_title_text_size"
        android:gravity="center"
        android:id="@id/tv_rank_num"
        android:tag="css/.title"
        android:layout_width="29.0dip"
        android:layout_height="@dimen/ranking_medal_image_size"
        android:maxLines="1"
        app:hwAutoSizeMinTextSize="12.0sp"
        app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
        app:layout_constraintBottom_toBottomOf="@id/view"
        app:layout_constraintEnd_toEndOf="@id/view"
        app:layout_constraintStart_toStartOf="@id/view"
        app:layout_constraintTop_toTopOf="@id/view"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
    <RelativeLayout
        android:id="@id/app_serial_layout"
        android:visibility="gone"
        android:layout_width="84.0dip"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="@id/view"
        app:layout_constraintEnd_toEndOf="@id/view"
        app:layout_constraintStart_toStartOf="@id/view"
        app:layout_constraintTop_toTopOf="@id/view">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/appSerialBg"
            android:visibility="invisible"
            android:layout_width="84.0dip"
            android:layout_height="wrap_content"
            android:text="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/wisedist_ageadapter_title_text_size"
            android:gravity="center"
            android:id="@id/appSerial"
            android:tag="css/.title"
            android:layout_width="84.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:hwAutoSizeMinTextSize="12.0sp"
            app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
    </RelativeLayout>
    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/title_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_appicon">
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/tv_title"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/second_line"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_layout" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/third_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/second_line">
        <RelativeLayout
            android:id="@id/upordown_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m">
            <ImageView
                android:id="@id/iv_upordown"
                android:layout_width="@dimen/comment_min_textsize"
                android:layout_height="@dimen/comment_min_textsize"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/tv_number"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:textAlignment="viewStart"
                android:layout_toEndOf="@id/iv_upordown"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/score_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m">
            <ImageView
                android:id="@id/iv_star"
                android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
                android:layout_height="@dimen/hiappbase_card_fasticon_size_large"
                android:src="@drawable/wisedist_ic_star"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />
            <TextView
                android:ellipsize="end"
                android:id="@id/tv_score"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:textAlignment="viewStart"
                android:layout_marginStart="1.0dip"
                android:layout_toEndOf="@id/iv_star"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </RelativeLayout>
        <TextView
            android:ellipsize="end"
            android:id="@id/tv_package_size"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <TextView
            android:ellipsize="end"
            android:id="@id/tv_install_times"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <TextView
            android:ellipsize="end"
            android:id="@id/tv_types"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <TextView
            android:ellipsize="end"
            android:id="@id/tv_status"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <TextView
            android:ellipsize="end"
            android:id="@id/tv_memo"
            android:tag="css/.subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
    <com.huawei.appgallery.pageframe.view.DownloadButtonV2
        android:id="@id/downbtn"
        android:tag="css/.download-button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:minHeight="28.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/third_line"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
    <View
        android:id="@id/devider_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AppGallery.Widget.Divider" />
</androidx.constraintlayout.widget.ConstraintLayout>