<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:id="@id/forum_section_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip">
        <ImageView
            android:id="@id/forum_section_icon"
            android:layout_width="56.0dip"
            android:layout_height="56.0dip"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="16.0dip"
            android:layout_toEndOf="@id/forum_section_icon">
            <RelativeLayout
                android:id="@id/name_button"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/res_textsize_16dp"
                    android:textColor="@color/forum_base_buoy_emui_primary"
                    android:ellipsize="end"
                    android:id="@id/forum_section_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:fontFamily="@string/emui_text_font_family_medium"
                    android:textAlignment="viewStart"
                    android:layout_marginEnd="@dimen/margin_l"
                    android:layout_toStartOf="@id/forum_section_follow" />
                <com.huawei.uikit.phone.hwbutton.widget.HwButton
                    android:textSize="@dimen/res_textsize_14dp"
                    android:textColor="@color/appgallery_text_color_primary_activated"
                    android:gravity="center"
                    android:id="@id/forum_section_follow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64.0dip"
                    android:minHeight="28.0dip"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:textAllCaps="true"
                    android:fontFamily="@string/emui_text_font_family_medium"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/forum_post_and_follow_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xs"
                android:layout_below="@id/name_button">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/forum_post_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_l">
                    <TextView
                        android:textSize="@dimen/res_textsize_12dp"
                        android:textColor="@color/forum_base_buoy_emui_primary"
                        android:ellipsize="end"
                        android:id="@id/forum_post"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginEnd="@dimen/margin_s" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/forum_followed_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_l">
                    <TextView
                        android:textSize="@dimen/res_textsize_12dp"
                        android:textColor="@color/forum_base_buoy_emui_primary"
                        android:ellipsize="end"
                        android:id="@id/forum_followed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginEnd="@dimen/margin_s" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/forum_contribution_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_l">
            <TextView
                android:textSize="@dimen/res_textsize_12dp"
                android:textColor="@color/forum_base_buoy_emui_primary"
                android:ellipsize="end"
                android:id="@id/forum_contribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_below="@id/forum_section_name"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginEnd="@dimen/margin_s" />
            <ImageView
                android:layout_width="8.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/forum_ic_arrow_white" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/forum_claim_welfare_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/res_textsize_12dp"
                android:textColor="@color/forum_base_buoy_emui_primary"
                android:ellipsize="end"
                android:id="@id/forum_claim_welfare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forum_claim_welfare"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginEnd="@dimen/margin_s" />
            <ImageView
                android:layout_width="8.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/forum_ic_arrow_white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>