<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:gravity="center"
        android:id="@id/video_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        app:clip_background="true"
        app:round_corner="@dimen/appgallery_default_corner_radius_l"
        app:stroke_width="@dimen/appgallery_card_stroke_width">
        <com.huawei.appgallery.videokit.api.WiseVideoView
            android:id="@id/video_player"
            android:tag="@string/properties_video_contentDescription"
            android:background="@android:color/transparent"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:media_type="0"
            app:view_type="0" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    <include
        android:id="@id/bigcard_des_layout"
        layout="@layout/search_bigcard_des_include" />
</LinearLayout>