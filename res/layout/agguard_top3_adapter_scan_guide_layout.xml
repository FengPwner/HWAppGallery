<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/top3_scan_guide_layout"
    android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
    android:paddingTop="@dimen/ui_12_dp"
    android:paddingBottom="@dimen/ui_12_dp"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/ui_12_dp"
    android:paddingEnd="@dimen/ui_12_dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/top3_scan_guide_icon"
        android:layout_width="32.0dip"
        android:layout_height="32.0dip" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_8_dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/top3_scan_guide_title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@id/top3_scan_guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cs_2_dp"
                android:text="@string/agguard_records_title"
                android:maxLines="1"
                style="@style/AppGallery.Widget.SubHeader.Title" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/appgallery_text_size_body3"
            android:textColor="@color/appgallery_text_color_tertiary"
            android:id="@id/top3_scan_guide_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>