<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appgallery.forum.cards.widget.PostTitleTextView
        android:ellipsize="end"
        android:id="@id/forum_post_moment_content"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:textAlignment="viewStart"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
    <com.huawei.appgallery.forum.cards.widget.MomentImgView
        android:id="@id/forum_post_moment_img"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip" />
</LinearLayout>