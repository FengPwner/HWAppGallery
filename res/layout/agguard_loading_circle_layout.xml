<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/loadingBar_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/middle_text_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@id/progress_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/agguard_scan_progress_text_size"
                    android:id="@id/percent_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="16.0dip"
                    android:id="@id/percent_symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agguard_scan_percent_symbol"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="1.0dip"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Secondary" />
            </LinearLayout>
        </LinearLayout>
        <com.huawei.uikit.phone.hwprogressindicator.widget.HwProgressIndicator
            android:id="@id/loading_circle"
            android:layout_width="@dimen/agguard_scan_layout_size"
            android:layout_height="@dimen/agguard_scan_layout_size"
            android:layout_centerInParent="true"
            app:hwSizeMode="middle" />
    </RelativeLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="18.0sp"
        android:textColor="@color/appgallery_text_color_primary"
        android:id="@id/scanning_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:text="@string/agguard_str_scanning"
        android:layout_below="@id/loadingBar_layout"
        android:layout_centerHorizontal="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:textDirection="locale" />
</RelativeLayout>