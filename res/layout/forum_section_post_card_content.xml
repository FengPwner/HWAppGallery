<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@id/forum_section_post_user_viewstub"
            android:layout="@layout/forum_section_post_top_user_viewstub_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <ViewStub
            android:id="@id/forum_feed_post_section_viewstub"
            android:layout="@layout/forum_feed_post_section_viewstub_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/forum_more"
            android:background="@drawable/forum_more_selector"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/appgallery_card_icon_size_middle"
            android:layout_centerVertical="true"
            android:contentDescription="@string/card_more_btn"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/detail_delete_reply_icon_imageview"
                android:background="@drawable/aguikit_ic_public_more_list"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:scaleType="centerCrop" />
        </LinearLayout>
    </RelativeLayout>
    <ViewStub
        android:id="@id/forum_section_post_error_viewstub"
        android:layout="@layout/forum_section_post_error_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/forum_section_post_main_body"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.forum.cards.widget.PostTitleTextView
            android:ellipsize="end"
            android:id="@id/forum_section_post_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
        <com.huawei.appgallery.forum.cards.widget.HighLightTextView
            android:ellipsize="end"
            android:id="@id/forum_section_post_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:maxLines="2"
            android:lineSpacingMultiplier="1.1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        <ViewStub
            android:id="@id/forum_section_post_stub_video"
            android:layout="@layout/forum_section_post_video_banner_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <ViewStub
            android:id="@id/forum_section_post_stub_vote"
            android:layout="@layout/forum_section_post_vote_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <ViewStub
            android:id="@id/forum_section_post_stub_moment"
            android:layout="@layout/forum_section_post_moment_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <ViewStub
            android:id="@id/forum_section_post_stub_banner"
            android:layout="@layout/forum_section_post_banner_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <ViewStub
            android:id="@id/forum_section_post_stub_three_imgs"
            android:layout="@layout/forum_section_post_three_img_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
    </LinearLayout>
</merge>