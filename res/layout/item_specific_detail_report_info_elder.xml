<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:paddingTop="@dimen/component_detail_report_item_common_margin_vertical"
    android:paddingBottom="@dimen/component_detail_report_proof_add_size"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    android:paddingStart="@dimen/component_detail_report_item_common_margin_horizontal"
    android:paddingEnd="@dimen/component_detail_report_item_common_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.RoundImageView
        android:id="@id/iv_logo"
        android:focusable="false"
        android:layout_width="@dimen/component_detail_report_logo_width"
        android:layout_height="@dimen/component_detail_report_logo_height"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:corner_radius="@dimen/component_detail_report_logo_radius"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body1"
        android:textColor="@color/appgallery_text_color_primary"
        android:id="@id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_detail_report_margin_xl"
        android:layout_marginBottom="@dimen/stroke_line_width"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body3"
        android:textColor="@color/appgallery_text_color_secondary"
        android:id="@id/tv_developer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_detail_report_margin_l"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_name" />
</androidx.constraintlayout.widget.ConstraintLayout>