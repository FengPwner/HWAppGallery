<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12.0dip"
    android:importantForAccessibility="no"
    android:layout_marginStart="16.0dip"
    android:layout_marginEnd="16.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appgallery.agguard.business.ui.view.DrawableTextView
        android:textSize="@dimen/appgallery_text_size_subtitle2"
        android:textColor="@color/appgallery_text_color_primary"
        android:gravity="start|center"
        android:layout_gravity="center_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/agguard_scan_item_detail"
        android:includeFontPadding="false"
        android:drawablePadding="8.0dip"
        android:drawableStart="@drawable/agguard_safety_report_detail_icon"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:textDirection="locale"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip"
        style="@style/AppGallery.Widget.SubHeader.ViewGroup" />
    <View
        android:id="@id/divider"
        android:layout_width="fill_parent"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip"
        style="@style/AppGallery.Widget.Divider" />
    <GridLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@id/detail_grid_layout"
        android:paddingTop="16.0dip"
        android:paddingBottom="24.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip" />
    <View
        android:id="@id/divider_bottom"
        android:layout_width="fill_parent"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>