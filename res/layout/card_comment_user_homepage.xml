<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.appgallery.forum.cards.widget.PostUserContentView
            android:id="@id/comment_user_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="24.0dip" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/forum_more"
            android:background="@drawable/forum_more_selector"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/appgallery_card_icon_size_middle"
            android:layout_centerVertical="true"
            android:contentDescription="@string/card_more_btn"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/detail_delete_reply_icon_imageview"
                android:background="@drawable/aguikit_ic_public_more_list"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:scaleType="centerCrop" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/user_comment_home_conetnt"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/appgallery_max_padding_end"
        android:layout_marginStart="68.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/error_tip_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m">
            <ImageView
                android:layout_width="@dimen/forum_error_icon_size_normal"
                android:layout_height="@dimen/forum_error_icon_size_normal"
                android:src="@drawable/aguikit_ic_public_error"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_vertical" />
            <TextView
                android:id="@id/error_tip_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appgallery.forum.cards.widget.FoldTextView
                android:id="@id/reply_content_tv_open"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
        </FrameLayout>
        <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
            android:id="@id/reply_img"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:scaleType="fitStart"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="48.0dip">
            <TextView
                android:textSize="@dimen/appgallery_text_size_button2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:gravity="left"
                android:id="@id/open_or_fold_tv"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forum_user_fold_content"
                android:layout_centerVertical="true"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/like_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <ImageView
                        android:id="@id/like_comment_iv"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:src="@drawable/aguikit_ic_public_thumbsup"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/forum_user_like"
                        android:layout_alignParentEnd="true" />
                    <TextView
                        android:textSize="@dimen/emui_master_caption_2_dp"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:id="@id/like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/reply_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/margin_l">
                    <ImageView
                        android:id="@id/reply_comment_iv"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:src="@drawable/aguikit_ic_public_comments"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/forum_post_comment_reply"
                        android:layout_marginEnd="@dimen/margin_s"
                        android:layout_alignParentEnd="true" />
                    <TextView
                        android:textSize="@dimen/emui_master_caption_2_dp"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:id="@id/reply_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/forum_share"
                    android:background="@drawable/forum_more_selector"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/share_app_title"
                    android:layout_marginStart="@dimen/margin_l">
                    <ImageView
                        android:id="@id/iv_forum_personl_center_share"
                        android:background="@drawable/aguikit_ic_public_share"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="@dimen/margin_s" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <com.huawei.appgallery.forum.user.usercenter.widget.CommentReferenceView
        android:id="@id/comment_card_reference_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8.0dip"
        android:layout_marginBottom="@dimen/margin_l"
        android:layout_marginStart="68.0dip"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
</LinearLayout>