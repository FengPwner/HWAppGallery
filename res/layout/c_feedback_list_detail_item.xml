<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/emui_master_caption_2"
        android:textColor="@color/emui_color_gray_7"
        android:id="@id/time_stamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_l"
        android:layout_centerHorizontal="true" />
    <ImageView
        android:id="@id/feedback_person_icon"
        android:layout_width="32.0dip"
        android:layout_height="32.0dip"
        android:layout_marginTop="@dimen/margin_l"
        android:src="@drawable/c_feedback_list_consumer"
        android:layout_below="@id/time_stamp"
        android:layout_marginEnd="@dimen/margin_l"
        android:layout_alignParentEnd="true" />
    <TextView
        android:textSize="@dimen/emui_master_subtitle"
        android:textColor="@color/c_feedback_question_color"
        android:id="@id/feedback_person_question"
        android:background="@drawable/c_feedback_list_background_question"
        android:paddingTop="@dimen/padding_m"
        android:paddingBottom="@dimen/padding_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_below="@id/time_stamp"
        android:paddingStart="@dimen/padding_l"
        android:paddingEnd="@dimen/padding_l"
        android:layout_marginStart="56.0dip"
        android:layout_marginEnd="@dimen/margin_m"
        android:layout_toStartOf="@id/feedback_person_icon" />
    <ImageView
        android:id="@id/feedback_customer_icon"
        android:layout_width="32.0dip"
        android:layout_height="32.0dip"
        android:layout_marginTop="@dimen/margin_l"
        android:src="@drawable/c_feedback_list_customer_services"
        android:layout_below="@id/feedback_person_question"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_alignParentStart="true" />
    <TextView
        android:textSize="@dimen/emui_master_subtitle"
        android:textColor="#ff191919"
        android:id="@id/feedback_customer_answer"
        android:background="@drawable/c_feedback_list_background_answer"
        android:paddingTop="@dimen/padding_m"
        android:paddingBottom="@dimen/padding_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_below="@id/feedback_person_question"
        android:paddingStart="@dimen/padding_l"
        android:paddingEnd="@dimen/padding_l"
        android:layout_marginStart="@dimen/margin_m"
        android:layout_marginEnd="56.0dip"
        android:layout_toEndOf="@id/feedback_customer_icon" />
</RelativeLayout>