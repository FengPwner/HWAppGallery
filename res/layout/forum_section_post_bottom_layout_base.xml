        android:maxLines="1"
        android:layout_centerVertical="true"
        android:lineSpacingMultiplier="1.2"
        android:layout_toStartOf="@id/operation_layout"
        android:layout_alignParentStart="true"
        style="@style/AppGallery.TextAppearance.Card.TextBody4.Tertiary" />
</RelativeLayout>