<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/faq_emui_white_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:id="@id/scroll_view"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true"
        android:layout_above="@id/btn_submit_host">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@id/ll_category"
                android:paddingBottom="@dimen/feedback_sdk_common_10_dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end">
                <TextView
                    android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                    android:textColor="@color/feedback_sdk_text_normal_black_50"
                    android:gravity="bottom"
                    android:id="@id/txt_style_title"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/feedback_sdk_common_36_dp"
                    android:text="@string/feedback_sdk_problem_type" />
                <ImageView
                    android:layout_width="@dimen/feedback_sdk_common_16_dip"
                    android:layout_height="@dimen/feedback_sdk_common_16_dip"
                    android:src="@drawable/feedback_sdk_icon_label_star" />
            </LinearLayout>
            <TextView
                android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                android:textColor="@color/feedback_sdk_text_normal_black"
                android:textColorHint="@color/feedback_sdk_text_normal_black"
                android:gravity="center_vertical"
                android:id="@id/txt_style"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/feedback_sdk_common_48_dip"
                android:text=""
                android:hint="@string/feedback_sdk_contact_fill_city"
                android:drawablePadding="@dimen/feedback_sdk_common_16_dip"
                android:drawableEnd="@drawable/feedback_sdk_cs_arrow_right"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end" />
            <TextView
                android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                android:textColor="@color/feedback_sdk_text_normal_black"
                android:textColorHint="@color/feedback_sdk_text_normal_black"
                android:gravity="center_vertical"
                android:id="@id/txt_style_2"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/feedback_sdk_common_36_dp"
                android:text=""
                android:hint="@string/feedback_sdk_contact_fill_city"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/grid_styles"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end" />
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@id/ll_description"
                android:paddingBottom="@dimen/feedback_sdk_common_10_dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end">
                <TextView
                    android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                    android:textColor="@color/feedback_sdk_text_normal_black_50"
                    android:gravity="bottom"
                    android:id="@id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/feedback_sdk_common_36_dp"
                    android:text="@string/feedback_sdk_problem_question_info_advice" />
                <ImageView
                    android:layout_width="@dimen/feedback_sdk_common_16_dip"
                    android:layout_height="@dimen/feedback_sdk_common_16_dip"
                    android:src="@drawable/feedback_sdk_icon_label_star" />
            </LinearLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@id/rl_description"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/feedback_sdk_common_8_dip"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/rl_edittext"
                    android:background="@drawable/feedback_sdk_problem_rectangle_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                        android:textColor="@color/feedback_sdk_text_normal_black"
                        android:textColorHint="@color/feedback_sdk_text_normal_black_50"
                        android:gravity="start|center|top"
                        android:id="@id/edit_desc"
                        android:background="@null"
                        android:paddingTop="@dimen/feedback_sdk_common_8_dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/feedback_sdk_common_108_dp"
                        android:textAlignment="viewStart"
                        android:paddingStart="@dimen/feedback_sdk_common_16_dip"
                        android:paddingEnd="@dimen/feedback_sdk_common_16_dip" />
                    <TextView
                        android:textSize="@dimen/feedback_sdk_common_ui_12_sp"
                        android:textColor="@color/feedback_sdk_common_black_50"
                        android:layout_gravity="end|bottom|center"
                        android:id="@id/txt_number"
                        android:paddingBottom="@dimen/feedback_sdk_common_8_dip"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/feedback_sdk_common_16_dip" />
                </LinearLayout>
                <com.huawei.phoneservice.feedback.widget.FeedbackGridView
                    android:id="@id/list_media"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/feedback_sdk_common_8_dip"
                    android:listSelector="@android:color/transparent"
                    android:horizontalSpacing="@dimen/feedback_sdk_common_10_dip"
                    android:verticalSpacing="@dimen/feedback_sdk_common_10_dip"
                    android:layout_below="@id/rl_edittext" />
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/ll_phone_or_email"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@id/ll_contact"
                    android:paddingBottom="@dimen/feedback_sdk_common_10_dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/emui_dimens_max_start"
                    android:layout_marginEnd="@dimen/emui_dimens_max_end">
                    <TextView
                        android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                        android:textColor="@color/feedback_sdk_text_normal_black_50"
                        android:gravity="bottom"
                        android:id="@id/feedback_contact_view"
                        android:visibility="visible"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/feedback_sdk_common_36_dp"
                        android:text="@string/feedback_sdk_problem_contact_type" />
                    <ImageView
                        android:id="@id/feedback_contact_red_star"
                        android:layout_width="@dimen/feedback_sdk_common_16_dip"
                        android:layout_height="@dimen/feedback_sdk_common_16_dip"
                        android:src="@drawable/feedback_sdk_icon_label_star" />
                </LinearLayout>
                <EditText
                    android:textSize="16.0sp"
                    android:textColor="@color/feedback_sdk_text_normal_black"
                    android:textColorHint="@color/feedback_sdk_text_normal_black_50"
                    android:gravity="start|center"
                    android:id="@id/edit_contact"
                    android:background="@drawable/feedback_sdk_problem_rectangle_bg"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/feedback_sdk_common_8_dip"
                    android:minHeight="36.0dip"
                    android:hint="@string/feedback_sdk_problem_phone_email"
                    android:textAlignment="viewStart"
                    android:paddingStart="@dimen/feedback_sdk_common_16_dip"
                    android:paddingEnd="@dimen/feedback_sdk_common_16_dip"
                    android:layout_marginStart="@dimen/emui_dimens_max_start"
                    android:layout_marginEnd="@dimen/emui_dimens_max_end" />
            </LinearLayout>
            <RelativeLayout
                android:id="@id/cbx_host"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_sdk_common_8_dip"
                android:layout_marginBottom="@dimen/feedback_sdk_common_10_dip"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end">
                <CheckBox
                    android:id="@id/cbx_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Emui.HwCheckBox.Normal" />
                <TextView
                    android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
                    android:textColor="@color/feedback_sdk_text_normal_black"
                    android:id="@id/cbx_text"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_sdk_upload_log_hint"
                    android:layout_centerVertical="true"
                    android:textAlignment="viewStart"
                    android:layout_toEndOf="@id/cbx_log" />
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/emui_text_size_body3"
                android:textColor="@color/problem_suggest_privacy_color"
                android:id="@id/problem_suggest_tv_privacy"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/feedback_sdk_common_10_dip"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end" />
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/emui_text_size_body2"
        android:textColor="@color/emui_control_highlight"
        android:gravity="center"
        android:id="@id/tv_tryagain"
        android:background="@color/faq_emui_white_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/emui_dimens_element_vertical_large"
        android:text="@string/feedback_sdk_zipcompress_btn"
        android:layout_centerHorizontal="true"
        android:textAllCaps="true"
        android:fontFamily="@string/emui_text_font_family_medium" />
    <Button
        android:id="@id/bg_dismiss"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:gravity="center"
        android:id="@id/layout_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btn_submit_host"
        android:layout_centerHorizontal="true">
        <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
            android:id="@id/progress_bar"
            android:layout_width="@dimen/feedback_sdk_common_24_dip"
            android:layout_height="@dimen/feedback_sdk_common_24_dip"
            style="@style/Widget.Emui.HwProgressBar" />
        <TextView
            android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
            android:textColor="@color/feedback_sdk_text_normal_black"
            android:gravity="center"
            android:id="@id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_sdk_common_in_submission"
            android:layout_marginStart="@dimen/feedback_sdk_common_8_dip" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@id/btn_submit_host"
        android:background="@color/faq_emui_white_bg"
        android:paddingTop="@dimen/feedback_sdk_common_16_dip"
        android:paddingBottom="@dimen/feedback_sdk_common_16_dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <Button
            android:enabled="true"
            android:id="@id/btn_submit"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/feedback_sdk_common_commite"
            style="@style/Widget.Emui.HwButton.Emphasize" />
    </LinearLayout>
    <com.huawei.phoneservice.feedback.widget.FeedbackNoticeView
        android:id="@id/feedback_problem_noticeView"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:fbsdknoticeAutoFitCenterYInLandScape="true"
        app:fbsdknoticeViewType="progress" />
</RelativeLayout>