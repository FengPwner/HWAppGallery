<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/check_box_prize_collect_tips_text_view">
        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <RelativeLayout
                android:id="@id/address_info_layout"
                android:background="@drawable/aguikit_card_panel_bg"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end">
                <TableLayout
                    android:layout_gravity="start"
                    android:id="@id/address_info"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1"
                    android:shrinkColumns="1"
                    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
                    <LinearLayout
                        android:id="@id/select_phone_country_code_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:id="@id/country_region_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/country_and_region"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:id="@id/user_phone_country_code_click_area"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@id/nickname_arrow_oversea"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                style="@style/AppGallery.Widget.List.RightArrow" />
                            <TextView
                                android:textSize="@dimen/appgallery_text_size_body2"
                                android:textColor="@color/appgallery_text_color_secondary"
                                android:ellipsize="end"
                                android:gravity="right"
                                android:id="@id/user_phone_country_code"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="8.0dip"
                                android:maxLines="1"
                                android:layout_centerVertical="true"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                android:layout_toStartOf="@id/nickname_arrow_oversea"
                                style="@style/AppGallery.TextAppearance.List.TextBody1" />
                        </RelativeLayout>
                    </LinearLayout>
                    <TableRow
                        android:id="@id/user_info_name_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/user_address_tag_length"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_info_name_remind"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@id/txt_baseline_username"
                                android:visibility="invisible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:text="@string/about"
                                android:layout_centerVertical="true"
                                style="@style/message_item_key" />
                            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                                android:textSize="@dimen/appgallery_text_size_body1"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:textColorHint="@color/appgallery_text_color_hint"
                                android:ellipsize="end"
                                android:id="@id/user_info_name"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/mine_info_name_remind_hint"
                                android:maxLines="1"
                                android:includeFontPadding="true"
                                android:maxLength="200"
                                android:layout_centerVertical="true"
                                android:inputType="text"
                                android:imeOptions="actionNone"
                                android:textCursorDrawable="@drawable/ic_cursor"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                style="@style/Widget.Emui.HwEditText.Space" />
                        </RelativeLayout>
                    </TableRow>
                    <TableRow
                        android:id="@id/user_info_receiver_telephone_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/user_address_tag_length"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_info_receive_telephone_remind"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@id/txt_baseline_tele"
                                android:visibility="invisible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:text="@string/about"
                                android:layout_centerVertical="true"
                                style="@style/message_item_key" />
                            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                                android:textSize="@dimen/appgallery_text_size_body1"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:textColorHint="@color/appgallery_text_color_hint"
                                android:ellipsize="end"
                                android:id="@id/user_info_receiver_telephone"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/mine_info_phone_number_remind_hint"
                                android:maxLines="1"
                                android:maxLength="50"
                                android:layout_centerVertical="true"
                                android:inputType="phone"
                                android:imeOptions="actionNone"
                                android:textCursorDrawable="@drawable/ic_cursor"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                style="@style/Widget.Emui.HwEditText.Space" />
                        </RelativeLayout>
                    </TableRow>
                    <TableRow
                        android:id="@id/user_info_area_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/user_address_tag_length"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_info_area_remind"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:visibility="invisible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:text="@string/about"
                                android:layout_centerVertical="true"
                                style="@style/message_item_key" />
                            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                                android:textSize="@dimen/appgallery_text_size_body1"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:textColorHint="@color/appgallery_text_color_hint"
                                android:ellipsize="end"
                                android:id="@id/user_info_area"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dip"
                                android:hint="@string/mine_info_state_province_remind_hint"
                                android:maxLines="1"
                                android:scrollHorizontally="false"
                                android:maxLength="500"
                                android:layout_alignParentTop="true"
                                android:layout_centerVertical="true"
                                android:inputType="text"
                                android:imeOptions="actionNone"
                                android:textCursorDrawable="@drawable/ic_cursor"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                style="@style/Widget.Emui.HwEditText.Space" />
                        </RelativeLayout>
                    </TableRow>
                    <TableRow
                        android:id="@id/user_info_city_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/user_address_tag_length"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_info_city_remind"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:visibility="invisible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:text="@string/about"
                                android:layout_centerVertical="true"
                                style="@style/message_item_key" />
                            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                                android:textSize="@dimen/appgallery_text_size_body1"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:textColorHint="@color/appgallery_text_color_hint"
                                android:ellipsize="end"
                                android:id="@id/user_info_city"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dip"
                                android:hint="@string/mine_info_city_remind_hint"
                                android:maxLines="1"
                                android:scrollHorizontally="false"
                                android:maxLength="500"
                                android:layout_alignParentTop="true"
                                android:layout_centerVertical="true"
                                android:inputType="text"
                                android:imeOptions="actionNone"
                                android:textCursorDrawable="@drawable/ic_cursor"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                style="@style/Widget.Emui.HwEditText.Space" />
                        </RelativeLayout>
                    </TableRow>
                    <TableRow
                        android:id="@id/user_info_postal_code_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_info_postal_code_remind"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:visibility="invisible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:text="@string/about"
                                android:layout_centerVertical="true"
                                style="@style/message_item_key" />
                            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                                android:textSize="@dimen/appgallery_text_size_body1"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:textColorHint="@color/appgallery_text_color_hint"
                                android:ellipsize="end"
                                android:id="@id/user_info_postal_code"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dip"
                                android:layout_marginBottom="2.0dip"
                                android:hint="@string/mine_info_postalcode_remind_hint"
                                android:maxLines="1"
                                android:scrollHorizontally="false"
                                android:maxLength="50"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentBottom="true"
                                android:layout_centerVertical="true"
                                android:inputType="number"
                                android:imeOptions="actionNone"
                                android:textCursorDrawable="@drawable/ic_cursor"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                style="@style/Widget.Emui.HwEditText.Space" />
                        </RelativeLayout>
                    </TableRow>
                    <TableRow
                        android:id="@id/user_info_addr_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon">
                        <TextView
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/user_address_tag_length"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_info_addr_remind"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:visibility="invisible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:text="@string/about"
                                android:layout_centerVertical="true"
                                style="@style/message_item_key" />
                            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                                android:textSize="@dimen/appgallery_text_size_body1"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:textColorHint="@color/appgallery_text_color_hint"
                                android:ellipsize="end"
                                android:id="@id/user_info_addr"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/mine_info_addr_short_remind_hint"
                                android:maxLines="1"
                                android:scrollHorizontally="false"
                                android:maxLength="900"
                                android:layout_centerVertical="true"
                                android:inputType="text"
                                android:imeOptions="actionNone"
                                android:textCursorDrawable="@drawable/ic_cursor"
                                android:textAllCaps="false"
                                android:fontFamily="@string/appgallery_text_font_family_regular"
                                style="@style/Widget.Emui.HwEditText.Space" />
                        </RelativeLayout>
                    </TableRow>
                </TableLayout>
            </RelativeLayout>
        </ScrollView>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_text_color_primary"
        android:gravity="top"
        android:id="@id/check_box_prize_collect_tips_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginBottom="@dimen/margin_l"
        android:text="@string/settings_prize_collect_tips"
        android:layout_above="@id/change_submit_btn"
        android:layout_centerHorizontal="true"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.TextAppearance.Paragraph.TextBody2" />
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:gravity="center"
        android:id="@id/change_submit_btn"
        android:layout_width="@dimen/cs_button_min_width"
        android:layout_height="@dimen/hwbutton_default_height"
        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
        android:text="@string/detail_comment_submit"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwAutoSizeMinTextSize="9.0sp"
        app:hwAutoSizeStepGranularity="1.0sp"
        style="@style/Widget.Emui.HwButton.Emphasize" />
</RelativeLayout>