<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.assistantdock.buoydock.uikit.navigator.NavigatorMaxWidthLinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/buoy_navigator_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwsubtab.widget.HwSubTabWidget
                android:layout_gravity="center_horizontal"
                android:id="@id/buoy_subtab"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </com.huawei.appgallery.assistantdock.buoydock.uikit.navigator.NavigatorMaxWidthLinearLayout>
    </LinearLayout>
    <com.huawei.uikit.hwviewpager.widget.HwViewPager
        android:id="@id/buoy_pager"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:overScrollMode="never" />
</LinearLayout>