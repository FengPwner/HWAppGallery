<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/agguard_tip_fragment_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.phone.hwbubblelayout.widget.HwBubbleLayout
        android:id="@id/bubble_layout_popup"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:hwArrowDirection="top"
        app:hwArrowPosition="0.0dip"
        app:hwArrowStartLocation="negative"
        app:hwShadowEnabled="true"
        app:hwWidgetStyle="light"
        style="@style/Widget.Emui.HwBubbleLayout.Light">
        <ScrollView
            android:id="@id/detail_fa_bubble_dialog_scrollview"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="12.0dip"
            android:layout_marginBottom="12.0dip">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/pop_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Barrier
                    android:id="@id/title_right_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    app:barrierDirection="end"
                    app:constraint_referenced_ids="detail_fa_bubble_dialog_serviceinfo_title,detail_fa_bubble_dialog_version_title,detail_fa_bubble_dialog_developer_title,detail_fa_bubble_dialog_privacy_title,detail_fa_bubble_dialog_permission_title" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_text_color"
                    android:ellipsize="end"
                    android:id="@id/detail_fa_bubble_dialog_serviceinfo_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/component_detail_fa_about_info"
                    android:maxLines="2"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="16.0dip"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <FrameLayout
                    android:id="@id/detail_fa_intro_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24.0dip"
                    android:layout_marginEnd="12.0dip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/title_right_barrier"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.huawei.appgallery.detail.detailbase.common.FoldingTextView
                        android:textSize="14.0sp"
                        android:textColor="@color/component_detail_fa_about_text_color"
                        android:id="@id/detail_fa_bubble_dialog_serviceinfo_content"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.0dip"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        android:layout_marginEnd="4.0dip" />
                    <FrameLayout
                        android:layout_gravity="end|bottom|center"
                        android:id="@id/detail_fa_desc_folding_background"
                        android:background="@drawable/ic_fa_arrow_background"
                        android:visibility="gone"
                        android:layout_width="@dimen/ui_24_dp"
                        android:layout_height="@dimen/ui_24_dp"
                        android:contentDescription="@string/component_detail_head_game_open">
                        <com.huawei.appgallery.detail.detailbase.common.ArrowImageView
                            android:layout_gravity="center"
                            android:id="@id/detail_fa_desc_folding_imageview"
                            android:background="@drawable/ic_fa_arrow_down"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </FrameLayout>
                </FrameLayout>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@id/serviceinfo_bottom_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="detail_fa_bubble_dialog_serviceinfo_title,detail_fa_intro_desc" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_text_color"
                    android:ellipsize="end"
                    android:id="@id/detail_fa_bubble_dialog_version_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aguikit_cur_version"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="16.0dip"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/serviceinfo_bottom_barrier" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_text_color"
                    android:id="@id/detail_fa_bubble_dialog_version_content"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="24.0dip"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/title_right_barrier"
                    app:layout_constraintTop_toBottomOf="@id/serviceinfo_bottom_barrier" />
                <androidx.constraintlayout.widget.Barrier
                    android:id="@id/version_bottom_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="detail_fa_bubble_dialog_version_title,detail_fa_bubble_dialog_version_content" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_text_color"
                    android:ellipsize="end"
                    android:id="@id/detail_fa_bubble_dialog_developer_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:text="@string/aguikit_developer"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="16.0dip"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/version_bottom_barrier" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_text_color"
                    android:id="@id/detail_fa_bubble_dialog_developer_content"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="24.0dip"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/title_right_barrier"
                    app:layout_constraintTop_toBottomOf="@id/version_bottom_barrier" />
                <androidx.constraintlayout.widget.Barrier
                    android:id="@id/version_developer_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="detail_fa_bubble_dialog_developer_title,detail_fa_bubble_dialog_developer_content" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_text_color"
                    android:ellipsize="end"
                    android:id="@id/detail_fa_bubble_dialog_privacy_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:text="@string/component_detail_privacy_policy"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="16.0dip"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/version_developer_barrier" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_link_color"
                    android:ellipsize="end"
                    android:id="@id/detail_fa_bubble_dialog_privacy_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="24.0dip"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintStart_toEndOf="@id/title_right_barrier"
                    app:layout_constraintTop_toBottomOf="@id/version_developer_barrier" />
                <androidx.constraintlayout.widget.Barrier
                    android:id="@id/version_privacy_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="detail_fa_bubble_dialog_privacy_title,detail_fa_bubble_dialog_privacy_content" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_text_color"
                    android:ellipsize="end"
                    android:id="@id/detail_fa_bubble_dialog_permission_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:text="@string/component_detail_permissions"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="16.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/version_privacy_barrier" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="14.0sp"
                    android:textColor="@color/component_detail_fa_about_link_color"
                    android:ellipsize="end"
                    android:id="@id/detail_fa_bubble_dialog_permission_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="24.0dip"
                    android:layout_marginEnd="16.0dip"
                    app:layout_constraintStart_toEndOf="@id/title_right_barrier"
                    app:layout_constraintTop_toBottomOf="@id/version_privacy_barrier" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </com.huawei.uikit.phone.hwbubblelayout.widget.HwBubbleLayout>
</FrameLayout>