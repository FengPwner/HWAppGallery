<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@id/detail_head_back"
            android:visibility="invisible"
            layout="@layout/appdetail_head_view_back_layout" />
        <include
            android:visibility="gone"
            layout="@layout/detail_item_download_in_head" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@id/vw_divider_top"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/component_detail_normal_divider_line" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/detail_head_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_end">
                <FrameLayout
                    android:layout_width="@dimen/component_detail_icon_width_l"
                    android:layout_height="@dimen/component_detail_icon_height_v3"
                    android:layout_marginBottom="@dimen/component_detail_icon_bottom_v4">
                    <com.huawei.appgallery.detail.detailbase.widget.HwShadowLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@id/hs_shadow"
                        android:layout_width="wrap_content"
                        android:layout_height="72.0dip"
                        android:layout_marginTop="8.0dip">
                        <ImageView
                            android:id="@id/iv_detail_app_icon_bg"
                            android:focusable="false"
                            android:layout_width="56.0dip"
                            android:layout_height="56.0dip"
                            android:scaleType="fitCenter" />
                    </com.huawei.appgallery.detail.detailbase.widget.HwShadowLayout>
                    <RelativeLayout
                        android:layout_width="@dimen/component_detail_icon_width_l"
                        android:layout_height="@dimen/component_detail_icon_height_v3">
                        <ImageView
                            android:id="@id/detail_head_app_icon_imageview"
                            android:focusable="false"
                            android:layout_width="@dimen/component_detail_icon_width_l"
                            android:layout_height="@dimen/component_detail_icon_height_l"
                            android:src="@drawable/icon_default_bg"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@id/detail_head_fast_app_icon_imageview"
                            android:layout_width="@dimen/component_detail_fasticon_size"
                            android:layout_height="@dimen/component_detail_fasticon_size"
                            android:src="@color/transparent"
                            android:scaleType="fitCenter"
                            android:layout_alignBottom="@id/detail_head_app_icon_imageview"
                            android:layout_alignEnd="@id/detail_head_app_icon_imageview" />
                    </RelativeLayout>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/detail_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="4.0">
                            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@id/detail_app_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s">
                                <TextView
                                    android:textSize="@dimen/detail_ageadapter_data_card_text_size_caption"
                                    android:textColor="@color/appgallery_text_color_primary"
                                    android:ellipsize="end"
                                    android:id="@id/detail_head_app_name_textview"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="2"
                                    android:fontFamily="@string/appgallery_text_font_family_medium"
                                    android:textDirection="locale"
                                    android:textAlignment="viewStart" />
                            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
                            <ImageView
                                android:id="@id/appQualityImage"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="14.0dip"
                                android:layout_marginBottom="@dimen/appgallery_button_safety_margin" />
                            <TextView
                                android:textSize="@dimen/res_textsize_10sp"
                                android:textColor="@color/appgallery_text_color_secondary"
                                android:ellipsize="end"
                                android:id="@id/app_source"
                                android:tag="css/.subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/component_detail_head_age_interval_s"
                                android:layout_marginBottom="@dimen/component_detail_screen_point_margin"
                                android:text="@string/app_name_appstore"
                                android:maxLines="1" />
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@id/detail_head_desc_layout"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xs" />
                            <RelativeLayout
                                android:layout_gravity="top"
                                android:orientation="horizontal"
                                android:id="@id/detail_head_label_layout_linearlayout"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/component_detail_margin_bottom">
                                <com.huawei.appgallery.foundation.ui.framework.widget.MultiLineLabelLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@id/detail_head_label_icon_layout_linearlayout"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1" />
                            </RelativeLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/res_textsize_10sp"
                                    android:textColor="@color/appgallery_text_color_secondary"
                                    android:ellipsize="end"
                                    android:id="@id/pure_mode_switch_textview"
                                    android:tag="css/.subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="2" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@id/vw_divider_line"
                android:background="@color/divider_horizontal_color_emui"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/stroke_line_width" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/setting_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true" />
            <RelativeLayout
                android:id="@id/no_adapt_container"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_end">
                <ImageView
                    android:id="@id/no_adapt_icon"
                    android:layout_width="@dimen/component_detail_report_title_menubtn_width"
                    android:layout_height="@dimen/component_detail_report_title_menubtn_height"
                    android:layout_marginBottom="2.0dip"
                    android:layout_alignParentStart="true" />
                <RelativeLayout
                    android:id="@id/no_adapt_container_child_view"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/no_adapt_icon">
                    <TextView
                        android:textSize="@dimen/res_textsize_10sp"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:ellipsize="end"
                        android:id="@id/no_adapt_title"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/component_detail_head_age_interval_m"
                        android:maxLines="4" />
                    <FrameLayout
                        android:id="@id/detail_upgrade_body_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/component_detail_head_age_interval_m"
                        android:layout_marginEnd="8.0dip">
                        <com.huawei.appgallery.detail.detailbase.common.FoldingTextView
                            android:textSize="@dimen/res_textsize_12sp"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:id="@id/detail_desc_content_textview"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            style="@style/detail_card_introduce_content" />
                        <com.huawei.appgallery.detail.detailbase.common.ArrowImageView
                            android:layout_gravity="end|bottom|center"
                            android:id="@id/detail_upgrade_folding_imageview"
                            android:background="@drawable/ic_public_arrow_down_900"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/component_detail_head_game_open" />
                    </FrameLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/ll_permission_list"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/no_adapt_container_child_view">
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:gravity="bottom"
                        android:paddingTop="@dimen/margin_l"
                        android:paddingBottom="@dimen/margin_m"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/installconfirmriskcard_app_permission_list_title"
                        android:fontFamily="@string/appgallery_text_font_family_medium" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/ll_permission_content"
                        android:background="@drawable/aguikit_card_panel_bg"
                        android:paddingTop="@dimen/padding_l"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/margin_m"
                        android:paddingEnd="@dimen/margin_m">
                        <com.huawei.appgallery.detail.installservice.installconfirmdetailheadcard.WrapContentViewPager
                            android:id="@id/vp_permission_list"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
                        <com.huawei.uikit.phone.hwdotspageindicator.widget.HwDotsPageIndicator
                            android:id="@id/indicator_layout"
                            android:visibility="visible"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
                <com.huawei.appgallery.detail.installservice.installconfirmdetailheadcard.view.RiskDetailView
                    android:id="@id/detail_risk_layout"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ll_permission_list" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/cs_8_dp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detail_risk_layout">
                    <com.huawei.uikit.phone.hwcheckbox.widget.HwCheckBox
                        android:id="@id/risk_tips_check_box"
                        android:paddingTop="0.0dip"
                        android:paddingBottom="0.0dip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cs_4_dp"
                        android:layout_marginBottom="@dimen/cs_12_dp"
                        android:includeFontPadding="false"
                        android:textAlignment="viewStart"
                        wapbutton:hwAutoTopEnabled="true"
                        style="@style/Widget.Emui.HwCheckBox.Normal" />
                    <com.huawei.appgallery.detail.installservice.continueinstall.HeadContinueButton
                        android:textSize="14.0sp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/pure_install_button_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/hwprogressbutton_small_button_min_height"
                        android:singleLine="true"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        wapbutton:downloadFixedWidth="true"
                        wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                        style="@style/Widget.Emui.HwProgressButton" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/res_textsize_12sp"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:id="@id/move_to_control_center_tips_txt"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cs_8_dp"
                        android:text="@string/installconfirmriskcard_move_to_control_center_tips"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                </LinearLayout>
            </RelativeLayout>
            <View
                android:id="@id/normal_divider"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/component_detail_normal_divider" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>