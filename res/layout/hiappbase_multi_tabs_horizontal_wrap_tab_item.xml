<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/tab_relative"
        android:background="@drawable/hiappbase_horizontal_wrap_tab_item_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
        android:minHeight="28.0dip"
        android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_button3"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/tab_name_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
            android:maxLines="1"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m" />
    </RelativeLayout>
</RelativeLayout>