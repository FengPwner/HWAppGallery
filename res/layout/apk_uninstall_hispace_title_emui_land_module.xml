<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
    android:gravity="start|center"
    android:orientation="horizontal"
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:id="@id/apk_uninstall_arrow_layout"
        android:background="@drawable/hwappbarpattern_selector_item_bg"
        android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_height"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="4.0dip">
        <ImageView
            android:id="@id/up"
            android:layout_width="@dimen/ui_24_dp"
            android:layout_height="@dimen/ui_24_dp"
            android:src="@drawable/aguikit_ic_public_back" />
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center"
        android:orientation="vertical"
        android:id="@id/apk_uninstall_content_linearlayout"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:layout_marginEnd="@dimen/margin_s">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:gravity="start|center"
            android:id="@id/title_text_land"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_manager_title_ex"
            style="@style/AppGallery.Widget.Toolbar.Title" />
    </LinearLayout>
    <View
        android:layout_width="@dimen/margin_s"
        android:layout_height="1.0dip" />
</com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>