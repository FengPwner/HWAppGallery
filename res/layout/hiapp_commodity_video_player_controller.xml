<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/image"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:weightSum="3.0">
        <com.huawei.appmarket.service.video.VideoLinearGradient
            android:layout_gravity="bottom"
            android:id="@id/bottom_plate"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
    </LinearLayout>
    <ImageView
        android:id="@id/center_start"
        android:visibility="visible"
        android:layout_width="@dimen/appgallery_card_icon_size_xs"
        android:layout_height="@dimen/appgallery_card_icon_size_xs"
        android:layout_marginTop="@dimen/hwbottomnavigationview_single_icon_extend_size_land"
        android:src="@drawable/video_top_control_play"
        android:scaleType="centerInside"
        android:layout_centerHorizontal="true" />
</RelativeLayout>