<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hiappbase_subheader_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    style="@style/AppGallery.Widget.SubHeader.ViewGroup"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="start|center"
        android:id="@id/hiappbase_subheader_title_layout"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes">
        <LinearLayout
            android:id="@id/hiappbase_subheader_title_layout_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="start|center"
                android:id="@id/hiappbase_subheader_title_left"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_for_layout"
                android:maxLines="2"
                style="@style/AppGallery.Widget.SubHeader.Title" />
            <ImageView
                android:layout_gravity="center"
                android:id="@id/title_red_dot"
                android:visibility="gone"
                android:layout_width="8.0dip"
                android:layout_height="8.0dip"
                android:src="@drawable/tab_red_dot"
                android:layout_marginStart="@dimen/margin_m" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/hiappbase_ad_info_icon"
                android:background="@drawable/hiappbase_info_icon"
                android:visibility="gone"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:contentDescription="@string/hiappbase_one_click_control_more_info"
                android:layout_marginStart="8.0dip"
                android:layout_marginEnd="12.0dip" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/hiappbase_subheader_more_layout"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
        android:contentDescription="@string/card_more_btn"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:id="@id/hiappbase_subheader_more_txt"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/card_more_btn"
            android:layout_weight="1.0"
            android:lineSpacingMultiplier="1.1"
            style="@style/AppGallery.Widget.SubHeader.More" />
        <ImageView
            android:layout_gravity="end|center"
            android:id="@id/hiappbase_subheader_more_arrow"
            android:tag="css/.arrow"
            android:background="@drawable/ic_public_arrow_right_900"
            android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
            android:layout_height="@dimen/appgallery_list_item_right_arrow_height" />
    </LinearLayout>
</LinearLayout>