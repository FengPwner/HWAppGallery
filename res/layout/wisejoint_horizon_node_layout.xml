<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ViewStub
        android:id="@id/appList_ItemTitle_layout"
        android:layout="@layout/hiappbase_layout_subheader_title_more"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ViewStub
        android:id="@id/ageadapter_appList_ItemTitle_layout"
        android:layout="@layout/hiappbase_layout_ageadapter_subheader_title_more"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
        android:id="@id/AppListItem"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_elements_margin_horizontal_m"
        android:paddingEnd="@dimen/appgallery_elements_margin_horizontal_m"
        app:bounceEnable="true" />
</LinearLayout>