<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/upgrade_guide_bottom">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/upgrade_guide_container"
            android:paddingBottom="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@id/hiapp_img"
                android:background="@drawable/appicon_logo_oobe"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:layout_marginTop="48.0dip"
                android:layout_marginBottom="24.0dip" />
            <TextView
                android:textSize="@dimen/emui_primary_display_1"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24.0dip"
                android:layout_marginBottom="24.0dip"
                android:src="@drawable/ic_hiapp_hota" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/hota_intro"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/hiapp_hota_intro"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/hota_autoupdate_layout"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip">
                    <TextView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_settings"
                        style="@style/AppGallery.Widget.SubHeader.ListTitle" />
                    <ViewStub
                        android:id="@id/hota_setting"
                        android:layout="@layout/hiappbase_layout_subheader_title_more"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <ViewStub
                        android:id="@id/ageadapter_hota_setting"
                        android:layout="@layout/hiappbase_layout_ageadapter_subheader_title_more"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:id="@id/hota_autoupdate_content"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text="@string/hiapp_hota_autoupdate_content"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/hota_protocol_layout"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:id="@id/hota_info"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text=""
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:id="@id/hota_permission"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:text=""
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@id/upgrage_enable"
                    android:layout_width="@dimen/cs_button_min_width"
                    android:layout_height="@dimen/hwbutton_default_height"
                    android:layout_marginTop="16.0dip"
                    android:text="@string/hiapp_hota_enable"
                    android:textAllCaps="true"
                    style="@style/Widget.Emui.HwButton.Emphasize" />
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@id/upgrage_later"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/hiapp_hota_later"
                    android:textAllCaps="true"
                    style="@style/Widget.Emui.HwButton" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/hota_default_layout"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/gamecenter_view"
                    android:paddingTop="12.0dip"
                    android:paddingBottom="12.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="84.0dip">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/ic_gamecenter_icon" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16.0dip">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name_gamebox"
                            android:fontFamily="@string/appgallery_text_font_family_medium" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body2"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hiapp_hota_gamebox_content"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/mycenter_view"
                    android:paddingTop="12.0dip"
                    android:paddingBottom="12.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="84.0dip">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/ic_member_center" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16.0dip">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hiapp_hota_member_name"
                            android:fontFamily="@string/appgallery_text_font_family_medium" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body2"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hiapp_hota_member_content"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/books_view"
                    android:paddingTop="12.0dip"
                    android:paddingBottom="12.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="84.0dip">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/ic_hota_books" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16.0dip">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hiapp_hota_books_name"
                            android:fontFamily="@string/appgallery_text_font_family_medium" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body2"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hiapp_hota_books_content"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/upgrade_guide_bottom"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
        android:minHeight="48.0dip"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/hwcolumnsystem_cs_button_margin"
        android:layout_marginEnd="@dimen/hwcolumnsystem_cs_button_margin">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/hota_back_layout"
            android:paddingLeft="@dimen/margin_m"
            android:paddingRight="@dimen/margin_m"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginEnd="@dimen/margin_m">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/back_arrow"
                android:background="@drawable/hota_ic_back"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:layout_gravity="center_vertical"
                android:id="@id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_marginStart="@dimen/margin_m" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/hota_next_layout"
            android:paddingLeft="@dimen/margin_m"
            android:paddingRight="@dimen/margin_m"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/margin_m">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:id="@id/hota_next_button"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/wisedist_next"
                android:layout_weight="1.0"
                android:textAllCaps="true"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_marginEnd="@dimen/margin_m" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/next_arrow"
                android:background="@drawable/hota_ic_next"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>