<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="2.0"
        android:importantForAccessibility="no">
        <include
            android:id="@id/update_card_layout1"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            layout="@layout/updatemanager_oversea_update_record_item2" />
        <include
            android:id="@id/update_card_layout2"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            layout="@layout/updatemanager_oversea_update_record_item2" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="2.0"
        android:importantForAccessibility="no">
        <include
            android:id="@id/update_card_layout3"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
            layout="@layout/updatemanager_oversea_update_record_item2" />
    </LinearLayout>
</LinearLayout>