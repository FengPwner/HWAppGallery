<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:gravity="start|center"
        android:id="@id/start_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Toolbar.Title" />
</LinearLayout>