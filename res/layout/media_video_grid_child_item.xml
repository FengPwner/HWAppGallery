<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appgallery.common.media.widget.SquareLayout
    android:background="@drawable/media_grid_item_bg"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/child_image"
        android:background="@drawable/media_bg_perch_square"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <ImageView
        android:id="@id/over_image"
        android:background="@color/media_video_grid_child_item_66FFFFFF"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:gravity="center"
        android:id="@id/video_checkbox_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <CheckBox
            android:textSize="13.0dip"
            android:textColor="@color/emui_black"
            android:id="@id/video_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/meida.checkbox.IconSelect" />
    </LinearLayout>
    <TextView
        android:textSize="@dimen/emui_primary_caption_2"
        android:textColor="@color/appgallery_text_color_primary_inverse"
        android:id="@id/video_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4.0dip"
        android:layout_alignParentBottom="true"
        android:alpha="1.0"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="32.0dip" />
</com.huawei.appgallery.common.media.widget.SquareLayout>