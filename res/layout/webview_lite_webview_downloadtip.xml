<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:background="@color/appgallery_color_background"
    android:paddingTop="8.0dip"
    android:paddingBottom="8.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="64.0dip"
    android:paddingStart="16.0dip"
    android:paddingEnd="16.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/downloadtip_icon"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:src="@drawable/aguikit_ic_public_download"
        android:scaleType="centerInside" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/right_top_layout"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:layout_marginStart="16.0dip">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_subtitle3"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="middle"
            android:id="@id/downloadtip_title_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textAlignment="viewStart" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_secondary"
                android:ellipsize="end"
                android:id="@id/downloadtip_downsize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1.0"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/downloadtip_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/appgallery_text_margin_horizontal" />
        </LinearLayout>
    </LinearLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_button2"
        android:textColor="@color/appgallery_color_accent"
        android:id="@id/downloadtip_detailbtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/webview_lite_webview_downloadtip_details"
        android:singleLine="true"
        android:textAllCaps="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:layout_marginStart="16.0dip"
        android:layout_marginEnd="16.0dip" />
    <ImageView
        android:id="@id/downloadtip_cancelbtn"
        android:layout_width="16.0dip"
        android:layout_height="16.0dip"
        android:src="@drawable/aguikit_ic_public_cancel"
        android:scaleType="centerInside"
        android:contentDescription="@string/webview_lite_webview_menu_close" />
</LinearLayout>