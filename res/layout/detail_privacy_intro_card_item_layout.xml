<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/linear_intro_container"
    android:background="@drawable/aguikit_card_panel_bg"
    android:paddingTop="16.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12.0dip"
    android:paddingEnd="12.0dip"
    android:layout_marginStart="@dimen/appgallery_max_padding_start"
    android:layout_marginEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16.0dip">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/img_privacy_intro_icon"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:layout_gravity="center_vertical"
            android:id="@id/txt_privacy_intro_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8.0dip"
            style="@style/detail_card_privacy_intro_name" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/linear_privacy_intro_card_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip" />
</LinearLayout>