<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/feedback_sdk_common_16_dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/tb_other_user_icon"
        android:layout_width="@dimen/feedback_sdk_common_32_dip"
        android:layout_height="@dimen/feedback_sdk_common_32_dip"
        android:src="@drawable/feedback_sdk_serviceavatar"
        android:layout_marginEnd="@dimen/feedback_sdk_common_8_dip"
        android:layout_alignParentStart="true" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/ll_evalua_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/tb_other_user_icon">
        <TextView
            android:textSize="@dimen/feedback_sdk_common_ui_sp_14"
            android:textColor="@color/feedback_sdk_text_normal_black"
            android:id="@id/tv_evaluad_content"
            android:background="@drawable/feedback_sdk_bg_question_to"
            android:padding="@dimen/feedback_sdk_common_8_dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:textIsSelectable="true" />
        <LinearLayout
            android:layout_gravity="start|bottom|center"
            android:orientation="horizontal"
            android:id="@id/ll_evaluat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/feedback_sdk_common_8_dip">
            <ImageView
                android:id="@id/img_resolved"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/feedback_sdk_ic_comment_useful"
                android:contentDescription="@string/feedback_sdk_good" />
            <ImageView
                android:id="@id/img_no_resolved"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/feedback_sdk_ic_comment_useless"
                android:contentDescription="@string/feedback_sdk_bad" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>