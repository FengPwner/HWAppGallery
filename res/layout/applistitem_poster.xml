<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/AppListItem"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minHeight="28.0dip"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appmarket.framework.widget.RenderImageView
        android:id="@id/appicon"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/wisedist_image"
        android:importantForAccessibility="yes"
        android:accessibilityLiveRegion="none" />
    <com.huawei.appmarket.framework.widget.RenderFrameLayout
        android:id="@id/containerbg"
        android:tag="css/.body"
        android:paddingTop="12.0dip"
        android:paddingBottom="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appmarket.service.appdetail.view.widget.MultiLineTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:id="@id/ItemText"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <com.huawei.appmarket.framework.widget.ArrowImageView
            android:layout_gravity="end|bottom|center"
            android:id="@id/detail_desc_folding"
            android:tag="css/.arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3.0dip" />
    </com.huawei.appmarket.framework.widget.RenderFrameLayout>
</LinearLayout>