<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="@dimen/ui_80_dp"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@id/fa_panel_list_layout_item_image_ll"
        android:background="@drawable/fa_panel_list_item_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@id/fa_panel_list_layout_item_image"
            android:layout_width="@dimen/ui_24_dp"
            android:layout_height="@dimen/ui_24_dp"
            android:layout_margin="@dimen/ui_12_dp" />
    </LinearLayout>
    <TextView
        android:textSize="@dimen/ui_sp_12"
        android:textColor="@color/text_color_primary"
        android:gravity="center_horizontal"
        android:id="@id/fa_panel_list_layout_item_tv"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_8_dp"
        android:text=""
        android:fontFamily="@string/emui_text_font_family_regular"
        android:paddingStart="@dimen/ui_4_dp"
        android:paddingEnd="@dimen/ui_4_dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fa_panel_list_layout_item_image_ll" />
</androidx.constraintlayout.widget.ConstraintLayout>