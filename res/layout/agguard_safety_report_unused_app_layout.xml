<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg"
    android:paddingTop="@dimen/ui_4_dp"
    android:paddingBottom="@dimen/ui_4_dp"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ui_12_dp"
    android:minHeight="@dimen/agguard_layout_min_height"
    android:layout_marginStart="@dimen/ui_16_dp"
    android:layout_marginEnd="@dimen/ui_16_dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/unused_app_card_container"
        android:background="@drawable/agguard_card_item_pressed_inset_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        style="@style/AppGallery.Widget.List.TwoTextLines">
        <ImageView
            android:id="@id/unused_app_arrow"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.Widget.List.RightArrow" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/unused_app_arrow">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:gravity="center_vertical"
                android:id="@id/unused_app_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_for_layout"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:gravity="center_vertical"
                android:id="@id/unused_app_desc"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:text="@string/placeholder_for_layout"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>