<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:background="@drawable/updatemanager_choose_auto_update_flag_bg"
        android:focusable="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_start">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/updatemanager_choose_state_card_desc_container"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
            android:paddingStart="@dimen/appgallery_card_elements_margin_l"
            android:paddingEnd="@dimen/appgallery_card_elements_margin_l">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/updatemanager_choose_state_card_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/updatemanager_auto_update_when_wlan"
                style="@style/AppGallery.TextAppearance.Card.SubTitle3" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/updatemanager_choose_state_card_desc"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
                android:text="@string/updatemanager_auto_update_apps_when_wlan"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
        <LinearLayout
            android:paddingTop="2.0dip"
            android:paddingBottom="2.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
            android:layout_below="@id/updatemanager_choose_state_card_desc_container"
            android:layout_alignParentEnd="true">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="@dimen/appgallery_text_size_button2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/updatemanager_choose_state_btn_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/updatemanager_not_auto_update"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                style="@style/Widget.Emui.HwButton.Borderless.Small" />
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:textSize="@dimen/appgallery_text_size_button2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/updatemanager_choose_state_btn_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/updatemanager_start_now"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_marginStart="8.0dip"
                android:layout_marginEnd="8.0dip"
                style="@style/Widget.Emui.HwButton.Borderless.Small" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>