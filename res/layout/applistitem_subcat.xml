<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rl_item_contain_parent"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/rl_item_contain"
        android:paddingLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingRight="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />
        <ImageView
            android:id="@id/arrow_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_public_arrow_right_900"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
        <TextView
            android:ellipsize="end"
            android:id="@id/ItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_for_layout"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_marginEnd="@dimen/appgallery_text_paragraph_margin_xs"
            android:layout_toStartOf="@id/arrow_right"
            android:layout_toEndOf="@id/appicon"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    </RelativeLayout>
    <View
        android:id="@id/divider_line"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="52.0dip"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>