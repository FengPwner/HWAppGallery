<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/itemlayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_two_text_lines"
        android:layout_centerVertical="true">
        <com.huawei.uikit.hwcheckbox.widget.HwCheckBox
            android:id="@id/button_check_box"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_alignParentEnd="true"
            style="@style/Widget.Emui.HwCheckBox.Normal" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/wistdist_wish_batch_delete_item_left_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_toStartOf="@id/button_check_box">
            <TextView
                android:ellipsize="end"
                android:id="@id/wistdist_wish_batch_delete_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <TextView
                android:gravity="center_vertical"
                android:id="@id/wistdist_wish_batch_delete_item_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
        <View
            android:id="@id/wistdist_wish_batch_delete_divider"
            android:layout_width="fill_parent"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
</RelativeLayout>