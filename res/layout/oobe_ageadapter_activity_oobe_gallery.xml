<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/oobe_gallery_content"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/oobe_loadingPager"
        android:visibility="gone"
        layout="@layout/oobe_loading_fragment" />
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@id/empty_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/oobe_hwcolumn_margin_offset"
            android:paddingEnd="@dimen/oobe_hwcolumn_margin_offset"
            app:hwColumnType="content_type">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/btn_layout_nodata"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <com.huawei.uikit.phone.hwbutton.widget.HwButton
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/reserve_normal_textcolor"
                    android:layout_gravity="center"
                    android:id="@id/open_hiapp_button"
                    android:background="@drawable/detail_downloadbutton_normal"
                    android:layout_width="fill_parent"
                    android:layout_height="48.0dip"
                    android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    style="@style/Widget.Emui.HwButton.Emphasize" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/blue_text_007dff"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/close_button"
                    android:layout_width="fill_parent"
                    android:layout_height="48.0dip"
                    android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
                    android:text="@string/oobe_no_thanks"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
            </LinearLayout>
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_above="@id/btn_layout_nodata">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@id/hiapp_img"
                        android:background="@drawable/appicon_logo_oobe"
                        android:layout_width="32.0dip"
                        android:layout_height="32.0dip"
                        android:layout_marginTop="48.0dip"
                        android:layout_marginBottom="116.0dip" />
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@id/empty_img"
                        android:background="@drawable/appicon_oobe_emptypage"
                        android:layout_width="145.0dip"
                        android:layout_height="145.0dip"
                        android:layout_marginBottom="24.0dip" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body1"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/oobe_empty_textview"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                </LinearLayout>
            </RelativeLayout>
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout>
        <RelativeLayout
            android:id="@id/app_container_layout"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout
                android:id="@id/oobe_title_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:paddingStart="@dimen/oobe_hwcolumn_margin_offset"
                android:paddingEnd="@dimen/oobe_hwcolumn_margin_offset"
                app:hwColumnType="content_type">
                <TextView
                    android:textSize="24.0dip"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:id="@id/app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16.0dip"
                    android:layout_below="@id/appicon"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
                <ImageView
                    android:id="@id/appicon"
                    android:background="@drawable/appicon_logo_oobe"
                    android:layout_width="32.0dip"
                    android:layout_height="32.0dip"
                    android:layout_marginTop="@dimen/margin_l"
                    android:layout_marginBottom="@dimen/margin_l"
                    android:layout_centerHorizontal="true" />
            </com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout>
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/button_layout"
                android:layout_below="@id/oobe_title_layout">
                <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                    android:orientation="vertical"
                    android:id="@id/oobe_desc_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:paddingStart="@dimen/oobe_hwcolumn_margin_offset"
                    android:paddingEnd="@dimen/oobe_hwcolumn_margin_offset"
                    app:hwColumnType="content_type">
                    <LinearLayout
                        android:id="@id/oobe_desc_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:ellipsize="end"
                            android:id="@id/oobe_desc"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/oobe_app_gallery_title"
                            android:layout_weight="1.0"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:layout_alignParentStart="true" />
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/ad_info_icon"
                            android:background="@drawable/hiappbase_info_icon"
                            android:layout_width="16.0dip"
                            android:layout_height="16.0dip"
                            android:contentDescription="@string/hiappbase_one_click_control_more_info"
                            android:layout_marginStart="8.0dip" />
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="@color/emui_functional_blue"
                        android:id="@id/oobe_select_deselect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/oobe_desc"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        android:layout_alignParentStart="true" />
                </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@id/app_container"
                    android:scrollbars="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="24.0dip"
                    android:layout_below="@id/oobe_desc_layout"
                    android:paddingStart="@dimen/oobe_hwcolumn_margin_offset"
                    android:paddingEnd="@dimen/oobe_hwcolumn_margin_offset"
                    android:layout_alignParentStart="true" />
            </RelativeLayout>
            <include
                android:id="@id/button_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                layout="@layout/oobe_ageadapter_button_layout" />
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>