<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:descendantFocusability="blocksDescendants"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/item_layout"
        android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
        android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line">
        <com.huawei.appgallery.detail.detailbase.common.widget.DetailReportCheckBox
            android:id="@id/detail_appinfo_report_checkbox"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingStart="0.0dip"
            android:paddingEnd="0.0dip"
            android:layout_alignParentEnd="true"
            style="@style/Widget.Emui.HwCheckBox.Normal" />
        <TextView
            android:id="@id/report_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toStartOf="@id/detail_appinfo_report_checkbox"
            android:layout_alignParentStart="true"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    </RelativeLayout>
    <ImageView
        android:id="@id/devider_line"
        android:layout_width="fill_parent"
        android:layout_below="@id/item_layout"
        android:layout_alignStart="@id/item_layout"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>