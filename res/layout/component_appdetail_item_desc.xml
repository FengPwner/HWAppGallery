<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_desc_layout_linearlayout"
    android:paddingBottom="@dimen/margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@id/detail_desc_layout_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/detail_desc_title_layout_relativelayout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_m"
            android:layout_weight="1.0"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/ui_12_dp">
            <TextView
                android:id="@id/detail_desc_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/detail_card_title" />
            <ImageView
                android:id="@id/detail_desc_icon_imageview"
                android:visibility="gone"
                android:layout_width="28.0dip"
                android:layout_height="12.0dip"
                android:scaleType="centerCrop"
                android:layout_marginStart="6.0dip" />
        </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        <com.huawei.appgallery.detail.detailbase.common.RenderMachineImageView
            android:id="@id/detail_desc_translate_img"
            android:tag="css/.widget"
            android:visibility="gone"
            android:layout_width="@dimen/detail_translate_switch"
            android:layout_height="@dimen/detail_translate_switch"
            android:layout_marginTop="@dimen/component_detail_card_elements_margin_l"
            android:layout_marginBottom="6.0dip"
            android:scaleType="centerCrop"
            android:contentDescription="@string/component_detail_translate_btn_label"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
    </LinearLayout>
    <FrameLayout
        android:id="@id/detail_desc_body_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@id/detail_desc_body_layout_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appgallery.detail.detailbase.common.FoldingTextView
                android:id="@id/detail_desc_content_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                style="@style/detail_card_introduce_content" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/detail_desc_body_sub_layout_linearlayout"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <com.huawei.appgallery.detail.detailbase.common.ArrowImageView
            android:layout_gravity="end|bottom|center"
            android:id="@id/detail_desc_folding_imageview"
            android:tag="css/.arrow"
            android:background="@drawable/ic_public_arrow_down_900"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>