<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/emui_dimens_max_start"
    android:paddingEnd="@dimen/emui_dimens_max_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:id="@id/dynamic_install_describe"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/dynamic_install_describe"
        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/dynamic_install_features"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:id="@id/dynamic_install_confirm"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
</LinearLayout>