<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_head_layout_linearlayout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/detail_head_layout"
        android:paddingTop="@dimen/appgallery_card_elements_margin_s"
        android:paddingBottom="@dimen/appgallery_card_elements_margin_l"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <RelativeLayout
            android:layout_width="@dimen/component_detail_icon_width_l"
            android:layout_height="@dimen/component_detail_icon_height_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l">
            <ImageView
                android:id="@id/detail_head_app_icon_imageview"
                android:focusable="false"
                android:layout_width="@dimen/component_detail_icon_width_l"
                android:layout_height="@dimen/component_detail_icon_height_l"
                android:src="@drawable/icon_default_bg"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@id/detail_head_fast_app_icon_imageview"
                android:layout_width="@dimen/component_detail_fasticon_size"
                android:layout_height="@dimen/component_detail_fasticon_size"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                android:layout_alignBottom="@id/detail_head_app_icon_imageview"
                android:layout_alignEnd="@id/detail_head_app_icon_imageview" />
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/emui_text_size_headline7"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:id="@id/detail_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:ellipsize="end"
                android:id="@id/detail_app_developer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                android:maxLines="2"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>