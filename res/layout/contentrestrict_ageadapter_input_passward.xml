<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:scrollbars="none"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:id="@id/appcommon_imageview_divider"
            android:background="@color/transparent"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/appgallery_card_elements_margin_l" />
        <TextView
            android:id="@id/input_desc"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_l"
            android:text="@string/contentrestrict_set_passward_desc"
            style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
        <FrameLayout
            android:id="@id/appcommon_framelayout_set_password"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_l">
            <com.huawei.uikit.phone.hwedittext.widget.HwEditText
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:textColorHint="@color/appgallery_text_color_hint"
                android:ellipsize="end"
                android:id="@id/password"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="@string/contentrestrict_input_password_default_desc"
                android:singleLine="true"
                android:digits="\ 1234567890"
                android:inputType="numberPassword"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:paddingEnd="44.0dip"
                style="@style/Widget.Emui.HwEditText.Linear" />
            <LinearLayout
                android:layout_gravity="end|center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@id/eye"
                    android:background="@drawable/aguikit_ic_public_password_unvisible"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:layout_marginEnd="@dimen/appgallery_default_card_space_vertical_l" />
            </LinearLayout>
        </FrameLayout>
        <com.huawei.uikit.phone.hwedittext.widget.HwEditText
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_primary"
            android:textColorHint="@color/appgallery_text_color_hint"
            android:ellipsize="end"
            android:id="@id/password_confirm"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:hint="@string/contentrestrict_input_password_default_desc"
            android:singleLine="true"
            android:digits="\ 1234567890"
            android:inputType="numberPassword"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            style="@style/Widget.Emui.HwEditText.Linear" />
    </LinearLayout>
</ScrollView>