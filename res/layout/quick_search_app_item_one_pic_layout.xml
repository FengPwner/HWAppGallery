<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/one_pic_img_container"
    android:paddingTop="@dimen/cs_4_dp"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
            android:id="@id/quick_search_app_item_image"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m"
            app:touch_drawable="@drawable/quick_search_app_item_image_bg" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/quick_search_app_item_text"
            android:paddingTop="8.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="HarmonyHeiTi"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        <LinearLayout
            android:id="@id/bottom_line_layout"
            android:paddingTop="12.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <View
                android:id="@id/bottom_divider_line"
                android:layout_width="fill_parent"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.Widget.Divider" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>