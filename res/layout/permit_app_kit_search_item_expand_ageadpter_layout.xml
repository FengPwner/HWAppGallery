<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:gravity="start|center"
            android:id="@id/more_links_website"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:id="@id/more_links_get"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/emui_dimens_text_margin_fifth"
            android:text="@string/permit_app_kit_get"
            android:singleLine="true"
            style="@style/AppGallery.Widget.Button.TextButton3" />
    </LinearLayout>
</RelativeLayout>