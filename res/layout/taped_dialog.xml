<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/alert_dialog_card"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/interwork_16_dp"
    android:layout_centerHorizontal="true"
    android:layoutDirection="locale"
    android:layout_marginStart="@dimen/interwork_16_dp"
    android:layout_marginEnd="@dimen/interwork_16_dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/dialog_outer_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@id/dialog_tapped_layout"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.ohos.localability.base.FixRatioLayout
                android:id="@id/constraint_dialog_icon"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/interwork_25_dp"
                android:layout_marginStart="@dimen/interwork_24_dp"
                android:layout_marginEnd="@dimen/interwork_24_dp">
                <ImageView
                    android:id="@id/dialog_icon"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitCenter" />
            </com.huawei.ohos.localability.base.FixRatioLayout>
            <TextView
                android:textSize="@dimen/emui_text_size_subtitle1"
                android:textColor="@color/emui_text_primary"
                android:gravity="center_horizontal"
                android:id="@id/dialog_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/interwork_24_dp"
                android:layout_below="@id/constraint_dialog_icon"
                android:fontFamily="@string/emui_text_font_family_medium"
                android:layout_marginStart="@dimen/interwork_24_dp"
                android:layout_marginEnd="@dimen/interwork_24_dp" />
            <TextView
                android:textSize="@dimen/emui_text_size_caption"
                android:textColor="@color/emui_color_secondary"
                android:ellipsize="none"
                android:id="@id/dialog_description"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/interwork_16_dp"
                android:singleLine="false"
                android:layout_below="@id/dialog_title"
                android:layout_centerHorizontal="true"
                android:fontFamily="@string/emui_text_font_family_regular"
                android:layout_marginStart="@dimen/interwork_24_dp"
                android:layout_marginEnd="@dimen/interwork_24_dp" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/interwork_36_dp"
                android:layout_marginTop="@dimen/interwork_18_dp"
                android:layout_marginBottom="@dimen/interwork_10_dp"
                android:divider="@drawable/divider"
                android:layout_below="@id/dialog_description"
                android:showDividers="middle"
                android:dividerPadding="@dimen/interwork_6_dp"
                android:layout_marginStart="@dimen/interwork_16_dp"
                android:layout_marginEnd="@dimen/interwork_16_dp">
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0"
                    android:paddingEnd="@dimen/interwork_4_dp">
                    <Button
                        android:textSize="@dimen/interwork_text_16_sp"
                        android:textColor="@color/emui_functional_blue"
                        android:id="@id/button_cancel"
                        android:background="@null"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/alert_cancel_button"
                        android:singleLine="true"
                        style="?android:borderlessButtonStyle" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0"
                    android:paddingStart="@dimen/interwork_4_dp">
                    <Button
                        android:textSize="@dimen/interwork_text_16_sp"
                        android:textColor="@color/emui_functional_blue"
                        android:id="@id/button_open"
                        android:background="@null"
                        android:visibility="visible"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:minWidth="0.0dip"
                        android:minHeight="0.0dip"
                        android:text="@string/alert_open_button"
                        android:singleLine="true"
                        style="?android:borderlessButtonStyle" />
                    <RelativeLayout
                        android:id="@id/waiting_layout"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="@dimen/interwork_8_dp"
                        android:layout_marginEnd="@dimen/interwork_8_dp">
                        <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
                            android:id="@id/open_button_progress"
                            android:layout_width="@dimen/interwork_24_dp"
                            android:layout_height="@dimen/interwork_24_dp"
                            android:indeterminateOnly="true"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"
                            android:indeterminateTint="#99000000"
                            android:indeterminateTintMode="src_atop"
                            style="?android:progressBarStyle" />
                        <TextView
                            android:textSize="@dimen/interwork_text_16_sp"
                            android:textColor="@color/emui_functional_blue"
                            android:gravity="center_vertical"
                            android:id="@id/wait_dialog_title"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:text="@string/alert_open_button"
                            android:singleLine="true"
                            android:alpha="@dimen/emui_disabled_alpha"
                            android:textAllCaps="true"
                            android:fontFamily="@string/emui_text_font_family_medium"
                            android:layout_marginStart="@dimen/interwork_4_dp"
                            android:layout_toEndOf="@id/open_button_progress" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/dialog_error_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_above="@id/button_error_cancel">
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <ImageView
                        android:id="@id/dialog_error_icon"
                        android:layout_width="@dimen/interwork_64_dp"
                        android:layout_height="@dimen/interwork_64_dp"
                        android:src="@drawable/error_dialog_icon"
                        android:scaleType="fitCenter"
                        android:layout_centerHorizontal="true" />
                    <TextView
                        android:textSize="@dimen/emui_text_size_subtitle2"
                        android:textColor="@color/emui_text_primary"
                        android:gravity="center_horizontal"
                        android:id="@id/dialog_error_text"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/interwork_8_dp"
                        android:text="@string/load_error"
                        android:layout_below="@id/dialog_error_icon"
                        android:fontFamily="@string/emui_text_font_family_medium"
                        android:layout_marginStart="@dimen/interwork_24_dp"
                        android:layout_marginEnd="@dimen/interwork_24_dp" />
                    <TextView
                        android:textSize="@dimen/emui_text_size_subtitle3"
                        android:textColor="@color/emui_text_hint"
                        android:gravity="center_horizontal"
                        android:id="@id/dialog_error_reason"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/dialog_error_text"
                        android:fontFamily="@string/emui_text_font_family_medium"
                        android:layout_marginStart="@dimen/interwork_24_dp"
                        android:layout_marginEnd="@dimen/interwork_24_dp" />
                </RelativeLayout>
            </RelativeLayout>
            <Button
                android:textSize="@dimen/interwork_text_16_sp"
                android:textColor="@color/emui_functional_blue"
                android:id="@id/button_error_cancel"
                android:background="@null"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/interwork_36_dp"
                android:layout_marginTop="@dimen/interwork_10_dp"
                android:layout_marginBottom="@dimen/interwork_10_dp"
                android:minWidth="0.0dip"
                android:minHeight="0.0dip"
                android:text="@string/alert_cancel_button"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/interwork_24_dp"
                android:layout_marginEnd="@dimen/interwork_24_dp"
                style="?android:borderlessButtonStyle" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>