<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:focusable="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="yes"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="224.0dip"
        android:importantForAccessibility="noHideDescendants"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/installer_app_icon"
            android:layout_width="@dimen/install_dist_app_icon_height"
            android:layout_height="@dimen/install_dist_app_icon_width"
            android:layout_marginTop="56.0dip"
            android:layout_marginBottom="16.0dip"
            android:src="@drawable/install_dist_bg_perch_icon"
            android:scaleType="centerCrop"
            app:corner_radius="12.0dip"
            app:shade_enable="false" />
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@id/installer_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerInParent="true"
            style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary.Medium" />
        <TextView
            android:gravity="center"
            android:id="@id/app_source"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerInParent="true"
            style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Secondary" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/installer_quality"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="40.0dip"
        android:importantForAccessibility="noHideDescendants">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/green_success"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@drawable/install_dist_ic_tips_installation_security2"
            android:scaleType="centerCrop"
            android:layout_marginEnd="8.0dip" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_primary"
            android:layout_gravity="center_horizontal"
            android:id="@id/app_install"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/install_dist_install_success"
            android:singleLine="true"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
    </LinearLayout>
</LinearLayout>