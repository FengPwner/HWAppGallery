<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="60.0dip"
    android:paddingStart="24.0dip"
    android:paddingEnd="24.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_headline7"
        android:textColor="@color/appgallery_text_color_primary"
        android:gravity="start|center"
        android:id="@id/webviewtitle_text"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="@string/webview_lite_webview_config_text"
        android:layout_weight="1.0"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:textAlignment="viewStart"
        android:layout_marginEnd="16.0dip"
        app:hwAutoSizeMinTextSize="@dimen/emui_text_size_body2"
        app:hwAutoSizeStepGranularity="1.0sp"
        style="@style/AppGallery.Widget.Toolbar.Title" />
    <LinearLayout
        android:gravity="center"
        android:id="@id/webviewtitle_menu"
        android:background="@drawable/webview_lite_capsule_white_left"
        android:layout_width="wrap_content"
        android:layout_height="32.0dip">
        <ImageView
            android:id="@id/icon_first"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/webview_lite_ic_menubar_menu_darkmode"
            android:scaleType="fitCenter"
            android:contentDescription="@string/webview_lite_webview_menu_title" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@id/collapse_layout"
        android:background="@drawable/webview_lite_capsule_white_line"
        android:layout_width="2.0dip"
        android:layout_height="32.0dip">
        <ImageView
            android:id="@id/collapse_icon"
            android:layout_width="wrap_content"
            android:layout_height="24.0dip"
            android:scaleType="fitCenter" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@id/webviewtitle_quit"
        android:background="@drawable/webview_lite_capsule_white_right"
        android:layout_width="wrap_content"
        android:layout_height="32.0dip">
        <ImageView
            android:id="@id/icon_second"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/webview_lite_ic_menubar_mini_darkmode"
            android:scaleType="fitCenter"
            android:contentDescription="@string/webview_lite_webview_menu_close" />
    </LinearLayout>
</LinearLayout>