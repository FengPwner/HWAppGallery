<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    android:layout_alignParentTop="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:id="@id/back_layout"
        android:background="@drawable/hwappbarpattern_selector_item_bg"
        android:layout_width="@dimen/hwappbarpattern_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_height"
        android:contentDescription="@string/click_back"
        android:layout_marginStart="4.0dip">
        <ImageView
            android:id="@id/back_view"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/aguikit_ic_public_back" />
    </LinearLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:gravity="start|center"
        android:id="@id/title_text"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Toolbar.Title" />
</LinearLayout>