<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/recent_app_list_root"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12.0dip"
    android:layout_marginStart="16.0dip"
    android:layout_marginEnd="16.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@id/title_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.Widget.SubHeader.ViewGroup">
            <LinearLayout
                android:layout_gravity="start|center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:layout_gravity="start|center"
                    android:id="@id/subheader_title_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_for_layout"
                    android:maxLines="2"
                    style="@style/AppGallery.Widget.SubHeader.Title" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:layout_gravity="start|center"
                    android:id="@id/subheader_subtitle_left"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_2_dp"
                    android:text="@string/placeholder_for_layout"
                    android:maxLines="2"
                    style="@style/AppGallery.Widget.SubHeader.More" />
            </LinearLayout>
            <LinearLayout
                android:gravity="end|center"
                android:orientation="horizontal"
                android:id="@id/subheader_more_layout"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_m">
                <ImageView
                    android:id="@id/subheader_more_arrow"
                    android:background="@drawable/ic_public_arrow_right_900"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height" />
            </LinearLayout>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/item_app_list"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_4_dp"
            android:layout_marginBottom="@dimen/ui_4_dp" />
    </LinearLayout>
</LinearLayout>