<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_48dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@id/permission_label_linearlayout"
        android:focusable="true"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:gravity="center_vertical"
            android:id="@id/permission_label"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    </LinearLayout>
    <ImageView
        android:gravity="bottom"
        android:id="@id/view_divider"
        android:visibility="gone"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>