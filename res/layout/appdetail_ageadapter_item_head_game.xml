<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_head_layout_linearlayout"
    android:paddingTop="@dimen/appgallery_card_elements_margin_s"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@id/detail_head_back"
            android:visibility="invisible"
            layout="@layout/appdetail_ageadapter_head_view_back_layout" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/normal_head_game"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/detail_head_layout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ui_10_dp"
                android:paddingEnd="@dimen/appgallery_max_padding_end">
                <include
                    android:id="@id/detail_head_image_layout"
                    layout="@layout/appdetail_head_view_app_icon" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/detail_layout"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/component_detail_card_elements_margin_s">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/detail_content_layout"
                        android:clickable="false"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:id="@id/detail_app_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s">
                            <TextView
                                android:textSize="20.0sp"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:ellipsize="end"
                                android:id="@id/detail_head_app_name_textview"
                                android:focusable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:importantForAccessibility="no"
                                android:fontFamily="@string/appgallery_text_font_family_medium" />
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@id/iv_quality_img"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="14.0dip"
                                android:layout_marginStart="@dimen/margin_s" />
                        </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
                        <TextView
                            android:ellipsize="end"
                            android:gravity="start"
                            android:id="@id/detail_head_app_type_textview"
                            android:focusable="false"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xs"
                            android:maxLines="1"
                            android:importantForAccessibility="no"
                            android:textAlignment="viewStart"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                        <TextView
                            android:ellipsize="end"
                            android:gravity="start"
                            android:id="@id/detail_head_tariff_desc"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xs"
                            android:maxLines="2"
                            android:importantForAccessibility="no"
                            android:textAlignment="viewStart"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body3"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:ellipsize="end"
                            android:gravity="center|left"
                            android:id="@id/detail_head_time_desc"
                            android:focusable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xs"
                            android:maxWidth="104.0dip"
                            android:maxLines="2"
                            android:importantForAccessibility="no"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_gravity="start"
                        android:id="@id/fl_follow_bg"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_button_safety_margin">
                        <com.huawei.appgallery.detail.detailbase.common.DetailFollowSectionButton
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:id="@id/btn_follow"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/component_detail_card_element_width_l"
                            android:text="@string/component_detail_operation_unfollow"
                            android:maxLines="1"
                            maskview:hwAutoSizeMinTextSize="9.0sp"
                            maskview:hwAutoSizeStepGranularity="1.0sp"
                            style="@style/Widget.Emui.HwButton.Small" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@id/vw_divider"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/component_detail_normal_divider_line" />
            <View
                android:id="@id/vw_divider_line"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/component_detail_normal_divider_line" />
            <include
                android:id="@id/ll_tags"
                android:visibility="gone"
                layout="@layout/appdetail_ageadapter_head_view_tags" />
            <include
                android:id="@id/no_adapt_container"
                android:visibility="gone"
                layout="@layout/appdetail_head_view_no_adapt" />
            <View
                android:id="@id/normal_divider"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/appgallery_card_elements_margin_xl" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>