<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="30.0dip"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwimageview.widget.HwImageView
                android:id="@id/iv_fa_desc_img"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                app:layout_constraintDimensionRatio="h,3:2"
                app:layout_constraintTop_toTopOf="parent" />
            <ViewStub
                android:id="@id/vs_choice"
                android:layout="@layout/activity_fa_setting"
                android:inflatedId="@layout/activity_fa_setting"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/banner_bg_margin_24"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_start"
                app:layout_constraintTop_toBottomOf="@id/iv_fa_desc_img" />
            <ViewStub
                android:id="@id/vs_desc"
                android:layout="@layout/activity_fa_setting_desc"
                android:inflatedId="@layout/activity_fa_setting_desc"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/banner_bg_margin_24"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_start"
                app:layout_constraintTop_toBottomOf="@id/iv_fa_desc_img" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>