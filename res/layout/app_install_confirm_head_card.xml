<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/head_card_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/install_dist_head_card_height"
    android:contentDescription=""
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/install_dist_head_card_margin_top"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:hwColumnType="content_type">
        <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.NoFeedbackMaskImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/head_app_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_xl"
            android:layout_height="@dimen/appgallery_card_icon_size_xl"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_type="appicon"
            app:round_type="all" />
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/head_content_parent"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes">
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@id/head_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_safety_margin_l"
                android:text="@string/install_dist_market_name"
                style="@style/install_confirm_normal_head_app_name_style" />
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@id/head_app_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/install_dist_head_card_margin_bottom"
                android:text="@string/install_dist_text_installer_resource"
                style="@style/install_confirm_normal_head_app_source_style" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/install_capsule_group"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/install_dist_head_card_margin_bottom" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/install_fail_group"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:importantForAccessibility="no">
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@id/install_fail_title_layout"
                android:paddingTop="@dimen/appgallery_default_card_space_vertical_l"
                android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
                android:focusable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/install_fail_icon"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_height"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                    android:src="@drawable/install_dist_ic_tips_installation_security3"
                    android:layout_marginEnd="@dimen/appgallery_safety_margin_m" />
                <TextView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@id/install_fail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/install_dist_install_failed_result"
                    style="@style/AppGallery.Widget.SubHeader.Title" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/install_fail_tips_group"
                android:background="@drawable/app_permission_bg"
                android:paddingTop="@dimen/margin_s"
                android:paddingBottom="@dimen/margin_s"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xl"
                android:importantForAccessibility="no"
                android:paddingStart="@dimen/appgallery_default_card_space_vertical_l"
                android:paddingEnd="@dimen/appgallery_default_card_space_vertical_l">
                <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/app_install_fail_layout"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/appgallery_subheader_item_double_min_height"
                    android:importantForAccessibility="yes">
                    <TextView
                        android:id="@id/app_install_fail_reason_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        style="@style/AppGallery.Widget.SubHeader.Title" />
                    <TextView
                        android:id="@id/app_install_fail_content"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout>
                <View
                    android:id="@id/dividerLine"
                    android:layout_width="fill_parent"
                    style="@style/AppGallery.Widget.Divider" />
                <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@id/app_install_handle_suggest_layout"
                    android:focusable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/appgallery_subheader_item_double_min_height"
                    android:importantForAccessibility="yes">
                    <TextView
                        android:id="@id/app_install_handle_suggest_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        style="@style/AppGallery.Widget.SubHeader.Title" />
                    <TextView
                        android:id="@id/app_install_handle_suggest_content"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@id/install_confirm_normal_loading_group"
            android:focusable="true"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/install_dist_head_card_progressbar_margin_bottom"
            android:importantForAccessibility="yes">
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/appgallery_safety_margin_m">
                <com.huawei.uikit.phone.hwprogressbar.widget.HwProgressBar
                    android:layout_gravity="center"
                    android:id="@id/head_check_progressbar"
                    android:visibility="visible"
                    android:layout_width="@dimen/install_dist_head_card_progressbar_size"
                    android:layout_height="@dimen/install_dist_head_card_progressbar_size"
                    style="@style/Widget.Emui.HwProgressBar.Large" />
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/install_confirm_status_left_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_height"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                    android:src="@drawable/install_dist_ic_tips_installation_security2" />
            </FrameLayout>
            <TextView
                android:textColor="?android:textColorPrimary"
                android:layout_gravity="center"
                android:id="@id/install_confirm_normal_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_install_checking_v2_3"
                style="@style/install_confirm_normal_head_app_source_style" />
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/install_success_tip_txt"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/install_confirm_normal_tips_card_tips_style" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip">
            <FrameLayout
                android:id="@id/install_confirm_tip_add_restrict"
                android:background="@drawable/install_confirm_normal_isolate_bg1"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/install_dist_head_card_bg_margin_top_internal"
                android:minHeight="@dimen/install_dist_head_card_bg_min_height">
                <ImageView
                    android:background="@drawable/install_confirm_normal_isolate_bg2"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:alpha="0.4" />
                <TextView
                    android:textSize="@dimen/emui_text_size_body1"
                    android:textColor="@color/emui_color_4"
                    android:gravity="center_vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="@dimen/install_dist_head_card_bg_text_margin_top_and_bottom"
                    android:layout_marginBottom="@dimen/install_dist_head_card_bg_text_margin_top_and_bottom"
                    android:text="@string/installconfirmriskcard_move_to_control_center_tips_new"
                    android:layout_marginStart="@dimen/install_dist_head_card_bg_text_margin_start"
                    android:layout_marginEnd="@dimen/install_dist_head_card_bg_text_margin_end" />
                <ImageView
                    android:layout_gravity="end|bottom|center"
                    android:background="@drawable/install_bg_shield"
                    android:layout_width="@dimen/install_dist_head_card_bg_shield_width"
                    android:layout_height="@dimen/install_dist_head_card_bg_shield_height"
                    android:layout_marginEnd="@dimen/install_dist_head_card_bg_shield_margin_end" />
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/puremode_enhance_content"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/install_dist_head_card_bg_margin_top_internal">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/app_permission_bg"
                    android:paddingTop="@dimen/ui_4_dp"
                    android:paddingBottom="@dimen/ui_4_dp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ui_12_dp"
                    android:paddingEnd="@dimen/ui_12_dp">
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_8_dp"
                        android:layout_marginBottom="@dimen/ui_8_dp"
                        android:minHeight="@dimen/appgallery_list_height_single_text_line"
                        android:text="@string/install_dist_enhance_card_title"
                        android:layout_weight="1.0"
                        style="@style/install_confirm_normal_head_app_name_style" />
                    <com.huawei.uikit.hwswitch.widget.HwSwitch
                        android:id="@id/puremode_enhance_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/emui_text_size_body2"
                    android:textColor="?android:textColorSecondary"
                    android:id="@id/puremode_enhance_detail"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/install_dist_head_card_bg_text_margin_top_and_bottom"
                    android:fontFamily="@string/emui_text_font_family_regular" />
            </LinearLayout>
        </LinearLayout>
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
</LinearLayout>