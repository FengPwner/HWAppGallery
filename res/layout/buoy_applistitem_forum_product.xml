<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:padding="@dimen/appgallery_max_padding_start"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/appgallery_max_padding_start"
    android:layout_marginEnd="@dimen/appgallery_max_padding_end"
    app:clip_background="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/forum_product_constraintLayout"
        android:background="@drawable/buoy_forum_post_product_card_background"
        android:padding="@dimen/appgallery_max_padding_start"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
            android:id="@id/forum_product_icon"
            android:layout_width="64.0dip"
            android:layout_height="64.0dip"
            android:src="@drawable/buoy_placeholder_base_right_angle"
            android:scaleType="centerCrop"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m"
            app:layout_constraintBottom_toBottomOf="@id/barrierBottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/barrierTop"
            app:touch_drawable="@drawable/transparent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/forum_product_content"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginStart="16.0dip"
            app:layout_constraintBottom_toBottomOf="@id/barrierBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/forum_product_icon"
            app:layout_constraintTop_toTopOf="@id/barrierTop">
            <TextView
                android:ellipsize="end"
                android:id="@id/forum_product_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textAlignment="viewStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/BuoyCardTextBody2_Medium" />
            <TextView
                android:ellipsize="end"
                android:id="@id/forum_product_intro"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:maxLines="2"
                android:textAlignment="viewStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forum_product_name"
                style="@style/BuoyCardTextBody3" />
            <com.huawei.appgallery.forum.posts.view.CountDownLayout
                android:orientation="horizontal"
                android:id="@id/forum_product_countdown"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forum_product_intro" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@id/barrierTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="forum_product_icon,forum_product_content" />
        <androidx.constraintlayout.widget.Barrier
            android:id="@id/barrierBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="forum_product_icon,forum_product_content" />
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:textSize="@dimen/appgallery_text_size_body3_fixed"
            android:textColor="@drawable/forum_post_product_more_button_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/forum_product_more_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/hwbutton_small_button_min_height"
            android:layout_marginTop="16.0dip"
            android:minWidth="64.0dip"
            android:text="@string/forum_product_more"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/forum_product_content"
            style="@style/BuoyProductHwButton" />
        <TextView
            android:ellipsize="end"
            android:id="@id/forum_product_promote_price"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewEnd"
            android:layout_marginStart="16.0dip"
            android:layout_marginEnd="8.0dip"
            app:layout_constraintBottom_toBottomOf="@id/forum_product_more_button"
            app:layout_constraintEnd_toStartOf="@id/forum_product_more_button"
            app:layout_constraintStart_toStartOf="@id/forum_product_icon"
            app:layout_constraintTop_toTopOf="@id/forum_product_more_button"
            style="@style/BuoyCardTextBody3" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>