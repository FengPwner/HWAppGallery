<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_webview_bottom_layout"
    android:background="@color/emui_card_panel_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24.0dip"
    android:paddingEnd="24.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="64.0dip">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/detail_webview_bottom_app_icon_imageview"
            android:focusable="false"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:src="@drawable/icon_default_bg"
            android:scaleType="fitCenter" />
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12.0dip">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/res_textsize_16sp"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:id="@id/detail_webview_bottom_app_name"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginEnd="8.0dip" />
                <TextView
                    android:textSize="@dimen/res_textsize_10sp"
                    android:textColor="@color/appgallery_text_color_link"
                    android:layout_gravity="bottom"
                    android:id="@id/detail_webview_bottom_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_more_btn"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip">
                <TextView
                    android:textSize="@dimen/res_textsize_12sp"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:id="@id/detail_webview_bottom_dev_name"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1.0" />
                <TextView
                    android:textSize="@dimen/res_textsize_10sp"
                    android:textColor="@color/appgallery_text_color_link"
                    android:ellipsize="end"
                    android:layout_gravity="bottom"
                    android:id="@id/detail_webview_bottom_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/detail_webview_bottom_privacy_max_width"
                    android:text="@string/component_detail_privacy"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="8.0dip" />
                <TextView
                    android:textSize="@dimen/res_textsize_10sp"
                    android:textColor="@color/appgallery_text_color_link"
                    android:ellipsize="end"
                    android:layout_gravity="bottom"
                    android:id="@id/detail_webview_bottom_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/detail_webview_bottom_permission_max_width"
                    android:text="@string/component_detail_permissions"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="8.0dip" />
                <TextView
                    android:textSize="@dimen/res_textsize_10sp"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:layout_gravity="bottom"
                    android:id="@id/detail_webview_bottom_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/detail_webview_bottom_version_max_width"
                    android:text="@string/component_detail_new_version"
                    android:maxLines="1"
                    android:layout_marginStart="8.0dip" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.huawei.appgallery.detail.detailbase.widget.DetailRelativeLayout
        android:orientation="horizontal"
        android:id="@id/bottom_relative_layout"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@id/download_framelayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:background="@drawable/corner_button_download_v3"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cs_16_dp"
                android:minHeight="@dimen/component_detail_bottom_button_height_v3">
                <com.huawei.appgallery.detail.detailbase.api.DetailBigDownloadButton
                    android:textSize="16.0dip"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_webview_bottom_download_button"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:minHeight="@dimen/component_detail_bottom_button_height_v3"
                    android:text="@string/card_install_btn"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    wapbutton:downloadFixedWidth="true"
                    wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                    style="@style/detail_big_download_button" />
            </LinearLayout>
        </LinearLayout>
    </com.huawei.appgallery.detail.detailbase.widget.DetailRelativeLayout>
</LinearLayout>