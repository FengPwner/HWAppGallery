<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/detail_flow_action_bar"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@id/back_icon"
        android:background="@drawable/hwappbarpattern_selector_item_bg"
        android:layout_width="@dimen/hwappbarpattern_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_height"
        android:contentDescription="@string/click_back"
        android:layout_marginStart="@dimen/margin_s"
        android:layout_marginEnd="@dimen/margin_s">
        <ImageView
            android:id="@id/back_imageview"
            android:layout_width="@dimen/search_icon_landscape_width"
            android:layout_height="@dimen/search_icon_landscape_width" />
    </LinearLayout>
    <TextView
        android:gravity="start|center"
        android:layout_gravity="center_vertical"
        android:id="@id/title_textview"
        android:clickable="false"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/margin_s"
        android:layout_marginEnd="@dimen/margin_s"
        style="@style/AppGallery.Widget.Toolbar.Title" />
    <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
            android:gravity="center"
            android:id="@id/search_icon"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/hwappbarpattern_icon_size"
            android:layout_height="@dimen/hwappbarpattern_icon_size"
            android:contentDescription="@string/hiappbase_search_btn"
            app:popupDrawable="@drawable/aguikit_ic_public_search"
            app:popupTitle="@string/hiappbase_search_btn">
            <ImageView
                android:id="@id/search_imageview"
                android:layout_width="@dimen/search_icon_landscape_width"
                android:layout_height="@dimen/search_icon_landscape_width" />
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
        <RelativeLayout
            android:id="@id/hiappbase_install_btn_id"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="visible"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:transitionGroup="false">
            <RelativeLayout
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_centerInParent="true"
                android:transitionGroup="false">
                <ImageView
                    android:id="@id/detail_install_btn_icon_id"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/detail_ic_install_btn" />
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@id/detail_installing_btn"
                    android:visibility="gone"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/detail_install_icon"
                    app:lottie_repeatCount="-1"
                    app:lottie_repeatMode="restart" />
            </RelativeLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_caption_fixed"
                android:textColor="@color/appgallery_text_color_primary_inverse"
                android:gravity="center"
                android:id="@id/install_num_id"
                android:background="@drawable/hiappbase_bigtitle_clicked_corner_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16.0dip"
                android:layout_marginTop="4.0dip"
                android:minWidth="16.0dip"
                android:maxLines="1"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip"
                android:layout_marginEnd="4.0dip"
                android:layout_alignParentEnd="true"
                app:hwAutoSizeMinTextSize="9.0dip"
                app:hwAutoSizeStepGranularity="1.0dip" />
        </RelativeLayout>
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
            android:gravity="center"
            android:layout_gravity="end|center"
            android:id="@id/share_icon"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/hwappbarpattern_icon_size"
            android:layout_height="@dimen/hwappbarpattern_icon_size"
            android:contentDescription="@string/share_app_title"
            android:layout_marginEnd="@dimen/margin_s"
            app:popupDrawable="@drawable/aguikit_ic_public_share"
            app:popupTitle="@string/hiappbase_search_btn">
            <ImageView
                android:id="@id/share_imageview"
                android:layout_width="@dimen/search_icon_landscape_width"
                android:layout_height="@dimen/search_icon_landscape_width" />
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
    </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
</LinearLayout>