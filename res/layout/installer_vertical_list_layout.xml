<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@id/installer_vertical_layout"
    android:paddingTop="@dimen/install_vertical_card_padding_top"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/install_dist_card_installer_bg"
        android:paddingBottom="@dimen/ui_4_dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:hwColumnType="content_type">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/title_layout"
            android:paddingTop="@dimen/ui_10_dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/cs_48_dp"
            android:paddingStart="@dimen/install_vertical_card_padding_start"
            android:paddingEnd="@dimen/install_vertical_card_padding_end">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/installer_vertical_list_title"
                android:focusable="true"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                style="@style/AppGallery.Widget.SubHeader.Title" />
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/installer_vertical_more_layout"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/card_more_btn"
                android:layout_marginStart="@dimen/ui_8_dp">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:id="@id/installer_vertical_more_tv"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/card_more_btn"
                    android:layout_weight="1.0"
                    android:lineSpacingMultiplier="1.1"
                    style="@style/AppGallery.Widget.SubHeader.More" />
                <ImageView
                    android:layout_gravity="end|center"
                    android:id="@id/installer_vertical_more_arrow"
                    android:background="@drawable/ic_public_arrow_right_900"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/title_layout_age"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/install_vertical_card_ageadapter_margin_top"
            android:paddingStart="@dimen/install_vertical_card_padding_start"
            android:paddingEnd="@dimen/install_vertical_card_padding_start">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/installer_vertical_list_title_age"
                android:focusable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart"
                style="@style/AppGallery.Widget.SubHeader.Title" />
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/installer_vertical_more_layout_age"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:contentDescription="@string/card_more_btn">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:id="@id/installer_vertical_more_tv_age"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/card_more_btn"
                    android:layout_weight="1.0"
                    android:lineSpacingMultiplier="1.1"
                    style="@style/AppGallery.Widget.SubHeader.More" />
                <ImageView
                    android:layout_gravity="end|center"
                    android:id="@id/installer_vertical_more_arrow_age"
                    android:background="@drawable/ic_public_arrow_right_900"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/installer_vertical_list_container_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@id/refresh_layout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:layout_marginBottom="12.0dip"
            android:minHeight="19.0dip"
            android:contentDescription="@string/youmaylike_refresh">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_button2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/refresh_button_title"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/youmaylike_refresh"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <ImageView
                android:id="@id/refresh_button_icon"
                android:tag="css/.widget"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/ic_change"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
        </LinearLayout>
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
</LinearLayout>