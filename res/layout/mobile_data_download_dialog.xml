<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:orientation="vertical"
    android:paddingTop="@dimen/appgallery_default_padding_top"
    android:scrollbars="none"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/margin_xl"
    android:paddingEnd="@dimen/margin_xl"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_primary"
            android:id="@id/mobile_data_download_dialog_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/mobile_data_download_dialog_description"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
        <com.huawei.uikit.phone.hwcheckbox.widget.HwCheckBox
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_primary"
            android:orientation="vertical"
            android:id="@id/mobile_data_download_dialog_not_remind_checkbox"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:minHeight="@dimen/size_48dp"
            android:text="@string/download_dialog_not_remind_description"
            style="@style/Widget.Emui.HwCheckBox.Normal" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_primary"
            android:id="@id/mobile_download_dialog_sub_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/mobile_data_download_dialog_setting_description"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
    </LinearLayout>
</ScrollView>