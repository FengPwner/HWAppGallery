<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    style="@style/AppGallery.Widget.SubHeader.ViewGroup"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@id/player_level_txtView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gift_player_level"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/appgallery_text_margin_horizontal"
            android:layout_alignParentStart="true"
            style="@style/AppGallery.Widget.SubHeader.Title" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/ll_login_txtView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:layout_below="@id/player_level_txtView">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/emui_functional_blue"
                android:id="@id/login_txtView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gift_login_show_player_level"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <com.huawei.appgallery.assistantdock.base.widget.FixedHeightImageView
            android:id="@id/player_level_img"
            android:visibility="visible"
            android:layout_width="24.0dip"
            android:layout_height="12.0dip"
            android:scaleType="centerInside"
            android:layout_alignTop="@id/player_level_txtView"
            android:layout_alignBottom="@id/player_level_txtView"
            android:layout_toEndOf="@id/player_level_txtView" />
        <TextView
            android:id="@id/level_privilege_txtView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:layout_below="@id/ll_login_txtView"
            android:textAlignment="viewStart"
            style="@style/AppGallery.Widget.SubHeader.Action" />
    </RelativeLayout>
</RelativeLayout>