<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/hiappbase_subheader_layout"
    android:paddingTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@id/hiappbase_subheader_title_layout"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="1.0"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="20.0sp"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:gravity="start|center"
            android:layout_gravity="start|center"
            android:id="@id/hiappbase_subheader_title_left"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_for_layout"
            android:maxLines="1"
            android:layout_weight="1.0"
            android:layout_alignBaseline="@id/wisedist_subheader_more_arrow"
            android:layout_centerVertical="true"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textAlignment="viewStart" />
        <ImageView
            android:layout_gravity="end|center"
            android:id="@id/hiappbase_subheader_more_arrow"
            android:tag="css/.arrow"
            android:background="@drawable/ic_public_arrow_right_900"
            android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
            android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
            android:contentDescription="@string/card_more_btn"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_alignParentEnd="true" />
    </LinearLayout>
</RelativeLayout>