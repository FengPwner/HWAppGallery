<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@id/rewards_title_layout"
        android:background="@drawable/welfare_center_title_bg"
        android:paddingBottom="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <LinearLayout
            android:layout_gravity="start|center"
            android:paddingTop="8.0dip"
            android:paddingBottom="8.0dip"
            android:focusable="true"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="2.0"
            android:importantForAccessibility="yes"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body1_fixed"
                android:textColor="@color/emui_color_text_primary_translucent"
                android:ellipsize="end"
                android:layout_gravity="start|center"
                android:id="@id/hiappbase_subheader_title_left"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_for_layout"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center"
            android:layout_gravity="start|center"
            android:orientation="horizontal"
            android:id="@id/hiappbase_subheader_more_layout"
            android:paddingTop="8.0dip"
            android:paddingBottom="8.0dip"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:contentDescription="@string/card_more_btn"
            android:importantForAccessibility="yes"
            android:layout_marginStart="@dimen/margin_m"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3_fixed"
                android:textColor="@color/emui_color_text_primary_translucent"
                android:id="@id/hiappbase_subheader_more_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_more_btn"
                android:maxLines="1"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginEnd="4.0dip"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <ImageView
                android:id="@id/hiappbase_subheader_more_arrow"
                android:background="@drawable/welfare_center_arrow"
                android:layout_width="9.0dip"
                android:layout_height="18.0dip" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/rewards_body_layout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:paddingTop="@dimen/appgallery_card_elements_margin_xl"
        android:paddingBottom="@dimen/appgallery_card_elements_margin_xl"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16.0dip"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
</LinearLayout>