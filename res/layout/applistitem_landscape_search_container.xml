<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:tag="@string/bannerImage"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/appList_ItemTitle_layout"
        layout="@layout/hiappbase_layout_subheader_title_more" />
    <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
        android:id="@id/AppListItem"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        bounceViews:bounceEnable="true" />
</LinearLayout>