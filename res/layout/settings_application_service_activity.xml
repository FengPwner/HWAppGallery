<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ScrollView
        android:paddingBottom="@dimen/padding_xl"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.huawei.appmarket.service.settings.view.widget.VerticalRadioViewGroup
            android:orientation="vertical"
            android:id="@id/radio_layout_settings"
            android:background="@drawable/aguikit_card_panel_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.appmarket.service.settings.view.widget.VerticalRadioView
                android:id="@id/radio_service_all"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:minHeight="64.0dip"
                android:text="@string/settings_application_service_full_mode"
                android:title="@string/settings_application_service_full_mode" />
            <com.huawei.appmarket.service.settings.view.widget.VerticalRadioView
                android:id="@id/radio_service_trial"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:minHeight="64.0dip"
                android:text="@string/settings_application_service_trial_mode"
                android:title="@string/settings_application_service_trial_mode" />
            <com.huawei.appmarket.service.settings.view.widget.VerticalRadioView
                android:id="@id/radio_service_child"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:minHeight="64.0dip"
                android:text="@string/settings_application_service_child_mode"
                android:title="@string/settings_application_service_child_mode" />
        </com.huawei.appmarket.service.settings.view.widget.VerticalRadioViewGroup>
    </ScrollView>
</LinearLayout>