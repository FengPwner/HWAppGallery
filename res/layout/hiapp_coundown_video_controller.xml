<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/image"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop" />
    <ViewStub
        android:id="@id/video_stub"
        android:layout="@layout/hiapp_countdown_video_controller_stub"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <ImageView
        android:id="@id/center_start"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/ic_public_play_button"
        android:scaleType="center"
        android:layout_centerInParent="true" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_caption"
        android:textColor="#ffffffff"
        android:id="@id/port_time"
        android:background="@drawable/video_time_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12.0dip"
        android:layout_alignParentBottom="true"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:paddingStart="4.0dip"
        android:paddingEnd="4.0dip"
        android:layout_marginEnd="12.0dip"
        android:layout_alignParentEnd="true" />
</RelativeLayout>