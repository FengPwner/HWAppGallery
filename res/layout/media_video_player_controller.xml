<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/player_controller"
    android:background="@color/media_show_image_activity_00000000"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/center_start"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/videokit_ic_public_play_big"
        android:contentDescription="@string/video_accessibility_play" />
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@id/video_bottom_controller"
        android:background="@drawable/videokit_ic_video_bg"
        android:visibility="invisible"
        android:layout_width="fill_parent"
        android:layout_height="80.0dip"
        android:paddingStart="@dimen/padding_l"
        android:paddingEnd="@dimen/padding_l">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/end_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip"
            android:layout_marginBottom="16.0dip"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/mute"
                android:padding="12.0dip"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:src="@drawable/aguikit_ic_public_sound" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/time_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/video_play_seekbar"
            android:layout_alignStart="@id/video_play_seekbar"
            android:layout_alignEnd="@id/video_play_seekbar">
            <TextView
                android:textSize="@dimen/emui_master_caption_2"
                android:textColor="@android:color/white"
                android:id="@id/video_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true" />
            <TextView
                android:textSize="@dimen/emui_master_caption_2"
                android:textColor="@android:color/white"
                android:id="@id/video_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <com.huawei.appgallery.common.media.widget.VideoPlayButton
            android:id="@id/video_play_pause_imageview"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:src="@drawable/videokit_ic_public_play_big"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />
        <com.huawei.uikit.hwseekbar.widget.HwSeekBar
            android:id="@id/video_play_seekbar"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:indeterminate="false"
            android:layout_centerVertical="true"
            android:contentDescription="@string/video_accessibility_play_progress"
            android:layout_marginEnd="2.0dip"
            android:layout_toStartOf="@id/end_control"
            android:layout_toEndOf="@id/video_play_pause_imageview"
            style="@style/Widget.Emui.HwSeekBar" />
    </RelativeLayout>
</FrameLayout>