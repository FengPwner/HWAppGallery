<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/update_main_layout"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/update_card_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_card_height_three_text_lines">
        <RelativeLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                android:id="@id/update_icon_imageview"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:src="@color/transparent"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                maskview:corner_type="appicon"
                maskview:round_type="all" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/middlepart_linearlayout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_toEndOf="@id/update_icon_imageview">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/update_option_button">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:ellipsize="end"
                                android:id="@id/update_item_name_imageview"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:text="@string/updatemanager_app_info_default"
                                android:singleLine="true"
                                android:layout_weight="1.0"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:importantForAccessibility="no"
                                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                            <TextView
                                android:textColor="@color/appgallery_emui_color_9"
                                android:ellipsize="end"
                                android:id="@id/prefixAppIntro"
                                android:tag="css/.title"
                                android:background="@drawable/prefixappintro_bg"
                                android:paddingTop="@dimen/appgallery_auto_size_step_granularity_fixed"
                                android:paddingBottom="@dimen/appgallery_auto_size_step_granularity_fixed"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:fontFamily="@string/appgallery_text_font_family_medium"
                                android:textAlignment="viewStart"
                                android:paddingStart="@dimen/padding_m"
                                android:paddingEnd="@dimen/padding_m"
                                android:layout_marginStart="@dimen/margin_s"
                                style="@style/AppGallery.TextAppearance.Card.TextBody4" />
                        </LinearLayout>
                        <TextView
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@id/update_item_size_textview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                            android:text="@string/updatemanager_app_info_default"
                            android:singleLine="true"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:textAllCaps="false"
                            android:importantForAccessibility="no"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                        <TextView
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@id/update_item_version_textview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                            android:text="@string/updatemanager_app_info_default"
                            android:singleLine="true"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:textAllCaps="false"
                            android:importantForAccessibility="no"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    </LinearLayout>
                    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                        android:id="@id/update_option_button"
                        android:layout_width="wrap_content"
                        android:layout_height="28.0dip"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                        android:layout_alignParentEnd="true"
                        style="@style/AppGallery.Widget.DownloadButton.Normal" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/update_short_desc_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginRight="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <TextView
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/update_short_desc"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/updatemanager_app_info_default"
            android:singleLine="true"
            android:layout_weight="1.0"
            android:lineSpacingMultiplier="@dimen/appgallery_text_line_space_s"
            android:textAllCaps="false"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        <ImageView
            android:gravity="start|center"
            android:layout_gravity="bottom"
            android:id="@id/update_arrow_imageView"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_public_arrow_down_900" />
    </LinearLayout>
    <View
        android:id="@id/update_split_line"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_marginLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginRight="@dimen/appgallery_card_panel_inner_margin_horizontal"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>