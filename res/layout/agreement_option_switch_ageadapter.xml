<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="horizontal"
    android:paddingTop="@dimen/size_8dp"
    android:paddingBottom="@dimen/size_8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body3"
        android:textColor="@color/appgallery_text_color_primary"
        android:id="@id/privacy_text"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="48.0dip"
        android:fontFamily="HarmonyHeiTi"
        android:layout_toStartOf="@id/privacy_switch" />
    <com.huawei.uikit.hwswitch.widget.HwSwitch
        android:gravity="top"
        android:id="@id/privacy_switch"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:layout_alignTop="@id/privacy_text"
        android:layout_alignBottom="@id/privacy_text"
        android:paddingStart="0.0dip"
        android:paddingEnd="0.0dip"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
        android:layout_alignParentEnd="true"
        style="@style/Widget.Emui.HwSwitch" />
</RelativeLayout>