<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    app:clip_background="true"
    app:round_corner="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="@dimen/appgallery_card_stroke_width"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <View
            android:id="@id/video_content_layout"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_player" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/app_zone_layout"
            android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_player">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/video_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/fixed_linearlayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:id="@id/promotion_sign"
                        android:background="@drawable/promotion_sign_bg"
                        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                        style="@style/promotion_sign_style_banner" />
                    <TextView
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@id/video_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
                </LinearLayout>
            </LinearLayout>
            <com.huawei.appgallery.pageframe.view.DownloadButtonV2
                android:layout_gravity="end|bottom|center"
                android:id="@id/dl_btn"
                android:layout_width="56.0dip"
                android:layout_height="28.0dip"
                android:layout_marginStart="8.0dip"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
        </LinearLayout>
        <com.huawei.appgallery.videokit.api.WiseVideoView
            android:id="@id/video_player"
            android:tag="@string/properties_video_contentDescription"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginBottom="@dimen/margin_m"
            app:layout_constraintBottom_toTopOf="@id/app_zone_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:media_type="0"
            app:view_type="0" />
        <TextView
            android:textSize="8.0dip"
            android:textColor="@color/emui_color_white_origin"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/video_desc_textview"
            android:background="@drawable/substancelistcard_chip_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:minWidth="24.0dip"
            android:minHeight="14.0dip"
            android:maxLines="1"
            android:maxEms="9"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:paddingStart="@dimen/padding_m"
            android:paddingEnd="@dimen/padding_m"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>