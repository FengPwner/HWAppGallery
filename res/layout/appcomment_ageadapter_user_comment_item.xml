<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/click_layout"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/detail_click_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appcomment_16_dp"
        android:minHeight="@dimen/appgallery_card_height_two_text_lines"
        android:paddingStart="@dimen/appgallery_max_padding_start">
        <RelativeLayout
            android:id="@id/user_info_layout"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_m">
            <ImageView
                android:id="@id/user_head_shot"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/margin_l" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/content_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appcomment_12_dp"
                android:layout_below="@id/user_head_shot"
                android:layout_marginEnd="@dimen/margin_l">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:gravity="start|center"
                        android:id="@id/user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                        android:singleLine="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                    <RelativeLayout
                        android:id="@id/comment_audit_info_layout"
                        android:background="@drawable/appcomment_usercomment_round_corner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:layout_marginBottom="8.0dip">
                        <ImageView
                            android:id="@id/comment_item_tip"
                            android:background="@drawable/appcomment_user_comment_tip_icon"
                            android:clickable="true"
                            android:layout_width="12.0dip"
                            android:layout_height="12.0dip"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="2.0dip" />
                        <TextView
                            android:textSize="@dimen/emui_text_size_caption1"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:layout_gravity="center"
                            android:id="@id/comment_audit_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1.0dip"
                            android:layout_marginBottom="1.0dip"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:layout_marginStart="2.0dip"
                            android:layout_marginEnd="8.0dip"
                            android:layout_toEndOf="@id/comment_item_tip" />
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/appzone_comment_stars_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        android:importantForAccessibility="no">
                        <RatingBar
                            android:layout_gravity="center_vertical"
                            android:id="@id/appzone_comment_stars"
                            style="@style/appcomment_style_list_ratingbar" />
                        <View
                            android:id="@id/appzone_comment_stars_conceal_view"
                            android:background="@null"
                            android:layout_width="@dimen/appgallery_elements_margin_horizontal_m"
                            android:layout_height="4.0dip" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <com.huawei.uikit.hwtextview.widget.HwTextView
                                android:ellipsize="end"
                                android:id="@id/appzone_comment_time"
                                android:tag="css/.subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                            <com.huawei.uikit.hwtextview.widget.HwTextView
                                android:ellipsize="end"
                                android:id="@id/appzone_comment_ip"
                                android:tag="css/.subtitle"
                                android:visibility="gone"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4.0dip"
                                android:singleLine="true"
                                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/appzone_comment_delete_layout"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:visibility="visible"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:contentDescription="@string/card_more_btn"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/detail_delete_reply_icon_imageview"
                    android:background="@drawable/aguikit_ic_public_more_list"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="centerCrop" />
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:id="@id/detail_comment_content_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appcomment_12_dp"
            android:paddingEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.appgallery.appcomment.ui.view.FoldTextView
                android:id="@id/appzone_comment_info"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:layout_gravity="end|bottom|center"
                android:id="@id/open_or_fold_tv"
                android:tag="css/.title"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appcomment_user_open_content"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </FrameLayout>
        <include
            android:id="@id/appcommment_comment_shield_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appcomment_12_dp"
            android:paddingEnd="@dimen/appgallery_max_padding_end"
            layout="@layout/appcomment_comment_shield_layout" />
        <RelativeLayout
            android:id="@id/appcommment_app_info_layout"
            android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
            android:paddingTop="@dimen/appcomment_12_dp"
            android:paddingBottom="@dimen/appcomment_12_dp"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <ImageView
                android:id="@id/appcommment_app_info_icon"
                android:tag="css/.widget"
                android:layout_width="@dimen/appgallery_card_icon_size_middle"
                android:layout_height="@dimen/appgallery_card_icon_size_middle"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
            <RelativeLayout
                android:id="@id/right_middle_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/appcommment_app_info_icon">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/app_name"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                    android:layout_below="@id/app_name">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:ellipsize="end"
                        android:id="@id/app_tag"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:id="@id/app_stars"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/reply_tag"
                        style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
                </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/appzone_comment_clicklayout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@id/appcomment_like_diss_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="48.0dip">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/image_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/appzone_comment_approve_layout"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip"
                    android:layout_marginEnd="@dimen/margin_l">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/detail_comment_approve_icon_imageview"
                        android:background="@drawable/aguikit_ic_public_thumbsup"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:scaleType="centerCrop" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@id/appzone_comment_approve_counts"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/appzone_comment_diss_layout"
                    android:tag="css/.report-button"
                    android:background="@color/transparent"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip"
                    android:layout_marginEnd="@dimen/margin_l">
                    <com.huawei.appgallery.appcomment.ui.view.DissImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/detail_comment_diss_icon_imageview"
                        android:tag="css/.widget"
                        android:background="@drawable/appcomment_step_on"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:scaleType="centerCrop" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@id/appzone_comment_diss_counts"
                        android:tag="css/.title"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/appcomment_diss_comment"
                        android:maxLines="1"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/appzone_comment_reply_layout"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/detail_comment_reply_icon_imageview"
                        android:background="@drawable/aguikit_ic_public_comments"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:scaleType="centerCrop" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@id/appzone_comment_reply_counts"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/appcomment_reply_button"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/appzone_comment_share"
                    android:padding="12.0dip"
                    android:layout_width="40.0dip"
                    android:layout_height="fill_parent"
                    android:src="@drawable/aguikit_ic_public_share"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/share_app_title"
                    android:layout_alignParentEnd="true" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <include
        layout="@layout/appcomment_subheader_divider" />
</LinearLayout>