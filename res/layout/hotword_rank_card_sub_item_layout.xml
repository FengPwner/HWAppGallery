<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/aguikit_round_rectangle_card_item_bg"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/search_hot_word_rank_item_height"
    android:layout_weight="1.0"
    android:paddingStart="@dimen/appgallery_default_corner_radius_m"
    android:paddingEnd="@dimen/appgallery_default_corner_radius_m"
    android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_vertical"
    android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/emui_color_text_tertiary"
        android:gravity="center_horizontal"
        android:id="@id/tv_hot_item_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/search_hot_word_number_max_width"
        android:minWidth="@dimen/search_hot_word_number_min_width"
        android:text="1"
        android:layout_centerVertical="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:textDirection="locale"
        android:layout_alignParentStart="true" />
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/emui_color_text_primary"
        android:ellipsize="end"
        android:id="@id/tv_hot_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:textDirection="locale"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="@dimen/search_hot_word_content_end"
        android:layout_toEndOf="@id/tv_hot_item_num" />
    <ViewStub
        android:id="@id/search_flag_view_one_viewstub"
        android:layout="@layout/search_hot_flag_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/search_hot_word_iv_start"
        android:layout_toEndOf="@id/tv_hot_item_name" />
    <ImageView
        android:id="@id/hot_item_divider"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@id/tv_hot_item_name"
        android:layout_alignParentEnd="true"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>