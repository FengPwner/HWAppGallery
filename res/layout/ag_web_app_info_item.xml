<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:paddingTop="@dimen/appgallery_text_paragraph_margin_xs"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="@dimen/cs_16_dp"
        android:layout_height="@dimen/cs_16_dp"
        android:src="@drawable/ic_popup_point"
        android:layout_marginEnd="@dimen/appgallery_text_paragraph_margin_xs" />
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_text_color_primary"
        android:layout_gravity="center_vertical"
        android:id="@id/app_name_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/appgallery_text_font_family_regular" />
</LinearLayout>