<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@id/no_wifi_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/no_wifi"
        android:tag="css/.widget"
        android:background="@drawable/ic_no_wifi_disable"
        style="@style/AppGallery.ImageSize.NoData" />
    <ImageView
        android:layout_gravity="center"
        android:id="@id/in_maintenance"
        android:tag="css/.widget"
        android:background="@drawable/ic_empty_in_maintenance"
        android:visibility="gone"
        style="@style/AppGallery.ImageSize.NoData" />
    <TextView
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@id/title"
        android:tag="css/.subtitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.TextAppearance.NoData" />
</LinearLayout>