<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/img_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                android:id="@id/wisedist_searchbigcard_first_icon"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                app:corner_radius="@dimen/appgallery_default_corner_radius_m"
                app:touch_drawable="@color/mask_image_view_color" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/wisedist_searchbigcard_first_text"
                android:paddingTop="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="HarmonyHeiTi"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                android:id="@id/wisedist_searchbigcard_second_icon"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                app:corner_radius="@dimen/appgallery_default_corner_radius_m"
                app:touch_drawable="@color/mask_image_view_color" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/wisedist_searchbigcard_second_text"
                android:paddingTop="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="HarmonyHeiTi"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@id/bottom_line_layout"
        android:paddingTop="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <View
            android:id="@id/bigcard_detectorline"
            android:layout_width="fill_parent"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.Widget.Divider" />
    </LinearLayout>
</LinearLayout>