<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/buoy_head_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@id/head_frameLayout"
        android:paddingTop="@dimen/ui_8_dp"
        android:paddingBottom="@dimen/ui_8_dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_marginEnd="@dimen/margin_m">
        <ImageView
            android:id="@id/buoy_player_head_imageview"
            android:focusable="true"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:src="@drawable/img_defaultavatar_list_gray" />
        <ImageView
            android:layout_gravity="end|center|top"
            android:visibility="invisible"
            android:layout_width="@dimen/ui_6_dp"
            android:layout_height="@dimen/ui_6_dp"
            android:src="@drawable/tips_news" />
    </FrameLayout>
    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/ui_8_dp"
        android:layout_weight="1.0">
        <TextView
            android:textSize="@dimen/emui_text_size_headline7"
            android:textColor="@color/buoy_emui_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/buoy_nickname_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:alpha="1.0"
            android:fontFamily="@string/emui_text_font_family_medium" />
        <com.huawei.appgallery.assistantdock.base.widget.FixedHeightImageView
            android:layout_gravity="center_vertical"
            android:id="@id/buoy_player_level_imageview"
            android:visibility="gone"
            android:layout_width="24.0dip"
            android:layout_height="12.0dip"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/ui_6_dp" />
    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/buoy_forum_msg_layout"
                android:background="@drawable/buoy_more_bg_selector"
                android:paddingTop="@dimen/padding_xs"
                android:paddingBottom="@dimen/padding_xs"
                android:visibility="gone"
                android:layout_width="@dimen/ui_40_dp"
                android:layout_height="48.0dip"
                android:layout_marginStart="0.0dip"
                android:layout_marginEnd="0.0dip">
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip">
                    <ImageView
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_buoy_forum_msg"
                        android:layout_centerInParent="true" />
                    <ImageView
                        android:id="@id/buoy_forum_msg_dot"
                        android:visibility="gone"
                        android:layout_width="@dimen/ui_6_dp"
                        android:layout_height="@dimen/ui_6_dp"
                        android:src="@drawable/tab_red_dot"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/buoy_game_space_layout"
                android:background="@drawable/buoy_more_bg_selector"
                android:paddingTop="@dimen/padding_xs"
                android:paddingBottom="@dimen/padding_xs"
                android:visibility="gone"
                android:layout_width="36.0dip"
                android:layout_height="48.0dip"
                android:layout_marginStart="0.0dip"
                android:layout_marginEnd="0.0dip">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/buoy_game_space"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/buoy_func_game_space" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/buoy_assistant_layout"
                android:background="@drawable/buoy_more_bg_selector"
                android:paddingTop="@dimen/padding_xs"
                android:paddingBottom="@dimen/padding_xs"
                android:visibility="gone"
                android:layout_width="36.0dip"
                android:layout_height="48.0dip"
                android:layout_marginStart="0.0dip"
                android:layout_marginEnd="0.0dip">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/buoy_assistant"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/buoy_func_assistant" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/buoy_feedback_layout"
                android:background="@drawable/buoy_more_bg_selector"
                android:paddingTop="@dimen/padding_xs"
                android:paddingBottom="@dimen/padding_xs"
                android:visibility="gone"
                android:layout_width="36.0dip"
                android:layout_height="48.0dip"
                android:layout_marginStart="0.0dip"
                android:layout_marginEnd="0.0dip">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/buoy_feedback"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/buoy_func_feedback" />
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:id="@id/buoy_more_layout"
                android:background="@drawable/buoy_more_bg_selector"
                android:paddingTop="@dimen/padding_xs"
                android:paddingBottom="@dimen/padding_xs"
                android:visibility="gone"
                android:layout_width="36.0dip"
                android:layout_height="48.0dip"
                android:layout_marginStart="0.0dip"
                android:layout_marginEnd="0.0dip">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="12.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/ic_buoy_appbar_more"
                    android:layout_marginStart="8.0dip" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/download_bar_item_text"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/buoy_forum_msg_number_tv"
            android:background="@drawable/buoy_forum_msg_shape_red"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14.0dip"
            android:layout_marginTop="12.0dip"
            android:paddingStart="4.0dip"
            android:paddingEnd="4.0dip"
            android:layout_marginStart="24.0dip" />
    </FrameLayout>
</LinearLayout>