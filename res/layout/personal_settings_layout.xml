<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="end|center"
    android:id="@id/personal_settings"
    android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
    android:layout_width="@dimen/size_48dp"
    android:layout_height="@dimen/size_48dp"
    android:contentDescription="@string/action_settings"
    android:transitionGroup="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/personal_settings_icon"
        android:layout_width="@dimen/ui_24_dp"
        android:layout_height="@dimen/ui_24_dp"
        android:src="@drawable/aguikit_ic_public_settings"
        android:layout_marginEnd="@dimen/ui_12_dp" />
    <ImageView
        android:id="@id/personal_settings_right_red_dot"
        android:visibility="gone"
        android:layout_width="6.0dip"
        android:layout_height="6.0dip"
        android:src="@drawable/tab_red_dot"
        android:layout_alignTop="@id/personal_settings_icon"
        android:layout_alignEnd="@id/personal_settings_icon" />
</RelativeLayout>