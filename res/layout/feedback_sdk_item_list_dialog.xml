<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/feedback_sdk_common_24_dip"
    android:paddingEnd="@dimen/feedback_sdk_common_24_dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="16.0sp"
        android:textColor="@color/feedback_sdk_text_normal_black"
        android:id="@id/list_dialog_item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_marginBottom="10.0dip"
        android:layout_centerVertical="true" />
    <RadioButton
        android:id="@id/list_dialog_item_radio"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:layout_marginBottom="10.0dip"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true" />
    <View
        android:id="@id/list_dialog_item_line"
        android:background="@color/feedback_sdk_grid_divider_color"
        android:layout_width="fill_parent"
        android:layout_height="0.5dip"
        android:layout_alignParentBottom="true" />
</RelativeLayout>