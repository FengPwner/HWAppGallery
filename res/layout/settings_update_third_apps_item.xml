<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    style="@style/AppGallery.Widget.List.SingleTextLine"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:gravity="center_vertical"
        android:id="@id/item_title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="@string/settings_third_party_apps_support_background_updates"
        android:layout_weight="1.0"
        android:lineSpacingMultiplier="1.3"
        style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    <com.huawei.uikit.phone.hwswitch.widget.HwSwitch
        android:id="@id/switch_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
        style="@style/Widget.Emui.HwSwitch" />
</LinearLayout>