<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_desc_layout_linearlayout"
    android:paddingBottom="@dimen/margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/subtitle"
        layout="@layout/hiappbase_layout_subheader_title_action" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:layout_gravity="start|center"
        android:id="@id/detail_desc_traffic_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_for_layout"
        android:maxLines="2"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/detail_card_tariff_desc" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:layout_gravity="start|center"
        android:id="@id/detail_desc_content_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
        android:text="@string/placeholder_for_layout"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/detail_card_introduce_content" />
</LinearLayout>