<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/activity_comment_detail_title_layout" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/section_layout"
        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="48.0dip"
            style="@style/AppGallery.Widget.List.SingleTextLine">
            <TextView
                android:id="@id/forum_look_tip"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/forum_comments_post_enter"
                android:drawablePadding="@dimen/margin_s"
                android:drawableEnd="@drawable/ic_public_arrow_right_900"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.SubHeader.More" />
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toStartOf="@id/forum_look_tip">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/forum_title"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:layout_width="fill_parent"
            style="@style/AppGallery.Widget.Divider" />
    </LinearLayout>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@id/post_reply_layout"
        android:background="@color/appgallery_color_toolbar_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="48.0dip"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true"
        android:alpha="0.95"
        android:importantForAccessibility="no">
        <com.huawei.uikit.hwedittext.widget.HwCounterTextLayout
            android:layout_gravity="center_vertical"
            android:id="@id/reply_publish_content_layout"
            android:padding="0.0dip"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_s"
            android:layout_marginBottom="@dimen/margin_s"
            android:maxLines="6"
            android:layoutDirection="locale"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_marginEnd="52.0dip"
            app:hwMaxLength="500"
            app:hwShapeMode="bubble">
            <com.huawei.uikit.hwedittext.widget.HwEditText
                android:textSize="@dimen/emui_master_body_2"
                android:textColor="@color/appgallery_text_color_primary"
                android:textColorHint="@color/appgallery_text_color_hint"
                android:id="@id/post_comment_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="@string/forum_base_reply_content_hint" />
        </com.huawei.uikit.hwedittext.widget.HwCounterTextLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="end|bottom|center"
            android:id="@id/post_right_layout"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip"
            android:contentDescription="@string/forum_post_comment_reply"
            android:layout_marginEnd="@dimen/margin_s">
            <ImageView
                android:id="@id/post_icon"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip" />
            <ProgressBar
                android:id="@id/post_comment_loading_image"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_centerInParent="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@id/card_list_container"
        android:focusable="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/post_reply_layout"
        android:layout_below="@id/section_layout" />
</RelativeLayout>