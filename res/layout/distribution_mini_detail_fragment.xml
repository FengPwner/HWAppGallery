<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/mini_detail_container"
        android:tag="css/.body"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/mini_detail_headview"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <FrameLayout
            android:id="@id/hiappbase_data_layout_id"
            android:focusableInTouchMode="true"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/mini_detail_bottom"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginBottom="@dimen/margin_m">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.appgallery.detail.detailbase.api.MiniDetailDownloadButton
                    android:textSize="@dimen/appgallery_text_size_button2"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@id/mini_download_button"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_s"
                    android:layout_marginBottom="@dimen/margin_m"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="@dimen/margin_l"
                    android:layout_marginEnd="@dimen/margin_l"
                    style="@style/Widget.Emui.HwProgressButton" />
            </LinearLayout>
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_12_dp"
                android:layout_marginEnd="@dimen/ui_12_dp">
                <LinearLayout
                    android:gravity="start|center"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_l"
                    android:layout_toStartOf="@id/mini_more_detail_button">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/app_layout"
                        android:background="@drawable/detail_clickeffic_bg_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/detail_hot_zone_min_height"
                        android:paddingStart="@dimen/padding_s"
                        android:paddingEnd="@dimen/padding_s">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/app_icon_about"
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip" />
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:textSize="@dimen/appgallery_text_size_body2"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:id="@id/app_name_textview"
                            android:tag="css/.title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:layout_marginStart="4.0dip"
                            app:hwAutoSizeMinTextSize="12.0sp"
                            app:hwAutoSizeStepGranularity="1.0sp" />
                    </LinearLayout>
                </LinearLayout>
                <com.huawei.appgallery.detail.detaildist.mini.fragment.MiniDetailBottomButton
                    android:textSize="@dimen/appgallery_text_size_button2"
                    android:ellipsize="end"
                    android:id="@id/mini_more_detail_button"
                    android:tag="css/.title"
                    android:background="@drawable/detail_clickeffic_bg_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/detail_hot_zone_min_height"
                    android:text="@string/component_detail_more_detail"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:paddingStart="@dimen/padding_s"
                    android:paddingEnd="@dimen/padding_s"
                    android:layout_alignParentEnd="true"
                    style="@style/Widget.Emui.HwButton.Small" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>