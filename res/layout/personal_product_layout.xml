<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/content_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.huawei.appgallery.usercenter.personal.base.view.widget.ProductPullUpListView
            android:id="@id/applistview"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:drawSelectorOnTop="true"
            android:divider="@null"
            bounceViews:bounceEnable="true"
            bounceViews:hwCutoutMode="never" />
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.NodataWarnLayout
        android:id="@id/nodata_view"
        android:background="@color/appgallery_color_sub_background"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <FrameLayout
        android:id="@id/hiappbase_loading_layout_id"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</FrameLayout>