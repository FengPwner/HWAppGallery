<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/post_main_body"
    android:background="@drawable/aguikit_round_rectangle_card_bg"
    android:paddingTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/post_img_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xs"
        android:maxLines="2"
        android:textAlignment="viewStart"
        style="@style/AppGallery.TextAppearance.Card.TextBody1" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:id="@id/content"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:maxLines="2"
        android:textAlignment="viewStart"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
    <View
        android:id="@id/divide_line"
        android:visibility="visible"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>