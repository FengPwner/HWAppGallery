<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingBottom="@dimen/margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/subtitle"
        layout="@layout/hiappbase_layout_subheader_title_action" />
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/detail_grade_layout"
        android:background="@drawable/list_item_normal_selector"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <ImageView
            android:id="@id/detail_gradeImage"
            android:layout_width="28.0dip"
            android:layout_height="28.0dip"
            android:layout_centerVertical="true" />
        <ImageView
            android:id="@id/detail_grade_arrow_imageview"
            android:tag="css/.arrow"
            android:background="@drawable/ic_public_arrow_right_900"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:minHeight="@dimen/appgallery_list_height_single_text_line"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ui_12_dp"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_toStartOf="@id/detail_grade_arrow_imageview"
            android:layout_toEndOf="@id/detail_gradeImage">
            <TextView
                android:ellipsize="end"
                android:id="@id/detail_grade_name_textview"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/detail_grade_desc_textview"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/detail_grade_interactive_textview"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>