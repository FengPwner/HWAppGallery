<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:background="@drawable/bigbuoy_background_drawable"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/window_title"
        layout="@layout/buoy_window_title" />
    <com.huawei.uikit.hwviewpager.widget.HwViewPager
        android:id="@id/gallery"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/dot_indicator"
        android:layout_below="@id/window_title"
        android:overScrollMode="never"
        bounceViews:bounceEnable="true" />
    <com.huawei.uikit.phone.hwdotspageindicator.widget.HwDotsPageIndicator
        android:gravity="center_vertical"
        android:id="@id/dot_indicator"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:isIndicator="true"
        android:layout_alignParentBottom="true" />
</RelativeLayout>