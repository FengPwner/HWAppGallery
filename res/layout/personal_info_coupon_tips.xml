<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="8.0dip"
        android:textColor="@color/appgallery_text_color_primary_inverse"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/coupon_tips_text"
        android:background="@drawable/personal_coupon_tips_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/personal_coupon_tips_text_height"
        android:maxWidth="@dimen/personal_coupon_margin"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:paddingStart="@dimen/personal_coupon_tips_text_padding"
        android:paddingEnd="@dimen/personal_coupon_tips_text_padding" />
</LinearLayout>