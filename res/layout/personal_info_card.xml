<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="176.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/appcommon_personal_def_container_relativelayout"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
        android:layout_marginEnd="@dimen/appgallery_column_system_content_margin">
        <com.huawei.appmarket.framework.widget.PersonalClipRoundImageView
            android:id="@id/appcommon_personal_definfo_bg_imageview"
            android:layout_width="fill_parent"
            android:layout_height="152.0dip"
            android:src="@drawable/personal_info_bg"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
        <ImageView
            android:id="@id/appcommon_personal_definfo_bg_imageview_shadow"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/personal_infocard_bg_size"
            android:src="@drawable/personal_info_bg_shadow"
            android:scaleType="fitXY"
            android:layout_below="@id/appcommon_personal_definfo_bg_imageview" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/appcommon_personal_defcontainer_linearlayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
                android:layout_gravity="center_horizontal"
                android:id="@id/appcommon_personal_definfo_head_imageview"
                android:background="@android:color/transparent"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:src="@drawable/placeholder_base_account_header"
                android:scaleType="centerCrop" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_xl">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body1"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:id="@id/appcommon_personal_definfo_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_l"
                    android:maxLines="1"
                    android:layout_weight="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body3"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:id="@id/appcommon_personal_deftip_textview"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/personal_login_for_game_privileges"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/appcommon_personal_container_relativelayout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="176.0dip"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
        android:layout_marginEnd="@dimen/appgallery_column_system_content_margin">
        <com.huawei.appmarket.framework.widget.PersonalClipRoundImageView
            android:id="@id/appcommon_personal_info_bg_imageview"
            android:layout_width="fill_parent"
            android:layout_height="152.0dip"
            android:src="@drawable/personal_info_bg"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
        <ImageView
            android:id="@id/appcommon_personal_info_bg_imageview_shadow"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/personal_infocard_bg_size"
            android:src="@drawable/personal_info_bg_shadow"
            android:scaleType="fitXY"
            android:layout_below="@id/appcommon_personal_info_bg_imageview" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/appcommon_personal_head_linearlayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xl"
            android:layout_marginStart="@dimen/margin_xl"
            android:layout_marginEnd="@dimen/margin_l">
            <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
                android:id="@id/appcommon_personal_info_head_imageview"
                android:background="@android:color/transparent"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:src="@drawable/placeholder_base_account_header"
                android:scaleType="centerCrop" />
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/appcommon_personal_info_account_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserInfoTextView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/mine_user_home_page_tv"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_l" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/appcommon_personal_asset_linearlayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/personal_infocard_margin"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_xl"
            android:layout_marginEnd="@dimen/margin_xl">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/appcommon_personal_gticket_linearlayout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="@dimen/res_textsize_16dp"
                    android:textStyle="bold"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/appcommon_personal_gticket_value_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:alpha="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/res_textsize_12dp"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:ellipsize="end"
                        android:id="@id/appcommon_personal_gticket_label_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/personal_game_ticket"
                        android:maxLines="1"
                        android:alpha="1.0"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                    <ImageView
                        android:id="@id/appcommon_personal_gticket_red_dot"
                        android:visibility="gone"
                        android:layout_width="6.0dip"
                        android:layout_height="6.0dip"
                        android:src="@drawable/tab_red_dot"
                        android:layout_marginStart="@dimen/margin_s"
                        android:layout_toEndOf="@id/gticket_txt" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_gravity="center"
                android:id="@id/appcommon_personal_divider"
                android:background="@color/personal_color_personal_divider"
                android:layout_width="1.0dip"
                android:layout_height="24.0dip" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/appcommon_personal_hcoin_linearlayout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="@dimen/res_textsize_16dp"
                    android:textStyle="bold"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/appcommon_personal_hcoin_value_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:alpha="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
                <TextView
                    android:textSize="@dimen/res_textsize_12dp"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/appcommon_personal_hcoin_label_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/personal_hua_coin"
                    android:maxLines="1"
                    android:alpha="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>