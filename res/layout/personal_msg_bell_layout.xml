<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="end|center"
    android:id="@id/personal_msg_bell"
    android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
    android:layout_width="@dimen/size_48dp"
    android:layout_height="@dimen/size_48dp"
    android:contentDescription="@string/personal_msg_bell_click"
    android:transitionGroup="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/personal_msg_bell_icon"
        android:layout_width="@dimen/ui_24_dp"
        android:layout_height="@dimen/ui_24_dp"
        android:src="@drawable/personal_ic_msg_bell"
        android:layout_marginEnd="@dimen/ui_12_dp" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/emui_text_size_caption"
        android:textColor="@color/appgallery_text_color_primary_inverse"
        android:gravity="center"
        android:id="@id/personal_msg_bell_text"
        android:background="@drawable/personal_msg_bell_text_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/personal_msg_bell_text_minWidth"
        android:minWidth="@dimen/personal_msg_bell_text_minWidth"
        android:maxLines="1"
        android:fontFamily="@string/emui_text_font_family_regular"
        android:paddingStart="@dimen/personal_msg_bell_text_padding"
        android:paddingEnd="@dimen/personal_msg_bell_text_padding"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
        app:hwAutoSizeMinTextSize="8.0dip"
        app:hwAutoSizeStepGranularity="1.0dip" />
</RelativeLayout>