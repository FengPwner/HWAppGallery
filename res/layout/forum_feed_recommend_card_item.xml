<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg"
    android:paddingTop="12.0dip"
    android:paddingBottom="12.0dip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/forum_recommend_card_distance_with_post_card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:id="@id/forum_feed_recommend_section_icon"
        android:layout_width="@dimen/round_icon_width"
        android:layout_height="@dimen/round_icon_width"
        android:importantForAccessibility="no"
        app:corner_type="appicon"
        app:round_type="all" />
    <com.huawei.appgallery.forum.cards.widget.UserHeadImageView
        android:id="@id/forum_feed_recommend_user_icon"
        android:layout_width="@dimen/round_icon_width"
        android:layout_height="@dimen/round_icon_width"
        android:importantForAccessibility="no" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="12.0dip"
        android:textColor="@color/appgallery_text_color_primary"
        android:ellipsize="end"
        android:id="@id/forum_feed_recommend_first_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:maxLines="1"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/margin_m"
        android:layout_marginEnd="@dimen/margin_m" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="4.0dip">
        <ImageView
            android:id="@id/posts_img"
            android:layout_width="12.0dip"
            android:layout_height="12.0dip"
            android:layout_marginTop="@dimen/margin_xs"
            android:src="@drawable/forum_post_image"
            android:adjustViewBounds="true"
            android:contentDescription="@string/forum_post_desc"
            android:alpha="@dimen/appgallery_tertiary_content_alpha" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="10.0dip"
            android:textColor="@color/appgallery_text_color_tertiary"
            android:ellipsize="end"
            android:id="@id/forum_feed_recommend_second_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xs"
            android:maxLines="1"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginStart="@dimen/margin_xs" />
    </LinearLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_button2"
        android:textColor="@color/appgallery_text_color_link"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/forum_section_follow"
        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:singleLine="true"
        android:textAllCaps="true"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip"
        android:layout_marginStart="@dimen/margin_m"
        android:layout_marginEnd="@dimen/margin_m" />
</LinearLayout>