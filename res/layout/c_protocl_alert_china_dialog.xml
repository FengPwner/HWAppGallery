<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@id/protocoldialoglayout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:id="@id/checkBoxScrollLayout"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        android:layout_weight="1.0"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout
                android:layout_gravity="center_horizontal"
                android:id="@id/topLayout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:hwColumnType="content_type">
                <ImageView
                    android:id="@id/privacy_app_icon"
                    android:layout_width="72.0dip"
                    android:layout_height="72.0dip"
                    android:layout_marginTop="112.0dip"
                    android:layout_marginBottom="@dimen/ui_24_dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:id="@id/privacy_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2.0dip"
                    android:layout_below="@id/privacy_app_icon"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="30.0dip"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="center"
                    android:id="@id/privacy_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2.0dip"
                    android:layout_below="@id/privacy_welcome"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium" />
            </com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout>
            <com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                app:hwColumnType="content_type">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:id="@id/privacy_app_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:layout_below="@id/privacy_app_name"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textAlignment="center" />
            </com.huawei.uikit.hwcolumnlayout.widget.HwColumnRelativeLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/privacy_security_icon"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:layout_marginBottom="16.0dip" />
                <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/checkBoxLayout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:hwColumnType="content_type">
                    <ViewStub
                        android:id="@id/account_child_protect_desc"
                        android:layout="@layout/c_protocol_account_child_protect_description"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <ViewStub
                        android:id="@id/permission_description"
                        android:layout="@layout/c_protocol_permission_description"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <ViewStub
                        android:id="@id/privacy_description"
                        android:layout="@layout/c_protocol_privacy_description"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:id="@id/privacy_content"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.1"
                        android:fontFamily="@string/appgallery_text_font_family_regular" />
                </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/bottomLayout"
                android:background="@color/appgallery_color_sub_background"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/protocol_linearlayout"
                    android:paddingTop="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:hwColumnType="content_type" />
                <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/emui_dimens_default_bottom_fixed"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:baselineAligned="false"
                    app:hwColumnType="content_type">
                    <com.huawei.uikit.phone.hwbutton.widget.HwButton
                        android:gravity="center"
                        android:id="@id/privacy_negative_button"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/c_exit_cancel"
                        android:layout_weight="1.0"
                        android:textAllCaps="true"
                        app:hwAutoSizeMinTextSize="9.0sp"
                        app:hwAutoSizeStepGranularity="1.0sp"
                        style="@style/Widget.Emui.HwButton" />
                    <com.huawei.uikit.phone.hwbutton.widget.HwButton
                        android:gravity="center"
                        android:id="@id/privacy_positive_button"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/c_protocol_agree_btn"
                        android:layout_weight="1.0"
                        android:textAllCaps="true"
                        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                        app:hwAutoSizeMinTextSize="9.0sp"
                        app:hwAutoSizeStepGranularity="1.0sp"
                        style="@style/Widget.Emui.HwButton.Emphasize" />
                </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>