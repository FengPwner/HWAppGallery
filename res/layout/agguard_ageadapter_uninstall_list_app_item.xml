<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/item_layout"
    android:paddingTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/item_head_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/item_app_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            app:corner_type="appicon"
            app:round_type="all" />
        <com.huawei.uikit.hwcheckbox.widget.HwCheckBox
            android:id="@id/agguard_item_checkbox"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/Widget.Emui.HwCheckBox.Small" />
    </RelativeLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:id="@id/item_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:textDirection="locale"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textStyle="normal"
        android:id="@id/item_app_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
        android:textDirection="locale"
        style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textStyle="normal"
        android:id="@id/item_app_permission_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:id="@id/item_deal_btn"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            style="@style/AppGallery.Widget.Button.Small" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/item_uninstall_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agguard_safety_report_card_processed_uninstall"
            android:layout_centerVertical="true"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.SubTitle3.Regular" />
    </RelativeLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="8.0dip" />
    <View
        android:id="@id/item_layout_split_line"
        android:layout_width="fill_parent"
        android:layout_marginTop="4.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>