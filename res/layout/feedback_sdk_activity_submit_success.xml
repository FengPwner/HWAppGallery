<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rl_submit"
    android:background="@color/faq_emui_white_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/emui_dimens_max_start"
    android:paddingEnd="@dimen/emui_dimens_max_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="@dimen/emui_dimens_default_bottom_fixed"
        android:layout_above="@id/hw_column_ll">
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/feedback_sdk_common_64_dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/feedback_sdk_common_72_dp"
                android:layout_height="@dimen/feedback_sdk_common_72_dp"
                android:src="@drawable/ic_icon_bad" />
            <TextView
                android:textSize="@dimen/emui_text_size_body1"
                android:textColor="@color/emui_color_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_sdk_common_36_dp"
                android:text="@string/feedbacck_sdk_submit_success"
                android:fontFamily="@string/emui_text_font_family_medium" />
            <TextView
                android:textSize="@dimen/emui_text_size_body2"
                android:textColor="@color/emui_color_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_s"
                android:text="@string/feedback_sdk_dealwith"
                android:fontFamily="@string/emui_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/emui_text_size_body3"
                android:textColor="@color/emui_color_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feedback_sdk_common_24_dip"
                android:text="@string/feedback_sdk_number"
                android:fontFamily="@string/emui_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/emui_text_size_body3"
                android:textColor="@color/emui_color_primary"
                android:gravity="center"
                android:id="@id/tv_sr_number"
                android:background="@drawable/feedback_sr_number_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/emui_dimens_element_vertical_middle"
                android:minHeight="@dimen/feedback_sdk_common_28_dp"
                android:textIsSelectable="true"
                android:fontFamily="@string/emui_text_font_family_regular"
                android:paddingStart="10.0dip"
                android:paddingEnd="10.0dip" />
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
    </ScrollView>
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:gravity="center"
        android:id="@id/hw_column_ll"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/emui_dimens_default_bottom_fixed"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:hwColumnType="button_type">
        <Button
            android:id="@id/btn_submit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_sdk_submit"
            style="@style/Widget.Emui.HwButton" />
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
</RelativeLayout>