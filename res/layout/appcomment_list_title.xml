<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appcomment_common_spinner_height"
    style="@style/AppGallery.Widget.SubHeader.ViewGroup"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:layout_gravity="start|center"
        android:id="@id/hiappbase_subheader_title_left"
        android:tag="css/.title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="@string/appcomment_comment_user"
        android:singleLine="true"
        android:layout_weight="1.0"
        android:layout_marginEnd="@dimen/margin_m"
        style="@style/AppGallery.Widget.SubHeader.Title" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.appcomment.ui.view.SortSpinner
            android:id="@id/comment_filter_left"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/appcomment_8_dp"
            app:hwListShadowEnabled="true"
            style="@style/Widget.Emui.HwSpinner" />
        <com.huawei.appgallery.appcomment.ui.view.SortSpinner
            android:gravity="end"
            android:id="@id/comment_filter_right"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:hwListShadowEnabled="true"
            style="@style/Widget.Emui.HwSpinner" />
    </LinearLayout>
</LinearLayout>