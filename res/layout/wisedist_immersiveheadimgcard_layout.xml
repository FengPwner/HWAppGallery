<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_centerHorizontal="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@id/immersiveheadimgcard_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_centerHorizontal="true">
        <com.huawei.appmarket.framework.widget.RenderImageView
            android:id="@id/immersiveheadimgcard_big_imageview"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="8.0dip"
            android:textColor="@color/emui_color_white_origin"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/immersiveheadimgcard_lable_textview"
            android:background="@drawable/substancelistcard_chip_bg"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="24.0dip"
            android:minHeight="14.0dip"
            android:maxLines="1"
            android:maxEms="9"
            android:layout_above="@id/immersiveheadimgcard_bottom_layout"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip"
            android:layout_marginStart="@dimen/appgallery_max_padding_start" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/immersiveheadimgcard_bottom_layout"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_two_text_lines"
            android:layout_alignParentBottom="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <TextView
                android:ellipsize="end"
                android:id="@id/immersiveheadimgcard_title"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <TextView
                android:ellipsize="end"
                android:id="@id/immersiveheadimgcard_subtitle"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>