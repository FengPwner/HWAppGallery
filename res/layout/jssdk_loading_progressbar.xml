<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center"
    android:orientation="vertical"
    android:id="@id/loading_progressbar"
    android:paddingLeft="@dimen/jssdk_activity_horizontal_margin"
    android:paddingRight="@dimen/jssdk_activity_horizontal_margin"
    android:visibility="visible"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/jssdk_activity_horizontal_margin"
    android:paddingEnd="@dimen/jssdk_activity_horizontal_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8.0dip"
        android:layout_marginRight="8.0dip">
        <ProgressBar
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:progressBarStyleLarge" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@color/js_black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.0dip"
            android:text="@string/jssdk_loading"
            android:alpha="0.6" />
    </LinearLayout>
</RelativeLayout>