<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/forum_feed_post_bottom_head"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/forum_feed_post_bottom_section_icon"
                android:visibility="gone"
                android:layout_width="@dimen/emui_dimens_element_horizontal_large"
                android:layout_height="@dimen/emui_dimens_element_horizontal_large"
                android:layout_marginEnd="@dimen/margin_s" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/forum_feed_post_bottom_user_icon"
                android:visibility="gone"
                android:layout_width="@dimen/emui_dimens_element_horizontal_large"
                android:layout_height="@dimen/emui_dimens_element_horizontal_large"
                android:layout_marginEnd="@dimen/margin_s" />
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@id/forum_section_post_read_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lineSpacingMultiplier="1.2"
                    style="@style/AppGallery.TextAppearance.Card.TextBody4.Tertiary" />
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@id/forum_section_post_bottom_user_flag"
                    android:visibility="gone"
                    android:layout_width="@dimen/emui_dimens_element_horizontal_large"
                    android:layout_height="@dimen/emui_dimens_element_horizontal_large"
                    android:layout_marginStart="@dimen/margin_s" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        </LinearLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/forum_section_post_time_bottom"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody4.Tertiary" />
    </LinearLayout>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_below="@id/forum_feed_post_bottom_head"
        android:layout_alignParentStart="true"
        layout="@layout/forum_ageadapter_section_bottom_operation" />
</RelativeLayout>