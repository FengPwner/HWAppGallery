<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@id/center_dialog_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/center_icon"
                android:background="@drawable/appicon_logo_educenter"
                android:layout_width="64.0dip"
                android:layout_height="64.0dip"
                android:layout_centerHorizontal="true"
                android:importantForAccessibility="no" />
            <TextView
                android:gravity="center_horizontal"
                android:id="@id/delete_warn_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_below="@id/center_icon"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <TextView
                android:id="@id/delete_warn"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_below="@id/delete_warn_title"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary" />
        </RelativeLayout>
    </ScrollView>
</LinearLayout>