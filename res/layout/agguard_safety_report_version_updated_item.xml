<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/agguard_card_item_pressed_inset_bg"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/agguard_tab_view_icon_size">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:layout_gravity="center_vertical"
            android:id="@id/version_updated_item_icon"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/ui_8_dp"
            android:layout_marginBottom="@dimen/ui_8_dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="12.0dip"
            app:corner_type="appicon"
            app:round_type="all" />
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_8_dp"
                android:layout_marginBottom="@dimen/ui_8_dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/item_download_btn">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/version_updated_item_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textDirection="locale"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:id="@id/version_updated_item_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textDirection="locale"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:id="@id/version_updated_item_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textDirection="locale"
                        android:layout_marginStart="@dimen/margin_m"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
            </LinearLayout>
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/item_download_btn"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:layout_centerVertical="true"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="12.0dip"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@id/version_updated_item_divider"
        android:layout_width="fill_parent"
        android:layout_marginStart="80.0dip"
        android:layout_marginEnd="12.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>