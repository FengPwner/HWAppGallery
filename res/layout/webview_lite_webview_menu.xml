<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@id/webview_menu_browser"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="64.0dip"
                android:layout_height="64.0dip"
                android:src="@drawable/webview_lite_ic_dialog_open_in_browser"
                android:scaleType="fitCenter" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/webview_lite_webview_menu_browser"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@id/webview_menu_refreash"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="4.0dip">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="64.0dip"
                android:layout_height="64.0dip"
                android:src="@drawable/webview_lite_ic_dialog_refresh"
                android:scaleType="fitCenter" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/webview_lite_webview_menu_refresh"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@id/webview_menu_downloads"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:layout_marginStart="4.0dip">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="64.0dip"
                android:layout_height="64.0dip"
                android:src="@drawable/webview_lite_ic_dialog_download_manager"
                android:scaleType="fitCenter" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/webview_lite_webview_menu_downloads"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>