<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/root_item_container"
    android:paddingTop="12.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="72.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/appicon"
        android:layout_width="56.0dip"
        android:layout_height="56.0dip"
        android:src="@color/transparent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:ellipsize="end"
        android:id="@id/ItemTitle"
        android:tag="css/.title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_paragraph_margin_s"
        android:maxLines="1"
        android:textAlignment="viewStart"
        style="@style/AppGallery.TextAppearance.Card.TextBody1" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/label_rank_factor"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cs_2_dp">
        <TextView
            android:textSize="@dimen/emui_text_size_caption1"
            android:textColor="@color/upgrade_normal_card_label_text_color"
            android:ellipsize="end"
            android:id="@id/title_text_label"
            android:background="@drawable/title_text_label_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cs_2_dp"
            android:maxLines="1"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:paddingStart="@dimen/ui_4_dp"
            android:paddingEnd="@dimen/ui_4_dp" />
        <ImageView
            android:id="@id/title_iv_label"
            android:visibility="gone"
            android:layout_width="28.0sp"
            android:layout_height="16.0sp"
            android:layout_marginBottom="@dimen/cs_2_dp"
            android:src="@color/transparent"
            android:scaleType="fitCenter" />
        <TextView
            android:ellipsize="end"
            android:id="@id/title_text_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
    </LinearLayout>
    <TextView
        android:ellipsize="end"
        android:id="@id/desc"
        android:tag="css/.subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cs_2_dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
        android:id="@id/downbtn"
        android:tag="css/.download-button"
        android:layout_width="wrap_content"
        android:layout_height="28.0dip"
        android:layout_marginTop="@dimen/appgallery_text_paragraph_margin_s"
        android:layout_marginBottom="@dimen/ui_12_dp"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
    <View
        android:id="@id/devider_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/ll_desc"
        app:layout_constraintStart_toStartOf="@id/ll_desc"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>