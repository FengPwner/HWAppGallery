<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg"
    android:paddingBottom="@dimen/appgallery_elements_margin_vertical_l"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/search_shrink_apps_content"
        android:paddingTop="@dimen/appgallery_elements_margin_vertical_l"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="bottom"
            android:layout_gravity="start|bottom|center"
            android:id="@id/search_shrink_apps_title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
            android:maxLines="2"
            android:importantForAccessibility="yes"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
        <com.huawei.appgallery.search.ui.card.shrink.ShrinkLinearLayout
            android:orientation="horizontal"
            android:id="@id/search_shrink_apps_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/search_shrink_skus_content"
        android:paddingTop="@dimen/appgallery_elements_margin_vertical_l"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="bottom"
            android:layout_gravity="start|bottom|center"
            android:id="@id/search_shrink_skus_title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
            android:maxLines="2"
            android:importantForAccessibility="yes"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
        <com.huawei.appgallery.search.ui.card.shrink.ShrinkLinearLayout
            android:orientation="horizontal"
            android:id="@id/search_shrink_sku_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m" />
    </LinearLayout>
</LinearLayout>