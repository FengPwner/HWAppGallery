<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/fa_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <com.huawei.appgallery.aguikit.widget.screenshot.CutBlurGroundLayout
        android:orientation="vertical"
        android:id="@id/fragment_container"
        android:background="@color/id_fa_color_dialog_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/drop_down_arrow"
            android:visibility="gone"
            android:layout_width="@dimen/appgallery_list_height_three_text_lines"
            android:layout_height="@dimen/appgallery_bar_title_normal_text_size_24dp"
            android:src="@drawable/ic_drop_down_arrow"
            android:scaleType="center"
            android:contentDescription="@string/click_back" />
        <RelativeLayout
            android:id="@id/main_content_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <View
            android:id="@id/place_navigation"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip" />
    </com.huawei.appgallery.aguikit.widget.screenshot.CutBlurGroundLayout>
    <com.huawei.appgallery.distributionbase.ui.widget.CustomActionBar
        android:layout_gravity="top"
        android:id="@id/custombar"
        android:tag="css/.body"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />
</RelativeLayout>