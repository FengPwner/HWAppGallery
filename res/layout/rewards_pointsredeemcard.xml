<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/rewards_pointsredeemcard_layout"
    android:background="@drawable/points_exchang_card_bg"
    android:paddingBottom="@dimen/banner_pad_margin_8"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/banner_pad_margin_8"
    android:paddingEnd="@dimen/banner_pad_margin_8"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="@dimen/banner_commodity_margin_12"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body2_fixed"
            android:textColor="@color/emui_color_subbg_dark"
            android:ellipsize="end"
            android:layout_gravity="start|center"
            android:id="@id/rewards_name"
            android:tag="css/.title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1.0"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
        <ImageView
            android:id="@id/rewards_icon"
            android:layout_width="52.0dip"
            android:layout_height="52.0dip"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_marginStart="8.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body3_fixed"
            android:textColor="@color/welfare_center_text_color"
            android:ellipsize="end"
            android:id="@id/rewards_exchange_score"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1.0"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Primary" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body3_fixed"
            android:textColor="@color/welfare_center_exchange_card_text_color"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/rewards_exchange_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8.0dip"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
</LinearLayout>