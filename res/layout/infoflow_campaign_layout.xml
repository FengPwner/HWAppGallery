<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/infoflow_campaign_layout_0"
    android:background="@drawable/list_item_normal_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/icon"
        android:layout_width="@dimen/infoflow_4_3_icon_width"
        android:layout_height="@dimen/infoflow_4_3_icon_height"
        android:layout_marginTop="@dimen/emui_dimens_element_vertical_large"
        android:layout_marginBottom="@dimen/emui_dimens_element_vertical_large"
        android:scaleType="centerCrop"
        app:corner_radius="@dimen/appgallery_default_corner_radius_m"
        app:touch_drawable="@drawable/infoflow_round_img_border" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/emui_dimens_element_horizontal_large">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/title"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/emui_dimens_text_vertical">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:layout_gravity="center_vertical"
                android:id="@id/promotion_sign"
                android:tag="css/.title"
                android:background="@drawable/promotion_sign_bg_normal"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/promotion_sign_style" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/description"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/end_time"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
</LinearLayout>