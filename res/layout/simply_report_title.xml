<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/tabContainer"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_hwtoolbar_height">
        <RelativeLayout
            android:gravity="center"
            android:id="@id/back_icon"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:visibility="visible"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_centerVertical="true"
            android:contentDescription="@string/click_back"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="4.0dip"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@id/left_imageview"
                android:tag="css/.widget"
                android:background="@drawable/aguikit_ic_public_cancel"
                android:visibility="visible"
                android:layout_width="@dimen/search_icon_landscape_width"
                android:layout_height="@dimen/search_icon_landscape_width"
                android:layout_centerVertical="true" />
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@id/ok_layout_id"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_centerVertical="true"
            android:contentDescription="@string/exit_confirm"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/right_imageview"
                android:tag="css/.widget"
                android:layout_width="@dimen/ui_24_dp"
                android:layout_height="@dimen/ui_24_dp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:id="@id/title_textview"
            android:tag="css/.title"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s"
            android:layout_toStartOf="@id/ok_layout_id"
            android:layout_toEndOf="@id/back_icon"
            style="@style/AppGallery.Widget.Toolbar.Title" />
    </RelativeLayout>
</RelativeLayout>