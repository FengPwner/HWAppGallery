<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ll_search_history_container"
    android:paddingBottom="@dimen/appgallery_default_padding_bottom_fixed"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/subTitle"
        layout="@layout/hiappbase_layout_ageadapter_subheader_title_action" />
    <RelativeLayout
        android:id="@id/content_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_distance_title_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line"
        android:paddingStart="@dimen/search_history_word_padding">
        <com.huawei.uikit.hwrecyclerview.widget.HwRecyclerView
            android:id="@id/history_recycle_view"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true" />
        <ImageView
            android:id="@id/history_search_transition_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>