<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/wishlist_layout_loading"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/title"
        layout="@layout/loading_fragment" />
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/wishlist_linearlayout_no_wish"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/wishlist_button_wish_submit"
        android:layout_below="@id/title"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@id/wishlist_imageview_wish_icon"
            android:background="@drawable/wishbase_empty_wish_nor"
            style="@style/AppGallery.ImageSize.NoData" />
        <TextView
            android:id="@id/wishlist_textview_wishlist_nodata_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:text="@string/wishlist_string_no_wish_new"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.TextAppearance.NoData" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/wishlist_linearlayout_wish_info"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/wishlist_button_wish_submit"
        android:layout_below="@id/title">
        <ListView
            android:id="@id/wishlist_listview_wish_info"
            android:paddingTop="@dimen/margin_m"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:listSelector="@android:color/transparent"
            android:divider="@null"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end" />
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.BottomButton
        android:layout_gravity="center"
        android:id="@id/wishlist_button_wish_submit"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginBottom="@dimen/margin_l"
        android:text="@string/wishlist_wish_add_title"
        android:maxLines="1"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        bounceViews:hwAutoSizeMinTextSize="9.0sp"
        bounceViews:hwAutoSizeStepGranularity="1.0sp"
        style="@style/AppGallery.Widget.Button.BottomButton" />
</RelativeLayout>