<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ViewStub
        android:id="@id/title_layout"
        android:layout="@layout/search_layout_subheader_no_botton_title_more"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ViewStub
        android:id="@id/ageadapter_title_layout"
        android:layout="@layout/search_layout_ageadapter_subheader_no_botton_title_more"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/item_container"
        android:background="@drawable/aguikit_card_panel_bg"
        android:paddingTop="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
</LinearLayout>