<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12.0dip"
    android:paddingEnd="12.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/list_env_item_layout"
        android:paddingTop="8.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                android:textAlignment="viewStart"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/item_tip"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary.Medium" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/item_description"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:textDirection="locale"
                android:textAlignment="viewStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_name"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Secondary" />
            <ImageView
                android:id="@id/item_tip"
                android:background="@drawable/agguard_tip_icon"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:contentDescription="@string/agguard_one_click_control_more_info"
                android:layout_marginStart="8.0dip"
                app:layout_constraintBottom_toBottomOf="@id/item_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/item_name"
                app:layout_constraintTop_toTopOf="@id/item_name" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:id="@id/item_status_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:id="@id/item_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agguard_pure_enhanced_mode_item_open"
                style="@style/AppGallery.Widget.Button.Small" />
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:id="@id/item_button_deep_clean"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agguard_space_clean_item_deep_clean"
                style="@style/AppGallery.Widget.Button.Small" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/item_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agguard_protecting"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/item_senior_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agguard_senior_mode_opened"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@id/item_divider_line"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>