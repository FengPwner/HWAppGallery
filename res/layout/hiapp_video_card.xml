<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:id="@id/video_round_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:clip_background="true"
        app:stroke_width="0.0dip">
        <com.huawei.appgallery.videokit.api.WiseVideoView
            android:id="@id/video_player"
            android:tag="@string/properties_video_contentDescription"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            app:media_type="0"
            app:view_type="0" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
</RelativeLayout>