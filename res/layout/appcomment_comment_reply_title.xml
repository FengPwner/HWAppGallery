<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/comment_root_view"
    android:focusable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/sort_layout"
        android:paddingTop="@dimen/margin_l"
        android:paddingBottom="@dimen/margin_s"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:gravity="bottom"
            android:paddingBottom="@dimen/margin_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_toStartOf="@id/reply_spinner_id"
            android:layout_alignParentStart="true">
            <TextView
                android:ellipsize="end"
                android:id="@id/reply_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/AppGallery.Widget.SubHeader.Title" />
        </LinearLayout>
        <com.huawei.uikit.hwspinner.widget.HwSpinner
            android:gravity="bottom"
            android:id="@id/reply_spinner_id"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_alignParentEnd="true"
            app:hwListShadowEnabled="true"
            style="@style/Widget.Emui.HwSpinner" />
    </RelativeLayout>
</LinearLayout>