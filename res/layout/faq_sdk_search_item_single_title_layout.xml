<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/faq_sdk_list_item_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/faq_sdk_listitem_height"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.phoneservice.faq.base.widget.ListItemRelativeLayout
        android:id="@id/item_rl"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/faq_sdk_listitem_height"
        android:layout_marginStart="@dimen/emui_dimens_max_start"
        android:layout_marginEnd="@dimen/emui_dimens_max_end">
        <TextView
            android:textSize="15.0sp"
            android:textColor="@color/faq_sdk_list_item_title_text_color_normal"
            android:id="@id/tv_search_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/faq_sdk_ui_10_dip"
            android:layout_marginBottom="@dimen/faq_sdk_ui_10_dip"
            android:layout_centerVertical="true"
            android:textAlignment="viewStart" />
        <View
            android:id="@id/service_network_split_line"
            android:background="@drawable/faq_sdk_list_divider_color_drawable"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/faq_sdk_line_height"
            android:layout_alignParentBottom="true" />
    </com.huawei.phoneservice.faq.base.widget.ListItemRelativeLayout>
</RelativeLayout>