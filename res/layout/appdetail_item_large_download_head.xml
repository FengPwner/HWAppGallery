<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/detail_head_layout"
    android:paddingTop="12.0dip"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10.0dip"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/appdetail_head_view_app_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/appdetail_head_view_app_icon" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
        android:layout_weight="1.0">
        <TextView
            android:textSize="20.0sp"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
            android:maxLines="2"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textDirection="locale"
            android:textAlignment="viewStart" />
        <TextView
            android:ellipsize="end"
            android:id="@id/tv_download_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2.0dip"
            android:maxLines="1"
            style="@style/detail_head_label" />
        <TextView
            android:ellipsize="end"
            android:id="@id/tv_tariff_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2.0dip"
            android:maxLines="1"
            style="@style/detail_head_label" />
    </LinearLayout>
    <com.huawei.appgallery.detail.detailbase.api.DetailHeadDownLoadButton
        android:id="@id/btn_download"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
        android:minWidth="64.0dip"
        android:minHeight="28.0dip"
        android:layout_marginStart="8.0dip"
        app:hwAutoSizeMinTextSize="9.0sp"
        app:useCustomLayerDrawable="false"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
</LinearLayout>