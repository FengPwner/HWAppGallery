<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/welfare_relative_layout"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_elements_margin_m"
        android:paddingEnd="12.0dip">
        <ImageView
            android:id="@id/welfare_icon"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:src="@drawable/ic_detail_gift"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@id/welfare_title_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/welfare_title_layout" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/welfare_title_layout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginStart="8.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/welfare_icon"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:ellipsize="end"
                android:id="@id/welfare_gift_title"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/welfare_newcomer_logo_text"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/newcomer_logo"
                android:tag="css/.title"
                android:background="@drawable/newcomer_logo_text_bg"
                android:padding="1.0px"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welfare_newcomer_exclusive"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip"
                android:layout_marginStart="4.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/welfare_subtitle_layout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/welfare_title_layout"
            app:layout_constraintTop_toBottomOf="@id/welfare_title_layout">
            <TextView
                android:ellipsize="end"
                android:id="@id/welfare_subtitle"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/welfare_subtitle1"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
        <com.huawei.appmarket.service.gift.widget.GiftDownloadButton
            android:textColor="@color/appgallery_color_primary"
            android:id="@id/welfare_status_button"
            android:tag="css/.report-button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:maxWidth="90.0dip"
            android:minWidth="64.0dip"
            android:layout_marginEnd="12.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/welfare_subtitle_layout"
            app:layout_constraintTop_toBottomOf="@id/welfare_subtitle_layout"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@id/divide_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_below="@id/welfare_relative_layout"
        android:layout_marginStart="48.0dip"
        android:layout_marginEnd="8.0dip"
        android:layout_alignStart="@id/welfare_relative_layout"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>