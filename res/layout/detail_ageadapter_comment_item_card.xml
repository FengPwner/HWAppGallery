<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_round_rectangle_card_item_bg"
    android:paddingTop="@dimen/padding_l"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.appcomment.ui.view.HeadImageView
            android:id="@id/detail_comment_item_card_avatar"
            android:layout_width="@dimen/detail_comment_card_user_icon_width"
            android:layout_height="@dimen/detail_comment_card_user_icon_width"
            android:layout_alignTop="@id/detail_comment_item_card_nick_name_layout"
            android:layout_alignBottom="@id/detail_comment_item_card_nick_name_layout"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/hiappbase_user_avatar"
            android:layout_marginEnd="@dimen/margin_l"
            android:layout_alignParentStart="true" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_comment_item_card_nick_name_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@id/detail_comment_item_card_avatar">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/detail_comment_item_card_nick_name"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_marginEnd="@dimen/margin_m" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:layout_below="@id/detail_comment_item_card_nick_name_layout"
            android:layout_toEndOf="@id/detail_comment_item_card_avatar">
            <com.huawei.appgallery.foundation.ui.framework.widget.RenderRatingBar
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/detail_comment_item_card_stars_rating_bar"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="12.0dip"
                android:maxHeight="12.0dip"
                android:indeterminateOnly="false"
                android:indeterminateDrawable="@drawable/appcomment_ratingbar_list"
                android:progressDrawable="@drawable/appcomment_ratingbar_list"
                android:minHeight="12.0dip"
                android:thumb="@null"
                android:numStars="5"
                android:rating="0.0"
                android:isIndicator="true"
                android:importantForAccessibility="no" />
            <View
                android:id="@id/stars_rating_bar_conceal_view"
                android:background="@null"
                android:layout_width="@dimen/margin_l"
                android:layout_height="12.0dip" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/appgallery_text_color_secondary"
                android:gravity="center_vertical"
                android:id="@id/detail_comment_item_card_comment_time"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_text_color_primary"
        android:ellipsize="end"
        android:id="@id/detail_comment_item_card_comment_info"
        android:tag="css/.title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:maxLines="3"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:textAlignment="viewStart" />
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginBottom="@dimen/margin_l">
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/detail_comment_item_card_phone"
            android:tag="css/.subtitle"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginEnd="@dimen/appgallery_max_padding_start"
            android:layout_alignParentStart="true" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/detail_comment_item_card_add_approve_layout"
            android:tag="css/.report-button"
            android:background="@color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_l"
            android:layout_toStartOf="@id/detail_comment_item_card_add_reply_layout">
            <com.huawei.appgallery.appcomment.ui.view.ApproveImageView
                android:id="@id/detail_comment_item_card_approve_icon"
                android:tag="css/.widget"
                android:background="@drawable/aguikit_ic_public_thumbsup"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:scaleType="centerCrop" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/detail_comment_item_card_approve_counts"
                android:tag="css/.title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appcomment_master_good_label"
                android:maxLines="1"
                android:textAllCaps="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="@dimen/margin_s" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/detail_comment_item_card_add_reply_layout"
            android:tag="css/.report-button"
            android:background="@color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"
            android:layout_marginEnd="@dimen/margin_l"
            android:layout_toStartOf="@id/detail_comment_share_layout_linearlayout">
            <ImageView
                android:id="@id/detail_comment_item_card_reply_icon"
                android:tag="css/.widget"
                android:background="@drawable/aguikit_ic_public_comments"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:scaleType="centerCrop" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@id/detail_comment_item_card_reply_text"
                android:tag="css/.title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appcomment_reply_button"
                android:maxLines="1"
                android:textAllCaps="true"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="@dimen/margin_s" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/detail_comment_share_layout_linearlayout"
            android:tag="css/.report-button"
            android:background="@color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="24.0dip"
            android:layout_centerVertical="true"
            android:contentDescription="@string/share_app_title"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/detail_comment_share_icon_imageview"
                android:tag="css/.widget"
                android:background="@drawable/aguikit_ic_public_share"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:scaleType="centerCrop" />
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@id/divide_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>