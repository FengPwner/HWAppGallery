<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/horizonitemcontainer"
    android:layout_width="@dimen/wisedist_horizontal_sliding_item_width"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/appicon_layout"
        android:layout_width="@dimen/wisedist_card_icon_size_xl"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/wisedist_card_icon_size_xl"
            android:layout_height="@dimen/wisedist_card_icon_size_xl"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_type="appicon"
            app:round_type="all" />
        <ViewStub
            android:layout_gravity="end|bottom|center"
            android:id="@id/fastappicon"
            android:layout="@layout/wisedist_fastappicon_layout"
            android:layout_width="@dimen/wisedist_horizontal_sliding_fast_app_flag_size"
            android:layout_height="@dimen/wisedist_horizontal_sliding_fast_app_flag_size" />
    </FrameLayout>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/ItemTitle"
        android:tag="css/.title"
        android:layout_width="@dimen/wisedist_horizontal_sliding_item_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:maxLines="@integer/horizonhomecard_name_max_lines"
        android:layout_below="@id/appicon_layout"
        style="@style/AppGallery.TextAppearance.HorizontalCard.Item.Title" />
    <ViewStub
        android:id="@id/ItemTextViewStub"
        android:layout="@layout/wisedist_tag_render_textview"
        android:layout_width="@dimen/wisedist_horizontal_sliding_item_width"
        android:layout_height="wrap_content"
        android:layout_below="@id/ItemTitle" />
    <com.huawei.appgallery.pageframe.view.DownloadButtonV2
        android:id="@id/downbtn"
        android:tag="css/.download-button"
        android:layout_width="@dimen/wisedist_card_icon_size_xl"
        android:layout_height="28.0dip"
        android:layout_marginTop="@dimen/margin_m"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
</RelativeLayout>