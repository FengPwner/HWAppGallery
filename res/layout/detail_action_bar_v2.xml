<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/app_detail_action_bar"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/status_bar"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <RelativeLayout
        android:gravity="center"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_hwtoolbar_height">
        <RelativeLayout
            android:gravity="center"
            android:id="@id/rl_close"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:visibility="visible"
            android:layout_width="48.0dip"
            android:layout_height="@dimen/appgallery_hwtoolbar_height"
            android:layout_centerVertical="true"
            android:contentDescription="@string/click_back"
            android:layout_marginStart="@dimen/margin_s"
            android:layout_marginEnd="@dimen/margin_s"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@id/iv_close"
                android:layout_width="@dimen/search_icon_landscape_width"
                android:layout_height="@dimen/search_icon_landscape_width"
                android:layout_centerVertical="true"
                android:contentDescription="@string/click_back" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/rl_actionbar_end"
            android:layout_width="96.0dip"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/rl_share_and_search"
                android:layout_width="96.0dip"
                android:layout_height="48.0dip"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/margin_s">
                <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                    android:gravity="center"
                    android:id="@id/rl_share"
                    android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                    android:layout_width="@dimen/detail_toolbar_height"
                    android:layout_height="@dimen/detail_toolbar_height"
                    android:contentDescription="@string/share_app_title"
                    maskview:popupDrawable="@drawable/aguikit_ic_public_share"
                    maskview:popupTitle="@string/share_app_title">
                    <com.huawei.appgallery.detail.detailbase.common.widget.DetailShareButton
                        android:id="@id/btn_share"
                        android:background="@drawable/aguikit_ic_public_share"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:scaleType="center"
                        style="@style/detail_widget_tag" />
                </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
                <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                    android:gravity="center"
                    android:id="@id/rl_search"
                    android:background="@drawable/hwappbarpattern_selector_item_bg"
                    android:visibility="visible"
                    android:layout_width="@dimen/hwappbarpattern_icon_size"
                    android:layout_height="@dimen/hwappbarpattern_icon_size"
                    android:contentDescription="@string/component_detail_search_btn_click"
                    maskview:popupDrawable="@drawable/aguikit_ic_public_search"
                    maskview:popupTitle="@string/hiappbase_search_btn">
                    <ImageView
                        android:id="@id/iv_search"
                        android:layout_width="@dimen/search_icon_landscape_width"
                        android:layout_height="@dimen/search_icon_landscape_width" />
                </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@id/rl_download"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="64.0dip"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:alpha="0.0"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                android:layout_alignParentEnd="true">
                <com.huawei.appgallery.detail.detailbase.api.DetailHeadDownLoadButton
                    android:layout_gravity="end|center"
                    android:id="@id/btn_download"
                    android:visibility="visible"
                    android:layout_width="@dimen/component_detail_card_element_width_l"
                    android:layout_height="28.0dip"
                    android:minWidth="@dimen/component_detail_card_element_width_l"
                    maskview:hwAutoSizeMinTextSize="9.0sp"
                    maskview:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                    style="@style/Widget.Emui.HwProgressButton" />
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="start|center"
            android:id="@id/rl_icon_title"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:alpha="0.0"
            android:importantForAccessibility="yes"
            android:layout_toStartOf="@id/rl_actionbar_end"
            android:layout_toEndOf="@id/rl_close">
            <ImageView
                android:id="@id/iv_app_icon"
                android:layout_width="28.0dip"
                android:layout_height="28.0dip"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/margin_m" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/tv_title"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/component_detail_title_activity_app_detail"
                android:layout_centerVertical="true"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/margin_l"
                android:layout_toEndOf="@id/iv_app_icon"
                style="@style/AppGallery.Widget.Toolbar.Title" />
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>