<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:orientation="vertical"
    android:scrollbars="none"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <include
            android:id="@id/report_title"
            layout="@layout/appcomment_report_title_layout" />
        <LinearLayout
            android:orientation="vertical"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@id/detail_comment_user_info"
                android:paddingTop="@dimen/padding_m"
                android:paddingBottom="@dimen/padding_m"
                android:focusable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/appgallery_max_padding_start"
                android:paddingEnd="@dimen/appgallery_max_padding_end">
                <RelativeLayout
                    android:id="@id/comment_info_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/report_icon_imageview">
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5.0dip"
                        android:layout_below="@id/comment_nick_layout">
                        <com.huawei.appgallery.foundation.ui.framework.widget.RenderRatingBar
                            android:id="@id/report_stars_ratingbar"
                            android:tag="css/.title"
                            android:layout_width="wrap_content"
                            android:layout_height="12.0dip"
                            android:maxHeight="12.0dip"
                            android:indeterminateOnly="false"
                            android:indeterminateDrawable="@drawable/appcomment_ratingbar_list"
                            android:progressDrawable="@drawable/appcomment_ratingbar_list"
                            android:minHeight="12.0dip"
                            android:thumb="@null"
                            android:numStars="5"
                            android:rating="0.0"
                            android:isIndicator="true"
                            android:layout_centerVertical="true"
                            android:importantForAccessibility="no" />
                        <View
                            android:id="@id/report_stars_ratingbar_conceal_view"
                            android:background="@null"
                            android:layout_width="1.0dip"
                            android:layout_height="1.0dip" />
                    </RelativeLayout>
                    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                        android:orientation="horizontal"
                        android:id="@id/comment_nick_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5.0dip"
                        android:layout_marginBottom="@dimen/appgallery_text_margin_vertical">
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:ellipsize="end"
                            android:gravity="start"
                            android:id="@id/detail_comment_user_textview"
                            android:tag="css/.title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                        <com.huawei.appgallery.appcomment.widget.CommentLabelTextView
                            android:textSize="10.0dip"
                            android:textColor="@color/emui_accent"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@id/detail_comment_user_role_textview"
                            android:tag="css/.title"
                            android:background="@drawable/appcomment_comment_label_bg"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="14.0dip"
                            android:singleLine="true"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            android:paddingStart="8.0dip"
                            android:paddingEnd="8.0dip"
                            android:layout_marginStart="4.0dip" />
                    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
                </RelativeLayout>
                <com.huawei.appgallery.appcomment.ui.view.HeadImageView
                    android:id="@id/report_icon_imageview"
                    android:layout_width="@dimen/appgallery_card_icon_size_small"
                    android:layout_height="@dimen/appgallery_card_icon_size_small"
                    android:layout_marginTop="5.0dip"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                    android:layout_alignParentStart="true" />
                <FrameLayout
                    android:id="@id/detail_comment_content_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15.0dip"
                    android:layout_below="@id/comment_info_layout">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="@color/appgallery_text_color_primary_activated"
                        android:layout_gravity="end|bottom|center"
                        android:id="@id/open_or_fold_tv"
                        android:tag="css/.title"
                        android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/appcomment_user_open_content"
                        android:fontFamily="@string/appgallery_text_font_family_medium" />
                    <com.huawei.appgallery.appcomment.ui.view.FoldTextView
                        android:id="@id/detail_comment_content_textview"
                        android:tag="css/.title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/detail_comment_version_layout"
                        android:lineSpacingMultiplier="1.1"
                        android:textAlignment="viewStart"
                        style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Primary" />
                </FrameLayout>
            </RelativeLayout>
            <include
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                layout="@layout/hiappbase_layout_subheader_spliter" />
            <include
                android:id="@id/subTitle"
                layout="@layout/hiappbase_layout_subheader_list_title_action" />
            <com.huawei.appgallery.appcomment.ui.view.NoScrollListView
                android:id="@id/report_type_list"
                android:visibility="visible"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                style="@style/AppGallery.Widget.SubHeader.ViewGroup">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:layout_gravity="start|bottom|center"
                    android:id="@id/edittext_info_left"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/appcomment_operation_report_supplementary_instruction"
                    android:maxLines="2"
                    style="@style/AppGallery.Widget.SubHeader.ListTitle" />
            </LinearLayout>
        </LinearLayout>
        <com.huawei.uikit.hwedittext.widget.HwEditText
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:textColorHint="@color/appgallery_text_color_secondary"
            android:id="@id/explain_et"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:minHeight="50.0dip"
            android:hint="@string/appcomment_operation_report_say_more"
            android:maxLength="80"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
    </LinearLayout>
</ScrollView>