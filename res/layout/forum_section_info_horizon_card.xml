<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/forum_section_info_top_layout"
    android:layout_width="84.0dip"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:id="@id/follow_section_icon"
        android:layout_width="80.0dip"
        android:layout_height="80.0dip"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_centerHorizontal="true"
        android:importantForAccessibility="no"
        app:corner_type="appicon"
        app:round_type="all" />
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@id/forum_section_info_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/follow_section_icon"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="13.0sp"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/follow_section_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:text=""
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Primary.Regular" />
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:layout_below="@id/follow_section_name"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@id/posts_img"
                android:layout_width="12.0dip"
                android:layout_height="12.0dip"
                android:src="@drawable/forum_post_image"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/forum_post_desc"
                android:alpha="@dimen/appgallery_tertiary_content_alpha" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption_fixed"
                android:textColor="@color/appgallery_text_color_tertiary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/follow_posts_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:layout_alignTop="@id/posts_img"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_xs"
                android:layout_toEndOf="@id/posts_img" />
            <ImageView
                android:id="@id/follow_img"
                android:layout_width="12.0dip"
                android:layout_height="12.0dip"
                android:src="@drawable/forum_follower_image"
                android:layout_alignTop="@id/posts_img"
                android:layout_centerVertical="true"
                android:contentDescription="@string/forum_followers_desc"
                android:alpha="@dimen/appgallery_tertiary_content_alpha"
                android:layout_marginStart="@dimen/appgallery_text_paragraph_margin_xs"
                android:layout_toEndOf="@id/follow_posts_count" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption_fixed"
                android:textColor="@color/appgallery_text_color_tertiary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/follow_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:layout_alignTop="@id/follow_img"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_xs"
                android:layout_toEndOf="@id/follow_img" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>