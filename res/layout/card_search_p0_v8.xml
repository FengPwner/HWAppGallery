<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/appinfo_layout"
        android:paddingLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingTop="@dimen/appgallery_default_card_space_vertical_l"
        android:paddingRight="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
        android:minHeight="@dimen/appgallery_list_height_two_text_lines"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:src="@color/transparent"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
            android:id="@id/downbtn"
            android:tag="css/.download-button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="28.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Search.Widget.P0card.DownloadBtn" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@id/memo"
            app:layout_constraintEnd_toStartOf="@id/downbtn"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/appicon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="0.0dip">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/titleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/adFlag"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_caption_fixed"
                android:textColor="@color/emui_functional_blue"
                android:gravity="center"
                android:id="@id/adFlag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16.0dip"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:paddingStart="@dimen/padding_s"
                android:paddingEnd="@dimen/padding_s"
                android:layout_marginStart="@dimen/margin_m"
                app:layout_constraintBottom_toBottomOf="@id/titleName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/titleName"
                app:layout_constraintTop_toTopOf="@id/titleName"
                app:layout_goneMarginStart="0.0dip" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="start|center"
            android:id="@id/second_line_container"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/downbtn"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/title_layout"
            app:layout_goneMarginEnd="0.0dip"
            app:layout_goneMarginTop="0.0dip">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/second_ad_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ui_8_dp"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/memo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/downbtn"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/appicon"
                app:layout_constraintTop_toBottomOf="@id/title_layout"
                app:layout_goneMarginEnd="0.0dip"
                app:layout_goneMarginTop="0.0dip"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            <com.huawei.appmarket.service.appdetail.view.widget.DynamicLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/dynamic_second_container"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>