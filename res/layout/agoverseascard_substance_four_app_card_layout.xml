<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@id/agoverseascard_shadow_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:round_corner="@dimen/appgallery_default_corner_radius_l"
        app:stroke_width="0.0dip">
        <include
            android:id="@id/card_item_title_layout"
            layout="@layout/agoverseascard_substance_four_app_card_title" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/app_container"
            android:background="@color/appgallery_shadow_card_background_color"
            android:paddingTop="12.0dip"
            android:paddingBottom="12.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_item_title_layout"
            android:paddingStart="@dimen/agoverseas_substance_four_app_card_padding_horizontal"
            android:paddingEnd="@dimen/agoverseas_substance_four_app_card_padding_horizontal">
            <include
                android:id="@id/first_app_layout"
                layout="@layout/agoverseascard_substance_four_app_card_item_layout" />
            <View
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0" />
            <include
                android:id="@id/second_app_layout"
                layout="@layout/agoverseascard_substance_four_app_card_item_layout" />
            <View
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0" />
            <include
                android:id="@id/third_app_layout"
                layout="@layout/agoverseascard_substance_four_app_card_item_layout" />
            <View
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0" />
            <include
                android:id="@id/fourth_app_layout"
                layout="@layout/agoverseascard_substance_four_app_card_item_layout" />
        </LinearLayout>
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
</LinearLayout>