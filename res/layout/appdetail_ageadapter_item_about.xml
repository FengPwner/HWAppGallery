<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_desc_layout_linearlayout"
    android:paddingBottom="@dimen/margin_m"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/detail_card_click_range"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@id/subtitle"
            layout="@layout/detail_ageadapter_item_about_subheader" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_update_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
            android:baselineAligned="false"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/detail_traffic_textview"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_for_layout"
                android:maxLines="2"
                android:importantForAccessibility="yes"
                style="@style/detail_card_tariff_desc" />
            <TextView
                android:id="@id/detail_about_version_textview"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:importantForAccessibility="yes"
                style="@style/detail_card_tariff_desc" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ad_details"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appgallery_card_elements_margin_s"
            android:baselineAligned="false"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/tv_ad_cropname"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_for_layout"
                android:maxLines="1"
                android:importantForAccessibility="yes"
                style="@style/detail_card_tariff_desc" />
            <TextView
                android:ellipsize="end"
                android:id="@id/tv_ad_identifier"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:maxLines="1"
                android:importantForAccessibility="yes"
                style="@style/detail_card_tariff_desc" />
        </LinearLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="start|center"
            android:id="@id/detail_desc_content_textview"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_for_layout"
            android:maxLines="2"
            android:importantForAccessibility="yes"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/detail_card_introduce_content" />
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.MultiLineLabelLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/detail_label_layout_framelayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_12_dp"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
</LinearLayout>