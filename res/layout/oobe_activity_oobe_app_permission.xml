<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <include
        android:id="@id/oobe_permission_loadingPager"
        android:visibility="gone"
        layout="@layout/oobe_loading_fragment" />
    <RelativeLayout
        android:id="@id/oobe_no_permission_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/title">
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/oobe_no_permission_tips"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:text="@string/oobe_no_special_permissions_required"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@id/oobe_app_permission_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/title">
        <com.huawei.uikit.phone.hwrecyclerview.widget.HwRecyclerView
            android:id="@id/oobe_app_permission_icon_horizontal_recycler_view"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:drawSelectorOnTop="true"
            android:divider="@null"
            android:dividerHeight="0.0dip"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            app:hwCutoutMode="never" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/oobe_app_permission_tips"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:text="@string/oobe_permission_required"
            android:layout_below="@id/oobe_app_permission_icon_horizontal_recycler_view"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
        <ExpandableListView
            android:id="@id/oobe_app_permission_text_listview"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:groupIndicator="@null"
            android:childDivider="@color/appgallery_color_sub_background"
            android:divider="@color/appgallery_color_sub_background"
            android:layout_below="@id/oobe_app_permission_tips"
            android:layout_alignParentStart="true" />
    </RelativeLayout>
</RelativeLayout>