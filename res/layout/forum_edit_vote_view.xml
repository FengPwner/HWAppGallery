<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.forum.option.post.view.DeletableEditText
        android:textSize="32.0dip"
        android:layout_gravity="top"
        android:id="@id/front_span_edittext"
        android:background="@android:color/transparent"
        android:layout_width="2.0px"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:imeOptions="flagNoExtractUi|flagNoFullscreen" />
    <FrameLayout
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <com.huawei.appgallery.forum.option.post.view.PostVoteView
            android:id="@id/edit_voteView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:layout_marginBottom="8.0dip" />
        <View
            android:layout_gravity="start|center|top"
            android:id="@id/click_front_span"
            android:layout_width="30.0dip"
            android:layout_height="80.0dip"
            android:layout_marginTop="8.0dip" />
        <View
            android:layout_gravity="end|bottom|center"
            android:id="@id/click_back_span"
            android:layout_width="30.0dip"
            android:layout_height="80.0dip"
            android:layout_marginBottom="8.0dip" />
    </FrameLayout>
    <com.huawei.appgallery.forum.option.post.view.DeletableEditText
        android:textSize="32.0dip"
        android:layout_gravity="bottom"
        android:id="@id/span_edittext"
        android:background="@android:color/transparent"
        android:layout_width="2.0px"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4.0dip"
        android:minWidth="24.0dip"
        android:imeOptions="flagNoExtractUi|flagNoFullscreen" />
</LinearLayout>