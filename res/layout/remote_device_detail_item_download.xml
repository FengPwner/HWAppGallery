<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/detail_toolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.detail.detailbase.widget.DetailRelativeLayout
        android:orientation="horizontal"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/detail_toolbar_height">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/download_framelayout"
            android:layout_width="200.0dip"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.huawei.appgallery.remotedevice.api.download.RemoteDeviceDetailDownloadButton
                android:textSize="14.0dip"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/remote_detail_download_button"
                android:visibility="visible"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/appgallery_button_safety_margin"
                android:text="@string/card_install_btn"
                android:singleLine="true"
                android:layout_weight="1.0"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                wapbutton:downloadFixedWidth="true"
                wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                wapbutton:isDownloadButtonCancelableLocal="false"
                style="@style/Widget.Emui.HwProgressButton" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/detail_download_cancel_button_linearlayout"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/detail_toolbar_height"
            android:layout_centerVertical="true"
            android:contentDescription="@string/component_detail_comment_cancel"
            android:layout_marginStart="@dimen/margin_m"
            android:layout_marginEnd="@dimen/margin_l"
            android:layout_toStartOf="@id/download_framelayout"
            android:layout_alignParentStart="true">
            <ImageView
                android:gravity="center"
                android:id="@id/detail_download_cancel_imageview"
                android:background="@drawable/ic_details_cancel"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:scaleType="center"
                style="@style/detail_widget_tag" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/detail_download_comment_layout_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_toEndOf="@id/download_framelayout"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/detail_download_comment_button_linearlayout"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:layout_width="@dimen/detail_toolbar_height"
                android:layout_height="@dimen/detail_toolbar_height"
                android:contentDescription="@string/component_detail_appzone_comments">
                <ImageView
                    android:gravity="center"
                    android:id="@id/detail_comment_imageview"
                    android:background="@drawable/aguikit_ic_public_comments"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="center"
                    style="@style/detail_widget_tag" />
            </LinearLayout>
        </LinearLayout>
    </com.huawei.appgallery.detail.detailbase.widget.DetailRelativeLayout>
</LinearLayout>