<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/horizonitemcontainer"
    android:layout_width="@dimen/hiapp_horizontal_medium_icon_card_width"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/hiapp_horizontal_medium_icon_width"
        android:layout_height="@dimen/hiapp_horizontal_medium_icon_width"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"
        android:importantForAccessibility="noHideDescendants"
        app:corner_type="appicon"
        app:round_type="all" />
    <TextView
        android:textSize="@dimen/emui_master_body_2"
        android:ellipsize="end"
        android:gravity="center|top"
        android:id="@id/ItemTitle"
        android:tag="css/.title"
        android:layout_width="@dimen/hiapp_horizontal_medium_icon_card_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:lines="2"
        android:layout_below="@id/appicon"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Primary.Regular" />
    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
        android:id="@id/downbtn"
        android:tag="css/.download-button"
        android:layout_width="@dimen/hiapp_horizontal_medium_icon_width"
        android:layout_height="28.0dip"
        android:layout_marginTop="@dimen/margin_m"
        android:layout_below="@id/ItemTitle"
        android:layout_centerHorizontal="true"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
</RelativeLayout>