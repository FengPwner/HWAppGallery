<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="0.0dip"
    android:layout_height="wrap_content"
    android:layout_weight="1.0"
    android:importantForAccessibility="yes"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:layout_gravity="center"
        android:id="@id/imageView"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:corner_radius="@dimen/appgallery_default_corner_radius_l"
        app:layout_constraintDimensionRatio="H,15:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_type="all"
        app:touch_drawable="@drawable/hiappbase_line_image_selector_stoke_corner_radius_l" />
    <TextView
        android:id="@id/promotion_sign"
        android:background="@drawable/promotion_sign_bg_bannerv9"
        android:layout_marginBottom="@dimen/banner_commodity_margin_12"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/margin_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/promotion_sign_style_banner" />
</androidx.constraintlayout.widget.ConstraintLayout>