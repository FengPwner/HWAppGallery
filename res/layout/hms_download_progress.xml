<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="13.0sp"
        android:id="@id/hms_message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8.0dip"
        android:layout_marginEnd="8.0dip" />
    <TextView
        android:textSize="13.0sp"
        android:gravity="end"
        android:id="@id/hms_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/hms_message_text"
        android:layout_alignTop="@id/hms_message_text"
        android:layout_alignEnd="@id/progress_linear" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/progress_linear"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_below="@id/hms_message_text">
        <ProgressBar
            android:id="@id/download_info_progress"
            android:layout_width="fill_parent"
            android:layout_height="7.0dip"
            android:layout_weight="1.0"
            style="?android:progressBarStyleHorizontal" />
        <FrameLayout
            android:id="@id/cancel_btn"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_below="@id/hms_message_text"
            android:layout_alignParentRight="true"
            android:layout_marginStart="8.0dip">
            <ImageView
                android:layout_gravity="center"
                android:id="@id/hms_progress_pause"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip" />
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>