<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/faq_sdk_ui_48_dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/faq_sdk_ui_sp_15"
        android:textColor="@color/faq_sdk_list_item_title_text_color_normal"
        android:ellipsize="end"
        android:id="@id/evaluate_list_item_content"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="12.0dip"
        android:maxLines="2"
        android:layout_centerVertical="true"
        android:textAlignment="viewStart"
        android:layout_toStartOf="@id/evaluate_list_item_radio" />
    <RadioButton
        android:id="@id/evaluate_list_item_radio"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true" />
    <View
        android:id="@id/evaluate_list_item_line"
        android:background="@color/faq_sdk_list_divider_color"
        android:layout_width="fill_parent"
        android:layout_height="1.0px"
        android:layout_alignParentBottom="true" />
</RelativeLayout>