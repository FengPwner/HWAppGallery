<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/horizonitemcontainer"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:background="@color/appgallery_color_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:clip_background="true"
        app:round_corner="16.0dip"
        app:stroke_width="0.0dip">
        <ImageView
            android:id="@id/app_shown_img"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/user_comment_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:layout_below="@id/app_shown_img"
            android:layout_marginStart="12.0dip"
            android:layout_marginEnd="12.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/user_info_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.appgallery.appcomment.ui.view.HeadImageView
                    android:id="@id/comment_user_icon"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body3"
                    android:textColor="@color/appgallery_color_secondary"
                    android:ellipsize="end"
                    android:id="@id/comment_user_name"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="6.0dip"
                    android:layout_marginEnd="12.0dip" />
            </LinearLayout>
            <com.huawei.appgallery.foundation.ui.framework.widget.RenderRatingBar
                android:id="@id/comment_user_stars"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/appcomment_12_dp"
                android:layout_marginTop="8.0dip"
                android:maxHeight="12.0dip"
                android:indeterminateOnly="false"
                android:indeterminateDrawable="@drawable/appcomment_ratingbar_list"
                android:progressDrawable="@drawable/appcomment_ratingbar_list"
                android:minHeight="12.0dip"
                android:thumb="@null"
                android:numStars="5"
                android:rating="0.0"
                android:isIndicator="true"
                android:importantForAccessibility="noHideDescendants" />
            <View
                android:id="@id/comment_user_stars_conceal_view"
                android:background="@null"
                android:layout_width="1.0dip"
                android:layout_height="1.0dip" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:id="@id/comment_content_info"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:lines="5"
                android:lineSpacingMultiplier="1.1"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@id/comment_app_name_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_below="@id/user_comment_content"
            android:layout_marginStart="8.0dip"
            android:layout_marginEnd="8.0dip">
            <LinearLayout
                android:background="@drawable/appcomment_reivewwall_appname_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body3"
                    android:textColor="@color/appgallery_text_color_primary_activated"
                    android:ellipsize="end"
                    android:id="@id/comment_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:layout_marginBottom="4.0dip"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:layout_marginStart="4.0dip"
                    android:layout_marginEnd="4.0dip" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/emui_text_size_caption1"
            android:textColor="@color/appgallery_color_tertiary"
            android:id="@id/comment_liked_info"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_marginBottom="12.0dip"
            android:maxLines="1"
            android:layout_below="@id/comment_app_name_layout"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginStart="12.0dip"
            android:layout_marginEnd="12.0dip" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
</RelativeLayout>