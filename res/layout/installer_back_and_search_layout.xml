<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@id/back_search_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/install_dist_head_card_bg_min_height"
        app:hwColumnType="content_type">
        <LinearLayout
            android:gravity="center"
            android:id="@id/head_back_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_card_icon_size_middle"
            android:layout_height="@dimen/appgallery_card_icon_size_middle"
            android:contentDescription="@string/click_back">
            <ImageView
                android:layout_width="@dimen/appgallery_card_elements_margin_xl"
                android:layout_height="@dimen/appgallery_card_elements_margin_xl"
                android:src="@drawable/aguikit_ic_public_back" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/head_search_setting_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/appgallery_card_icon_size_middle"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:gravity="center"
                android:id="@id/head_search_layout"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:layout_width="@dimen/appgallery_card_icon_size_middle"
                android:layout_height="@dimen/appgallery_card_icon_size_middle"
                android:contentDescription="@string/hiappbase_search_btn">
                <ImageView
                    android:layout_width="@dimen/appgallery_card_elements_margin_xl"
                    android:layout_height="@dimen/appgallery_card_elements_margin_xl"
                    android:src="@drawable/aguikit_ic_public_search" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@id/head_setting_layout"
                android:background="@drawable/hwappbarpattern_selector_item_bg"
                android:layout_width="@dimen/appgallery_card_icon_size_middle"
                android:layout_height="@dimen/appgallery_card_icon_size_middle"
                android:contentDescription="@string/card_more_btn">
                <ImageView
                    android:layout_width="@dimen/appgallery_card_elements_margin_xl"
                    android:layout_height="@dimen/appgallery_card_elements_margin_xl"
                    android:src="@drawable/aguikit_ic_public_more" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>