<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/AppListItem"
    android:clipChildren="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:gravity="center"
        android:id="@id/banner_layout"
        android:clipChildren="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <com.huawei.appmarket.service.store.awk.widget.topbanner.DotsViewPager
            android:id="@id/dotsviewpager"
            android:clipChildren="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            app:hwViewPagerSupportLoop="true"
            app:screenAdaptationStyle="Fixed" />
        <com.huawei.appmarket.service.store.awk.widget.topbanner.BannerDotsPageIndicator
            android:id="@id/hwdotspageindicator"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:importantForAccessibility="no"
            app:hwIsShowAsDot="true"
            style="@style/Widget.Emui.HwDotsPageIndicator.Translucent" />
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/searchLayout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="34.0dip"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_marginEnd="@dimen/search_view_margin_right" />
</RelativeLayout>