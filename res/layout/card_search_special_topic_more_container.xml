<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/sub_title_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/AppGallery.TextAppearance.Card.TextBody1" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:layout_gravity="start"
            android:id="@id/sub_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:maxLines="2"
            style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/item_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <View
        android:id="@id/divide_line"
        android:layout_width="fill_parent"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>