<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/horizonitemcontainer"
    android:layout_width="@dimen/detail_component_card_icon_size_large"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:layout_width="@dimen/detail_component_card_icon_size_large"
        android:layout_height="@dimen/detail_component_card_icon_size_large"
        app:round_corner="@dimen/appgallery_default_corner_radius_s">
        <com.huawei.appgallery.detail.detailbase.card.detailorderprisecard.view.DetailOrderPriseImageView
            android:layout_gravity="center"
            android:id="@id/appicon"
            android:layout_width="@dimen/detail_component_card_icon_size_large"
            android:layout_height="@dimen/detail_component_card_icon_size_large"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/ItemTitle"
        android:layout_width="@dimen/detail_component_card_icon_size_large"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:text="@string/placeholder_for_layout"
        android:maxLines="2"
        android:textAlignment="center"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Primary.Regular" />
</LinearLayout>