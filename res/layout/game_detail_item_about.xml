<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginBottom="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ViewStub
        android:id="@id/subtitle"
        android:layout="@layout/hiappbase_layout_subheader_title_more"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ViewStub
        android:id="@id/ageadapter_subtitle"
        android:layout="@layout/detail_ageadapter_item_about_subheader"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/detail_about_gridlayout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:padding="@dimen/appgallery_card_elements_margin_l"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:numColumns="2"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
</LinearLayout>