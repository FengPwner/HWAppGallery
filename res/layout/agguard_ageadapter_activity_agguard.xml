<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/titlelayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_hwtoolbar_height"
        android:layout_alignParentTop="true"
        layout="@layout/agguard_title_with_setting_layout" />
    <include
        android:id="@id/no_agguard_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/titlelayout"
        layout="@layout/agguard_ageadapter_open_fragment" />
    <include
        android:id="@id/no_agguard_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/titlelayout"
        layout="@layout/agguard_unsupport_fragment" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/fragment_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/titlelayout" />
</RelativeLayout>