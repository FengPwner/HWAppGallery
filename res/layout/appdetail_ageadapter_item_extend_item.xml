<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_extend_layout"
    android:paddingBottom="@dimen/appgallery_card_elements_margin_l"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/detail_extend_image"
            android:layout_width="@dimen/component_detail_icon_width_xs"
            android:layout_height="@dimen/banner_bg_margin_16"
            android:src="@drawable/ic_details_score_select"
            android:layout_marginEnd="2.0dip" />
        <TextView
            android:textSize="@dimen/detail_ageadapter_data_card_text_size_caption"
            android:id="@id/detail_extend_value"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/detail_card_data_content" />
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/detail_extend_ranking"
            android:visibility="gone"
            android:layout_width="8.0dip"
            android:layout_height="@dimen/banner_bg_margin_16"
            android:src="@drawable/ic_detail_rise"
            android:layout_marginStart="2.0dip" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@id/detail_extend_ranking_num"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/detail_card_data_content_s" />
    </LinearLayout>
    <RelativeLayout
        android:gravity="start|center"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/appgallery_text_size_caption"
            android:gravity="center"
            android:id="@id/detail_extend_name"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/detail_card_data_content_s" />
        <ImageView
            android:id="@id/arrowlayout"
            android:background="@drawable/ic_public_arrow_right_900"
            android:visibility="gone"
            android:layout_width="8.0dip"
            android:layout_height="@dimen/banner_bg_margin_16"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/detail_extend_name" />
    </RelativeLayout>
</LinearLayout>