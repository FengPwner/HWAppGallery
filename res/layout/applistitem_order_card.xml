<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ll_order_app_item"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/rl_main"
        android:background="@drawable/list_item_all_selector"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:minHeight="@dimen/appgallery_card_height_three_text_lines"
        android:layout_weight="1.0">
        <ImageView
            android:id="@id/iv_app_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:src="@color/transparent"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
        <RelativeLayout
            android:id="@id/rl_right"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/iv_app_icon">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:gravity="center"
                android:id="@id/tv_rank_num"
                android:tag="css/.title"
                android:layout_width="29.0dip"
                android:layout_height="@dimen/ranking_medal_image_size"
                android:maxLines="1"
                app:hwAutoSizeMinTextSize="14.0dip"
                app:hwAutoSizeStepGranularity="1.0dip"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
            <RelativeLayout
                android:id="@id/rl_serial"
                android:visibility="gone"
                android:layout_width="29.0dip"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4.0dip">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/tv_serial_bg"
                    android:visibility="invisible"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:gravity="center"
                    android:id="@id/tv_serial"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerInParent="true"
                    app:hwAutoSizeMinTextSize="14.0dip"
                    app:hwAutoSizeStepGranularity="1.0dip"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Fixed.Primary.Regular" />
            </RelativeLayout>
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/btn_download"
                android:tag="css/.download-button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ll_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/wisedist_serial_number_layout_width"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                android:layout_toStartOf="@id/btn_download"
                android:layout_alignParentStart="true">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/tv_title"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ll_second_line"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/appgallery_card_elements_margin_xl"
                android:layout_below="@id/ll_title"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                android:layout_toStartOf="@id/btn_download"
                android:layout_alignStart="@id/ll_title" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ll_third_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_second_line"
                android:layout_alignStart="@id/ll_second_line">
                <RelativeLayout
                    android:id="@id/rl_up_or_down"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m">
                    <ImageView
                        android:id="@id/iv_up_or_down"
                        android:layout_width="@dimen/ui_9_dp"
                        android:layout_height="@dimen/ui_9_dp"
                        android:scaleType="fitCenter"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true" />
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:id="@id/tv_up_or_down"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_centerVertical="true"
                        android:textAlignment="viewStart"
                        android:layout_toEndOf="@id/iv_up_or_down"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </RelativeLayout>
                <TextView
                    android:ellipsize="end"
                    android:id="@id/tv_first_time"
                    android:tag="css/.subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                <TextView
                    android:ellipsize="end"
                    android:id="@id/tv_order_number"
                    android:tag="css/.subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                <TextView
                    android:ellipsize="end"
                    android:id="@id/tv_memo"
                    android:tag="css/.subtitle"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@id/divider_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_marginStart="@dimen/ui_80_dp"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>