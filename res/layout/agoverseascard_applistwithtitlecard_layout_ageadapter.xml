<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/AppListItem"
    android:background="@drawable/aguikit_round_rectangle_card_item_bg"
    android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="76.0dip"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:src="@color/transparent"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@id/view"
        android:background="@color/transparent"
        android:layout_width="@dimen/appgallery_elements_margin_horizontal_m"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="@id/appicon"
        app:layout_constraintStart_toEndOf="@id/appicon"
        app:layout_constraintTop_toTopOf="@id/appicon" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textColor="@color/appgallery_text_color_tertiary"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@id/original_price_textview"
        android:tag="css/.subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
        android:singleLine="true"
        app:layout_constraintStart_toEndOf="@id/downbtn"
        app:layout_constraintStart_toStartOf="@id/downbtn"
        app:layout_constraintTop_toBottomOf="@id/downbtn"
        style="@style/AppGallery.TextAppearance.TextCaption" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@id/ItemTitle"
        android:tag="css/.title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_alignParentStart="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appicon"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:id="@id/item_text_rl"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
        app:layout_constraintEnd_toEndOf="@id/ItemTitle"
        app:layout_constraintStart_toStartOf="@id/ItemTitle"
        app:layout_constraintTop_toBottomOf="@id/ItemTitle">
        <ImageView
            android:id="@id/markIcon"
            android:visibility="gone"
            android:layout_width="@dimen/appgallery_text_size_body3_fixed"
            android:layout_height="@dimen/appgallery_text_size_body3_fixed"
            android:adjustViewBounds="true"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/ItemText"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/Second_line_divider"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
        android:id="@id/nonadapt_imageview"
        android:visibility="gone"
        android:layout_width="18.0dip"
        android:layout_height="14.0dip"
        android:scaleType="fitCenter"
        android:paddingEnd="@dimen/appgallery_text_paragraph_margin_xs"
        app:layout_constraintStart_toStartOf="@id/item_text_rl"
        app:layout_constraintTop_toBottomOf="@id/item_text_rl" />
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:id="@id/item_text_r2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/item_text_rl"
        app:layout_constraintStart_toEndOf="@id/nonadapt_imageview"
        app:layout_constraintTop_toBottomOf="@id/item_text_rl">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/memo"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/third_line_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
        android:id="@id/downbtn"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:minHeight="28.0dip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_text_r2"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
</androidx.constraintlayout.widget.ConstraintLayout>