<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:background="@color/appgallery_color_sub_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/essentialapp_loadingPager"
        layout="@layout/essentialapp_loading_layout" />
    <include
        android:id="@id/essentialapp_data_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/button_layout"
        layout="@layout/essentialapp_gamecenter_data_layout" />
    <include
        android:id="@id/button_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        layout="@layout/essentialapp_gamecenter_button_layout" />
</RelativeLayout>