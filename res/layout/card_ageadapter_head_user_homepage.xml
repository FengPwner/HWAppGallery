<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:id="@id/user_head_card"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/user_head_content"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/user_head_card_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/img_personal_home_page"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@id/user_head_container"
            android:background="@drawable/user_head_container_layout_bg"
            android:paddingLeft="@dimen/margin_l"
            android:paddingTop="32.0dip"
            android:paddingRight="@dimen/margin_l"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/appgallery_max_padding_start"
            android:layout_marginTop="50.0dip"
            android:layout_marginRight="@dimen/appgallery_max_padding_start"
            android:layout_alignParentTop="true">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@id/nickname_user_head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@id/duty_user_head_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="@dimen/margin_l">
                    <ImageView
                        android:id="@id/ic_duty"
                        android:layout_width="@dimen/user_head_icon_width"
                        android:layout_height="@dimen/user_head_icon_width"
                        android:src="@drawable/forum_ic_moderator" />
                    <TextView
                        android:textSize="@dimen/res_textsize_10dp"
                        android:textColor="@color/emui_color_gray_7"
                        android:ellipsize="end"
                        android:id="@id/duty_user_head"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="Regular"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@id/level_user_head_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/ic_level"
                        android:layout_width="@dimen/user_head_icon_width"
                        android:layout_height="@dimen/user_head_icon_width"
                        android:src="@drawable/ic_grade_small_10"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:textSize="@dimen/res_textsize_10dp"
                        android:textColor="@color/emui_color_gray_7"
                        android:ellipsize="end"
                        android:id="@id/level_user_head"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="Regular"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/res_textsize_10dp"
                android:textColor="@color/emui_color_gray_7"
                android:ellipsize="end"
                android:id="@id/ip_user_head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:maxLines="1"
                android:fontFamily="Regular" />
            <LinearLayout
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_marginBottom="@dimen/margin_l">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/follow_user_head_container"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body1"
                        android:textStyle="bold"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:id="@id/follow_user_head"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/emui_master_body_1"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forum_user_follow_count"
                        android:maxLines="1"
                        android:fontFamily="Regular" />
                </LinearLayout>
                <View
                    android:background="@color/forum_user_head_divider"
                    android:layout_width="@dimen/user_head_divider_width"
                    android:layout_height="@dimen/user_head_divider_height" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/fans_user_head_container"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body1"
                        android:textStyle="bold"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:id="@id/fans_user_head"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/emui_master_body_1"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forum_user_fans_count"
                        android:maxLines="1"
                        android:fontFamily="Regular" />
                </LinearLayout>
                <View
                    android:background="@color/forum_user_head_divider"
                    android:layout_width="@dimen/user_head_divider_width"
                    android:layout_height="@dimen/user_head_divider_height" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/likes_user_head_container"
                    android:focusable="true"
                    android:clickable="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body1"
                        android:textStyle="bold"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:id="@id/likes_user_head"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/emui_master_body_1"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forum_user_like_count"
                        android:maxLines="1"
                        android:fontFamily="Regular" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="10.0">
                <com.huawei.uikit.phone.hwbutton.widget.HwButton
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/user_head_follow_btn"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_l"
                    android:minWidth="64.0dip"
                    android:text="@string/forum_operation_unfollow"
                    android:maxLines="1"
                    android:layout_weight="3.0"
                    android:layout_centerVertical="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
                    app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
                    style="@style/Widget.Emui.HwButton.Small" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="@dimen/appgallery_elements_margin_vertical_l"
            android:src="@drawable/img_personal_home_page_shadow"
            android:scaleType="fitXY"
            android:layout_below="@id/user_head_container"
            android:layout_alignLeft="@id/user_head_container"
            android:layout_alignRight="@id/user_head_container" />
        <ImageView
            android:id="@id/img_user_head_circle"
            android:background="@drawable/user_head_circle_bg"
            android:layout_width="@dimen/user_head_circle_width"
            android:layout_height="@dimen/user_head_circle_width"
            android:layout_marginTop="-32.0dip"
            android:src="@drawable/placeholder_base_account_header"
            android:layout_alignTop="@id/user_head_container"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>
</LinearLayout>