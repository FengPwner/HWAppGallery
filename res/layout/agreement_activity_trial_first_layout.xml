<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/title"
        layout="@layout/agreement_trial_title_emui" />
    <ScrollView
        android:id="@id/trial_scroll_view"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:fillViewport="true"
        android:layout_weight="1.0">
        <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:baselineAligned="false"
            android:layout_weight="1.0"
            app:hwColumnType="content_type">
            <TextView
                android:id="@id/agreement_trial_agree_first_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                android:lineSpacingMultiplier="1.1"
                style="@style/AppGallery.TextAppearance.trial.TextBody1" />
            <TextView
                android:id="@id/agreement_trial_agree_second_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                android:lineSpacingMultiplier="1.1"
                style="@style/AppGallery.TextAppearance.trial.TextBody1" />
            <TextView
                android:id="@id/agreement_trial_agree_third_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                android:lineSpacingMultiplier="1.1"
                style="@style/AppGallery.TextAppearance.trial.TextBody1" />
            <Space
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0" />
            <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                android:orientation="vertical"
                android:id="@id/bottomLayout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_l"
                app:hwColumnType="content_type">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/agreement_trial_first_protocol_linearlayout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/emui_dimens_element_vertical_large" />
                <com.huawei.uikit.phone.hwbutton.widget.HwButton
                    android:gravity="center"
                    android:id="@id/agreement_trial_agree_btn"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/emui_dimens_element_vertical_large"
                    android:text="@string/agreement_sign_type_normal_mode_btn"
                    android:textAllCaps="true"
                    app:hwAutoSizeMinTextSize="9.0sp"
                    app:hwAutoSizeStepGranularity="1.0sp"
                    style="@style/Widget.Emui.HwButton.Emphasize" />
                <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/emui_dimens_default_bottom_fixed"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <com.huawei.uikit.phone.hwbutton.widget.HwButton
                        android:gravity="center"
                        android:id="@id/agreement_trial_mode_btn"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/emui_dimens_element_vertical_large"
                        android:text="@string/agreement_sign_type_trial_mode_btn"
                        android:textAllCaps="true"
                        app:hwAutoSizeMinTextSize="9.0sp"
                        app:hwAutoSizeStepGranularity="1.0sp"
                        style="@style/Widget.Emui.HwButton" />
                    <com.huawei.uikit.phone.hwbutton.widget.HwButton
                        android:gravity="center"
                        android:id="@id/agreement_trial_exit_btn"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agreement_trial_exit_btn"
                        android:textAllCaps="true"
                        app:hwAutoSizeMinTextSize="9.0sp"
                        app:hwAutoSizeStepGranularity="1.0sp"
                        style="@style/Widget.Emui.HwButton" />
                </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
            </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
        </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
    </ScrollView>
</LinearLayout>