<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/content_layout_id"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/pageframev2_title_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <com.huawei.appgallery.aguikit.widget.scrollview.HeadNestedScrollView
        android:id="@id/pageframev2_nested_scroll_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true"
        android:layout_weight="1.0">
        <com.huawei.appgallery.aguikit.widget.scrollview.HeadNestedLinearLayout
            android:orientation="vertical"
            android:id="@id/hiappbase_nested_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <FrameLayout
                android:id="@id/pageframev2_transition_card_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
            <FrameLayout
                android:id="@id/pageframev2_container"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <FrameLayout
                    android:id="@id/pageframev2_data_layout_id"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
                <ViewStub
                    android:id="@id/nodata_viewstub"
                    android:layout="@layout/hiappbase_nodata_warn_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
                <FrameLayout
                    android:id="@id/pageframev2_loading_layout_id"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
            </FrameLayout>
        </com.huawei.appgallery.aguikit.widget.scrollview.HeadNestedLinearLayout>
    </com.huawei.appgallery.aguikit.widget.scrollview.HeadNestedScrollView>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@id/bottom_container"
        android:layout="@layout/bottom_container_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
</LinearLayout>