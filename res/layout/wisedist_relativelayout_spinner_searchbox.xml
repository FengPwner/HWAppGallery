<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appmarket.framework.titleframe.title.TitleSpinner
        android:id="@id/wisedist_title_spinner"
        android:layout_width="96.0dip"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
        android:layout_alignParentStart="true"
        style="@style/Widget.Emui.HwSpinner" />
    <com.huawei.appmarket.framework.widget.FixedSearchView
        android:id="@id/wisedist_title_searchbar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        android:layout_toEndOf="@id/wisedist_title_spinner"
        android:layout_alignParentEnd="true" />
</RelativeLayout>