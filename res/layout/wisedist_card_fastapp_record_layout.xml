<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/recently_applist_layout"
        layout="@layout/wisedist_card_fastapp_list_layout" />
    <include
        android:id="@id/favorite_applist_layout"
        layout="@layout/wisedist_card_fastapp_list_layout" />
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/hwbutton_selector_color_emphasize_emui"
        android:layout_gravity="center"
        android:id="@id/more_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_8_dp"
        android:layout_marginBottom="@dimen/ui_4_dp"
        android:minHeight="@dimen/hwbutton_default_height"
        android:text="@string/wisedist_fastapp_favorite_view_more"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:textAlignment="center"
        style="@style/Widget.Emui.HwButton.Borderless" />
</LinearLayout>