<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:paddingTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_list_height_two_text_lines"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/setTextContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?android:textColorPrimary"
                android:gravity="start|center"
                android:id="@android:id/title"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <com.huawei.uikit.phone.hwradiobutton.widget.HwRadioButton
                android:id="@id/radio_btn"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10.0dip"
                android:layout_alignParentEnd="true"
                style="@style/Widget.Emui.HwRadioButton" />
            <com.huawei.uikit.phone.hwswitch.widget.HwSwitch
                android:id="@id/switch_btn"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_marginEnd="@dimen/appgallery_button_safety_margin"
                android:layout_alignParentEnd="true"
                style="@style/Widget.Emui.HwSwitch" />
        </LinearLayout>
        <TextView
            android:textColor="?android:textColorSecondary"
            android:gravity="start|center"
            android:id="@android:id/summary"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
</RelativeLayout>