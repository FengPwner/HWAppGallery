<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:layout_gravity="center_horizontal"
        android:id="@id/third_comment_dialog_appicon"
        android:layout_width="@dimen/appgallery_card_icon_size_large"
        android:layout_height="@dimen/appgallery_card_icon_size_large"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:corner_type="appicon"
        app:round_type="all" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:gravity="center_horizontal"
        android:id="@id/third_comment_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        app:hwAutoSizeMinTextSize="@dimen/appgallery_text_size_body2"
        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary.Medium" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:gravity="center_horizontal"
        android:id="@id/third_comment_dialog_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        app:hwAutoSizeMinTextSize="@dimen/appgallery_text_size_body2"
        style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Secondary" />
    <RatingBar
        android:id="@id/third_comment_stars_ratingbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:layout_marginBottom="8.0dip"
        android:numStars="5"
        android:rating="0.0"
        android:stepSize="1.0"
        style="@style/appcomment_big_style_ratingbar" />
</LinearLayout>