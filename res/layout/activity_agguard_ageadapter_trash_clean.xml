<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/title"
        layout="@layout/agguard_common_title_layout" />
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/trash_clean_layout"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@id/scanning_result_score"
                layout="@layout/agguard_rate_progress_layout" />
            <RelativeLayout
                android:id="@id/trash_file_clear_layout"
                android:background="@drawable/aguikit_card_panel_bg"
                android:paddingTop="@dimen/agguard_ageadapter_card_padding_size"
                android:paddingBottom="@dimen/agguard_ageadapter_card_padding_size"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.Widget.List.TwoTextLines">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/clean_item_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/clean_item_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agguard_space_clean_item_clean_title"
                        android:textDirection="locale"
                        android:textAlignment="viewStart"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary.Medium" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/clean_item_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:textDirection="locale"
                        android:textAlignment="viewStart"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/clean_item_name"
                        style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <RelativeLayout
                    android:id="@id/item_button_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_8_dp"
                    android:layout_below="@id/clean_item_layout">
                    <com.huawei.uikit.phone.hwbutton.widget.HwButton
                        android:id="@id/clean_item_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agguard_space_clean_item_simple_clean"
                        style="@style/AppGallery.Widget.Button.Small" />
                </RelativeLayout>
            </RelativeLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/deep_clean_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_ageadapter_popup_text_margin_top"
                android:text="@string/agguard_space_clean_item_deep_clean"
                android:textDirection="locale"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody2.Secondary.Medium" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/deep_clean_layout"
                android:background="@drawable/aguikit_card_panel_bg"
                android:paddingTop="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_safety_margin_m"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end">
                <RelativeLayout
                    android:id="@id/uninstall_item"
                    android:paddingTop="@dimen/appgallery_list_padding_vertical_ageadapter_huge_level3"
                    android:paddingBottom="@dimen/appgallery_list_padding_vertical_ageadapter_huge_level3"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/appgallery_default_padding_start"
                    android:paddingEnd="@dimen/appgallery_default_padding_end"
                    style="@style/AppGallery.Widget.List.SingleTextLine">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/uninstall_item_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agguard_deep_clean_item_uninstall_title"
                        android:textDirection="locale"
                        android:textAlignment="viewStart"
                        style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary.Medium" />
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_8_dp"
                        android:layout_below="@id/uninstall_item_name">
                        <com.huawei.uikit.phone.hwbutton.widget.HwButton
                            android:id="@id/uninstall_item_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/agguard_deep_clean_item_uninstall"
                            style="@style/AppGallery.Widget.Button.Small" />
                    </RelativeLayout>
                </RelativeLayout>
                <View
                    android:id="@id/item_divider_line"
                    android:layout_width="fill_parent"
                    android:layout_marginTop="1.0dip"
                    android:layout_marginBottom="1.0dip"
                    android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    style="@style/AppGallery.Widget.Divider" />
                <RelativeLayout
                    android:id="@id/app_data_item"
                    android:paddingTop="@dimen/appgallery_list_padding_vertical_ageadapter_huge_level3"
                    android:paddingBottom="@dimen/appgallery_list_padding_vertical_ageadapter_huge_level3"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/appgallery_default_padding_start"
                    android:paddingEnd="@dimen/appgallery_default_padding_end"
                    style="@style/AppGallery.Widget.List.SingleTextLine">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/app_data_item_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agguard_deep_clean_item_app_data_title"
                        android:textDirection="locale"
                        android:textAlignment="viewStart"
                        style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary.Medium" />
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_8_dp"
                        android:layout_below="@id/app_data_item_name">
                        <com.huawei.uikit.phone.hwbutton.widget.HwButton
                            android:id="@id/app_data_item_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/agguard_deep_clean_item_app_data_clean"
                            style="@style/AppGallery.Widget.Button.Small" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:layout_width="fill_parent"
                android:layout_height="@dimen/appgallery_card_elements_margin_l" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>