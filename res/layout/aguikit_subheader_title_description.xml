<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@id/aguikit_subheader_layout_background"
    android:paddingBottom="@dimen/appgallery_subheader_padding_bottom"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_subheader_item_double_min_height"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/emui_text_size_subtitle2"
        android:textColor="@color/emui_color_text_primary"
        android:ellipsize="end"
        android:id="@id/aguikit_subheader_title_left"
        android:tag="css/.title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@string/emui_text_font_family_medium"
        android:textAlignment="viewStart" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/emui_text_size_body2"
        android:textColor="@color/emui_color_text_secondary"
        android:ellipsize="end"
        android:id="@id/aguikit_subheader_title_description"
        android:tag="css/.subtitle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@string/emui_text_font_family_medium"
        android:textAlignment="viewStart" />
</LinearLayout>