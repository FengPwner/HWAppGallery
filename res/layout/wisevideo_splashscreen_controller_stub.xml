<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:layout_gravity="start|center|top"
    android:id="@id/video_play_layout"
    android:background="@drawable/splashscreen_btn_bg"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="@dimen/videokit_splash_screen_controller_width"
    android:layout_height="@dimen/videokit_splash_screen_controller_image_size"
    android:layout_marginTop="@dimen/videokit_splash_screen_controller_layout_margintop"
    android:layout_marginStart="@dimen/videokit_splash_screen_controller_layout_marginstart"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/splashscreen_video_mute"
        android:layout_width="@dimen/videokit_splash_screen_controller_image_size"
        android:layout_height="@dimen/videokit_splash_screen_controller_image_size"
        android:src="@drawable/videokit_ic_volume_down" />
</LinearLayout>