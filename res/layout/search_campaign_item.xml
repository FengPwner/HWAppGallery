<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/compaign_item_layout"
    android:background="@drawable/aguikit_round_rectangle_card_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/item_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
            android:id="@id/icon"
            android:layout_width="96.0dip"
            android:layout_height="72.0dip"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/right_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toEndOf="@id/icon">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/item_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:maxLines="1"
                android:layout_below="@id/item_title"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_below="@id/item_desc"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </RelativeLayout>
    </RelativeLayout>
    <ImageView
        android:id="@id/item_divider_line"
        android:layout_width="fill_parent"
        android:layout_below="@id/item_layout"
        android:layout_alignStart="@id/right_content"
        style="@style/AppGallery.Widget.Divider" />
    <View
        android:id="@id/bottom_blank_view"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_below="@id/item_layout" />
</RelativeLayout>