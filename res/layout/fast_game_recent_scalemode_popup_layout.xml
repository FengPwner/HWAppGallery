<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout
        android:id="@id/pop_view_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ui_4_dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        app:shadowColor="@color/appgallery_shadow_layout_default_color"
        app:shadowCornerRadius="@dimen/ui_16_dp">
        <com.huawei.uikit.hwadvancedcardview.widget.HwAdvancedCardView
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:layout_marginStart="@dimen/ui_4_dp"
            android:layout_marginEnd="@dimen/ui_4_dp"
            android:elevation="@dimen/ui_16_dp"
            app:cardBackgroundColor="@color/global_card_bg"
            app:cardCornerRadius="@dimen/ui_16_dp"
            app:hwAdvancedCardViewClickAnimationEnable="false">
            <RelativeLayout
                android:background="@drawable/fast_game_recent_pop_bg"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@id/relativelayout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/iv_Game"
                        android:layout_width="@dimen/ui_40_dp"
                        android:layout_height="@dimen/ui_40_dp"
                        android:layout_marginTop="@dimen/ui_12_dp"
                        android:layout_marginBottom="@dimen/ui_12_dp"
                        android:src="@drawable/fastgame"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/ui_12_dp" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@id/lin_content"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_12_dp"
                        android:layout_marginStart="@dimen/ui_16_dp"
                        android:layout_toEndOf="@id/iv_Game">
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:ellipsize="end"
                            android:id="@id/tv_Content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wisedist_fastgame_add_games"
                            android:maxLines="2"
                            android:layout_centerVertical="true"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            android:layout_marginEnd="@dimen/ui_16_dp" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body3"
                            android:textColor="@color/appgallery_text_color_tertiary"
                            android:ellipsize="end"
                            android:id="@id/tv_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ui_2_dp"
                            android:text="@string/wisedist_fastgame_game_pop_text"
                            android:maxLines="2"
                            android:layout_centerVertical="true"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            android:layout_marginEnd="@dimen/ui_16_dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@id/iv_Close"
                        android:padding="@dimen/ui_4_dp"
                        android:layout_width="@dimen/ui_20_dp"
                        android:layout_height="@dimen/ui_20_dp"
                        android:layout_marginTop="@dimen/ui_2_dp"
                        android:src="@drawable/ic_popupwindow_close"
                        android:layout_marginEnd="@dimen/ui_2_dp"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <com.huawei.uikit.phone.hwbutton.widget.HwButton
                    android:textSize="@dimen/appgallery_text_size_body2"
                    android:textColor="@color/appgallery_text_color_primary_activated"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/fast_Game_Add"
                    android:background="@drawable/popupwindow_add_btn_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_8_dp"
                    android:layout_marginBottom="@dimen/ui_12_dp"
                    android:minHeight="@dimen/ui_28_dp"
                    android:text="@string/wisedist_fastgame_add_game_to_luancher"
                    android:maxLines="1"
                    android:layout_below="@id/relativelayout"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:paddingStart="@dimen/ui_8_dp"
                    android:paddingEnd="@dimen/ui_8_dp"
                    android:layout_marginStart="@dimen/ui_60_dp"
                    android:layout_marginEnd="@dimen/ui_12_dp"
                    app:hwAutoSizeMinTextSize="9.0sp"
                    app:hwAutoSizeStepGranularity="1.0sp" />
            </RelativeLayout>
        </com.huawei.uikit.hwadvancedcardview.widget.HwAdvancedCardView>
    </com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout>
</LinearLayout>