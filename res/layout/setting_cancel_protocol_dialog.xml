<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:id="@id/tv_stop"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Emui.HwButton.Borderless" />
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:id="@id/tv_stop_clean"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
        style="@style/Widget.Emui.HwButton.Borderless" />
    <com.huawei.uikit.phone.hwbutton.widget.HwButton
        android:id="@id/cancel"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
        android:layout_marginBottom="@dimen/appgallery_safety_margin_m"
        style="@style/Widget.Emui.HwButton.Borderless" />
</LinearLayout>