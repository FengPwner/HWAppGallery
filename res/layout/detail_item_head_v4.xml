<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_head_layout_linearlayout"
    android:paddingTop="@dimen/emui_dimens_default_top"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/detail_head_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="0.0dip">
        <RelativeLayout
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l">
            <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                android:id="@id/detail_head_app_icon_imageview"
                android:focusable="false"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:src="@drawable/icon_default_bg"
                android:scaleType="fitCenter"
                maskview:corner_type="appicon"
                maskview:round_type="all" />
            <ImageView
                android:id="@id/detail_head_fast_app_icon_imageview"
                android:layout_width="@dimen/component_detail_fasticon_size"
                android:layout_height="@dimen/component_detail_fasticon_size"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                android:layout_alignBottom="@id/detail_head_app_icon_imageview"
                android:layout_alignEnd="@id/detail_head_app_icon_imageview" />
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/detail_reserve_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@id/detail_reserve_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                style="@style/AppGallery.TextAppearance.Card.SubTitle1" />
            <TextView
                android:id="@id/detail_reserve_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            <TextView
                android:id="@id/detail_reserve_briefdesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/hiappbase_refresh_header_text_margin">
                <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                    android:id="@id/detail_download_btn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cs_14_dp"
                    android:minWidth="@dimen/component_detail_card_element_width_l"
                    android:minHeight="@dimen/detail_mini_download_button_hight"
                    android:layout_alignParentEnd="true"
                    maskview:hwAutoSizeMinTextSize="9.0sp"
                    style="@style/Widget.Emui.HwProgressButton.Normal" />
                <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/detail_app_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="@dimen/ui_24_dp"
                    android:layout_toStartOf="@id/detail_download_btn"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/detail_head_app_name_textview"
                        android:tag="css/.title"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        style="@style/AppGallery.TextAppearance.Card.SubTitle2" />
                    <ImageView
                        android:id="@id/appQualityImage"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="14.0dip"
                        android:layout_marginStart="@dimen/margin_s" />
                </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/detail_head_developer_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:layout_below="@id/detail_app_name"
                    android:layout_toStartOf="@id/detail_download_btn">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:ellipsize="end"
                        android:id="@id/detail_head_developer"
                        android:tag="css/.subtitle"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/detail_head_grade_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detail_head_developer_layout"
                    android:layout_toStartOf="@id/detail_download_btn">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_caption"
                        android:id="@id/detail_head_others"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TextView"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_head_label_layout_linearlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                <com.huawei.appgallery.foundation.ui.framework.widget.MultiLineLabelLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/detail_head_label_icon_layout_linearlayout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/detail_vanattend_head_layout"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.appgallery.detail.detailbase.common.DetailFollowSectionButton
                    android:ellipsize="end"
                    android:id="@id/detail_vanattend_follow_btn"
                    android:tag="css/.download-button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/component_detail_card_element_width_l"
                    android:text="@string/component_detail_operation_unfollow"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    android:layout_alignParentEnd="true"
                    maskview:hwAutoSizeMinTextSize="9.0sp"
                    maskview:hwAutoSizeStepGranularity="1.0sp"
                    style="@style/Widget.Emui.HwButton.Small" />
                <TextView
                    android:gravity="center_vertical"
                    android:id="@id/detail_vanattend_head_name"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_alignParentTop="true"
                    android:layout_toStartOf="@id/detail_vanattend_follow_btn"
                    android:layout_alignParentStart="true"
                    style="@style/AppGallery.TextAppearance.Card.SubTitle1" />
                <TextView
                    android:id="@id/detail_vanattend_head_tag"
                    android:tag="css/.subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:maxLines="1"
                    android:layout_below="@id/detail_vanattend_head_name"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                <TextView
                    android:id="@id/detail_vanattend_head_time"
                    android:tag="css/.subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_below="@id/detail_vanattend_head_tag"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody4.Secondary" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/detail_head_safe_icon_layout_linearlayout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_head_safe_icon_container_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end" />
    </LinearLayout>
    <RelativeLayout
        android:id="@id/no_adapt_container"
        android:tag="css/.blank"
        android:background="@color/appdetail_label_default_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:minHeight="@dimen/appgallery_list_height_single_text_line_with_icon"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
            android:id="@id/no_adapt_icon"
            android:tag="css/.title"
            android:layout_width="@dimen/ui_24_dp"
            android:layout_height="@dimen/ui_24_dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/setting_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_settings"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
            <ImageView
                android:tag="css/.arrow"
                android:background="@drawable/ic_public_arrow_right_900"
                android:layout_width="12.0dip"
                android:layout_height="24.0dip"
                android:alpha="0.2"
                android:layout_marginStart="@dimen/padding_s" />
        </LinearLayout>
        <TextView
            android:id="@id/no_adapt_title"
            android:tag="css/.title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toStartOf="@id/setting_layout"
            android:layout_toEndOf="@id/no_adapt_icon"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/detail_head_vanattend_info_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_head_vanattend_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end" />
        <View
            android:id="@id/detail_vanattend_head_info_divider"
            android:tag="css/.title"
            android:background="@color/appgallery_card_color_default_background"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
    </LinearLayout>
    <View
        android:id="@id/normal_divider"
        android:background="@color/transparent"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_subheader_spliter_height" />
</LinearLayout>