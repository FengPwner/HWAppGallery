<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="368.0dip">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/post_banner_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/post_video_banner"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />
            <ImageView
                android:id="@id/post_video_sign"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:layout_marginBottom="8.0dip"
                android:src="@drawable/forum_post_video"
                android:layout_marginStart="20.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_caption"
                android:textColor="@color/white"
                android:id="@id/post_video_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_marginStart="8.0dip"
                app:layout_constraintBottom_toBottomOf="@id/post_video_sign"
                app:layout_constraintStart_toEndOf="@id/post_video_sign"
                app:layout_constraintTop_toTopOf="@id/post_video_sign" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/appgallery_text_size_body1"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/post_title"
            android:paddingTop="20.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-8.0dip"
            android:maxLines="2"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textAlignment="viewStart"
            android:paddingStart="24.0dip"
            android:paddingEnd="24.0dip" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/post_user_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:paddingStart="24.0dip"
            android:paddingEnd="24.0dip">
            <com.huawei.appgallery.forum.cards.widget.UserHeadImageView
                android:id="@id/post_user_icon"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:contentDescription="@string/hiappbase_user_avatar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.huawei.appgallery.forum.cards.widget.ShareUserInfoTextView
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/share_user_info"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginStart="8.0dip"
                app:layout_constraintBottom_toTopOf="@id/layout_forum_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/post_user_icon"
                app:layout_constraintTop_toTopOf="parent" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/layout_forum_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:layout_marginStart="8.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/post_user_icon"
                app:layout_constraintTop_toBottomOf="@id/share_user_info">
                <TextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:id="@id/post_section_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textAlignment="viewStart" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_caption"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:id="@id/post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="16.0dip" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/post_content_container"
            android:paddingTop="12.0dip"
            android:paddingBottom="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24.0dip"
            android:paddingEnd="24.0dip" />
    </LinearLayout>
</LinearLayout>