<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        layout="@layout/hiappbase_layout_subheader_title_more" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/content_layout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:paddingTop="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <RelativeLayout
            android:background="@drawable/aguikit_round_rectangle_card_item_bg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip">
            <com.huawei.appmarket.framework.widget.RoundCornerLayout
                android:id="@id/icon_layout"
                android:layout_width="120.0dip"
                android:layout_height="67.0dip"
                android:layout_marginTop="12.0dip"
                android:layout_marginBottom="12.0dip"
                app:round_corner="@dimen/appgallery_default_corner_radius_m">
                <ImageView
                    android:id="@id/image"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true" />
            </com.huawei.appmarket.framework.widget.RoundCornerLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/right_content"
                android:layout_width="fill_parent"
                android:layout_height="67.0dip"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toEndOf="@id/icon_layout">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/description_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <com.huawei.appgallery.search.ui.view.TagTextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/emui_dimens_element_vertical_middle"
                    android:maxLines="2"
                    android:textDirection="locale"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>