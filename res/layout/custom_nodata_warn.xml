<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:gravity="center"
    android:id="@id/no_data_layout"
    android:tag="css/.body"
    android:visibility="visible"
    android:scrollbars="none"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:id="@id/warn_image"
            android:tag="css/.widget"
            android:src="@drawable/no_search_result"
            style="@style/AppGallery.ImageSize.NoData" />
        <TextView
            android:gravity="center"
            android:id="@id/warn_text_one"
            android:tag="css/.subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.TextAppearance.NoData" />
        <TextView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@id/warn_text_two"
            android:tag="css/.subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            style="@style/AppGallery.TextAppearance.NoData" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end">
            <TextView
                android:id="@id/title_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.NoData" />
            <TextView
                android:id="@id/content_desc_one"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.NoData" />
            <TextView
                android:id="@id/content_desc_two"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.NoData" />
            <TextView
                android:id="@id/content_desc_three"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.NoData" />
        </LinearLayout>
        <com.huawei.appmarket.framework.widget.RenderButton
            android:textSize="@dimen/res_textsize_21dp"
            android:textColor="@color/hwbutton_selector_text_normal_emui"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@id/warn_btn"
            android:tag="css/.title"
            android:background="@drawable/hwbutton_default_emui"
            android:visibility="gone"
            android:layout_width="196.0dip"
            android:layout_height="48.0dip"
            android:layout_marginTop="52.0dip"
            style="@style/Widget.Emui.HwButton" />
    </LinearLayout>
</ScrollView>