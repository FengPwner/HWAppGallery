<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8.0dip"
    android:layout_marginStart="16.0dip"
    android:layout_marginEnd="16.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.agguard.business.ui.view.DrawableTextView
            android:textSize="@dimen/appgallery_text_size_subtitle2"
            android:textColor="@color/appgallery_text_color_primary"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/agguard_safety_report_overview"
            android:includeFontPadding="false"
            android:drawablePadding="8.0dip"
            android:drawableStart="@drawable/agguard_safety_report_overview"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textDirection="locale"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip"
            style="@style/AppGallery.Widget.SubHeader.ViewGroup" />
        <View
            android:id="@id/divider"
            android:layout_width="fill_parent"
            android:layout_marginStart="12.0dip"
            android:layout_marginEnd="12.0dip"
            style="@style/AppGallery.Widget.Divider" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip">
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                layout="@layout/agguard_safety_report_overview_chart_layout" />
            <com.huawei.appgallery.agguard.business.ui.view.DrawableTextView
                android:textSize="@dimen/appgallery_text_size_body3"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/overview_chart_all_app_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:drawablePadding="8.0dip"
                android:drawableStart="@drawable/agguard_safety_report_all_circle"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textDirection="locale"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
            <com.huawei.appgallery.agguard.business.ui.view.DrawableTextView
                android:textSize="@dimen/appgallery_text_size_subtitle1"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/overview_chart_unpass_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:text="@string/agguard_safety_report_chart_unpass_desc"
                android:drawablePadding="8.0dip"
                android:drawableStart="@drawable/agguard_safety_report_unpass_circle"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textDirection="locale"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_subtitle1"
                android:textColor="@color/appgallery_text_color_primary"
                android:layout_gravity="start"
                android:id="@id/overview_chart_allpass_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:text="@string/agguard_safety_report_chart_pass_desc"
                android:includeFontPadding="false"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textDirection="locale"
                android:paddingStart="16.0dip"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Secondary" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="16.0sp"
                android:textStyle="normal"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:id="@id/overview_chart_unpass_num_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:singleLine="true"
                android:layout_marginStart="16.0dip"
                style="@style/TextAppearance.MaterialComponents.Headline4" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>