<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:paddingTop="12.0dip"
    android:paddingBottom="@dimen/appgallery_max_padding_end"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:id="@id/top_round_Corner"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:round_corner="@dimen/appgallery_default_corner_radius_l">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/backPicture"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop" />
        <View
            android:id="@id/gradient_view"
            android:layout_width="fill_parent"
            android:layout_height="144.0dip"
            android:layout_alignParentBottom="true" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:id="@id/mid_round_Corner"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-56.0dip"
        android:layout_below="@id/top_round_Corner"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        app:round_corner="@dimen/appgallery_default_corner_radius_l">
        <include
            layout="@layout/card_half_brand_bottom_pad" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    <com.huawei.appgallery.search.ui.view.QuoteTextView
        android:textSize="@dimen/appgallery_text_size_subtitle1"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@id/appintroduce"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72.0dip"
        android:maxLines="2"
        android:shadowColor="@color/search_black_alpha_50"
        android:shadowDx="0.0"
        android:shadowDy="2.0"
        android:shadowRadius="0.8"
        android:layout_above="@id/mid_round_Corner"
        android:layout_centerHorizontal="true"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end" />
</RelativeLayout>