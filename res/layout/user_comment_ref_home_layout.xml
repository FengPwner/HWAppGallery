<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/comment_ref_user_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appgallery.forum.cards.widget.UserHeadImageView
        android:id="@id/comment_ref_user_icon"
        android:layout_width="@dimen/appgallery_card_icon_size_xs"
        android:layout_height="@dimen/appgallery_card_icon_size_xs"
        android:src="@drawable/placeholder_base_account_header"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
        android:layout_alignParentStart="true" />
    <com.huawei.appgallery.forum.cards.widget.NickNameFakeView
        android:id="@id/comment_ref_user_info_nickname_top_fake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/forum_user_home_page_tv_layout"
        android:layout_alignBottom="@id/forum_user_home_page_tv_layout" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/forum_user_home_page_tv_layout"
        android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
        android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
        android:layout_toEndOf="@id/comment_ref_user_icon">
        <com.huawei.appgallery.forum.cards.widget.UserInfoTextView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/forum_user_home_page_tv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Primary" />
        <TextView
            android:ellipsize="end"
            android:id="@id/comment_ref_section_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:text=""
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.TextCaption.Secondary" />
    </LinearLayout>
</RelativeLayout>