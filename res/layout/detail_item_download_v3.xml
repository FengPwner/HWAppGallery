<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="bottom"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/component_detail_bottom_height_v3"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.detail.detailbase.widget.DetailRelativeLayout
        android:orientation="horizontal"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@id/download_framelayout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="176.0dip"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:id="@id/ll_try_game"
                android:background="@drawable/corner_button_download_v3"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/component_detail_margin_bottom"
                android:minHeight="@dimen/component_detail_bottom_button_height_v3"
                android:layout_weight="1.0"
                android:layout_marginEnd="12.0dip">
                <com.huawei.appgallery.detail.detailbase.api.DetailBigTryGameButton
                    android:textSize="16.0dip"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_try_game_button"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:minHeight="@dimen/component_detail_bottom_button_height_v3"
                    android:text="@string/card_install_btn"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    wapbutton:downloadFixedWidth="true"
                    wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                    style="@style/detail_big_download_button" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/component_detail_margin_bottom"
                android:minHeight="@dimen/component_detail_bottom_button_height_v3"
                android:layout_weight="1.0">
                <com.huawei.appgallery.detail.detailbase.api.DetailBigDownloadButton
                    android:textSize="16.0dip"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/detail_download_button"
                    android:background="@drawable/corner_button_download_v3"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:minHeight="@dimen/component_detail_bottom_button_height_v3"
                    android:text="@string/card_install_btn"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    wapbutton:downloadFixedWidth="true"
                    wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                    style="@style/detail_big_download_button" />
            </LinearLayout>
        </LinearLayout>
    </com.huawei.appgallery.detail.detailbase.widget.DetailRelativeLayout>
</LinearLayout>