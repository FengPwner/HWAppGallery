<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@id/dialogLayout"
    android:background="@drawable/popup_full_bright_emui"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/res_textsize_16dp"
        android:textColor="@color/dialog_title"
        android:gravity="center"
        android:id="@id/push_downapp_alert_title"
        android:layout_width="fill_parent"
        android:layout_height="60.0dip"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip" />
    <TextView
        android:textSize="@dimen/emui_master_subtitle"
        android:textColor="@color/emui_black"
        android:id="@id/push_downapp_alert_msg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        android:layout_marginBottom="@dimen/margin_xs"
        android:text="@string/pushagent_alert_msg"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip" />
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip">
        <ImageView
            android:id="@id/push_app_icon"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:contentDescription="@string/pushagent_alert_msg" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8.0dip">
            <TextView
                android:textSize="@dimen/emui_master_subtitle"
                android:textColor="@color/title_name_black"
                android:id="@id/push_app_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:singleLine="true" />
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/emui_master_subtitle"
                    android:textColor="@color/push_app_size_color"
                    android:gravity="center_vertical"
                    android:id="@id/push_app_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true" />
                <RatingBar
                    android:id="@id/push_app_stars"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/push_app_size"
                    style="@style/style_list_ratingbar" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/button_layout"
        android:paddingTop="@dimen/padding_l"
        android:paddingBottom="@dimen/padding_l"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20.0dip"
        android:paddingEnd="20.0dip">
        <Button
            android:textSize="@dimen/res_textsize_16dp"
            android:textColor="@color/emui_accent"
            android:id="@id/push_downapp_cancel"
            android:background="@drawable/emui_button_select"
            android:layout_width="fill_parent"
            android:layout_height="44.0dip"
            android:text="@string/exit_cancel"
            android:layout_weight="1.0"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginEnd="8.0dip" />
        <Button
            android:textSize="@dimen/res_textsize_16dp"
            android:textColor="@color/emui_accent"
            android:id="@id/push_downapp_ok"
            android:background="@drawable/emui_button_select"
            android:layout_width="fill_parent"
            android:layout_height="44.0dip"
            android:text="@string/exit_confirm"
            android:layout_weight="1.0"
            android:fontFamily="@string/appgallery_text_font_family_medium" />
    </LinearLayout>
</LinearLayout>