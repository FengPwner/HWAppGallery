<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/personal_header_v5_card_id"
        android:background="@drawable/aguikit_card_panel_bg"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
        android:layout_marginEnd="@dimen/appgallery_column_system_content_margin">
        <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
            android:layout_gravity="center"
            android:id="@id/appcommon_personal_info_head_imageview"
            android:background="@android:color/transparent"
            android:layout_width="@dimen/personal_head_size"
            android:layout_height="@dimen/personal_head_size"
            android:src="@drawable/placeholder_base_account_header"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:contentDescription="@string/hiappbase_user_avatar"
            android:layout_marginStart="@dimen/ui_12_dp" />
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/ui_12_dp"
            android:paddingBottom="@dimen/ui_12_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/cs_16_dp"
            android:layout_marginEnd="@dimen/ui_12_dp"
            android:layout_toEndOf="@id/appcommon_personal_info_head_imageview"
            android:layout_alignParentEnd="true">
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/appcommon_personal_info_account_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="31.0dip">
                <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserInfoTextView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/mine_user_home_page_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
            <LinearLayout
                android:gravity="end|center"
                android:orientation="horizontal"
                android:id="@id/personal_home_page_layout"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip">
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:textSize="@dimen/res_textsize_14sp"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/personal_home_page_text"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="27.0dip"
                    android:text="@string/personal_home_page"
                    android:maxLines="2"
                    android:alpha="1.0"
                    android:fontFamily="@string/emui_text_font_family_regular"
                    android:layout_marginStart="@dimen/ui_12_dp"
                    android:layout_marginEnd="@dimen/ui_8_dp" />
                <ImageView
                    android:id="@id/arrow_imageview"
                    android:layout_width="@dimen/cs_12_dp"
                    android:layout_height="@dimen/cs_24_dp"
                    android:src="@drawable/ic_public_arrow_right_900" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>