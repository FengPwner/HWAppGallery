<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@id/share_fragment_layout"
    android:background="@color/community_share_fragment_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="12.0dip"
        app:shadowCornerRadius="@dimen/appgallery_default_corner_radius_m">
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            app:clip_background="true"
            app:round_corner="@dimen/appgallery_default_corner_radius_m"
            app:stroke_width="0.0dip">
            <ScrollView
                android:id="@id/app_share_layout"
                android:scrollbars="none"
                android:layout_width="295.0dip"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:importantForAccessibility="noHideDescendants">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/share_card_layout"
                    android:background="@color/community_share_card_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="440.0dip">
                    <ImageView
                        android:id="@id/share_banner_img"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitCenter" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/app_info_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="64.0dip"
                        android:layout_marginTop="12.0dip"
                        android:layout_marginBottom="12.0dip"
                        android:layout_marginStart="24.0dip"
                        android:layout_marginEnd="24.0dip">
                        <ImageView
                            android:id="@id/app_icon"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip" />
                        <TextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:id="@id/app_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:layout_weight="1.0"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            android:textAlignment="viewStart"
                            android:layout_marginStart="12.0dip" />
                        <com.huawei.appgallery.foundation.ui.framework.widget.RenderRatingBar
                            android:gravity="center"
                            android:layout_gravity="center_vertical"
                            android:id="@id/app_comment_stars_ratingbar"
                            android:tag="css/.title"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/appcomment_14_dp"
                            android:maxHeight="@dimen/appcomment_14_dp"
                            android:indeterminateOnly="false"
                            android:progressDrawable="@drawable/appcomment_ratingbar_list"
                            android:minHeight="@dimen/appcomment_14_dp"
                            android:thumb="@null"
                            android:numStars="1"
                            android:rating="1.0"
                            android:isIndicator="true"
                            android:importantForAccessibility="no"
                            android:layout_marginStart="@dimen/appcomment_8_dp" />
                        <TextView
                            android:textSize="20.0sp"
                            android:textColor="@color/appcomment_score"
                            android:gravity="center_vertical"
                            android:id="@id/app_comment_score"
                            android:tag="css/.title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/appgallery_text_font_family_medium"
                            android:layout_marginStart="2.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/user_info_layout"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24.0dip"
                        android:paddingEnd="24.0dip">
                        <com.huawei.appgallery.appcomment.ui.view.HeadImageView
                            android:id="@id/comment_user_icon"
                            android:layout_width="32.0dip"
                            android:layout_height="32.0dip"
                            android:contentDescription="@string/hiappbase_user_avatar" />
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8.0dip">
                            <TextView
                                android:textSize="@dimen/appgallery_text_size_body3"
                                android:textColor="@color/appgallery_text_color_primary"
                                android:id="@id/comment_user_name"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:fontFamily="@string/appgallery_text_font_family_medium"
                                android:textAlignment="viewStart" />
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dip">
                                <com.huawei.appgallery.foundation.ui.framework.widget.RenderRatingBar
                                    android:id="@id/comment_user_stars"
                                    android:tag="css/.title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/appcomment_12_dp"
                                    android:maxHeight="@dimen/appcomment_12_dp"
                                    android:indeterminateOnly="false"
                                    android:indeterminateDrawable="@drawable/appcomment_ratingbar_list"
                                    android:progressDrawable="@drawable/appcomment_ratingbar_list"
                                    android:minHeight="@dimen/appcomment_12_dp"
                                    android:thumb="@null"
                                    android:numStars="5"
                                    android:rating="0.0"
                                    android:isIndicator="true"
                                    android:layout_centerVertical="true" />
                                <TextView
                                    android:textSize="10.0sp"
                                    android:textColor="@color/appgallery_text_color_secondary"
                                    android:id="@id/user_comment_time"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@string/appgallery_text_font_family_regular"
                                    android:textAlignment="viewStart"
                                    android:layout_marginStart="@dimen/appcomment_16_dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="10.0sp"
                        android:ellipsize="end"
                        android:id="@id/user_comment_text"
                        android:paddingTop="12.0dip"
                        android:paddingBottom="16.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="0.0dip"
                        android:layout_weight="1.0"
                        android:textAlignment="viewStart"
                        android:paddingStart="24.0dip"
                        android:paddingEnd="24.0dip" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/share_qr_layout"
                        android:background="@color/community_share_qr_bg"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72.0dip"
                        android:paddingStart="24.0dip"
                        android:paddingEnd="24.0dip">
                        <TextView
                            android:textSize="10.0sp"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:id="@id/qr_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:textAlignment="viewStart" />
                        <ImageView
                            android:id="@id/qr_img"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:layout_marginStart="@dimen/appcomment_12_dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    </com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout>
</LinearLayout>