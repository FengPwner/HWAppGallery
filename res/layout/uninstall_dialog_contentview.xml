<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/margin_m"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="@dimen/emui_master_subtitle"
            android:textColor="@color/emui_color_gray_10"
            android:id="@id/uninstall_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_l" />
        <TextView
            android:textSize="@dimen/emui_master_body_2"
            android:textColor="@color/emui_color_gray_10"
            android:id="@id/uninstall_username_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>