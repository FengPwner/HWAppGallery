<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/transparent"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/forum_section_info_container"
        android:background="@drawable/forum_list_item_all_selector_v2"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_two_text_lines_with_icon"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <ImageView
            android:id="@id/section_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true" />
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@id/forum_section_info_llayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
            android:layout_toEndOf="@id/section_icon">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:ellipsize="end"
                android:id="@id/section_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:layout_below="@id/section_name">
                <ImageView
                    android:id="@id/posts_img"
                    android:layout_width="12.0dip"
                    android:layout_height="12.0dip"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/forum_post_desc" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="9.0dip"
                    android:ellipsize="end"
                    android:id="@id/posts_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignTop="@id/posts_img"
                    android:alpha="0.6"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="@dimen/appgallery_text_margin_vertical"
                    android:layout_toEndOf="@id/posts_img" />
                <ImageView
                    android:id="@id/follow_img"
                    android:layout_width="12.0dip"
                    android:layout_height="12.0dip"
                    android:layout_alignTop="@id/posts_img"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/forum_followers_desc"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
                    android:layout_toEndOf="@id/posts_count" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="9.0dip"
                    android:ellipsize="end"
                    android:id="@id/follow_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignTop="@id/follow_img"
                    android:alpha="0.6"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="@dimen/appgallery_text_margin_vertical"
                    android:layout_toEndOf="@id/follow_img" />
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>