<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@id/forum_section_post_user_main"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/emui_text_size_headline7"
        android:textColor="@color/appgallery_text_color_primary"
        android:ellipsize="end"
        android:id="@id/personal_user_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:alpha="1.0"
        android:fontFamily="@string/appgallery_text_font_family_medium"
        android:textAlignment="center" />
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@id/personal_user_flag"
        android:visibility="gone"
        android:layout_width="@dimen/personal_userflag_size"
        android:layout_height="@dimen/personal_userflag_size"
        android:layout_marginStart="@dimen/margin_m" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body3"
        android:textColor="@color/appgallery_text_color_secondary"
        android:ellipsize="end"
        android:id="@id/personal_user_duties"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/margin_s" />
</LinearLayout>