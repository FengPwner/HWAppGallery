<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@id/share_fragment_layout"
    android:background="@color/community_share_fragment_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="12.0dip"
        app:shadowCornerRadius="@dimen/appgallery_default_corner_radius_m">
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            app:clip_background="true"
            app:round_corner="@dimen/appgallery_default_corner_radius_m"
            app:stroke_width="0.0dip">
            <ScrollView
                android:id="@id/app_share_layout"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:importantForAccessibility="noHideDescendants">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/share_card_layout"
                    android:background="@color/community_share_card_bg"
                    android:layout_width="295.0dip"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="413.0dip">
                        <ImageView
                            android:id="@id/share_poster_img"
                            android:background="@color/share_image_poster_bg"
                            android:layout_width="295.0dip"
                            android:layout_height="wrap_content"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:maxHeight="2288.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/share_qr_layout"
                        android:background="@color/community_share_qr_bg"
                        android:layout_width="fill_parent"
                        android:layout_height="72.0dip"
                        android:paddingStart="24.0dip"
                        android:paddingEnd="24.0dip">
                        <TextView
                            android:textSize="10.0sp"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:id="@id/qr_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:textAlignment="viewStart" />
                        <ImageView
                            android:id="@id/qr_img"
                            android:layout_width="40.0dip"
                            android:layout_height="40.0dip"
                            android:layout_marginStart="12.0dip" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    </com.huawei.appgallery.aguikit.widget.AppGalleryShadowFrameLayout>
</LinearLayout>