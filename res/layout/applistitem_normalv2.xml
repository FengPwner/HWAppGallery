<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/normalv2_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/normal_card_container"
            android:background="@drawable/aguikit_round_rectangle_card_item_bg"
            android:paddingLeft="8.0dip"
            android:paddingRight="8.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:minHeight="72.0dip">
            <FrameLayout
                android:id="@id/rank_view"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_marginEnd="6.0dip"
                app:layout_constraintEnd_toStartOf="@id/appicon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/appicon">
                <TextView
                    android:textColor="@color/appgallery_text_color_primary"
                    android:layout_gravity="center"
                    android:id="@id/rank_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/emui_text_font_family_medium" />
                <ImageView
                    android:id="@id/rank_imageview"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@color/transparent"
                    android:scaleType="fitCenter" />
            </FrameLayout>
            <ImageView
                android:id="@id/appicon"
                android:layout_width="56.0dip"
                android:layout_height="56.0dip"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/app_description"
                app:layout_constraintStart_toEndOf="@id/rank_view"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@id/fastappicon"
                android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
                android:layout_height="@dimen/hiappbase_card_fasticon_size_large"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="@id/appicon"
                app:layout_constraintEnd_toEndOf="@id/appicon" />
            <View
                android:id="@id/horizon_line"
                android:background="@drawable/aguikit_horizontal_line_bg"
                android:inflatedId="@id/horizon_line"
                android:layout_width="@dimen/ui_40_dp"
                android:layout_height="1.5dip"
                android:layout_marginTop="4.0dip"
                app:layout_constraintEnd_toEndOf="@id/appicon"
                app:layout_constraintStart_toStartOf="@id/appicon"
                app:layout_constraintTop_toBottomOf="@id/appicon" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/app_description"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/cs_8_dp"
                android:layout_marginBottom="@dimen/cs_8_dp"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="8.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/downbtn"
                app:layout_constraintStart_toEndOf="@id/appicon"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/ItemTitle"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    app:layout_constraintBottom_toTopOf="@id/sec_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1" />
                <com.huawei.appmarket.service.appdetail.view.widget.FixedLeftLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/sec_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@id/memo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ItemTitle">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/label_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_m">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@id/label_rank_factor"
                            android:background="@drawable/title_text_label_bg"
                            android:layout_width="wrap_content"
                            android:layout_height="16.0sp"
                            android:paddingStart="@dimen/ui_4_dp"
                            android:paddingEnd="@dimen/ui_4_dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@id/title_label_small_icon"
                                android:visibility="gone"
                                android:layout_width="@dimen/ui_12_dp"
                                android:layout_height="@dimen/ui_12_dp"
                                android:src="@color/transparent"
                                android:layout_marginEnd="2.0dip" />
                            <TextView
                                android:textSize="@dimen/emui_text_size_caption1"
                                android:textColor="@color/normal_card_label_text_color"
                                android:ellipsize="end"
                                android:id="@id/title_text_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:fontFamily="@string/appgallery_text_font_family_regular" />
                        </LinearLayout>
                        <ImageView
                            android:id="@id/appflag"
                            android:visibility="gone"
                            android:layout_width="28.0sp"
                            android:layout_height="16.0sp"
                            android:src="@color/transparent"
                            android:scaleType="fitCenter" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@id/secline_first_container"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@id/secline_first_image"
                            android:layout_width="10.0dip"
                            android:layout_height="10.0dip"
                            android:src="@color/transparent"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="2.0dip" />
                        <TextView
                            android:ellipsize="end"
                            android:id="@id/secline_first_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                        <View
                            android:id="@id/secline_split"
                            android:background="@color/appgallery_text_color_tertiary"
                            android:layout_width="1.0dip"
                            android:layout_height="9.0dip"
                            android:layout_marginStart="6.0dip"
                            android:layout_marginEnd="6.0dip" />
                        <ImageView
                            android:id="@id/secline_sec_image"
                            android:layout_width="10.0dip"
                            android:layout_height="10.0dip"
                            android:src="@color/transparent"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="2.0dip" />
                        <TextView
                            android:ellipsize="end"
                            android:id="@id/secline_sec_text"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:layout_weight="1.0"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    </LinearLayout>
                </com.huawei.appmarket.service.appdetail.view.widget.FixedLeftLinearLayout>
                <TextView
                    android:ellipsize="end"
                    android:id="@id/memo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sec_container"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.huawei.appgallery.pageframe.view.DownloadButtonV2
                android:id="@id/downbtn"
                android:tag="css/.download-button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                app:layout_constraintBottom_toTopOf="@id/original_price_textview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <TextView
                android:textColor="@color/appgallery_text_color_tertiary"
                android:ellipsize="end"
                android:id="@id/original_price_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="14.0dip"
                android:singleLine="true"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/downbtn"
                app:layout_constraintStart_toStartOf="@id/downbtn"
                app:layout_constraintTop_toBottomOf="@id/downbtn"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/AppGallery.TextAppearance.TextCaption" />
            <View
                android:id="@id/devider_line"
                android:tag="css/.split-line"
                android:layout_width="0.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/downbtn"
                app:layout_constraintStart_toStartOf="@id/app_description"
                style="@style/AppGallery.Widget.Divider" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>