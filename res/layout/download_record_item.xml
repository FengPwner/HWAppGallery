<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/downloadRecord_layout"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_card_height_two_text_lines"
        android:importantForAccessibility="yes"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/icon_linear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l">
            <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                android:id="@id/item_icon_imageview"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:layout_centerVertical="true"
                android:importantForAccessibility="yes"
                maskview:corner_type="appicon"
                maskview:round_type="all" />
            <ViewStub
                android:layout_gravity="center"
                android:id="@id/horizon_line"
                android:layout="@layout/aguikit_horizontal_line_layout"
                android:layout_width="@dimen/ui_40_dp"
                android:layout_height="1.5dip"
                android:layout_marginTop="4.0dip"
                android:layout_below="@id/localpackage_item_icon_view" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/downloadRecord_middle_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/icon_linear">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/middle_layout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:ellipsize="end"
                    android:id="@id/app_name_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_info_default"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="0"
                    android:importantForAccessibility="no"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/app_download_paused_layout"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/app_paused_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:importantForAccessibility="no"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <ImageView
                        android:id="@id/expand_arrow_view1"
                        android:background="@drawable/ic_public_arrow_down_900"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/aguikit_expand_menu"
                        android:importantForAccessibility="yes"
                        android:layout_marginStart="@dimen/margin_s" />
                </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/app_downloading_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/app_desinfo_textview"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_weight="1.0"
                        android:importantForAccessibility="no"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/app_dldspeed_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="0.0dip"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <ImageView
                        android:id="@id/expand_arrow_view2"
                        android:background="@drawable/ic_public_arrow_down_900"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/aguikit_expand_menu"
                        android:importantForAccessibility="yes"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.appmarket.service.appmgr.view.widget.FeatureSupportDownloadButton
                    android:id="@id/download_record_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28.0dip"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    style="@style/AppGallery.Widget.DownloadButton.Normal" />
            </RelativeLayout>
        </LinearLayout>
        <View
            android:id="@id/download_split_line"
            android:layout_width="fill_parent"
            android:layout_alignParentBottom="true"
            android:layout_alignStart="@id/downloadRecord_middle_layout"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/bottom_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@id/bottom_button_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line">
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:gravity="start|center"
                android:layout_gravity="start|center"
                android:id="@id/delete_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_marginBottom="@dimen/margin_m"
                android:text="@string/download_cancel"
                android:maxLines="1"
                maskview:hwAutoSizeMinTextSize="9.0sp"
                maskview:hwAutoSizeStepGranularity="1.0sp"
                style="@style/AppGallery.Widget.Button.TextButton1" />
        </LinearLayout>
        <View
            android:id="@id/dld_long_split"
            android:layout_width="fill_parent"
            style="@style/AppGallery.Widget.Divider" />
    </LinearLayout>
</LinearLayout>