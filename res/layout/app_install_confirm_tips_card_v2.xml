<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/tips_card_layout"
    android:focusable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:contentDescription=""
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:focusable="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:hwColumnType="content_type">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/install_head_security_tips_group"
            android:background="@drawable/app_permission_bg"
            android:paddingBottom="@dimen/appgallery_card_elements_margin_s"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l"
            android:paddingStart="@dimen/appgallery_default_card_space_vertical_l"
            android:paddingEnd="@dimen/appgallery_default_card_space_vertical_l">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@id/app_security_tips_title_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/appgallery_subheader_default_height_single_text_line">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
                    android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m">
                    <ImageView
                        android:layout_width="@dimen/small_control_image_with"
                        android:layout_height="@dimen/small_control_image_height"
                        android:src="@drawable/install_dist_head_security_tip_ic" />
                    <TextView
                        android:id="@id/app_security_tips_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/install_dist_head_security_tip_title"
                        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                        style="@style/AppGallery.Widget.SubHeader.Title" />
                </LinearLayout>
            </LinearLayout>
            <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="@dimen/appgallery_card_elements_margin_m"
                android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/appgallery_subheader_item_double_min_height">
                <TextView
                    android:id="@id/app_security_tips_found_risk_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/install_head_enhance_protect_subheader_style" />
                <TextView
                    android:id="@id/head_security_tips_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                    style="@style/install_confirm_normal_tips_card_tips_style" />
            </com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout>
            <RelativeLayout
                android:id="@id/app_security_tips_risk_detail"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/appgallery_subheader_item_double_min_height">
                <View
                    android:id="@id/dividerLine"
                    android:layout_width="fill_parent"
                    android:layout_alignParentTop="true"
                    style="@style/AppGallery.Widget.Divider" />
                <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/appgallery_card_elements_margin_m"
                    android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <TextView
                        android:id="@id/app_security_tips_risk_detail_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/install_dist_head_risk_detail_title"
                        style="@style/install_head_security_tips_detail_title_style" />
                    <TextView
                        android:id="@id/head_security_tips_risk_detail_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                        style="@style/install_confirm_normal_tips_card_tips_style" />
                </com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/install_head_enhance_protect_tips_group"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_default_card_space_vertical_l">
            <RelativeLayout
                android:id="@id/install_head_enhance_protect_main_group"
                android:paddingBottom="@dimen/appgallery_card_elements_margin_s"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/appgallery_default_card_space_vertical_l">
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@id/head_enhance_protect_title_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/appgallery_subheader_default_height_single_text_line"
                    android:layout_alignParentTop="true"
                    android:layout_toStartOf="@id/head_enhance_protect_icon"
                    android:layout_alignParentStart="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
                        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_m">
                        <TextView
                            android:id="@id/head_enhance_protect_title"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/install_dist_head_enhance_protect_tips_title"
                            style="@style/AppGallery.Widget.SubHeader.Title" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:id="@id/head_enhance_protect_icon"
                    android:layout_width="@dimen/appgallery_card_icon_size_12_column"
                    android:layout_height="@dimen/appgallery_card_icon_size_12_column"
                    android:src="@drawable/install_dist_enhance_protect_ic_green"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true" />
                <com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout
                    android:orientation="vertical"
                    android:paddingTop="@dimen/appgallery_card_elements_margin_m"
                    android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/appgallery_input_box_default_height"
                    android:layout_below="@id/head_enhance_protect_title_layout"
                    android:paddingEnd="@dimen/appgallery_default_card_space_vertical_l"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:id="@id/head_enhance_found_risk_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/install_head_enhance_protect_subheader_style" />
                    <TextView
                        android:id="@id/head_enhance_found_risk_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                        style="@style/install_confirm_normal_tips_card_tips_style" />
                </com.huawei.appgallery.systeminstalldistservice.riskcheck.ui.view.AgeAdaptLinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/emui_text_size_body3"
                android:textColor="?android:textColorSecondary"
                android:id="@id/head_pure_mode_enhance_detail"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
                android:fontFamily="@string/emui_text_font_family_regular"
                android:layout_marginStart="@dimen/appgallery_default_card_space_vertical_l"
                android:layout_marginEnd="@dimen/appgallery_default_card_space_vertical_l" />
        </LinearLayout>
    </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
</LinearLayout>