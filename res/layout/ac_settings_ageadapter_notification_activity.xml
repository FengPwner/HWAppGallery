<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ScrollView
        android:orientation="vertical"
        android:id="@id/scroll_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/notification_settings_data_selection_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@id/notification_settings_toggle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                layout="@layout/settings_ageadapter_openflag_notification_item" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textColor="@color/appgallery_text_color_secondary"
                android:ellipsize="end"
                android:id="@id/cacel_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xl"
                android:layout_marginBottom="@dimen/emui_dimens_default_end"
                android:text="@string/appcommon_settings_notification_prompt"
                android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody2" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/notification_msg_switch_container"
                android:background="@drawable/aguikit_card_panel_bg"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end">
                <include
                    android:id="@id/notification_settings_push_toggle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
                    layout="@layout/settings_ageadapter_openflag_notification_item" />
                <ImageView
                    android:layout_width="fill_parent"
                    android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    style="@style/AppGallery.Widget.Divider" />
                <include
                    android:id="@id/notification_settings_emails_toggle"
                    layout="@layout/settings_ageadapter_openflag_notification_item" />
                <ImageView
                    android:layout_width="fill_parent"
                    android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    style="@style/AppGallery.Widget.Divider" />
                <include
                    android:id="@id/notification_settings_im_toggle"
                    layout="@layout/settings_ageadapter_openflag_notification_item" />
                <ImageView
                    android:layout_width="fill_parent"
                    android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                    style="@style/AppGallery.Widget.Divider" />
                <include
                    android:id="@id/notification_settings_sms_toggle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
                    layout="@layout/settings_ageadapter_openflag_notification_item" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/emui_dimens_default_start"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/c_feedback_red_start" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@id/settings_notification_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/appgallery_subheader_spliter_height"
                    android:layout_marginEnd="@dimen/appgallery_subheader_spliter_height"
                    style="@style/AppGallery.TextAppearance.Paragraph.TextBody2" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>