<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:background="@color/appgallery_color_sub_background"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/appgallery_hwtoolbar_height"
    android:paddingEnd="@dimen/margin_s"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:id="@id/hiappbase_arrow_layout"
        android:background="@drawable/c_actionbar_icon_bg_selector"
        android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_height"
        android:contentDescription="@string/click_back"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="4.0dip">
        <ImageView
            android:id="@id/up"
            android:layout_width="@dimen/ui_24_dp"
            android:layout_height="@dimen/ui_24_dp"
            android:src="@drawable/aguikit_ic_public_back" />
    </LinearLayout>
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:ellipsize="end"
        android:gravity="start|center"
        android:id="@id/title_text"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:layout_weight="1.0"
        android:layout_marginStart="@dimen/margin_s"
        style="@style/AppGallery.Widget.Toolbar.Title" />
</LinearLayout>