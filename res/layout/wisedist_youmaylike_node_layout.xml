<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:tag="@string/bannerImage"
    android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ViewStub
        android:id="@id/appList_ItemTitle_layout"
        android:layout="@layout/hiappbase_layout_subheader_title_more"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ViewStub
        android:id="@id/ageadapter_appList_ItemTitle_layout"
        android:layout="@layout/hiappbase_layout_ageadapter_subheader_title_more"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <RelativeLayout
        android:id="@id/card_container"
        android:background="@drawable/aguikit_card_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_start">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/main_container"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/appgallery_elements_margin_vertical_l"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_vertical_l">
                <View
                    android:tag="css/.split-line"
                    android:layout_width="@dimen/wisedist_youmaylikecard_divider_width"
                    android:layout_marginEnd="@dimen/appgallery_card_elements_margin_xs"
                    style="@style/AppGallery.Widget.Divider" />
                <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                    android:ellipsize="middle"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@id/top_title"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:singleLine="true"
                    android:layout_weight="1.0"
                    app:hwAutoSizeMinTextSize="@dimen/emui_text_size_subtitle2"
                    app:hwAutoSizeStepGranularity="@dimen/res_textsize_1sp"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <View
                    android:tag="css/.split-line"
                    android:layout_width="@dimen/wisedist_youmaylikecard_divider_width"
                    android:layout_marginStart="@dimen/appgallery_card_elements_margin_xs"
                    style="@style/AppGallery.Widget.Divider" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/card_container_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_vertical"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_vertical" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/main_container"
            android:layout_centerHorizontal="true">
            <com.huawei.uikit.phone.hwprogressbar.widget.HwProgressBar
                android:layout_gravity="center"
                android:id="@id/refresh_button_loading"
                android:visibility="gone"
                android:layout_width="@dimen/wisedist_youmaylikecard_icon_width"
                android:layout_height="@dimen/wisedist_youmaylikecard_icon_width"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m"
                style="@style/Widget.Emui.HwProgressBar" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_button2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/refresh_button_title"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/wisedist_youmaylikecard_icon_width"
                android:text="@string/youmaylike_refresh"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <ImageView
                android:id="@id/refresh_button_icon"
                android:tag="css/.widget"
                android:layout_width="@dimen/wisedist_youmaylikecard_icon_width"
                android:layout_height="@dimen/wisedist_youmaylikecard_icon_width"
                android:src="@drawable/ic_change"
                android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/refresh_hot_area"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/wisedist_youmaylikecard_hotarea_height"
            android:layout_marginTop="@dimen/wisedist_youmaylikecard_hotarea_margintop"
            android:layout_below="@id/refresh_button"
            android:contentDescription="@string/youmaylike_refresh"
            android:layout_alignStart="@id/refresh_button"
            android:layout_alignEnd="@id/refresh_button" />
    </RelativeLayout>
</LinearLayout>