<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView
        android:id="@id/log_info_desc_scrollview"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <RelativeLayout
                android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
                android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/appgallery_list_height_two_text_lines">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/log_upload_info_pkg"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
                    <TextView
                        android:id="@id/upload_log_info_pkg"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Secondary" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
                android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/appgallery_list_height_two_text_lines">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/log_upload_info_version"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
                    <TextView
                        android:id="@id/upload_log_info_version"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Secondary" />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@id/upload_log_info_logcat_layout_collaps"
                android:paddingTop="14.0dip"
                android:paddingBottom="14.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/log_upload_info_logcat"
                        android:layout_weight="1.0"
                        style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
                    <ImageView
                        android:id="@id/arrow_icon_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_public_arrow_down_900" />
                </LinearLayout>
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                    android:text="@string/log_upload_show_log_dialog_tips"
                    style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/log_content_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@id/upload_log_info_logcat_layout_expand"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/log_upload_info_logcat"
                android:layout_weight="1.0"
                style="@style/AppGallery.TextAppearance.Dialog.TextBody1.Primary" />
            <ImageView
                android:id="@id/arrow_icon_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_public_arrow_up_900" />
        </LinearLayout>
        <TextView
            android:id="@id/upload_log_info_logcat_layout_expand_subtitle"
            android:paddingBottom="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:text="@string/log_upload_show_log_dialog_tips"
            style="@style/AppGallery.TextAppearance.Dialog.TextBody2.Secondary" />
        <com.huawei.appgallery.foundation.ui.framework.widget.PullUpListView
            android:id="@id/log_content_listview"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:divider="@null"
            android:dividerHeight="0.0dip"
            app:hwCutoutMode="never" />
    </LinearLayout>
</LinearLayout>