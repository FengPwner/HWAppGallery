<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/essentialapp_loadingPager"
    android:visibility="gone"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/appgallery_color_appbar_bg"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_hwtoolbar_height">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:gravity="start|center"
            android:id="@id/loading_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
            app:hwAutoSizeMinTextSize="@dimen/appgallery_text_size_body2"
            app:hwAutoSizeStepGranularity="@dimen/res_textsize_1sp"
            style="@style/AppGallery.Widget.Toolbar.Title" />
    </LinearLayout>
    <include
        layout="@layout/loading_fragment" />
</LinearLayout>