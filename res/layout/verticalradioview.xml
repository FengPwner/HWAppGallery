<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/radio_layout"
    android:background="@drawable/aguikit_round_rectangle_card_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/main_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16.0dip"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="0.0dip"
        style="@style/AppGallery.Widget.List.TwoTextLines">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/buttonLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <com.huawei.uikit.phone.hwradiobutton.widget.HwRadioButton
                android:layout_gravity="center_vertical"
                android:tag="radionbutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                style="@style/Widget.Emui.HwRadioButton" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/buttonLayout"
            android:layout_alignParentStart="true">
            <TextView
                android:tag="title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <TextView
                android:textSize="@dimen/res_textsize_14sp"
                android:tag="content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                android:textAllCaps="false"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:tag="divider"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        style="@style/AppGallery.Widget.Divider" />
</RelativeLayout>