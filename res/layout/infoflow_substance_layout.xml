<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:tag="layout/infoflow_substance_layout_0"
    android:background="@drawable/list_item_normal_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:layout_width="@dimen/infoflow_4_5_icon_width"
        android:layout_height="@dimen/infoflow_4_5_icon_height"
        android:layout_marginTop="@dimen/emui_dimens_element_vertical_large"
        android:layout_marginBottom="@dimen/emui_dimens_element_vertical_large"
        app:round_corner="@dimen/emui_corner_radius_mediums">
        <ImageView
            android:id="@id/banner"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true" />
        <ImageView
            android:id="@id/typeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/emui_dimens_element_horizontal_middle"
            android:scaleType="centerCrop"
            android:layout_centerVertical="false"
            android:layout_marginStart="@dimen/emui_dimens_element_horizontal_middle" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/itemDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/emui_dimens_element_vertical_middle"
            android:maxLines="3"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
</LinearLayout>