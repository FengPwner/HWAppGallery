<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="yes"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/immersive_big_imageview"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:leftTop_radius="@dimen/appgallery_default_corner_radius_l"
        app:rightTop_radius="@dimen/appgallery_default_corner_radius_l"
        app:round_type="all"
        app:touch_drawable="@drawable/app_detail_wisedist_substancelistcard_stoke_corner_radius_l_normal" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bottom_circle_left_right_bg"
        android:padding="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/immersive_big_imageview">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:ellipsize="end"
                android:id="@id/immersive_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.SubTitle3" />
            <TextView
                android:textColor="@color/appgallery_color_appbar_subtitle"
                android:ellipsize="end"
                android:gravity="start"
                android:layout_gravity="center_vertical"
                android:id="@id/immersive_body"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody3" />
        </LinearLayout>
        <com.huawei.appgallery.pageframe.view.DownloadButtonV2
            android:layout_gravity="end|center"
            android:id="@id/dl_btn"
            android:layout_width="56.0dip"
            android:layout_height="28.0dip"
            android:layout_marginStart="8.0dip"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>