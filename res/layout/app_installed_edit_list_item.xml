<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/item_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_card_height_two_text_lines"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <ImageView
            android:id="@id/localpackage_item_icon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_alignParentStart="true" />
        <com.huawei.uikit.phone.hwcheckbox.widget.HwCheckBox
            android:id="@id/button_check_box"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
            android:layout_alignParentEnd="true"
            style="@style/Widget.Emui.HwCheckBox.Normal" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/localpackage_item"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/button_check_box"
            android:layout_toEndOf="@id/localpackage_item_icon">
            <TextView
                android:ellipsize="end"
                android:id="@id/localpackage_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_info_default"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                <TextView
                    android:textStyle="normal"
                    android:gravity="center_vertical"
                    android:id="@id/localpackage_item_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_info_default"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                <TextView
                    android:id="@id/localpackage_item_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_info_default"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/margin_m"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@id/app_installed_edit_split_line"
            android:layout_width="fill_parent"
            android:layout_alignParentBottom="true"
            android:layout_alignStart="@id/localpackage_item"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
</RelativeLayout>