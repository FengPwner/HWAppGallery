<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="yes"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/immersive_big_imageview"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:corner_radius="@dimen/appgallery_default_corner_radius_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_type="all"
        app:touch_drawable="@drawable/wisedist_substancelistcard_stoke_corner_radius_l" />
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@id/immersive_desc_textview"
        android:background="@drawable/substancelistcard_round_chip_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:minWidth="24.0dip"
        android:minHeight="16.0dip"
        android:maxLines="1"
        android:maxEms="9"
        android:paddingStart="8.0dip"
        android:paddingEnd="8.0dip"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppGallery.TextAppearance.Card.RoundChip" />
    <RelativeLayout
        android:id="@id/immersive_bg_view"
        android:layout_width="0.0dip"
        android:layout_height="100.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/app_zone_layout"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <TextView
                android:ellipsize="end"
                android:id="@id/immersive_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/immerse_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs">
                <TextView
                    android:id="@id/promotion_sign"
                    android:background="@drawable/promotion_sign_bg_bannerv9"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                    style="@style/promotion_sign_style_banner" />
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@id/immersive_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
        </LinearLayout>
        <com.huawei.appgallery.pageframe.view.DownloadButtonV2
            android:layout_gravity="end|bottom|center"
            android:id="@id/dl_btn"
            android:visibility="gone"
            android:layout_width="56.0dip"
            android:layout_height="28.0dip"
            android:layout_marginStart="8.0dip"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>