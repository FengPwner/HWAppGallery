<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/appcommon_personal_overser_container_relativelayout"
        android:layout_width="fill_parent"
        android:layout_height="176.0dip"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
        android:layout_marginEnd="@dimen/appgallery_column_system_content_margin">
        <com.huawei.appmarket.framework.widget.PersonalClipRoundImageView
            android:id="@id/appcommon_personal_info_overser_bg_imageview"
            android:layout_width="fill_parent"
            android:layout_height="152.0dip"
            android:src="@drawable/personal_info_bg"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
        <ImageView
            android:id="@id/appcommon_personal_info_overser_bg_imageview_shadow"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/personal_infocard_bg_size"
            android:src="@drawable/personal_info_bg_shadow"
            android:scaleType="fitXY"
            android:layout_below="@id/appcommon_personal_info_overser_bg_imageview" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/appcommon_personal_overser_defcontainer_linearlayout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
                android:layout_gravity="center_horizontal"
                android:id="@id/appcommon_personal_overser_definfo_head_imageview"
                android:background="@android:color/transparent"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:src="@drawable/placeholder_base_account_header"
                android:scaleType="centerCrop" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@id/appcommon_personal_overser_definfo_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_l"
                android:layout_marginBottom="@dimen/margin_xl"
                android:maxLines="1"
                android:layout_weight="1.0"
                android:alpha="1.0"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/appcommon_personal_head_overser_linearlayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="176.0dip"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
            android:layout_marginEnd="@dimen/appgallery_column_system_content_margin">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xl"
                android:layout_marginStart="@dimen/margin_xl"
                android:layout_marginEnd="@dimen/margin_l">
                <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
                    android:id="@id/appcommon_personal_info_head_overser_imageview"
                    android:background="@android:color/transparent"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:src="@drawable/placeholder_base_account_header"
                    android:scaleType="centerCrop" />
                <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                    android:layout_gravity="start|center"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <android.widget.TextView
                        android:textSize="@dimen/res_textsize_16dp"
                        android:textStyle="bold"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:gravity="start|center"
                        android:orientation="horizontal"
                        android:id="@id/appcommon_personal_info_overser_account_textview"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:alpha="1.0"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="@dimen/margin_l" />
                </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/appcommon_personal_asset_oversea_linearlayout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/personal_infocard_margin"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/margin_xl"
                android:layout_marginEnd="@dimen/margin_xl">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/appcommon_personal_gticket_oversea_linearlayout"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <TextView
                        android:textSize="@dimen/res_textsize_16dp"
                        android:textStyle="bold"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@id/appcommon_personal_gticket_value_oversea_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:alpha="1.0"
                        android:fontFamily="@string/appgallery_text_font_family_medium" />
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/res_textsize_12dp"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:ellipsize="end"
                            android:id="@id/appcommon_personal_gticket_label_oversea_textview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/personal_game_ticket"
                            android:maxLines="1"
                            android:alpha="1.0"
                            android:fontFamily="@string/appgallery_text_font_family_regular" />
                        <ImageView
                            android:id="@id/appcommon_personal_gticket_oversea_red_dot"
                            android:visibility="gone"
                            android:layout_width="6.0dip"
                            android:layout_height="6.0dip"
                            android:src="@drawable/tab_red_dot"
                            android:layout_marginStart="4.0dip"
                            android:layout_toEndOf="@id/gticket_txt" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>