<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/list_item_all_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/appinfo_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_card_height_three_text_lines">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:src="@drawable/transparent"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l" />
        <RelativeLayout
            android:id="@id/appinfo_right_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/appicon">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/center_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/downbtn">
                <TextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                    android:singleLine="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_body3"
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/intro_down_count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
            <TextView
                android:id="@id/web_site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@id/center_layout"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/downbtn"
                android:tag="css/.download-button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@id/detectorline"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_marginStart="72.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>