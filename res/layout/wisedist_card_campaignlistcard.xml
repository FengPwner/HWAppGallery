<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_vertical"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/campaign_first"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_vertical"
        layout="@layout/wisedist_card_campaigncard" />
    <include
        android:id="@id/campaign_second"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/wisedist_card_campaigncard" />
    <include
        android:id="@id/campaign_third"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
        layout="@layout/wisedist_card_campaigncard" />
</LinearLayout>