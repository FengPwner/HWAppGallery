<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:paddingBottom="0.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/ui_40_dp"
    style="@style/AppGallery.Widget.SubHeader.ViewGroup"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="start|center"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="2.0">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textColor="@color/buoy_emui_primary"
            android:ellipsize="end"
            android:layout_gravity="start|center"
            android:id="@id/hiappbase_subheader_title_left"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_for_layout"
            android:maxLines="2"
            style="@style/AppGallery.Widget.SubHeader.Title" />
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center"
        android:orientation="horizontal"
        android:id="@id/hiappbase_subheader_more_layout"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:contentDescription="@string/card_more_btn"
        android:layout_marginStart="@dimen/margin_m">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textColor="@color/buoy_emui_color_gray_7"
            android:id="@id/hiappbase_subheader_more_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_more_btn"
            android:lineSpacingMultiplier="1.1"
            style="@style/AppGallery.Widget.SubHeader.More" />
        <ImageView
            android:id="@id/hiappbase_subheader_more_arrow"
            android:tag="css/.arrow"
            android:background="@drawable/wisejoint_buoy_arrow"
            android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
            android:layout_height="@dimen/appgallery_list_item_right_arrow_height" />
    </LinearLayout>
</LinearLayout>