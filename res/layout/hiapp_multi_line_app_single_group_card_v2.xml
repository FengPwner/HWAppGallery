<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@drawable/aguikit_card_panel_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:id="@id/group_title_bg_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_corner_top_left="@dimen/appgallery_default_corner_radius_l"
        app:round_corner_top_right="@dimen/appgallery_default_corner_radius_l"
        app:stroke_width="0.0dip">
        <ImageView
            android:id="@id/group_title_bg"
            android:tag="@string/bannerImage"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/appgallery_bar_title_big_text_size_42dp"
            android:adjustViewBounds="true" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@id/group_title_layout"
        android:paddingTop="@dimen/margin_l"
        android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/item_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/ui_20_dp"
            android:ellipsize="end"
            android:id="@id/group_title"
            android:tag="css/.title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1.0"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <ImageView
            android:id="@id/hiappbase_subheader_more_arrow"
            android:tag="css/.arrow"
            android:layout_width="@dimen/ui_12_dp"
            android:layout_height="@dimen/ui_24_dp"
            android:src="@drawable/ic_public_arrow_right_900"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_vertical"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/item_container"
        android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/group_title_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>