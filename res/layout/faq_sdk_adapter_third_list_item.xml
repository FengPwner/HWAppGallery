<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/faq_sdk_list_item_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/emui_text_size_headline4"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.phoneservice.faq.base.widget.ListItemRelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginStart="@dimen/emui_dimens_max_start"
        android:layout_marginEnd="@dimen/emui_dimens_max_end">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/faq_sdk_ui_10_dip"
            android:paddingBottom="@dimen/faq_sdk_ui_10_dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:minHeight="@dimen/emui_text_size_headline4"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/faq_sdk_list_item_title_font_size"
                android:textColor="@color/faq_sdk_list_item_title_text_color_normal"
                android:id="@id/tv_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/emui_dimens_element_horizontal_middle" />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/faq_sdk_arrow_right" />
        </LinearLayout>
        <View
            android:id="@id/divider_view"
            android:background="@drawable/faq_sdk_list_divider_color_drawable"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/faq_sdk_line_height"
            android:layout_alignParentBottom="true" />
    </com.huawei.phoneservice.faq.base.widget.ListItemRelativeLayout>
</RelativeLayout>