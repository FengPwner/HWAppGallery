<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/main_layout"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/icon_linear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:layout_centerVertical="true">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/localpackage_item_icon_view"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:importantForAccessibility="yes"
            maskview:corner_type="appicon"
            maskview:round_type="all" />
        <ViewStub
            android:layout_gravity="center"
            android:id="@id/horizon_line"
            android:layout="@layout/aguikit_horizontal_line_layout"
            android:layout_width="@dimen/ui_40_dp"
            android:layout_height="1.5dip"
            android:layout_marginTop="4.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/middle_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@id/localpackage_item_name_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_info_default"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:importantForAccessibility="yes"
                maskview:layout_constrainedWidth="true"
                maskview:layout_constraintBottom_toBottomOf="parent"
                maskview:layout_constraintEnd_toStartOf="@id/red_dot_layout"
                maskview:layout_constraintHorizontal_bias="0.0"
                maskview:layout_constraintHorizontal_chainStyle="packed"
                maskview:layout_constraintStart_toStartOf="parent"
                maskview:layout_constraintTop_toTopOf="parent"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            <LinearLayout
                android:id="@id/red_dot_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                maskview:layout_constraintBottom_toBottomOf="parent"
                maskview:layout_constraintEnd_toEndOf="parent"
                maskview:layout_constraintStart_toEndOf="@id/localpackage_item_name_view"
                maskview:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@id/red_dot"
                    android:visibility="gone"
                    android:layout_width="@dimen/personal_imgecard_size"
                    android:layout_height="@dimen/personal_imgecard_size"
                    android:src="@drawable/tab_red_dot"
                    android:layout_marginStart="@dimen/margin_m" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
            <TextView
                android:textStyle="normal"
                android:id="@id/localpackage_item_size_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_info_default"
                android:importantForAccessibility="yes"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <ImageView
                android:id="@id/localpackage_item_size_arrow"
                android:background="@drawable/ic_public_arrow_down_900"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/aguikit_expand_menu"
                android:importantForAccessibility="yes"
                android:layout_marginStart="@dimen/margin_s" />
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@id/localpackage_item_date_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_info_default"
                    android:singleLine="true"
                    android:importantForAccessibility="yes"
                    android:layout_marginStart="@dimen/margin_m"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                <ImageView
                    android:id="@id/localpackage_item_date_arrow"
                    android:background="@drawable/ic_public_arrow_down_900"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/aguikit_expand_menu"
                    android:importantForAccessibility="yes"
                    android:layout_marginStart="@dimen/margin_s" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@id/uninstall_list_actions_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:ellipsize="end"
            android:id="@id/localpackage_option_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginBottom="@dimen/margin_m"
            android:maxWidth="140.0dip"
            android:text="@string/imagetextbutton_uninstall"
            android:maxLines="1"
            maskview:hwAutoSizeMinTextSize="9.0sp"
            maskview:hwAutoSizeStepGranularity="1.0sp"
            style="@style/AppGallery.Widget.Button.TextButton1" />
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:id="@id/app_management_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:layout_marginBottom="@dimen/margin_m"
            android:maxWidth="140.0dip"
            android:text="@string/install_manage"
            android:maxLines="1"
            android:layout_marginStart="16.0dip"
            maskview:hwAutoSizeMinTextSize="9.0sp"
            maskview:hwAutoSizeStepGranularity="1.0sp"
            style="@style/AppGallery.Widget.Button.TextButton1" />
    </LinearLayout>
    <RelativeLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m">
        <com.huawei.appmarket.service.appmgr.view.widget.InstallButton
            android:id="@id/app_open_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_open_btn"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
    </RelativeLayout>
    <ImageView
        android:id="@id/app_installed_split_line"
        android:layout_width="fill_parent"
        android:layout_marginTop="12.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>