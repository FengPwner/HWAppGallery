<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/comment_ref_user_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:id="@id/comment_ref_user_info_nickname_top_fake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/comment_ref_userinfo_llayout"
        android:layout_alignBottom="@id/comment_ref_userinfo_llayout" />
    <com.huawei.appgallery.forum.cards.widget.UserHeadImageView
        android:gravity="start|center"
        android:id="@id/comment_ref_user_icon"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:src="@drawable/forum_message_default_user_icon"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_marginEnd="@dimen/margin_l"
        android:layout_alignParentStart="true" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/comment_ref_userinfo_llayout"
        android:paddingTop="@dimen/padding_m"
        android:paddingBottom="@dimen/padding_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/comment_ref_user_icon">
        <com.huawei.appgallery.forum.cards.widget.UserInfoTextView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/comment_ref_userinfo_tv"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:textSize="@dimen/emui_master_caption_2"
            android:textColor="@color/emui_color_gray_7"
            android:ellipsize="end"
            android:id="@id/comment_ref_section_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xs"
            android:maxLines="1"
            android:fontFamily="Regular" />
    </LinearLayout>
</RelativeLayout>