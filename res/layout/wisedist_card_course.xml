<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/course_list_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="104.0dip">
        <com.huawei.appgallery.aguikit.widget.imageview.RoundImageView
            android:layout_gravity="center_vertical"
            android:id="@id/course_image"
            android:layout_width="128.0dip"
            android:layout_height="@dimen/appgallery_card_icon_size_xl"
            android:scaleType="centerCrop"
            app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/course_title"
                android:tag="css/.title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/course_detail"
                android:tag="css/.subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_elements_margin_horizontal_m"
                android:maxLines="2"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@id/devider_line"
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_marginStart="144.0dip"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>