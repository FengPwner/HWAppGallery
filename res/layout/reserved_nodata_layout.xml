<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@id/warn_image"
        android:src="@drawable/wisedist_ic_maa_game_empty"
        style="@style/AppGallery.ImageSize.NoData" />
    <TextView
        android:gravity="center"
        android:id="@id/warn_text_one"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:text="@string/reserved_manage_noapp"
        style="@style/AppGallery.TextAppearance.NoData" />
</LinearLayout>