<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/wishlist_info_content_layout"
        android:background="@drawable/aguikit_card_panel_bg"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_m"
        android:importantForAccessibility="yes"
        android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/wishlist_wish_name"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/wishlist_textview_wish_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="192.0dip"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
        <ImageView
            android:layout_width="fill_parent"
            android:layout_marginTop="0.0dip"
            style="@style/AppGallery.Widget.Divider" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/wishlist_string_wish_add_date"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/wishlist_textview_wish_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="192.0dip"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
        <ImageView
            android:layout_width="fill_parent"
            android:layout_marginTop="0.0dip"
            style="@style/AppGallery.Widget.Divider" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/wishlist_detail_state_container"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/wishlist_string_wish_detail_state"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/wishlist_textview_wish_detail_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="192.0dip"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/wish_detail_add_count_container"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/wish_wishlist_add_count_baseinfo"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/wishlist_textview_wish_add_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="192.0dip"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
        <ImageView
            android:id="@id/wishlist_imageview_divide_line_add_count_or_state"
            android:layout_width="fill_parent"
            android:layout_marginTop="0.0dip"
            style="@style/AppGallery.Widget.Divider" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_list_height_single_text_line">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/wishlist_wish_autoinstall"
                android:layout_weight="1.0"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/AppGallery.TextAppearance.Paragraph.TextBody1.Primary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/wishlist_textview_wish_autoinstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="192.0dip"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>