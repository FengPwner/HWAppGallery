<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_end"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/comment_header_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@id/rlv_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56.0dip"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@id/forum_user_pic"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:layout_centerVertical="true" />
            <com.huawei.uikit.phone.hwbutton.widget.HwButton
                android:gravity="center"
                android:id="@id/comment_detail_follow_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64.0dip"
                android:minHeight="28.0dip"
                android:text="@string/forum_operation_unfollow"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/margin_m"
                android:paddingEnd="@dimen/margin_m"
                android:layout_alignParentEnd="true"
                app:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
                app:hwAutoSizeStepGranularity="@dimen/appgallery_auto_size_step_granularity"
                style="@style/AppGallery.Widget.Button.Small" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/comment_detail_follow_btn"
                android:layout_toEndOf="@id/forum_user_pic">
                <com.huawei.appgallery.forum.cards.widget.UserInfoTextView
                    android:id="@id/forum_user_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_xs">
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:textColor="@color/appgallery_text_color_secondary"
                        android:id="@id/forum_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2018/6/05"
                        android:fontFamily="Regular" />
                    <TextView
                        android:ellipsize="end"
                        android:id="@id/forum_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/margin_l"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rlv_img"
            android:layout_marginStart="56.0dip"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true">
            <com.huawei.appgallery.forum.cards.widget.PostHeadContentTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary"
                android:id="@id/comment_content_info"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:fontFamily="Regular"
                android:textAlignment="viewStart" />
            <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                android:id="@id/comment_img"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m"
                android:scaleType="fitStart"
                android:contentDescription="@string/forum_base_str_image"
                app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ll_comment_error_state"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_m">
                <ImageView
                    android:id="@id/reject_img"
                    android:background="@drawable/aguikit_ic_public_error"
                    android:layout_width="@dimen/forum_error_icon_size_normal"
                    android:layout_height="@dimen/forum_error_icon_size_normal"
                    android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_vertical" />
                <TextView
                    android:id="@id/error_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forum_base_this_replies_msg"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
            </LinearLayout>
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="48.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/forum_commet_share"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:id="@id/forum_commet_share_img"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:src="@drawable/aguikit_ic_public_share"
                        android:contentDescription="@string/share_app_title" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/ll_praise"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_alignWithParentIfMissing="true"
                    android:layout_toStartOf="@id/forum_commet_share">
                    <ImageView
                        android:id="@id/forum_commet_praise_img"
                        android:layout_width="16.0dip"
                        android:layout_height="16.0dip"
                        android:contentDescription="@string/forum_post_comment_like" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_caption_fixed"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:id="@id/forum_comment_praise_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginStart="@dimen/margin_s" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>