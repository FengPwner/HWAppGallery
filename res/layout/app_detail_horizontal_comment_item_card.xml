<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
    android:paddingTop="@dimen/component_detail_card_elements_margin_l"
    android:paddingBottom="@dimen/padding_l"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/detail_comment_item_card_min_height"
    android:layout_marginTop="@dimen/margin_m"
    android:paddingStart="@dimen/padding_l"
    android:paddingEnd="@dimen/padding_l"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/app_detail_horizontal_comment_item_card_avatar"
            android:background="@drawable/detail_head_image_selector"
            android:layout_width="@dimen/detail_comment_card_user_icon_width"
            android:layout_height="@dimen/detail_comment_card_user_icon_width"
            android:contentDescription="@string/hiappbase_user_avatar"
            android:layout_marginEnd="@dimen/margin_m" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RatingBar
                    android:id="@id/app_detail_horizontal_comment_item_card_stars_rating_bar"
                    android:indeterminateOnly="false"
                    android:thumb="@null"
                    android:isIndicator="true"
                    android:layout_centerVertical="true"
                    android:importantForAccessibility="no"
                    android:layout_alignParentEnd="true"
                    style="@style/style_list_ratingbar" />
                <View
                    android:id="@id/stars_rating_bar_conceal_view"
                    android:background="@null"
                    android:layout_width="1.0dip"
                    android:layout_height="1.0dip"
                    android:layout_alignLeft="@id/app_detail_horizontal_comment_item_card_stars_rating_bar" />
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/app_detail_horizontal_comment_item_card_stars_rating_bar"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:textSize="@dimen/component_detail_text_size_l"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:gravity="start|center"
                        android:id="@id/app_detail_horizontal_comment_item_card_nick_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        android:layout_marginEnd="@dimen/margin_m" />
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/appgallery_text_size_body3_fixed"
                android:textColor="@color/appgallery_text_color_secondary"
                android:gravity="center_vertical"
                android:id="@id/app_detail_horizontal_comment_item_card_comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/component_detail_text_size_l"
        android:textColor="@color/appgallery_text_color_secondary"
        android:ellipsize="end"
        android:id="@id/app_detail_horizontal_comment_item_card_comment_info"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:textAlignment="viewStart" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/app_detail_horizontal_comment_item_card_reply_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_m">
        <TextView
            android:textSize="@dimen/component_detail_text_size_l"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/app_detail_horizontal_comment_item_card_reply_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="@string/appgallery_text_font_family_medium" />
        <TextView
            android:textSize="@dimen/component_detail_text_size_l"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:id="@id/app_detail_horizontal_comment_item_card_reply_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingMultiplier="1.1"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textAlignment="viewStart" />
    </LinearLayout>
</LinearLayout>