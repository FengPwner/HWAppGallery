<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/update_main_layout"
    android:addStatesFromChildren="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:gravity="bottom"
        android:paddingTop="@dimen/margin_l"
        android:paddingBottom="@dimen/margin_m"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_subheader_default_height_single_text_line">
        <TextView
            android:id="@id/history_update_left_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            style="@style/AppGallery.Widget.SubHeader.Title" />
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="@drawable/aguikit_round_rectangle_card_and_panel_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@id/history_update_card_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_space"
            android:minHeight="@dimen/appgallery_card_height_three_text_lines" />
        <View
            android:id="@id/update_split_line"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_marginLeft="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginRight="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.Widget.Divider" />
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:textSize="@dimen/appgallery_text_size_button2"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@id/view_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_marginBottom="4.0dip"
            android:text="@string/updatemanager_view_more"
            android:maxLines="1"
            android:textAllCaps="true"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_marginEnd="@dimen/margin_l"
            maskview:hwAutoSizeMinTextSize="9.0sp"
            maskview:hwAutoSizeStepGranularity="1.0sp"
            style="@style/Widget.Emui.HwButton.Borderless.Small" />
    </LinearLayout>
</LinearLayout>