<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:id="@id/AppListItem"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/appinfo_layout"
        android:background="@drawable/list_item_all_selector"
        android:paddingTop="@dimen/appgallery_default_card_space_vertical_l"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <ImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/appgallery_card_icon_size_large"
            android:layout_height="@dimen/appgallery_card_icon_size_large"
            android:src="@color/transparent"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ViewStub
            android:id="@id/horizon_line"
            android:layout="@layout/aguikit_horizontal_line_layout"
            android:layout_width="@dimen/search_ui_40_dp"
            android:layout_height="1.5dip"
            android:layout_marginTop="4.0dip"
            android:layout_below="@id/app_icon_frame_layout"
            app:layout_constraintEnd_toEndOf="@id/appicon"
            app:layout_constraintStart_toStartOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/appicon" />
        <ViewStub
            android:id="@id/fastappicon"
            android:layout="@layout/search_fastappicon_layout"
            android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
            android:layout_height="@dimen/hiappbase_card_fasticon_size_large"
            android:src="@color/emui_appbar_icon_dark"
            app:layout_constraintBottom_toBottomOf="@id/appicon"
            app:layout_constraintEnd_toEndOf="@id/appicon" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@id/item_title_layout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/horizon_line">
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/ItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/info_watch_imageview"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <ViewStub
                android:id="@id/info_watch_imageview"
                android:layout="@layout/search_detector_info_image"
                android:layout_width="14.0dip"
                android:layout_height="14.0dip"
                android:layout_marginStart="@dimen/margin_s"
                app:layout_constraintBottom_toBottomOf="@id/ItemTitle"
                app:layout_constraintEnd_toStartOf="@id/info_vr_imageview"
                app:layout_constraintStart_toEndOf="@id/ItemTitle"
                app:layout_constraintTop_toTopOf="@id/ItemTitle"
                app:layout_goneMarginStart="0.0dip" />
            <ViewStub
                android:id="@id/info_vr_imageview"
                android:layout="@layout/search_detector_info_image"
                android:layout_width="14.0dip"
                android:layout_height="14.0dip"
                android:layout_marginStart="@dimen/margin_s"
                app:layout_constraintBottom_toBottomOf="@id/ItemTitle"
                app:layout_constraintEnd_toStartOf="@id/info_appquality_imageview"
                app:layout_constraintStart_toEndOf="@id/info_watch_imageview"
                app:layout_constraintTop_toTopOf="@id/ItemTitle"
                app:layout_goneMarginStart="@dimen/margin_s" />
            <ViewStub
                android:id="@id/info_appquality_imageview"
                android:layout="@layout/search_detector_info_image"
                android:layout_width="14.0dip"
                android:layout_height="14.0dip"
                android:layout_marginStart="@dimen/margin_s"
                app:layout_constraintBottom_toBottomOf="@id/ItemTitle"
                app:layout_constraintEnd_toStartOf="@id/info_cloud_game_imageview"
                app:layout_constraintStart_toEndOf="@id/info_vr_imageview"
                app:layout_constraintTop_toTopOf="@id/ItemTitle"
                app:layout_goneMarginStart="@dimen/margin_s" />
            <ViewStub
                android:id="@id/info_cloud_game_imageview"
                android:layout="@layout/search_detector_info_image"
                android:layout_width="14.0dip"
                android:layout_height="14.0dip"
                android:layout_marginStart="@dimen/margin_s"
                app:layout_constraintBottom_toBottomOf="@id/ItemTitle"
                app:layout_constraintEnd_toStartOf="@id/gift_flag"
                app:layout_constraintStart_toEndOf="@id/info_appquality_imageview"
                app:layout_constraintTop_toTopOf="@id/ItemTitle"
                app:layout_goneMarginStart="@dimen/margin_s" />
            <ViewStub
                android:id="@id/gift_flag"
                android:layout="@layout/search_giftflag_layout"
                android:layout_width="wrap_content"
                android:layout_height="14.0dip"
                android:layout_marginStart="@dimen/margin_s"
                app:layout_constraintBottom_toBottomOf="@id/ItemTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/info_cloud_game_imageview"
                app:layout_constraintTop_toTopOf="@id/ItemTitle"
                app:layout_goneMarginStart="@dimen/margin_s" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/emui_text_size_caption1"
            android:textColor="@color/tooltip_background_light"
            android:gravity="center"
            android:id="@id/tv_disclaimer"
            android:tag="css/.subtitle"
            android:background="@drawable/ad_tag_item_bg"
            android:paddingTop="@dimen/cs_2_dp"
            android:paddingBottom="@dimen/cs_2_dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:minHeight="@dimen/ui_16_dp"
            android:text="@string/hiappbase_disclaimer"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textAllCaps="false"
            android:paddingStart="@dimen/ui_4_dp"
            android:paddingEnd="@dimen/ui_4_dp"
            android:layout_marginEnd="8.0dip"
            app:layout_constraintLeft_toLeftOf="@id/item_title_layout"
            app:layout_constraintTop_toBottomOf="@id/item_title_layout"
            app:layout_goneMarginBottom="@dimen/appgallery_card_protect_margin_vertical"
            app:layout_goneMarginTop="@dimen/appgallery_card_protect_margin_vertical" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/item_info_layout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            app:layout_constraintBottom_toTopOf="@id/item_memo_layout"
            app:layout_constraintEnd_toEndOf="@id/item_title_layout"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/tv_disclaimer">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/ad_info_icon"
                android:background="@drawable/hiappbase_info_icon"
                android:visibility="gone"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:contentDescription="@string/hiappbase_one_click_control_more_info"
                android:layout_marginEnd="4.0dip" />
            <TextView
                android:gravity="center"
                android:id="@id/ad_text"
                android:tag="css/.subtitle"
                android:visibility="gone"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginEnd="4.0dip"
                style="@style/AdTextViewBlackStyle" />
            <TextView
                android:id="@id/promotion_sign"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/promotion_sign_ageadapter_style" />
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/label_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@id/app_flag_rect"
                    android:layout="@layout/search_appflag_layout"
                    android:layout_width="28.0sp"
                    android:layout_height="16.0sp"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
                <ViewStub
                    android:layout_gravity="center_vertical"
                    android:id="@id/prefixAppIntro"
                    android:layout="@layout/search_prefix_app_intro"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/res_textsize_16sp"
                    android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m" />
            </RelativeLayout>
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/ItemText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/item_memo_layout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/item_title_layout"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/item_info_layout">
            <ViewStub
                android:layout_gravity="center_vertical"
                android:id="@id/no_adapter_icon"
                android:layout="@layout/search_no_adapter_icon"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:layout_marginEnd="@dimen/margin_m" />
            <TextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/memo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        </LinearLayout>
        <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
            android:id="@id/downbtn"
            android:tag="css/.download-button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:layout_marginBottom="@dimen/appgallery_default_card_space_vertical_l"
            android:minHeight="28.0dip"
            app:layout_constraintBottom_toTopOf="@id/detectorline"
            app:layout_constraintStart_toStartOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/item_memo_layout"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
        <ViewStub
            android:id="@id/original_price_textview"
            android:layout="@layout/search_original_price_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_m"
            app:layout_constraintBottom_toBottomOf="@id/downbtn"
            app:layout_constraintStart_toEndOf="@id/downbtn"
            app:layout_constraintTop_toTopOf="@id/downbtn" />
        <View
            android:id="@id/detectorline"
            android:layout_width="fill_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/item_title_layout"
            app:layout_constraintStart_toStartOf="@id/appicon"
            app:layout_constraintTop_toBottomOf="@id/downbtn"
            style="@style/AppGallery.Widget.Divider" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@id/decorate_container"
        android:layout="@layout/search_decorate_container_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appinfo_layout" />
    <ViewStub
        android:id="@id/shrink_container"
        android:layout="@layout/search_app_shrink_container_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appinfo_layout" />
    <LinearLayout
        android:id="@id/pic_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/shrink_container" />
</RelativeLayout>