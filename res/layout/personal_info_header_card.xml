<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/personal_header_v5_card_id"
        android:background="@drawable/aguikit_card_panel_bg"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:minHeight="@dimen/personal_head_v5_height"
        android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
        android:layout_marginEnd="@dimen/appgallery_column_system_content_margin">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/appcommon_personal_head_linearlayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_marginEnd="@dimen/margin_l">
            <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserHeadImageView
                android:id="@id/appcommon_personal_info_head_imageview"
                android:background="@android:color/transparent"
                android:layout_width="@dimen/personal_head_size"
                android:layout_height="@dimen/personal_head_size"
                android:src="@drawable/placeholder_base_account_header"
                android:scaleType="centerCrop"
                android:contentDescription="@string/hiappbase_user_avatar" />
            <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/appcommon_personal_info_account_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.huawei.appmarket.service.usercenter.userinfo.view.widget.UserInfoTextView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/mine_user_home_page_tv"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_12_dp" />
            </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/min_divider"
            android:layout_width="fill_parent"
            android:layout_height="16.0dip"
            android:layout_below="@id/appcommon_personal_head_linearlayout" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@id/personal_info_linear_layout"
            android:paddingBottom="14.0dip"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/min_divider"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_l">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/personal_info_left_linear_layout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="@dimen/res_textsize_14sp"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/personal_info_left_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_medium"
                    android:paddingStart="@dimen/ui_12_dp"
                    android:paddingEnd="@dimen/ui_12_dp" />
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:textSize="@dimen/res_textsize_10sp"
                        android:textColor="@color/appgallery_text_color_tertiary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@id/personal_info_left_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:alpha="1.0"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:paddingStart="@dimen/ui_10_dp" />
                    <ImageView
                        android:id="@id/personal_info_left_red_dot"
                        android:visibility="invisible"
                        android:layout_width="6.0dip"
                        android:layout_height="6.0dip"
                        android:src="@drawable/tab_red_dot"
                        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_gravity="center"
                android:id="@id/personal_divider"
                android:background="@color/personal_black_20_percent"
                android:layout_width="1.0dip"
                android:layout_height="24.0dip" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/personal_info_right_linear_layout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/res_textsize_14sp"
                        android:textColor="@color/appgallery_text_color_primary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@id/personal_info_right_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="1.0"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        android:paddingStart="@dimen/ui_12_dp"
                        android:paddingEnd="2.0dip" />
                    <ImageView
                        android:id="@id/personal_info_right_red_dot"
                        android:visibility="invisible"
                        android:layout_width="6.0dip"
                        android:layout_height="6.0dip"
                        android:src="@drawable/tab_red_dot"
                        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s" />
                </LinearLayout>
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/res_textsize_10sp"
                    android:textColor="@color/appgallery_text_color_tertiary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/personal_info_right_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:alpha="1.0"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:paddingStart="@dimen/ui_10_dp"
                    android:paddingEnd="@dimen/ui_10_dp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>