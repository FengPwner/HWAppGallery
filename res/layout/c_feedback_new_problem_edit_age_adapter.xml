<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:id="@id/scroll_view"
        android:fadingEdge="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/feedback_edit_activity_send_btn_layout"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_marginEnd="@dimen/margin_l">
            <TextView
                android:textSize="@dimen/res_textsize_13sp"
                android:textColor="@color/emui_black"
                android:id="@id/feedback_edit_activity_descrption_textview"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_l"
                android:layout_marginBottom="@dimen/margin_m"
                android:text="@string/c_feedback_content_description"
                android:alpha="0.5"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_alignParentStart="true" />
            <ImageView
                android:id="@id/red_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/c_feedback_red_start"
                android:layout_alignTop="@id/feedback_edit_activity_descrption_textview"
                android:layout_alignBottom="@id/feedback_edit_activity_descrption_textview"
                android:layout_marginStart="@dimen/margin_m"
                android:layout_toEndOf="@id/feedback_edit_activity_descrption_textview" />
            <TextView
                android:textSize="@dimen/res_textsize_13sp"
                android:textColor="@color/emui_functional_blue"
                android:id="@id/feedback_edit_activity_feedback_history"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_l"
                android:layout_marginBottom="@dimen/margin_m"
                android:text="@string/c_feedback_content_feedback_history"
                android:layout_below="@id/feedback_edit_activity_descrption_textview"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:layout_alignParentStart="true" />
            <RelativeLayout
                android:id="@id/feedback_new_content_photo"
                android:background="@drawable/c_feedback_edit_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="144.0dip"
                android:layout_below="@id/feedback_edit_activity_feedback_history">
                <com.huawei.appmarket.component.feedback.activity.FeedBackCounterTextLayout
                    android:id="@id/feedback_edit_activity_content_edittext_count_layout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:textSize="@dimen/res_textsize_13sp"
                        android:textColor="@color/emui_black"
                        android:textColorHint="@color/emui_color_gray_7"
                        android:gravity="start|center|top"
                        android:id="@id/feedback_edit_activity_content_edittext"
                        android:background="@drawable/c_feedback_edit_background"
                        android:paddingTop="@dimen/padding_m"
                        android:paddingBottom="64.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/c_feedback_descrption_content_hint"
                        android:inputType="textMultiLine"
                        android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                        android:paddingStart="@dimen/padding_m"
                        android:paddingEnd="@dimen/padding_m" />
                </com.huawei.appmarket.component.feedback.activity.FeedBackCounterTextLayout>
                <GridView
                    android:id="@id/feedback_add_image_grid"
                    android:paddingBottom="@dimen/padding_m"
                    android:layout_width="216.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_m"
                    android:layout_marginBottom="@dimen/margin_m"
                    android:numColumns="4"
                    android:scaleType="centerCrop"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/margin_m" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/feedback_log_detail_layout"
                android:visibility="invisible"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/margin_m"
                android:layout_below="@id/feedback_new_content_photo">
                <com.huawei.uikit.hwcheckbox.widget.HwCheckBox
                    android:textSize="@dimen/res_textsize_13sp"
                    android:textColor="@color/emui_black"
                    android:id="@id/feedback_edit_activity_log_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="48.0dip"
                    android:checked="false"
                    android:text="@string/c_feedback_app_log_detail_upload"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/padding_m"
                    android:layout_alignParentStart="true"
                    style="@style/Widget.Emui.HwCheckBox.Normal" />
                <ImageView
                    android:id="@id/log_detail_view1"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/c_feedback_log_note"
                    android:layout_alignTop="@id/log_detail_tip1"
                    android:layout_marginStart="0.0dip" />
                <TextView
                    android:textSize="@dimen/res_textsize_13sp"
                    android:textColor="@color/emui_black"
                    android:id="@id/log_detail_tip1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_m"
                    android:layout_below="@id/feedback_edit_activity_log_checkbox"
                    android:layout_marginStart="@dimen/margin_xs"
                    android:layout_toEndOf="@id/log_detail_view1" />
                <ImageView
                    android:id="@id/log_detail_view2"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/c_feedback_log_note"
                    android:layout_alignTop="@id/log_detail_tip2"
                    android:layout_marginStart="0.0dip" />
                <TextView
                    android:textSize="@dimen/res_textsize_13sp"
                    android:textColor="@color/emui_black"
                    android:id="@id/log_detail_tip2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_xs"
                    android:text="@string/c_feedback_app_log_detail_tip2"
                    android:layout_below="@id/log_detail_tip1"
                    android:layout_marginStart="@dimen/margin_xs"
                    android:layout_toEndOf="@id/log_detail_view2" />
                <ImageView
                    android:id="@id/log_detail_view3"
                    android:layout_width="16.0dip"
                    android:layout_height="16.0dip"
                    android:src="@drawable/c_feedback_log_note"
                    android:layout_alignTop="@id/log_detail_tip3"
                    android:layout_marginStart="0.0dip" />
                <TextView
                    android:textSize="@dimen/res_textsize_13sp"
                    android:textColor="@color/emui_black"
                    android:id="@id/log_detail_tip3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_xs"
                    android:layout_marginBottom="8.0dip"
                    android:text="@string/c_feedback_app_log_detail_tip3"
                    android:layout_below="@id/log_detail_tip2"
                    android:layout_marginStart="@dimen/margin_xs"
                    android:layout_toEndOf="@id/log_detail_view3" />
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/feedback_edit_activity_send_btn_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <View
            android:layout_width="0.0dip"
            android:layout_height="32.0dip"
            android:layout_weight="1.0" />
        <com.huawei.uikit.hwbutton.widget.HwButton
            android:enabled="false"
            android:textSize="@dimen/res_textsize_15sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/feedback_edit_activity_send_btn"
            android:background="@drawable/c_feedback_edit_commit_selector"
            android:visibility="visible"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:minHeight="32.0dip"
            android:text="@string/c_feedback_submit"
            android:layout_weight="2.0"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:textAllCaps="true"
            android:fontFamily="@string/appgallery_text_font_family_medium"
            style="@style/Widget.Emui.HwButton" />
        <View
            android:layout_width="0.0dip"
            android:layout_height="32.0dip"
            android:layout_weight="1.0" />
    </LinearLayout>
</RelativeLayout>