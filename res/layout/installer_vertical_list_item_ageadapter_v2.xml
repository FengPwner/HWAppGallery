<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/install_vertical_item_ageadapter_margin_top"
        android:paddingStart="@dimen/install_vertical_card_padding_start"
        android:paddingEnd="@dimen/install_vertical_card_padding_start">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/appicon"
            android:layout_width="@dimen/install_vertical_card_icon_width_56dp"
            android:layout_height="@dimen/install_vertical_card_icon_width_56dp"
            android:layout_marginTop="@dimen/install_vertical_card_icon_ageadapter_margin_top"
            android:layout_marginBottom="@dimen/appgallery_card_protect_margin_vertical"
            android:src="@color/transparent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:round_type="all" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/install_vertical_item_ageadapter_title_margin_bottom">
            <TextView
                android:ellipsize="end"
                android:id="@id/itemTitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_text_margin_vertical"
                android:singleLine="true"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
            <TextView
                android:ellipsize="end"
                android:id="@id/itemSecondText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/itemText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
        <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
            android:textSize="@dimen/res_textsize_12sp"
            android:id="@id/downbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/install_vertical_item_ageadapter_button_margin_bottom"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
        <View
            android:id="@id/dividerLine"
            android:layout_width="fill_parent"
            style="@style/AppGallery.Widget.Divider" />
    </LinearLayout>
</LinearLayout>