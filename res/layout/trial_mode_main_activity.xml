<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/appgallery_color_subtab_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/trial_mode_main_activity_title_layout"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_headline7"
            android:ellipsize="end"
            android:id="@id/trial_mode_main_activity_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agtrialmode_main_activity_title"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/appgallery_max_padding_start"
            android:layout_marginEnd="56.0dip"
            android:layout_alignParentStart="true"
            style="@style/AppGallery.Widget.Toolbar.Title" />
        <LinearLayout
            android:id="@id/popup_menu_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/hwsubtab_icon_margin_bottom"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/agtrialmode_menu_full_mode"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@id/right_imageview"
                android:background="@drawable/aguikit_ic_public_more"
                android:layout_width="@dimen/trial_mode_menu_width"
                android:layout_height="@dimen/trial_mode_menu_height"
                android:layout_margin="@dimen/margin_m" />
        </LinearLayout>
        <LinearLayout
            android:id="@id/trial_mode_main_activity_title_search_btn"
            android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/hwsubtab_icon_margin_bottom"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/hiappbase_search_btn"
            android:layout_marginEnd="8.0dip"
            android:layout_toStartOf="@id/popup_menu_layout">
            <ImageView
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:layout_margin="8.0dip"
                android:src="@drawable/aguikit_ic_public_search" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/trial_mode_main_view_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:importantForAccessibility="no" />
</LinearLayout>