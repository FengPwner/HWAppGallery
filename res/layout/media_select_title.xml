<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:id="@id/hiappbase_arrow_layout"
        android:background="@drawable/hwappbarpattern_selector_item_bg"
        android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_height"
        android:contentDescription="@string/exit_cancel"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="4.0dip">
        <ImageView
            android:id="@id/up"
            android:layout_width="@dimen/media_titile_imageview_width"
            android:layout_height="@dimen/media_titile_imageview_width"
            android:src="@drawable/aguikit_ic_public_back" />
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:gravity="center"
            android:id="@id/title_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_s"
            app:hwAutoSizeMinTextSize="@dimen/hwappbarpattern_title_min_text_size"
            app:hwAutoSizeStepGranularity="@dimen/hwappbarpattern_title_textsize_step"
            style="@style/AppGallery.Widget.Toolbar.Title" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@id/hiappbase_right_title_layout"
        android:background="@drawable/hwappbarpattern_selector_item_bg"
        android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
        android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
        android:contentDescription="@string/exit_confirm"
        android:layout_marginEnd="@dimen/margin_s">
        <ImageView
            android:id="@id/icon2"
            android:layout_width="@dimen/media_titile_imageview_width"
            android:layout_height="@dimen/media_titile_imageview_width" />
    </LinearLayout>
</LinearLayout>