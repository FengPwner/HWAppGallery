<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center_horizontal"
    android:layout_gravity="bottom|center"
    android:id="@id/rl_root"
    android:background="@drawable/wisedist_guide_permission_dialog_bg"
    android:layout_width="fill_parent"
    android:layout_height="588.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/iv_arrow_down"
        android:layout_width="96.0dip"
        android:layout_height="24.0dip"
        android:src="@drawable/ic_arrow_down"
        android:scaleType="center"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true" />
    <TextView
        android:textSize="@dimen/appgallery_text_size_title"
        android:textColor="@color/emui_text_primary"
        android:gravity="center_horizontal"
        android:id="@id/tv_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32.0dip"
        android:text="@string/wisedist_enable_install_permission_title"
        android:layout_below="@id/iv_arrow_down"
        android:layout_marginStart="@dimen/ui_24_dp"
        android:layout_marginEnd="@dimen/ui_24_dp" />
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btn_to_open"
        android:layout_below="@id/tv_title">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/appgallery_text_size_subtitle2"
                android:textColor="@color/emui_text_primary"
                android:gravity="center_horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text="@string/wisedist_enable_install_permission_content"
                android:alpha="@dimen/emui_secondary_content_alpha"
                android:layout_marginStart="@dimen/ui_24_dp"
                android:layout_marginEnd="@dimen/ui_24_dp" />
            <ImageView
                android:id="@id/iv_install_permission"
                android:layout_width="312.0dip"
                android:layout_height="312.0dip"
                android:layout_marginTop="24.0dip"
                android:src="@drawable/img_install_permission" />
        </LinearLayout>
    </ScrollView>
    <com.huawei.uikit.hwbutton.widget.HwButton
        android:textSize="@dimen/emui_text_size_button1"
        android:id="@id/btn_to_open"
        android:paddingTop="@dimen/ui_8_dp"
        android:paddingBottom="@dimen/ui_8_dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_24_dp"
        android:layout_marginBottom="24.0dip"
        android:minHeight="@dimen/hwbutton_default_height"
        android:text="@string/wisedist_turn_on"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/ui_24_dp"
        android:layout_marginEnd="@dimen/ui_24_dp"
        style="@style/Widget.Emui.HwButton.Emphasize" />
</RelativeLayout>