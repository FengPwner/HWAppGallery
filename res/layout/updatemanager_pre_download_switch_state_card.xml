<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/pre_download"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/appgallery_list_height_single_text_line"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/appgallery_max_padding_start"
        android:paddingEnd="@dimen/appgallery_max_padding_end">
        <com.huawei.uikit.hwswitch.widget.HwSwitch
            android:id="@id/pre_download_switchBtn"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/Widget.Emui.HwSwitch" />
        <TextView
            android:id="@id/switch_name_tv"
            android:paddingTop="14.0dip"
            android:paddingBottom="14.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            android:layout_toStartOf="@id/pre_download_switchBtn"
            android:layout_alignParentStart="true"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
        <ImageView
            android:id="@id/gray_split_bar"
            android:layout_width="wrap_content"
            android:layout_height="0.0dip"
            android:layout_below="@id/switch_name_tv"
            android:layout_alignStart="@id/switch_name_tv"
            android:layout_alignEnd="@id/pre_download_switchBtn"
            style="@style/AppGallery.Widget.Divider" />
    </RelativeLayout>
</RelativeLayout>