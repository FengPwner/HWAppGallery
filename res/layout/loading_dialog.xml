<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/loading_tips_layout"
    android:background="@drawable/hiappbase_loading_dialog_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="30.0dip"
    android:layout_marginBottom="30.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/appgallery_text_size_body1"
        android:textColor="@color/appgallery_text_primary"
        android:gravity="center_vertical"
        android:id="@id/loading_tips_text"
        android:visibility="visible"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:minHeight="80.0dip"
        android:layout_weight="3.0"
        android:alpha="1.0"
        android:fontFamily="@string/appgallery_text_font_family_regular"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_marginEnd="@dimen/margin_s" />
    <LinearLayout
        android:gravity="end|center"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:layout_weight="1.0">
        <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
            android:id="@id/loading_light"
            android:visibility="visible"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_marginEnd="@dimen/margin_l"
            style="@style/Widget.Emui.HwProgressBar" />
    </LinearLayout>
</LinearLayout>