<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/content_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@id/hiappbase_content_layout_id"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <com.huawei.appmarket.service.infoflow.view.widget.PullDownListView
                android:id="@id/applistview"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:drawSelectorOnTop="true"
                android:divider="@null"
                android:dividerHeight="0.0dip" />
            <com.huawei.appgallery.detail.detailcard.widget.DetailInfoFlowDownloadView
                android:id="@id/detail_flow_download_view_container"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_6_dp" />
            <include
                android:id="@id/load_more_mask_layer"
                layout="@layout/detail_information_load_more_mask_layer_dark" />
        </RelativeLayout>
    </LinearLayout>
    <com.huawei.appgallery.detail.detailservice.widget.DetailFlowActionBar
        android:layout_gravity="top"
        android:id="@id/detail_flow_action_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <ViewStub
        android:id="@id/nodata_viewstub"
        android:layout="@layout/hiappbase_nodata_warn_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <FrameLayout
        android:id="@id/hiappbase_loading_layout_id"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</FrameLayout>