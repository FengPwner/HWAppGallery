<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/loading_layout"
        layout="@layout/loading_fragment" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/bar_layout"
        android:background="@color/appgallery_color_appbar_bg"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_hwtoolbar_height">
        <LinearLayout
            android:gravity="center"
            android:id="@id/back_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_icon_size"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="4.0dip">
            <ImageView
                android:id="@id/back_view"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip"
                android:src="@drawable/aguikit_ic_public_back" />
        </LinearLayout>
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:gravity="start|center"
            android:id="@id/title_textview"
            android:visibility="visible"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/margin_s"
            style="@style/AppGallery.Widget.Toolbar.Title" />
    </LinearLayout>
    <FrameLayout
        android:id="@id/detail_bar_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:id="@id/detail_head_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/head_small_image_view"
                android:background="@color/emui_control_normal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop" />
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/appgallery_hwtoolbar_height">
                <RelativeLayout
                    android:gravity="center"
                    android:id="@id/close_icon"
                    android:background="@drawable/hwappbarpattern_selector_item_bg"
                    android:visibility="visible"
                    android:layout_width="@dimen/hwappbarpattern_icon_size"
                    android:layout_height="@dimen/hwappbarpattern_icon_size"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/click_back"
                    android:layout_marginStart="@dimen/margin_s"
                    android:layout_marginEnd="@dimen/margin_s"
                    android:layout_alignParentStart="true">
                    <ImageView
                        android:id="@id/close_imageview"
                        android:layout_width="@dimen/search_icon_landscape_width"
                        android:layout_height="@dimen/search_icon_landscape_width"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@id/search_icon"
                    android:background="@drawable/hwappbarpattern_selector_item_bg"
                    android:visibility="visible"
                    android:layout_width="@dimen/hwappbarpattern_icon_size"
                    android:layout_height="@dimen/hwappbarpattern_icon_size"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_s"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:id="@id/search_imageview"
                        android:layout_width="@dimen/search_icon_landscape_width"
                        android:layout_height="@dimen/search_icon_landscape_width"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/detail_body_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/corner"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/detail_card_safe_bar_height" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/detail_head_linearlayout"
                android:background="@color/appgallery_color_sub_background"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1.0dip"
                android:layout_marginStart="@dimen/ui_10_dp"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end">
                <FrameLayout
                    android:layout_width="92.0dip"
                    android:layout_height="96.0dip"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_s"
                    android:layout_marginEnd="@dimen/ui_10_dp">
                    <RelativeLayout
                        android:layout_width="80.0dip"
                        android:layout_height="80.0dip"
                        android:layout_marginStart="@dimen/cs_6_dp">
                        <ImageView
                            android:id="@id/detail_head_app_icon_imageview"
                            android:focusable="false"
                            android:layout_width="80.0dip"
                            android:layout_height="80.0dip"
                            android:src="@drawable/icon_default_bg"
                            android:scaleType="fitCenter" />
                    </RelativeLayout>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_s">
                    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/detail_app_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m">
                        <TextView
                            android:id="@id/detail_head_app_name_textview"
                            android:tag="css/.title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            style="@style/AppGallery.TextAppearance.Card.SubTitle1" />
                    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/detail_loadingbar_layout"
            android:tag="css/.body"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.uikit.hwprogressbar.widget.HwProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@id/detail_loadingbar"
                    android:layout_width="@dimen/loading_large"
                    android:layout_height="@dimen/loading_large"
                    style="@style/Widget.Emui.HwProgressBar.Large" />
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@id/detail_loadingTip"
                    android:tag="css/.subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_loading_prompt"
                    style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>