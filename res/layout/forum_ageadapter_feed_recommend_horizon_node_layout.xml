<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/hori_parent"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ViewStub
        android:id="@id/forum_feed_recommend_empty_viewstub"
        android:layout="@layout/forum_feed_recommend_empty_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/appList_ItemTitle_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/AppGallery.Widget.SubHeader.ViewGroup">
        <LinearLayout
            android:layout_gravity="start|center"
            android:focusable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="start|center"
                android:id="@id/ItemTitle"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_for_layout"
                android:maxLines="2"
                style="@style/AppGallery.Widget.SubHeader.Title" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/more_layout"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:contentDescription="@string/card_more_btn"
            android:importantForAccessibility="yes">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/more_btn"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/card_more_btn"
                android:layout_weight="1.0"
                android:lineSpacingMultiplier="1.1"
                style="@style/AppGallery.Widget.SubHeader.More" />
            <ImageView
                android:layout_gravity="end|center"
                android:id="@id/btn_more_image"
                android:tag="css/.arrow"
                android:background="@drawable/ic_public_arrow_right_900"
                android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
                android:layout_height="@dimen/appgallery_list_item_right_arrow_height" />
        </LinearLayout>
    </LinearLayout>
    <com.huawei.appgallery.horizontalcard.api.view.BounceHorizontalRecyclerView
        android:id="@id/AppListItem"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_m"
        android:paddingEnd="@dimen/margin_m"
        app:bounceEnable="true" />
</LinearLayout>