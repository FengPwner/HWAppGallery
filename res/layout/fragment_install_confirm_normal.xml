<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@color/appgallery_color_sub_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/content_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <include
            layout="@layout/installer_back_and_search_layout" />
        <FrameLayout
            android:id="@id/hiappbase_container"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <FrameLayout
                android:id="@id/hiappbase_data_layout_id"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@id/install_button_group"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <include
        layout="@layout/installer_recommend_app_menu_layout" />
</FrameLayout>