<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/item_title_layout"
        layout="@layout/hiappbase_layout_subheader_title_action" />
    <TextView
        android:id="@id/detail_desc_sub_content_textview"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/detail_card_introduce_content" />
    <ImageView
        android:tag="css/.split-line"
        android:layout_width="fill_parent"
        android:layout_marginTop="@dimen/margin_l"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>