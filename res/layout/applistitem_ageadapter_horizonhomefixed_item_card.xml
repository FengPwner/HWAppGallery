<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:id="@id/icon"
        android:layout_width="80.0dip"
        android:layout_height="80.0dip"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:corner_type="appicon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_type="all" />
    <ViewStub
        android:id="@id/fastappicon"
        android:layout="@layout/wisedist_fastappicon_layout"
        android:layout_width="@dimen/hiappbase_card_fasticon_size_xxl"
        android:layout_height="@dimen/hiappbase_card_fasticon_size_xxl"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/icon"
        app:layout_constraintEnd_toEndOf="@id/icon" />
    <TextView
        android:textSize="13.0sp"
        android:ellipsize="end"
        android:id="@id/title"
        android:tag="css/.title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/margin_l"
        app:layout_constraintBottom_toBottomOf="@id/icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="@id/icon"
        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Primary.Regular" />
    <com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout
        android:orientation="horizontal"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/title">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="10.0sp"
            android:textColor="@color/appgallery_text_color_secondary"
            android:ellipsize="end"
            android:id="@id/text"
            android:tag="css/.subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:maxLines="1"
            android:fontFamily="@string/appgallery_text_font_family_regular" />
        <ImageView
            android:layout_gravity="center"
            android:id="@id/score_star"
            android:tag="css/.widget"
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:src="@drawable/ic_score"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/appgallery_text_margin_vertical" />
    </com.huawei.appmarket.service.appdetail.view.widget.FixedRightLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>