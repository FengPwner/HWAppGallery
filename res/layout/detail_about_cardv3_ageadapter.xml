<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ll_jumpInfo"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        style="@style/AppGallery.Widget.SubHeader.ViewGroup">
        <LinearLayout
            android:layout_gravity="start|center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2.0"
            android:layout_marginEnd="@dimen/margin_l">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="start|center"
                android:id="@id/hiappbase_subheader_title_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppGallery.Widget.SubHeader.Title" />
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center"
            android:id="@id/hiappbase_subheader_more_layout"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_m">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/hiappbase_subheader_more_txt"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.1"
                android:importantForAccessibility="yes"
                style="@style/AppGallery.Widget.SubHeader.More" />
            <ImageView
                android:id="@id/hiappbase_subheader_more_arrow"
                android:background="@drawable/ic_public_arrow_right_900"
                android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
                android:layout_height="@dimen/appgallery_list_item_right_arrow_height" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="8.0dip"
        android:layout_marginStart="16.0dip"
        android:layout_marginEnd="16.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_version"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/tv_version_description"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_current_version"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/tv_version_code"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:layout_marginBottom="6.0dip"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_develop_description"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/tv_develop_description"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_developer"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/tv_develop_name"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:layout_marginBottom="6.0dip"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_privacy_description"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/tv_privacy_description"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_detail_privacy_policy"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:id="@id/tv_privacy_jump"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:layout_marginBottom="6.0dip"
                android:minHeight="@dimen/hwappbarpattern_menuitem_padding"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip"
                style="@style/Widget.Emui.HwButton.Borderless.Small" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_permission_description"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:id="@id/tv_permission_description"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_detail_permissions"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_primary_activated"
                android:id="@id/tv_permission_jump"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:minHeight="@dimen/hwappbarpattern_menuitem_padding"
                android:importantForAccessibility="yes"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:paddingStart="4.0dip"
                android:paddingEnd="4.0dip"
                style="@style/Widget.Emui.HwButton.Borderless.Small" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>