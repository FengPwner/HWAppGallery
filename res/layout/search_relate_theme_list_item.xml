<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/AppListItem"
    android:background="@drawable/aguikit_round_rectangle_card_bg"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:id="@id/icon_layout"
        android:layout_width="96.0dip"
        android:layout_height="120.0dip"
        android:layout_marginTop="12.0dip"
        android:layout_marginBottom="12.0dip"
        app:round_corner="@dimen/appgallery_default_corner_radius_m">
        <ImageView
            android:id="@id/icon"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true" />
        <ImageView
            android:id="@id/typeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/emui_dimens_element_horizontal_middle"
            android:scaleType="centerCrop"
            android:layout_centerVertical="false"
            android:layout_marginStart="@dimen/emui_dimens_element_horizontal_middle" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/right_content"
        android:layout_width="fill_parent"
        android:layout_height="120.0dip"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
        android:layout_toEndOf="@id/icon_layout">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:id="@id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
        <com.huawei.appgallery.search.ui.view.TagTextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/item_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/emui_dimens_element_vertical_middle"
            android:maxLines="3"
            android:textDirection="locale"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
    <ImageView
        android:id="@id/item_divider_line"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_below="@id/icon_layout"
        android:layout_alignStart="@id/right_content"
        style="@style/AppGallery.Widget.Divider" />
    <View
        android:id="@id/bottom_blank_view"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_elements_margin_vertical_m"
        android:layout_below="@id/icon_layout" />
</RelativeLayout>