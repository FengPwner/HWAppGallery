<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.forum.message.widget.CommentReferenceUserView
            android:id="@id/like_card_user_view"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:paddingEnd="@dimen/padding_l"
            app:messageIconSize="40" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/like_card_main_content_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="72.0dip"
            android:paddingEnd="@dimen/padding_l">
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_text_color_secondary"
                android:gravity="center_vertical"
                android:id="@id/like_card_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_m"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
            <com.huawei.appgallery.forum.message.widget.CommentReferenceView
                android:id="@id/like_card_comment_reference_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_elements_margin_vertical_l" />
            <View
                android:id="@id/devider_line_bottom"
                android:layout_width="fill_parent"
                style="@style/AppGallery.Widget.Divider" />
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@id/bottom_forum_remind_new_card"
        layout="@layout/forum_remind_new_card" />
</LinearLayout>