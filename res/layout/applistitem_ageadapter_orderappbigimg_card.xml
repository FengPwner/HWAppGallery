<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huawei.appmarket.framework.widget.RoundCornerLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:round_corner_top_left="@dimen/appgallery_default_corner_radius_l"
            app:round_corner_top_right="@dimen/appgallery_default_corner_radius_l"
            app:stroke_width="0.0dip">
            <com.huawei.appmarket.service.store.awk.widget.horizon.HorizonBigVideoPlayer
                android:id="@id/app_big_img"
                android:tag="@string/properties_video_contentDescription"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                app:media_type="0"
                app:view_type="0" />
        </com.huawei.appmarket.framework.widget.RoundCornerLayout>
        <RelativeLayout
            android:id="@id/bottom_layout"
            android:background="@drawable/aguikit_card_panel_bg_bottom_corner"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_default_card_space_vertical_l"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="64.0dip"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                android:id="@id/smallicon"
                android:clickable="false"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:scaleType="centerCrop"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                app:corner_type="appicon"
                app:round_type="all" />
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/downbtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_default_card_space_vertical"
                android:minHeight="28.0dip"
                android:layout_below="@id/content_ll"
                android:layout_alignParentStart="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/content_ll"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_protect_margin_vertical"
                android:layout_below="@id/smallicon"
                android:layout_alignParentStart="true">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/appname"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.appmarket.framework.widget.PromotionSignTextView
                        android:layout_gravity="center_vertical"
                        android:id="@id/promotion_sign"
                        android:tag="css/.title"
                        android:background="@drawable/promotion_sign_bg_normal"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
                        android:minHeight="14.0dip"
                        style="@style/promotion_sign_ageadapter_style" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                        <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                            android:layout_gravity="center_vertical"
                            android:id="@id/non_adapter_icon"
                            android:tag="css/.title"
                            android:visibility="gone"
                            android:layout_width="@dimen/ui_10_dp"
                            android:layout_height="@dimen/ui_10_dp"
                            android:scaleType="centerInside"
                            android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s" />
                        <TextView
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@id/ItemText"
                            android:tag="css/.subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@id/welfare_layout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="8.0sp"
                    android:textColor="@color/emui_color_9"
                    android:gravity="center"
                    android:id="@id/welfare_label"
                    android:background="@drawable/welfare_label_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="14.0dip"
                    android:text="@string/welfare_label"
                    android:maxLines="1"
                    android:paddingStart="8.0dip"
                    android:paddingEnd="8.0dip" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/welfare_icon1"
                        android:visibility="gone"
                        android:layout_width="12.0dip"
                        android:layout_height="12.0dip"
                        android:layout_marginEnd="@dimen/margin_s"
                        app:corner_radius="2.0dip" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:layout_gravity="center_vertical"
                        android:id="@id/welfare_text1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_toEndOf="@id/welfare_icon1"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                        android:layout_gravity="center_vertical"
                        android:id="@id/welfare_icon2"
                        android:layout_width="12.0dip"
                        android:layout_height="12.0dip"
                        android:layout_marginEnd="@dimen/margin_s"
                        app:corner_radius="2.0dip" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body3"
                        android:layout_gravity="center_vertical"
                        android:id="@id/welfare_text2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Fixed.Secondary" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>