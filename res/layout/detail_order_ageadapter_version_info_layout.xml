<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/detail_order_ll"
    android:paddingTop="@dimen/appgallery_card_elements_margin_l"
    android:paddingBottom="@dimen/appgallery_card_elements_margin_l"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:importantForAccessibility="no"
    android:paddingStart="@dimen/appgallery_card_elements_margin_l"
    android:paddingEnd="@dimen/appgallery_card_elements_margin_l"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:layout_gravity="start|bottom|center"
            android:id="@id/detail_order_version_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/component_detail_new_version"
            android:textAlignment="viewStart"
            style="@style/AppGallery.Widget.SubHeader.Title" />
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:layout_gravity="start|bottom|center"
            android:id="@id/detail_order_version_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:text="@string/component_detail_no_version_provided"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
    <View
        android:id="@id/order_divider_version"
        android:layout_width="fill_parent"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_l"
        style="@style/AppGallery.Widget.Divider" />
    <RelativeLayout
        android:id="@id/detail_order_permission_rl"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/item_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24.0sp"
                android:gravity="start|center"
                android:id="@id/detail_order_permission_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/component_detail_permissions"
                android:layout_weight="1.0"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="viewStart"
                style="@style/AppGallery.Widget.SubHeader.Title" />
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/detail_order_permission_arrow"
                android:background="@drawable/ic_public_arrow_right_900"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.List.RightArrow" />
        </LinearLayout>
        <TextView
            android:gravity="start|center"
            android:id="@id/detail_order_permission_disc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:layout_below="@id/item_layout"
            android:textAlignment="viewStart"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </RelativeLayout>
    <View
        android:id="@id/order_divider_permission"
        android:layout_width="fill_parent"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_l"
        android:layout_marginBottom="@dimen/appgallery_card_elements_margin_l"
        style="@style/AppGallery.Widget.Divider" />
    <LinearLayout
        android:id="@id/detail_order_privacy_ll"
        android:focusable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes">
        <LinearLayout
            android:layout_gravity="start|center"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:layout_gravity="start|center"
                android:id="@id/detail_order_privacy_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/component_detail_privacy_policy"
                android:maxLines="2"
                android:textAlignment="viewStart"
                style="@style/AppGallery.Widget.SubHeader.Title" />
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_m">
            <ImageView
                android:id="@id/detail_order_privacy_arrow"
                android:background="@drawable/ic_public_arrow_right_900"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>