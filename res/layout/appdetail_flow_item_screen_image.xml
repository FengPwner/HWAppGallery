<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/appdetail_screen_cardview"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.appgallery.videokit.api.WiseVideoView
            android:id="@id/appdetail_screen_video"
            android:tag="@string/properties_video_contentDescription"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            app:media_type="0"
            app:view_type="0" />
        <com.huawei.appgallery.detail.detailbase.view.FadeImageView
            android:id="@id/detail_screen_image"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/full_screen_rotation"
        android:background="@drawable/bg_full_screen_rotation"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:minHeight="28.0dip"
        android:layoutDirection="locale"
        android:layout_marginStart="12.0dip"
        android:layout_marginEnd="12.0dip">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/full_screen_rotation_icon"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/detail_full_screen_rotation"
            android:importantForAccessibility="no"
            android:layout_marginStart="8.0dip"
            app:tint="@color/emui_color_primary" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body3"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/full_screen_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_full_screen"
            android:singleLine="true"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="8.0dip" />
    </LinearLayout>
</LinearLayout>