<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/horizonitemcontainer"
    android:layout_width="@dimen/wisedist_search_horizontal_card_item_width"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
        android:id="@id/appicon"
        android:layout_width="@dimen/wisedist_card_icon_size_small"
        android:layout_height="@dimen/wisedist_card_icon_size_small"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:corner_type="appicon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:round_type="all" />
    <ViewStub
        android:id="@id/fastappicon"
        android:layout="@layout/wisedist_fastappicon_layout"
        android:layout_width="@dimen/hiappbase_card_fasticon_size_large"
        android:layout_height="@dimen/hiappbase_card_fasticon_size_large"
        app:layout_constraintBottom_toBottomOf="@id/appicon"
        app:layout_constraintEnd_toEndOf="@id/appicon" />
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@id/ItemTitle"
        android:tag="css/.title"
        android:layout_width="@dimen/wisedist_search_horizontal_card_item_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/wisedist_search_horizontal_card_item_margin_top"
        android:textAlignment="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appicon"
        style="@style/AppGallery.TextAppearance.HorizontalCard.Item.Title" />
    <ViewStub
        android:id="@id/ItemTextViewStub"
        android:layout="@layout/wisedist_tag_render_textview"
        android:layout_width="@dimen/wisedist_search_horizontal_card_item_width"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ItemTitle" />
    <com.huawei.appgallery.search.api.view.AutoSearchDownloadButton
        android:id="@id/downbtn"
        android:tag="css/.download-button"
        android:layout_width="@dimen/wisedist_card_icon_size_middle"
        android:layout_height="28.0dip"
        android:layout_marginTop="@dimen/wisedist_search_horizontal_card_item_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/AppGallery.Widget.DownloadButton.Normal" />
</androidx.constraintlayout.widget.ConstraintLayout>