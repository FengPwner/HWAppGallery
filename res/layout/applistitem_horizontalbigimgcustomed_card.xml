<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/big_content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/bottom_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="64.0dip"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
            android:id="@id/smallicon"
            android:clickable="false"
            android:layout_width="@dimen/appgallery_card_icon_size_small"
            android:layout_height="@dimen/appgallery_card_icon_size_small"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:corner_type="appicon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:round_type="all" />
        <com.huawei.appgallery.pageframe.view.DownloadButtonV2
            android:id="@id/downbtn"
            android:tag="css/.download-button"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/infoflow_download_btn_height"
            android:minWidth="@dimen/infoflow_download_btn_width"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AppGallery.Widget.DownloadButton.Normal" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/appname"
            android:tag="css/.title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
            app:layout_constraintBottom_toTopOf="@id/fixed_linearlayout"
            app:layout_constraintEnd_toStartOf="@id/downbtn"
            app:layout_constraintStart_toEndOf="@id/smallicon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/AppGallery.TextAppearance.Card.TextBody1" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/fixed_linearlayout"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/appname"
            app:layout_constraintStart_toEndOf="@id/smallicon"
            app:layout_constraintTop_toBottomOf="@id/appname">
            <com.huawei.appmarket.framework.widget.PromotionSignTextView
                android:layout_gravity="center_vertical"
                android:id="@id/promotion_sign"
                android:tag="css/.title"
                android:background="@drawable/promotion_sign_bg_normal"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                style="@style/promotion_sign_style" />
            <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                android:layout_gravity="center_vertical"
                android:id="@id/non_adapter_icon"
                android:tag="css/.title"
                android:visibility="gone"
                android:layout_width="10.0dip"
                android:layout_height="10.0dip"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/ItemText"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>