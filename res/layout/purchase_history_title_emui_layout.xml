<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/appgallery_color_appbar_bg"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/appgallery_hwtoolbar_height"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center"
            android:id="@id/wisedist_arrow_layout"
            android:background="@drawable/hwappbarpattern_selector_item_bg"
            android:layout_width="@dimen/hwappbarpattern_icon_size"
            android:layout_height="@dimen/appgallery_hwtoolbar_height"
            android:contentDescription="@string/click_back"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="4.0dip">
            <ImageView
                android:id="@id/up"
                android:layout_width="@dimen/ui_24_dp"
                android:layout_height="@dimen/ui_24_dp"
                android:src="@drawable/aguikit_ic_public_back" />
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center"
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:id="@id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:paddingEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.Widget.Toolbar.Title" />
        </LinearLayout>
        <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
            android:gravity="end|center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent">
            <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/righticon_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent">
                <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                    android:gravity="center"
                    android:id="@id/btn_delete"
                    android:background="@drawable/hwappbarpattern_selector_item_bg"
                    android:layout_width="@dimen/hwappbarpattern_icon_size"
                    android:layout_height="@dimen/hwappbarpattern_icon_size"
                    app:popupTitle="@string/purchasehistory_button_batch_delete">
                    <ImageView
                        android:layout_width="@dimen/ui_24_dp"
                        android:layout_height="@dimen/ui_24_dp"
                        android:src="@drawable/aguikit_ic_public_delete" />
                </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
                <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                    android:gravity="center"
                    android:id="@id/btn_install"
                    android:background="@drawable/hwappbarpattern_selector_item_bg"
                    android:layout_width="@dimen/hwappbarpattern_icon_size"
                    android:layout_height="@dimen/hwappbarpattern_icon_size"
                    app:popupTitle="@string/purchasehistory_button_batch_install">
                    <ImageView
                        android:layout_width="@dimen/ui_24_dp"
                        android:layout_height="@dimen/ui_24_dp"
                        android:src="@drawable/aguikit_ic_install"
                        android:layout_marginStart="@dimen/margin_l"
                        android:layout_marginEnd="@dimen/margin_l" />
                </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
                <com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem
                    android:gravity="center"
                    android:id="@id/btn_share"
                    android:background="@drawable/hwappbarpattern_selector_item_bg"
                    android:layout_width="@dimen/hwappbarpattern_icon_size"
                    android:layout_height="@dimen/hwappbarpattern_icon_size"
                    app:popupTitle="@string/purchase_button_batch_family_share">
                    <ImageView
                        android:layout_width="@dimen/ui_24_dp"
                        android:layout_height="@dimen/ui_24_dp"
                        android:src="@drawable/aguikit_ic_public_family_share"
                        android:layout_marginStart="@dimen/margin_l"
                        android:layout_marginEnd="@dimen/margin_l" />
                </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryAppbarMenuItem>
            </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
            <View
                android:layout_width="@dimen/margin_s"
                android:layout_height="@dimen/appgallery_hwtoolbar_height" />
        </com.huawei.appgallery.aguikit.widget.toolbar.AppGalleryToolbarLayout>
    </LinearLayout>
</LinearLayout>