<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@color/faq_sdk_white_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.phoneservice.faq.widget.FaqInScrollView
        android:id="@id/faq_container"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <WebView
                android:id="@id/faq_webView"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end" />
            <View
                android:background="@color/faq_sdk_list_item_selector_color"
                android:layout_width="fill_parent"
                android:layout_height="8.0dip" />
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/faq_question_detail_evaluate_host"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end">
                <TextView
                    android:textSize="@dimen/emui_text_size_body1"
                    android:textColor="@color/emui_color_primary"
                    android:id="@id/textView_tech_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/faq_sdk_ui_32_dip"
                    android:text="@string/faq_sdk_problem_solve_text" />
                <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                    android:paddingBottom="@dimen/faq_sdk_ui_32_dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2.0"
                    app:hwColumnType="button_type">
                    <Button
                        android:id="@id/faq_question_detail_unresolved"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/faq_sdk_ui_16_dip"
                        android:text="@string/faq_sdk_common_no"
                        android:layout_weight="1.0"
                        style="@style/Widget.Emui.HwButton" />
                    <View
                        android:id="@id/faq_sdk_category_gap"
                        android:layout_width="@dimen/faq_sdk_ui_12_dip"
                        android:layout_height="0.0dip" />
                    <Button
                        android:id="@id/faq_question_detail_resolved"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/faq_sdk_ui_16_dip"
                        android:text="@string/faq_sdk_common_yes"
                        android:layout_weight="1.0"
                        style="@style/Widget.Emui.HwButton" />
                </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/faq_question_detail_evaluate_list_host"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end">
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="@color/faq_sdk_section_sub_title_text_color_normal"
                    android:gravity="bottom"
                    android:id="@id/faq_question_detail_evaluate_list_title"
                    android:paddingBottom="@dimen/faq_sdk_ui_8_dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/faq_sdk_ui_48_dip"
                    android:text="@string/faq_sdk_helpless_reason"
                    android:fontFamily="HwChinese-medium" />
                <com.huawei.phoneservice.faq.widget.FaqInScrollListView
                    android:id="@id/faq_question_detail_evaluate_list"
                    android:scrollbars="none"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="@android:color/transparent"
                    android:divider="@null" />
                <RelativeLayout
                    android:background="@drawable/faq_sdk_rectangle_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/faq_sdk_ui_8_dip">
                    <EditText
                        android:textSize="@dimen/faq_sdk_ui_sp_15"
                        android:textColor="@color/faq_sdk_edit_text_normal_black"
                        android:textColorHint="@color/faq_sdk_edit_text_hint"
                        android:gravity="start|center|top"
                        android:id="@id/faq_question_detail_evaluate_content"
                        android:background="@null"
                        android:scrollbars="none"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/faq_sdk_ui_108_dp"
                        android:layout_marginTop="@dimen/margin_m"
                        android:hint="@string/faq_sdk_tell_me_tip"
                        android:singleLine="false"
                        android:maxLength="500"
                        android:inputType="textMultiLine"
                        android:overScrollMode="always"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="@dimen/margin_l"
                        android:layout_marginEnd="@dimen/margin_l" />
                    <TextView
                        android:textSize="@dimen/faq_sdk_notice_view_text_size"
                        android:textColor="@color/faq_sdk_list_item_hint_text_color_normal"
                        android:id="@id/faq_question_detail_evaluate_content_count"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_m"
                        android:layout_below="@id/faq_question_detail_evaluate_content"
                        android:layout_marginEnd="@dimen/margin_l"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <Button
                    android:enabled="false"
                    android:layout_gravity="center_horizontal"
                    android:id="@id/faq_question_detail_evaluate_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/faq_sdk_ui_24_dip"
                    android:layout_marginBottom="@dimen/faq_sdk_ui_24_dip"
                    android:text="@string/faq_sdk_submit"
                    style="@style/Widget.Emui.HwButton.Emphasize" />
            </LinearLayout>
            <RelativeLayout
                android:id="@id/thanks_container"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="124.0dip"
                android:layout_marginStart="@dimen/emui_dimens_max_start"
                android:layout_marginEnd="@dimen/emui_dimens_max_end">
                <TextView
                    android:textSize="@dimen/emui_text_size_subtitle2"
                    android:textColor="@color/faq_emui_accent"
                    android:gravity="center_horizontal"
                    android:id="@id/thanks_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_sdk_thank_you_feedback"
                    android:drawableBottom="@drawable/faq_sdk_thanks_feedback"
                    android:drawablePadding="@dimen/faq_sdk_ui_16_dip"
                    android:layout_centerInParent="true" />
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/faq_question_detail_online_host"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/emui_text_size_subtitle2"
                    android:textColor="@color/faq_emui_accent"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/faq_sdk_ui_16_dip"
                    android:text="@string/faq_sdk_thank_you_feedback" />
                <TextView
                    android:textSize="@dimen/faq_sdk_ui_sp_14"
                    android:textColor="@color/emui_color_secondary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/faq_sdk_ui_8_dip"
                    android:text="@string/faq_sdk_online_introduce"
                    android:layout_marginStart="@dimen/emui_dimens_max_start"
                    android:layout_marginEnd="@dimen/emui_dimens_max_start" />
                <Button
                    android:id="@id/faq_question_detail_online"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/faq_sdk_ui_24_dip"
                    android:layout_marginBottom="@dimen/faq_sdk_ui_16_dip"
                    android:text="@string/faq_sdk_menu_online_service"
                    style="@style/Widget.Emui.HwButton" />
            </LinearLayout>
            <View
                android:background="@color/faq_sdk_list_item_selector_color"
                android:layout_width="fill_parent"
                android:layout_height="8.0dip" />
            <TextView
                android:textSize="@dimen/faq_sdk_ui_sp_14"
                android:textColor="@color/faq_sdk_section_sub_title_text_color_normal"
                android:gravity="bottom"
                android:id="@id/recommend_section"
                android:paddingBottom="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/emui_text_size_headline4"
                android:text="@string/faq_sdk_related_faqs"
                android:fontFamily="@string/emui_text_font_family_medium"
                android:paddingStart="@dimen/emui_dimens_max_start"
                android:paddingEnd="@dimen/emui_dimens_max_end" />
            <com.huawei.phoneservice.faq.widget.FaqAutoConfigLinearLayout
                android:id="@id/recommend_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.huawei.phoneservice.faq.widget.FaqInScrollView>
    <ProgressBar
        android:layout_gravity="bottom|center"
        android:id="@id/faq_question_detail_progress"
        android:visibility="gone"
        android:layout_width="@dimen/faq_sdk_ui_24_dip"
        android:layout_height="@dimen/faq_sdk_ui_24_dip"
        android:layout_marginBottom="@dimen/faq_sdk_ui_24_dip"
        style="?android:progressBarStyle" />
    <com.huawei.phoneservice.faq.widget.FaqNoticeView
        android:id="@id/notice_view"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:faqsdkNoticeViewType="faqsdkprogress"
        app:faqsdknoticeAutoFitCenterYInLandScape="true" />
</FrameLayout>