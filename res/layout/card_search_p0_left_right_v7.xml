<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/appinfo_layout_outer"
    android:background="@drawable/list_item_all_selector"
    android:paddingTop="@dimen/appgallery_safety_margin_s"
    android:paddingBottom="@dimen/appgallery_safety_margin_s"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/appinfo_layout_origin"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/appinfo_layout_inner_origin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@id/appicon_origin"
                android:layout_width="@dimen/appgallery_card_icon_size_large"
                android:layout_height="@dimen/appgallery_card_icon_size_large"
                android:src="@color/transparent"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/downbtn_origin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Search.Widget.P0cardV1.DownloadBtn" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:gravity="start|center"
                android:id="@id/titleName_origin"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                app:layout_constraintBottom_toTopOf="@id/memo_origin"
                app:layout_constraintEnd_toStartOf="@id/downbtn_origin"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/appicon_origin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_goneMarginEnd="0.0dip"
                style="@style/AppGallery.TextAppearance.Card.TextBody1" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/second_line_container_origin"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                app:layout_constraintBottom_toTopOf="@id/down_info_origin"
                app:layout_constraintEnd_toStartOf="@id/downbtn_origin"
                app:layout_constraintStart_toEndOf="@id/appicon_origin"
                app:layout_constraintTop_toBottomOf="@id/titleName_origin">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:id="@id/second_ad_text_origin"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ui_8_dp"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/memo_origin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                <com.huawei.appmarket.service.appdetail.view.widget.DynamicLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/dynamic_second_container_origin"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/third_line_container_origin"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/downbtn_origin"
                app:layout_constraintStart_toEndOf="@id/appicon_origin"
                app:layout_constraintTop_toBottomOf="@id/second_line_container_origin">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/old_third_line_origin"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/adFlag_origin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="0.0dip"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:gravity="start|center"
                        android:id="@id/down_info_origin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                </LinearLayout>
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:id="@id/third_ad_text_origin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginEnd="@dimen/ui_8_dp"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/third_memo_origin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    app:layout_goneMarginEnd="0.0dip"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                <com.huawei.appmarket.service.appdetail.view.widget.DynamicLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/dynamic_third_container_origin"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/appinfo_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end"
        xmlns:android="http://schemas.android.com/apk/res/android">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/appinfo_layout_inner"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            xmlns:android="http://schemas.android.com/apk/res/android">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@id/appicon"
                    android:layout_width="@dimen/appgallery_card_icon_size_large"
                    android:layout_height="@dimen/appgallery_card_icon_size_large"
                    android:src="@color/transparent"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/titleName"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@id/appicon"
                    app:layout_constraintTop_toBottomOf="@id/appicon"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1" />
                <LinearLayout
                    android:id="@id/second_container"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/titleName"
                    app:layout_constraintTop_toBottomOf="@id/titleName">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/second_ad_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/ui_8_dp"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:gravity="start|center"
                        android:id="@id/memo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textAlignment="viewStart"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    <com.huawei.appmarket.service.appdetail.view.widget.DynamicLinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/dynamic_second_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/third_container"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/titleName"
                    app:layout_constraintTop_toBottomOf="@id/second_container">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/old_third_line"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:id="@id/adFlag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="0.0dip"
                            android:layout_marginEnd="@dimen/ui_8_dp"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:ellipsize="end"
                            android:gravity="start|center"
                            android:id="@id/down_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textAlignment="viewStart"
                            android:layout_marginStart="@dimen/appgallery_card_elements_margin_s"
                            app:layout_goneMarginStart="0.0dip"
                            app:layout_goneMarginTop="@dimen/appgallery_card_elements_margin_xs"
                            style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    </LinearLayout>
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/third_ad_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_marginEnd="@dimen/ui_8_dp"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:gravity="start|center"
                        android:id="@id/third_memo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textAlignment="viewStart"
                        app:layout_goneMarginEnd="0.0dip"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Tertiary" />
                    <com.huawei.appmarket.service.appdetail.view.widget.DynamicLinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/dynamic_third_container"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                    android:id="@id/downbtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                    android:minHeight="28.0dip"
                    app:layout_constraintStart_toStartOf="@id/titleName"
                    app:layout_constraintTop_toBottomOf="@id/third_container"
                    style="@style/Search.Widget.P0cardV1.DownloadBtn" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <View
            android:id="@id/p0_searchbigcard_split_line"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.Widget.Divider" />
        <TextView
            android:ellipsize="end"
            android:gravity="start|center"
            android:id="@id/p0_searchbigcard_description"
            android:paddingTop="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
    </LinearLayout>
</RelativeLayout>