<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/aguikit_card_panel_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/top_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                android:id="@id/appicon_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
                app:touch_drawable="@drawable/wisedist_appscreentshot_left_line_image_selector" />
            <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                android:id="@id/appicon_middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_vertical"
                app:touch_drawable="@drawable/wisedist_appscreentshot_middle_line_image_selector" />
            <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                android:id="@id/appicon_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                app:touch_drawable="@drawable/wisedist_appscreentshot_right_line_image_selector" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/bottom_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="64.0dip"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
                android:id="@id/app_icon_imageview"
                android:clickable="false"
                android:layout_width="@dimen/appgallery_card_icon_size_small"
                android:layout_height="@dimen/appgallery_card_icon_size_small"
                android:scaleType="centerCrop"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                app:corner_radius="@dimen/appgallery_default_corner_radius_s" />
            <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
                android:id="@id/download_button"
                android:layout_width="wrap_content"
                android:layout_height="28.0dip"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/AppGallery.Widget.DownloadButton.Normal" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/wisedist_horizontal_big_card_icon_layout_margin_end"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_l"
                android:layout_toStartOf="@id/download_button"
                android:layout_toEndOf="@id/app_icon_imageview">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@id/ItemTitle"
                    android:tag="css/.title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appgallery_text_margin_vertical">
                    <com.huawei.appmarket.framework.widget.PromotionSignTextView
                        android:layout_gravity="center_vertical"
                        android:id="@id/promotion_sign"
                        android:tag="css/.title"
                        android:background="@drawable/promotion_sign_bg"
                        android:layout_marginEnd="@dimen/appgallery_elements_margin_horizontal_m"
                        style="@style/promotion_sign_style" />
                    <com.huawei.appmarket.framework.widget.NoAdaptRenderImageView
                        android:id="@id/nonadapt_imageview"
                        android:tag="css/.title"
                        android:visibility="gone"
                        android:layout_width="@dimen/ui_10_dp"
                        android:layout_height="@dimen/ui_10_dp"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="@dimen/appgallery_card_elements_margin_s" />
                    <TextView
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@id/ItemText"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>