<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/all_task_text_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body3_fixed"
            android:id="@id/all_task_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welfare_center_all_tasks"
            style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        <ImageView
            android:id="@id/arrow_view"
            android:background="@drawable/aguikit_ic_public_arrow_down"
            android:layout_width="16.0dip"
            android:layout_height="8.0dip" />
    </LinearLayout>
</LinearLayout>