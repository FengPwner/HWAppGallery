<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/padding_l"
    android:paddingEnd="@dimen/padding_l"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/newsinfo_icon"
        android:layout_width="@dimen/buoy_campain_img_width"
        android:layout_height="@dimen/buoy_campain_img_height"
        android:layout_marginTop="@dimen/margin_m"
        android:layout_marginBottom="@dimen/margin_m"
        android:src="@drawable/bg_perch_square"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true" />
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_6_dp"
        android:layout_marginBottom="@dimen/ui_6_dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_toEndOf="@id/newsinfo_icon">
        <TextView
            android:textSize="@dimen/emui_master_subtitle"
            android:textColor="@color/xh_item_ff000000"
            android:ellipsize="end"
            android:id="@id/title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/title">
            <TextView
                android:textSize="@dimen/emui_master_body_2"
                android:textColor="@color/xh_item_7f000000"
                android:ellipsize="end"
                android:id="@id/newsinfo_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart" />
            <TextView
                android:textSize="@dimen/emui_master_body_2"
                android:textColor="@color/xh_item_7f000000"
                android:ellipsize="end"
                android:id="@id/newsinfo_issued_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginStart="@dimen/margin_m" />
        </LinearLayout>
    </RelativeLayout>
    <View
        android:layout_gravity="center_vertical"
        android:id="@id/bootom_line"
        android:background="@color/divider_horizontal_color_emui"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/divider_horizontal_height_emui"
        android:layout_alignParentBottom="true" />
</RelativeLayout>