<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:id="@id/maskingLayerView"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    app:clip_background="true"
    app:round_corner_top_left="@dimen/appgallery_default_corner_radius_l"
    app:round_corner_top_right="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/rl_downbtn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:layout_marginStart="4.0dip">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@id/app_icon"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/transparent"
                android:scaleType="centerCrop" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:maxWidth="75.0dip"
                android:maxLines="@integer/hwbutton_single_line"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.HorizontalCard.Item.Title" />
        </LinearLayout>
        <com.huawei.appgallery.foundation.ui.framework.widget.button.DownloadButton
            android:layout_gravity="center_horizontal"
            android:id="@id/down_btn"
            android:layout_width="56.0dip"
            android:layout_height="28.0dip"
            android:layout_marginTop="28.0dip"
            android:layout_marginEnd="12.0dip"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.TextAppearance.Paragraph.TextBody3.Primary" />
    </RelativeLayout>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>