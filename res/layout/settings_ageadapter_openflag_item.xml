<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/pushsms_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    style="@style/AppGallery.Widget.List.TwoTextLines"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/setTextContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start|center"
                android:id="@id/setItemTitle"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="viewStart"
                style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
            <com.huawei.uikit.phone.hwswitch.widget.HwSwitch
                android:id="@id/switchBtn"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10.0dip"
                android:layout_alignParentEnd="true"
                style="@style/Widget.Emui.HwSwitch" />
        </LinearLayout>
        <TextView
            android:gravity="start|center"
            android:id="@id/setItemContent"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_text_margin_vertical"
            android:textAlignment="viewStart"
            android:paddingEnd="6.0dip"
            style="@style/AppGallery.TextAppearance.List.TextBody2.Secondary" />
    </LinearLayout>
</RelativeLayout>