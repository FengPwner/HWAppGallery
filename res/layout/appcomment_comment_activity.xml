<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.appcomment.ui.view.AddCommentTitle
        android:id="@id/add_comment_title"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/appgallery_hwtoolbar_height" />
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/comment_app_info_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@id/comment_app_info_container"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xl">
                        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                            android:layout_gravity="center"
                            android:id="@id/comment_app_icon"
                            android:layout_width="@dimen/appgallery_card_icon_size_large"
                            android:layout_height="@dimen/appgallery_card_icon_size_large"
                            android:importantForAccessibility="no" />
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:textSize="@dimen/appgallery_text_size_body1"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@id/comment_app_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                            android:layout_below="@id/comment_app_icon"
                            android:layout_centerHorizontal="true"
                            android:importantForAccessibility="no"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:layout_marginStart="@dimen/appgallery_max_padding_start"
                            android:layout_marginEnd="@dimen/appgallery_max_padding_start" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l">
                        <RatingBar
                            android:id="@id/comment_publish_stars_ratingbar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:rating="0.0"
                            android:stepSize="1.0"
                            style="@style/appcomment_big_style_ratingbar" />
                        <com.huawei.uikit.hwtextview.widget.HwTextView
                            android:textSize="@dimen/emui_master_caption_2"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:id="@id/comment_stars_desc_textview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/appgallery_text_paragraph_margin_xs"
                            android:text="@string/appcomment_comment_stars_desc"
                            android:importantForAccessibility="no"
                            android:fontFamily="HwChinese-regular" />
                        <TextView
                            android:textSize="@dimen/emui_master_caption_2"
                            android:textColor="@color/appgallery_text_color_secondary"
                            android:id="@id/comment_delete_tips_textview"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_l"
                            android:layout_marginBottom="@dimen/margin_m"
                            android:text="@string/appcomment_comment_delete_tips"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:layout_marginStart="@dimen/appgallery_max_padding_start"
                            android:layout_marginEnd="@dimen/appgallery_max_padding_start" />
                        <View
                            android:id="@id/detectorline"
                            android:visibility="visible"
                            android:layout_width="fill_parent"
                            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
                            android:paddingStart="@dimen/appgallery_max_padding_start"
                            android:paddingEnd="@dimen/appgallery_max_padding_end"
                            android:layout_marginStart="@dimen/appgallery_max_padding_start"
                            android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                            style="@style/AppGallery.Widget.Divider" />
                    </LinearLayout>
                    <com.huawei.uikit.hwedittext.widget.HwCounterTextLayout
                        android:id="@id/counter_tip_linear"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_l"
                        android:layoutDirection="locale"
                        app:hwLinearEditBg="@null"
                        app:hwMaxLength="800"
                        app:hwShapeMode="linear">
                        <com.huawei.uikit.hwedittext.widget.HwEditText
                            android:textSize="@dimen/appgallery_text_size_body2"
                            android:textColor="@color/appgallery_text_color_primary"
                            android:id="@id/comment_et"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/appcomment_comment_hint_1"
                            android:maxLength="800"
                            android:fontFamily="@string/appgallery_text_font_family_regular"
                            android:textDirection="locale"
                            android:textAlignment="textStart"
                            android:layoutDirection="locale"
                            style="@style/Widget.Emui.HwEditText.Linear" />
                    </com.huawei.uikit.hwedittext.widget.HwCounterTextLayout>
                </LinearLayout>
                <include
                    android:id="@id/detail_comment_loadingPager"
                    android:visibility="gone"
                    layout="@layout/loading_fragment" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>