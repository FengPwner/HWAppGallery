<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:round_corner="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/topic_parent_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.huawei.appmarket.service.store.awk.widget.horizon.HorizonBigVideoPlayer
            android:id="@id/topic_bigimg"
            android:tag="@string/properties_video_contentDescription"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:media_type="0"
            app:view_type="0" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/bottom_layout"
            android:background="@color/appgallery_color_card_panel_bg"
            android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
            android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <TextView
                android:ellipsize="end"
                android:id="@id/title_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
            <TextView
                android:ellipsize="end"
                android:id="@id/subtitle_textview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
        </LinearLayout>
    </LinearLayout>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>