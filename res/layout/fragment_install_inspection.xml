<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@color/appgallery_color_sub_background"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/content_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/install_dist_head_card_margin_top"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:importantForAccessibility="no"
                app:hwColumnType="content_type">
                <ScrollView
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/contentLayout"
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <com.huawei.appgallery.aguikit.widget.imageview.MaskImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@id/app_icon"
                            android:layout_width="@dimen/appgallery_card_icon_size_xl"
                            android:layout_height="@dimen/appgallery_card_icon_size_xl"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            app:corner_type="appicon"
                            app:round_type="all" />
                        <LinearLayout
                            android:layout_gravity="center_horizontal"
                            android:orientation="vertical"
                            android:id="@id/head_content_parent"
                            android:focusable="true"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="yes">
                            <TextView
                                android:layout_gravity="center_horizontal"
                                android:id="@id/app_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/appgallery_safety_margin_l"
                                style="@style/install_confirm_normal_head_app_name_style" />
                            <TextView
                                android:layout_gravity="center_horizontal"
                                android:id="@id/installer_source"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/install_dist_head_card_margin_bottom"
                                style="@style/install_confirm_normal_head_app_source_style" />
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:layout_gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:id="@id/install_confirm_normal_loading_group"
                            android:focusable="true"
                            android:visibility="visible"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/install_dist_head_card_margin_bottom"
                            android:layout_marginBottom="@dimen/install_dist_head_card_margin_bottom"
                            android:importantForAccessibility="yes">
                            <FrameLayout
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/appgallery_safety_margin_m">
                                <com.huawei.uikit.phone.hwprogressbar.widget.HwProgressBar
                                    android:layout_gravity="center"
                                    android:id="@id/head_check_progressbar"
                                    android:visibility="visible"
                                    android:layout_width="@dimen/install_dist_head_card_progressbar_size"
                                    android:layout_height="@dimen/install_dist_head_card_progressbar_size"
                                    style="@style/Widget.Emui.HwProgressBar.Large" />
                                <ImageView
                                    android:layout_gravity="center"
                                    android:id="@id/install_confirm_status_left_icon"
                                    android:visibility="gone"
                                    android:layout_width="@dimen/appgallery_list_item_right_arrow_height"
                                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                                    android:src="@drawable/install_dist_ic_tips_installation_security2" />
                            </FrameLayout>
                            <TextView
                                android:textColor="?android:textColorPrimary"
                                android:layout_gravity="center"
                                android:id="@id/install_confirm_normal_loading_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/start_install_checking_v2_3"
                                style="@style/install_confirm_normal_head_app_source_style" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/hidden_card_layout"
            android:paddingTop="@dimen/ui_24_dp"
            android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
            android:clipChildren="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                app:hwColumnType="content_type">
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@id/hidden_card_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
                    style="@style/install_confirm_normal_hidden_card_tips_style" />
                <com.huawei.uikit.hwbutton.widget.HwButton
                    android:id="@id/hidden_card_hw_appmarket_install"
                    android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
                    android:maxLines="1"
                    style="@style/install_confirm_normal_hidden_card_button_official_style" />
            </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
            <FrameLayout
                android:clipChildren="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/hidden_card_ll_install"
                    android:visibility="visible"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:hwColumnType="button_type">
                    <com.huawei.uikit.hwbutton.widget.HwButton
                        android:enabled="false"
                        android:id="@id/hidden_card_install_button_continue"
                        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
                        android:text="@string/install_dist_start_install"
                        android:maxLines="1"
                        style="@style/install_confirm_normal_hidden_card_button_official_style" />
                    <com.huawei.uikit.hwbutton.widget.HwButton
                        android:id="@id/hidden_card_install_button_cancel"
                        android:layout_marginBottom="@dimen/appgallery_default_padding_bottom_fixed"
                        android:text="@string/detail_cancel_text"
                        android:maxLines="1"
                        style="@style/install_confirm_normal_hidden_card_button_official_style" />
                </com.huawei.uikit.hwcolumnlayout.widget.HwColumnLinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>