<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="@dimen/appgallery_card_elements_margin_m"
    android:clickable="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/normal_count_timer"
        android:clickable="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_button2"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/fifth_tab_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <LinearLayout
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_button3"
                android:textColor="@color/appgallery_text_color_secondary"
                android:layout_gravity="center_vertical"
                android:id="@id/fifth_tab_distance_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance_end"
                android:layout_marginEnd="@dimen/appgallery_card_elements_margin_m" />
            <com.huawei.appmarket.framework.widget.RoundCornerLayout
                android:layout_gravity="center"
                android:background="@color/black_alpha_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:clip_background="true"
                app:round_corner="@dimen/cs_chkid_padding"
                app:stroke_width="0.0dip">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/emui_appbar_icon"
                    android:gravity="center"
                    android:id="@id/fifth_tab_hour"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/cs_4_dp" />
            </com.huawei.appmarket.framework.widget.RoundCornerLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:layout_gravity="center_vertical"
                android:id="@id/fifth_tab_hour_colon"
                android:paddingBottom="@dimen/cs_2_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:layout_marginStart="@dimen/infoflow_triple_img_margin"
                android:layout_marginEnd="@dimen/infoflow_triple_img_margin" />
            <com.huawei.appmarket.framework.widget.RoundCornerLayout
                android:layout_gravity="center"
                android:background="@color/black_alpha_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:clip_background="true"
                app:round_corner="@dimen/cs_chkid_padding"
                app:stroke_width="0.0dip">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="center"
                    android:id="@id/fifth_tab_minutes"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/cs_4_dp" />
            </com.huawei.appmarket.framework.widget.RoundCornerLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_body3"
                android:textColor="@color/appgallery_text_color_primary"
                android:layout_gravity="center_vertical"
                android:id="@id/fifth_tab_minutes_colon"
                android:paddingBottom="@dimen/cs_2_dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:layout_marginStart="@dimen/infoflow_triple_img_margin"
                android:layout_marginEnd="@dimen/infoflow_triple_img_margin" />
            <com.huawei.appmarket.framework.widget.RoundCornerLayout
                android:layout_gravity="center"
                android:background="@color/black_alpha_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:clip_background="true"
                app:round_corner="@dimen/cs_chkid_padding"
                app:stroke_width="0.0dip">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="center"
                    android:id="@id/fifth_tab_seconds"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/cs_4_dp" />
            </com.huawei.appmarket.framework.widget.RoundCornerLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/old_count_timer"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.huawei.uikit.hwtextview.widget.HwTextView
            android:textSize="@dimen/emui_text_size_button2"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/old_fifth_tab_name"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textAlignment="textStart"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
            android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_body3"
                android:textColor="@color/appgallery_text_color_secondary"
                android:layout_gravity="center_vertical"
                android:id="@id/old_fifth_tab_distance_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance_end" />
            <com.huawei.appmarket.framework.widget.RoundCornerLayout
                android:layout_gravity="center"
                android:background="@color/black_alpha_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
                app:clip_background="true"
                app:round_corner="@dimen/cs_chkid_padding"
                app:stroke_width="0.0dip">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/emui_appbar_icon"
                    android:gravity="center"
                    android:id="@id/old_fifth_tab_hour"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/cs_4_dp" />
            </com.huawei.appmarket.framework.widget.RoundCornerLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginStart="@dimen/infoflow_triple_img_margin"
                android:layout_marginEnd="@dimen/infoflow_triple_img_margin">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="center"
                    android:id="@id/old_fifth_tab_hour_colon"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text=":" />
            </RelativeLayout>
            <com.huawei.appmarket.framework.widget.RoundCornerLayout
                android:layout_gravity="center"
                android:background="@color/black_alpha_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:clip_background="true"
                app:round_corner="@dimen/cs_chkid_padding"
                app:stroke_width="0.0dip">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="center"
                    android:id="@id/old_fifth_tab_minutes"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/cs_4_dp" />
            </com.huawei.appmarket.framework.widget.RoundCornerLayout>
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginStart="@dimen/infoflow_triple_img_margin"
                android:layout_marginEnd="@dimen/infoflow_triple_img_margin">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="center"
                    android:id="@id/old_fifth_tab_minutes_colon"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text=":"
                    android:textAlignment="center" />
            </RelativeLayout>
            <com.huawei.appmarket.framework.widget.RoundCornerLayout
                android:layout_gravity="center"
                android:background="@color/black_alpha_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:clip_background="true"
                app:round_corner="@dimen/cs_chkid_padding"
                app:stroke_width="0.0dip">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/emui_text_size_body3"
                    android:textColor="@color/appgallery_text_color_primary"
                    android:gravity="center"
                    android:id="@id/old_fifth_tab_seconds"
                    android:paddingBottom="@dimen/cs_2_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/cs_4_dp" />
            </com.huawei.appmarket.framework.widget.RoundCornerLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="fill_parent"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:layout_marginStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
        android:layout_marginEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>