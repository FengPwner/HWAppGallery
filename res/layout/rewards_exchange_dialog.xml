<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/banner_bg_margin_24"
    android:paddingEnd="@dimen/banner_bg_margin_24"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/rewards_icon"
        android:clickable="true"
        android:layout_width="64.0dip"
        android:layout_height="64.0dip"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body1"
        android:gravity="center"
        android:id="@id/rewards_name"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_card_elements_margin_m"
        android:layout_marginBottom="@dimen/banner_bg_margin_24"
        android:maxLines="2"
        android:importantForAccessibility="yes"
        style="@style/AppGallery.TextAppearance.Card.SubTitle2" />
    <ScrollView
        android:id="@id/rewards_content_container"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginBottom="12.0dip"
        android:fillViewport="false"
        android:layout_weight="1.0"
        android:importantForAccessibility="yes">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/rewards_content"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            style="@style/AppGallery.TextAppearance.Card.SubTitle3.Regular" />
    </ScrollView>
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
        android:textSize="@dimen/appgallery_text_size_body1"
        android:id="@id/rewards_exchange_notice"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        style="@style/AppGallery.TextAppearance.Card.SubTitle2.Regular" />
</LinearLayout>