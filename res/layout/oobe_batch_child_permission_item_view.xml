<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:paddingStart="@dimen/appgallery_max_padding_start"
    android:paddingEnd="@dimen/appgallery_max_padding_start"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/appgallery_text_size_body2"
        android:textColor="@color/appgallery_text_color_primary"
        android:id="@id/batch_per_item_groupdesc"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_paragraph_margin_s" />
    <LinearLayout
        android:id="@id/batch_per_item_layout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appgallery_text_paragraph_margin_xs">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/margin_l"
            android:layout_height="@dimen/margin_l"
            android:src="@drawable/oobe_apppermission_point" />
        <TextView
            android:textSize="@dimen/appgallery_text_size_body2"
            android:textColor="@color/appgallery_text_color_secondary"
            android:id="@id/batch_per_item"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:layout_marginStart="4.0dip" />
    </LinearLayout>
</LinearLayout>