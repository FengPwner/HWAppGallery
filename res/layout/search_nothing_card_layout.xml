<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_l"
    android:paddingEnd="@dimen/padding_l"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/no_result_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/no_result_icon"
            android:background="@drawable/ic_search_app_empty"
            android:layout_width="66.0dip"
            android:layout_height="66.0dip" />
        <TextView
            android:textSize="@dimen/emui_master_body_2"
            android:textColor="@color/emui_color_gray_7"
            android:layout_gravity="center_horizontal"
            android:id="@id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_no_result_content" />
    </LinearLayout>
</LinearLayout>