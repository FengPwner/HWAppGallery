<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@id/aguikit_card_tips_container"
    android:background="@drawable/aguikit_card_tips_bg"
    android:paddingTop="@dimen/appgallery_card_panel_inner_margin_vertical"
    android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/appgallery_card_panel_inner_margin_horizontal"
    android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/aguikit_card_tips_icon"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:src="@drawable/aguikit_ic_public_error"
        android:tint="@color/appgallery_color_primary" />
    <com.huawei.uikit.hwtextview.widget.HwTextView
        android:id="@id/aguikit_card_tips_description"
        android:paddingTop="@dimen/appgallery_card_protect_margin_vertical"
        android:paddingBottom="@dimen/appgallery_card_protect_margin_vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/appgallery_card_elements_margin_l"
        style="@style/AppGallery.TextAppearance.Card.TextBody1.Regular" />
</LinearLayout>