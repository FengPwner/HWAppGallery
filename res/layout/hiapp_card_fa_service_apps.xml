<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/aguikit_card_panel_bg_bottom_corner"
    android:paddingLeft="12.0dip"
    android:paddingRight="12.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.appmarket.service.faroll.FaRollViewPager
        android:id="@id/hiapp_fa_recommend_faroll_viewpager"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <FrameLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@id/hiapp_fa_recommend_editor_desc_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16.0dip">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@id/hiapp_fa_recommend_editor_desc_container1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start|center|top"
                android:id="@id/hiapp_fa_recommend_start_quote1"
                android:layout_width="@dimen/ui_40_dp"
                android:layout_height="@dimen/hiapp_fa_recommend_start_quote_height"
                android:src="@drawable/hiapp_fa_recommend_quote"
                android:rotation="180.0"
                android:layout_marginEnd="8.0dip" />
            <TextView
                android:textSize="14.0sp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@id/hiapp_fa_recommend_editor_desc1"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:lines="2"
                android:layout_weight="1.0"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
            <ImageView
                android:layout_gravity="end|bottom|center"
                android:id="@id/hiapp_fa_recommend_end_quote1"
                android:layout_width="28.0dip"
                android:layout_height="@dimen/hiapp_fa_recommend_end_quote_height"
                android:src="@drawable/hiapp_fa_recommend_quote"
                android:layout_marginStart="8.0dip" />
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@id/hiapp_fa_recommend_editor_desc_container2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="start|center|top"
                android:id="@id/hiapp_fa_recommend_start_quote2"
                android:layout_width="@dimen/ui_40_dp"
                android:layout_height="@dimen/hiapp_fa_recommend_start_quote_height"
                android:src="@drawable/hiapp_fa_recommend_quote"
                android:rotation="180.0"
                android:layout_marginEnd="8.0dip" />
            <TextView
                android:textSize="14.0sp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@id/hiapp_fa_recommend_editor_desc2"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:lines="2"
                android:layout_weight="1.0"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary.Regular" />
            <ImageView
                android:layout_gravity="end|bottom|center"
                android:id="@id/hiapp_fa_recommend_end_quote2"
                android:layout_width="28.0dip"
                android:layout_height="@dimen/hiapp_fa_recommend_end_quote_height"
                android:src="@drawable/hiapp_fa_recommend_quote"
                android:layout_marginStart="8.0dip" />
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@id/hiapp_fa_recommend_devider_line"
        android:layout_width="fill_parent"
        style="@style/AppGallery.Widget.Divider" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/hiapp_fa_recommend_open_fa_detail"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="48.0dip">
        <FrameLayout
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/hiapp_fa_recommend_fa_layout1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/hiapp_fa_recommend_fa_icon1"
                    android:layout_width="28.0dip"
                    android:layout_height="28.0dip" />
                <TextView
                    android:ellipsize="end"
                    android:id="@id/hiapp_fa_recommend_fa_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="8.0dip"
                    android:layout_marginEnd="5.0dip"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Primary" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/hiapp_fa_recommend_fa_layout2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/hiapp_fa_recommend_fa_icon2"
                    android:layout_width="28.0dip"
                    android:layout_height="28.0dip" />
                <TextView
                    android:ellipsize="end"
                    android:id="@id/hiapp_fa_recommend_fa_name2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginStart="8.0dip"
                    android:layout_marginEnd="5.0dip"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Primary" />
            </LinearLayout>
        </FrameLayout>
        <ImageView
            android:id="@id/hiapp_fa_recommend_open_fa_image"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/hiapp_fa_recommend_open_detail" />
    </LinearLayout>
</LinearLayout>