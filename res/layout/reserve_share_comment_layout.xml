<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@color/appgallery_color_sub_background"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:wapbutton="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/six_element_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <com.huawei.appmarket.service.appdetail.view.widget.DetailRelativeLayout
        android:orientation="horizontal"
        android:id="@id/reserve_button_layout_relativelayout"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/reserve_framelayout"
            android:layout_width="200.0dip"
            android:layout_height="50.0dip"
            android:layout_centerInParent="true">
            <com.huawei.appgallery.detail.detailbase.api.DetailTryGameButton
                android:textSize="14.0dip"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/reserve_try_play_button"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/appgallery_button_safety_margin"
                android:singleLine="true"
                android:layout_weight="1.0"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                wapbutton:downloadFixedWidth="true"
                wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                style="@style/Widget.Emui.HwProgressButton" />
            <com.huawei.appgallery.detail.detailbase.api.DetailDownloadButton
                android:textSize="14.0dip"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/reserve_button"
                android:visibility="visible"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/appgallery_button_safety_margin"
                android:singleLine="true"
                android:layout_weight="1.0"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                wapbutton:downloadFixedWidth="true"
                wapbutton:hwProgressButtonStaticTextColor="@color/hwprogressbutton_selector_button_text_emphasize"
                wapbutton:isDownloadButtonCancelableLocal="false"
                style="@style/Widget.Emui.HwProgressButton" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/reserve_share_layout_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_m"
            android:layout_marginEnd="@dimen/margin_l"
            android:layout_toStartOf="@id/reserve_framelayout"
            android:layout_alignParentStart="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/reserve_share_sub_layout_linearlayout"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/detail_toolbar_height"
                android:contentDescription="@string/detail_share_text">
                <com.huawei.appmarket.service.appdetail.view.widget.DetailShareButton
                    android:gravity="center"
                    android:id="@id/reserve_share_button"
                    android:background="@drawable/aguikit_ic_public_share"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="center"
                    style="@style/detail_widget_tag" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/reserve_share_cancel_button_linearlayout"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/detail_toolbar_height">
                <ImageView
                    android:gravity="center"
                    android:id="@id/reserve_share_cancel_imageview"
                    android:background="@drawable/ic_details_cancel"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="center"
                    style="@style/detail_widget_tag" />
            </LinearLayout>
            <View
                android:id="@id/reserve_share_placeholder_view"
                android:visibility="gone"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@id/reserve_comment_layout_linearlayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_l"
            android:layout_marginEnd="@dimen/margin_m"
            android:layout_toEndOf="@id/reserve_framelayout"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/reserve_comment_button_linearlayout"
                android:background="@drawable/hiappbase_actionbar_icon_bg_selector"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/detail_toolbar_height"
                android:contentDescription="@string/reserve_appcomment">
                <ImageView
                    android:gravity="center"
                    android:id="@id/reserve_comment_imageview"
                    android:background="@drawable/aguikit_ic_public_comments"
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:scaleType="center"
                    style="@style/detail_widget_tag" />
            </LinearLayout>
            <View
                android:id="@id/reserve_comment_placeholder_view"
                android:visibility="gone"
                android:layout_width="24.0dip"
                android:layout_height="24.0dip" />
        </LinearLayout>
    </com.huawei.appmarket.service.appdetail.view.widget.DetailRelativeLayout>
</LinearLayout>