<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/common_ll"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/common_rl"
        android:background="@drawable/aguikit_round_rectangle_card_item_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
        android:paddingStart="@dimen/appgallery_default_corner_radius_m"
        android:paddingEnd="@dimen/appgallery_default_corner_radius_m"
        style="@style/AppGallery.Widget.List.SingleTextLine">
        <ImageView
            android:id="@id/arrowlayout"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/AppGallery.Widget.List.RightArrow" />
        <TextView
            android:gravity="center_vertical"
            android:id="@id/portalText"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_shareappcenter"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/arrowlayout"
            style="@style/AppGallery.TextAppearance.List.TextBody1.Primary" />
    </RelativeLayout>
    <ImageView
        android:id="@id/divider"
        android:layout_width="fill_parent"
        android:layout_marginStart="@dimen/appgallery_column_system_content_margin"
        android:layout_marginEnd="@dimen/appgallery_column_system_content_margin"
        style="@style/AppGallery.Widget.Divider" />
</LinearLayout>