<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/appicon1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_horizontal_m"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_marginEnd="@dimen/margin_m"
        app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/appicon2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/appgallery_elements_margin_horizontal_m"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:corner_radius="@dimen/appgallery_default_corner_radius_m" />
</LinearLayout>