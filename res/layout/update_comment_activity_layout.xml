<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:fitsSystemWindows="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/title"
        layout="@layout/publish_post_title_layout" />
    <ScrollView
        android:id="@id/scroll_layout"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_l"
        android:layout_marginBottom="@dimen/margin_l"
        android:layout_above="@id/insert_img_layout"
        android:layout_below="@id/title"
        android:layout_marginStart="@dimen/margin_l"
        android:layout_marginEnd="@dimen/margin_l">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appgallery.forum.option.comment.view.UpdateCommentContentLayout
                android:id="@id/update_content_layout"
                android:layout_width="fill_parent"
                android:layout_height="144.0dip" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/radius_m">
                <include
                    android:id="@id/img_added_layout"
                    android:visibility="gone"
                    layout="@layout/update_comment_gridview_item" />
                <include
                    android:id="@id/add_img_layout"
                    layout="@layout/update_comment_add_img_item" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>