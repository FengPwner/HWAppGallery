<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.foundation.ui.framework.widget.LineImageView
        android:id="@id/immersive_big_imageview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:corner_radius="@dimen/appgallery_default_corner_radius_l"
        app:touch_drawable="@drawable/bigbanner_round_image_border" />
    <LinearLayout
        android:background="@drawable/materiallistcard_item_bg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m" />
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:round_corner_bottom_left="@dimen/appgallery_default_corner_radius_l"
        app:round_corner_bottom_right="@dimen/appgallery_default_corner_radius_l"
        app:stroke_width="0.0dip">
        <ImageView
            android:id="@id/blood_imageview"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true" />
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/topic_title_layout"
            android:padding="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/wisedist_bigimagebannercard_topic_body_text"
                android:textColor="@color/emui_black"
                android:ellipsize="end"
                android:id="@id/topic_body"
                android:tag="css/.subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/appgallery_card_elements_margin_xs"
                android:maxLines="2"
                android:fontFamily="@string/appgallery_text_font_family_medium"
                android:textAlignment="viewStart" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                android:textSize="@dimen/appgallery_text_size_body3_fixed"
                android:textColor="@color/emui_black"
                android:ellipsize="end"
                android:id="@id/topic_title"
                android:tag="css/.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/game_title_layout"
            android:padding="@dimen/appgallery_elements_margin_vertical_l"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@id/game_icon"
                android:layout_width="@dimen/appgallery_card_icon_size_middle"
                android:layout_height="@dimen/appgallery_card_icon_size_middle"
                android:scaleType="centerCrop"
                android:layout_marginEnd="@dimen/appgallery_elements_margin_vertical_l" />
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body1_fixed"
                        android:textColor="@color/emui_black"
                        android:ellipsize="end"
                        android:id="@id/game_title"
                        android:tag="css/.title"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:maxLines="1"
                        android:layout_weight="1.0"
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        android:textAlignment="viewStart" />
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body1_fixed"
                        android:textColor="@color/emui_black"
                        android:id="@id/score_value"
                        android:tag="css/.title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:fontFamily="@string/appgallery_text_font_family_medium"
                        android:layout_marginStart="@dimen/wisedist_bigimagebannercard_margin" />
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_caption_fixed"
                        android:textColor="@color/emui_black"
                        android:id="@id/score_unit"
                        android:tag="css/.title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/score_unit"
                        android:fontFamily="@string/appgallery_text_font_family_medium" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body3_fixed"
                        android:textColor="@color/emui_black"
                        android:ellipsize="end"
                        android:id="@id/game_body"
                        android:tag="css/.subtitle"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                        android:text=""
                        android:maxLines="1"
                        android:layout_weight="1.0"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:textAlignment="viewStart" />
                    <com.huawei.uikit.phone.hwtextview.widget.HwTextView
                        android:textSize="@dimen/appgallery_text_size_body3_fixed"
                        android:textColor="@color/emui_black"
                        android:ellipsize="end"
                        android:id="@id/score_desc"
                        android:tag="css/.subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/appgallery_card_elements_margin_xs"
                        android:text=""
                        android:maxLines="1"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:layout_marginStart="@dimen/wisedist_bigimagebannercard_margin" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
</RelativeLayout>