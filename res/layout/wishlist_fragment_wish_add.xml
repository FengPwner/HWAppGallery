<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bounceViews="http://schemas.android.com/apk/res-auto">
    <com.huawei.appgallery.wishlist.widget.WishPullUpListView
        android:id="@id/wish_app_listview"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:drawSelectorOnTop="true"
        android:divider="@null"
        android:dividerHeight="0.0dip"
        android:layout_above="@id/wishlist_button_wish_submit_layout"
        bounceViews:bounceEnable="true"
        bounceViews:hwCutoutMode="never" />
    <LinearLayout
        android:gravity="center"
        android:id="@id/wishlist_button_wish_submit_layout"
        android:background="@color/appgallery_color_sub_background"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.huawei.appgallery.foundation.ui.framework.widget.BottomButton
            android:layout_gravity="center"
            android:id="@id/wishlist_button_wish_submit"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:text="@string/wishlist_detail_comment_submit"
            bounceViews:hwAutoSizeMinTextSize="9.0sp"
            bounceViews:hwAutoSizeStepGranularity="1.0sp"
            style="@style/AppGallery.Widget.Button.BottomButton" />
    </LinearLayout>
</RelativeLayout>