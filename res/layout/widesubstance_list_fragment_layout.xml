<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/content_layout_id"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/hiappbase_title_layout_id"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />
    <FrameLayout
        android:id="@id/hiappbase_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:id="@id/hiappbase_data_layout_id"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <ViewStub
            android:id="@id/nodata_viewstub"
            android:layout="@layout/hiappbase_nodata_warn_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@id/wisedist_substance_flowcard_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.appmarket.service.substance.FlowCardView
                android:layout_gravity="bottom"
                android:id="@id/wisedist_substance_flowcard"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout
            android:id="@id/hiappbase_loading_layout_id"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </FrameLayout>
</LinearLayout>