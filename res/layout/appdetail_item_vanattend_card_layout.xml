<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ll_vanattend"
    android:paddingBottom="@dimen/appgallery_elements_margin_vertical_l"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maskview="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/component_detail_card_element_height_l"
        style="@style/AppGallery.Widget.SubHeader.ViewGroup">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_subtitle2"
                android:textColor="@color/appgallery_text_color_primary"
                android:ellipsize="end"
                android:layout_gravity="start|bottom|center"
                android:id="@id/game_test_subheader_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_medium" />
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:textSize="@dimen/emui_text_size_subtitle3"
                android:textColor="@color/appgallery_text_color_secondary"
                android:ellipsize="end"
                android:layout_gravity="start|bottom|center"
                android:id="@id/game_test_subheader_content"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@string/appgallery_text_font_family_regular" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/game_test_card_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/appgallery_max_padding_start"
        android:layout_marginEnd="@dimen/appgallery_max_padding_end">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/order_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_card_icon_size_middle">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="@dimen/ui_12_dp"
                android:layout_height="fill_parent">
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="0.0dip"
                    android:layout_marginBottom="@dimen/component_detail_card_elements_margin_s"
                    android:layout_weight="1.0" />
                <ImageView
                    android:id="@id/order_indicator"
                    android:background="@drawable/vanattend_step_unfinished"
                    android:layout_width="@dimen/ui_12_dp"
                    android:layout_height="@dimen/ui_12_dp" />
                <View
                    android:layout_gravity="center_horizontal"
                    android:background="@color/appgallery_card_color_default_background"
                    android:layout_width="0.5dip"
                    android:layout_height="0.0dip"
                    android:layout_marginTop="@dimen/component_detail_card_elements_margin_s"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_24_dp">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/order_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_toStartOf="@id/game_order_fl"
                    android:layout_alignParentStart="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cs_2_dp"
                    android:layout_below="@id/order_title"
                    android:layout_toStartOf="@id/game_order_fl"
                    android:layout_alignParentStart="true">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:ellipsize="end"
                        android:id="@id/order_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/order_result_imageview"
                        android:layout_alignParentStart="true"
                        style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                    <ImageView
                        android:id="@id/order_result_imageview"
                        android:background="@drawable/vanattend_finish_right"
                        android:visibility="gone"
                        android:layout_width="@dimen/component_detail_card_element_width_s"
                        android:layout_height="@dimen/component_detail_card_element_height_s"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <FrameLayout
                    android:id="@id/game_order_fl"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <com.huawei.uikit.phone.hwbutton.widget.HwButton
                        android:ellipsize="end"
                        android:id="@id/game_test_order_btn"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/component_detail_button_max_width"
                        android:minWidth="@dimen/component_detail_card_element_width_l"
                        android:text="@string/component_detail_card_reserve_btn"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
                        maskview:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
                        maskview:hwAutoSizeStepGranularity="1.0sp"
                        style="@style/AppGallery.Widget.Button.Small" />
                </FrameLayout>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:id="@id/order_divider_view"
            android:background="@color/appgallery_card_color_default_background"
            android:layout_width="0.5dip"
            android:layout_height="@dimen/component_detail_card_element_height_s"
            android:layout_marginStart="5.75dip" />
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_card_icon_size_middle">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="@dimen/ui_12_dp"
                android:layout_height="fill_parent">
                <View
                    android:layout_gravity="center_horizontal"
                    android:id="@id/question_divider_top"
                    android:background="@color/appgallery_card_color_default_background"
                    android:layout_width="0.5dip"
                    android:layout_height="0.0dip"
                    android:layout_marginBottom="@dimen/component_detail_card_elements_margin_s"
                    android:layout_weight="1.0" />
                <ImageView
                    android:id="@id/question_indicator"
                    android:background="@drawable/vanattend_step_unfinished"
                    android:layout_width="@dimen/ui_12_dp"
                    android:layout_height="@dimen/ui_12_dp" />
                <View
                    android:layout_gravity="center_horizontal"
                    android:background="@color/appgallery_card_color_default_background"
                    android:layout_width="0.5dip"
                    android:layout_height="0.0dip"
                    android:layout_marginTop="@dimen/component_detail_card_elements_margin_s"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_24_dp">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/question_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_toStartOf="@id/question_action_fl"
                    android:layout_alignParentStart="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/question_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cs_2_dp"
                    android:maxLines="1"
                    android:layout_below="@id/question_title"
                    android:layout_toStartOf="@id/question_action_fl"
                    android:layout_alignParentStart="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
                <FrameLayout
                    android:id="@id/question_action_fl"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_gravity="end|center"
                        android:id="@id/question_result_imageview"
                        android:background="@drawable/vanattend_finish_right"
                        android:visibility="gone"
                        android:layout_width="@dimen/component_detail_card_element_width_s"
                        android:layout_height="@dimen/component_detail_card_element_height_s"
                        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m" />
                    <com.huawei.uikit.phone.hwbutton.widget.HwButton
                        android:ellipsize="end"
                        android:layout_gravity="end|center"
                        android:id="@id/game_test_question_btn"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/component_detail_button_max_width"
                        android:minWidth="@dimen/component_detail_card_element_width_l"
                        android:text="@string/component_detail_vanattend_question_fill"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
                        maskview:hwAutoSizeMinTextSize="@dimen/appgallery_auto_size_min_text_size_small"
                        maskview:hwAutoSizeStepGranularity="1.0sp"
                        style="@style/AppGallery.Widget.Button.Small" />
                </FrameLayout>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/appgallery_card_color_default_background"
            android:layout_width="0.5dip"
            android:layout_height="@dimen/component_detail_card_element_height_s"
            android:layout_marginStart="5.75dip" />
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/appgallery_card_icon_size_xs">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/game_test_publish_divider_layout"
                android:layout_width="@dimen/ui_12_dp"
                android:layout_height="fill_parent">
                <View
                    android:layout_gravity="center_horizontal"
                    android:background="@color/appgallery_card_color_default_background"
                    android:layout_width="0.5dip"
                    android:layout_height="0.0dip"
                    android:layout_marginBottom="@dimen/component_detail_card_elements_margin_s"
                    android:layout_weight="1.0" />
                <ImageView
                    android:id="@id/publish_indicator"
                    android:background="@drawable/vanattend_step_unfinished"
                    android:layout_width="@dimen/ui_12_dp"
                    android:layout_height="@dimen/ui_12_dp" />
                <View
                    android:layout_gravity="center_horizontal"
                    android:layout_width="0.5dip"
                    android:layout_height="0.0dip"
                    android:layout_marginTop="@dimen/component_detail_card_elements_margin_s"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_24_dp">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:id="@id/publish_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_alignParentTop="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_alignParentStart="true"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                <ImageView
                    android:id="@id/publish_imageview"
                    android:background="@drawable/vanattend_finish_right"
                    android:visibility="gone"
                    android:layout_width="@dimen/component_detail_card_element_width_s"
                    android:layout_height="@dimen/component_detail_card_element_height_s"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/appgallery_elements_margin_horizontal_m"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/game_test_login_layout"
            android:background="@drawable/detail_vanattend_card_background"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:minHeight="@dimen/appgallery_card_icon_size_small">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:id="@id/login_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/game_test_result_layout"
            android:background="@drawable/detail_vanattend_card_background"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:minHeight="@dimen/appgallery_card_icon_size_small">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:id="@id/result_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                android:layout_marginStart="@dimen/appgallery_max_padding_start"
                android:layout_marginEnd="@dimen/appgallery_max_padding_end"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/game_test_code_layout"
            android:background="@drawable/detail_vanattend_card_background"
            android:paddingTop="@dimen/appgallery_elements_margin_vertical_m"
            android:paddingBottom="@dimen/appgallery_elements_margin_vertical_m"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/appgallery_elements_margin_vertical_m"
            android:minHeight="@dimen/appgallery_card_icon_size_small"
            android:paddingStart="@dimen/appgallery_max_padding_start"
            android:paddingEnd="@dimen/appgallery_max_padding_end">
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:gravity="center_horizontal"
                android:id="@id/code_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@string/appgallery_text_font_family_regular"
                style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/code_detail_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/component_detail_vanattend_code"
                        android:maxLines="1"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                    <com.huawei.uikit.hwtextview.widget.HwTextView
                        android:id="@id/code_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        android:fontFamily="@string/appgallery_text_font_family_regular"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="4.0dip"
                        style="@style/AppGallery.TextAppearance.Card.TextBody2.Primary" />
                </LinearLayout>
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_12_dp"
                    android:text="@string/component_detail_vanattend_code_tips"
                    style="@style/AppGallery.TextAppearance.Card.TextBody3.Secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>