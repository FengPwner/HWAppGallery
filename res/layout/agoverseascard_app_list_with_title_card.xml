<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@id/shadow_container"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.huawei.appmarket.framework.widget.RoundCornerLayout
        android:id="@id/parent_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:shadowCornerRadius="@dimen/appgallery_default_corner_radius_l"
        app:stroke_width="0.0dip">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@id/title_container"
            android:background="@drawable/agoverseascard_app_list_with_title_top_corner"
            android:paddingTop="12.0dip"
            android:paddingBottom="@dimen/appgallery_card_elements_margin_m"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/secondary_title_layout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:weightSum="1.0"
                app:layout_constraintBottom_toTopOf="@id/primary_title"
                app:layout_constraintStart_toStartOf="parent">
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:ellipsize="end"
                    android:id="@id/secondary_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="8.0dip"
                    style="@style/AppGallery.TextAppearance.Card.TextBody2.Secondary" />
                <ImageView
                    android:id="@id/secondary_arrow"
                    android:tag="css/.arrow"
                    android:background="@drawable/ic_public_arrow_right_900"
                    android:layout_width="@dimen/appgallery_list_item_right_arrow_width"
                    android:layout_height="@dimen/appgallery_list_item_right_arrow_height"
                    android:layout_weight="0.0"
                    app:layout_constraintEnd_toEndOf="@id/secondary_title_layout" />
            </LinearLayout>
            <com.huawei.uikit.hwtextview.widget.HwTextView
                android:ellipsize="end"
                android:id="@id/primary_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/secondary_title_layout"
                style="@style/AppGallery.TextAppearance.MainTitle.BottomOfCard" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@id/app_container"
            android:background="@drawable/agoverseascard_app_list_with_title_bottom_corner"
            android:paddingBottom="@dimen/appgallery_card_panel_inner_margin_vertical"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:layout_below="@id/title_container"
            android:paddingStart="@dimen/appgallery_card_panel_inner_margin_vertical"
            android:paddingEnd="@dimen/appgallery_card_panel_inner_margin_vertical" />
    </com.huawei.appmarket.framework.widget.RoundCornerLayout>
</LinearLayout>