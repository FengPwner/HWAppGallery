<?xml version="1.0" encoding="utf-8"?>
<com.huawei.appmarket.framework.widget.RoundCornerLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/aguikit_round_rectangle_bg"
    app:round_corner="@dimen/appgallery_default_corner_radius_l"
    app:stroke_width="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/detail_post_item_card_banner"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop"
        android:layout_alignParentTop="true" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/detail_post_item_card_content_layout"
        android:background="@color/appgallery_color_card_panel_bg"
        android:paddingTop="@dimen/padding_m"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/detail_post_item_card_banner">
        <TextView
            android:textSize="@dimen/appgallery_text_size_body3"
            android:textColor="@color/appgallery_text_color_primary"
            android:ellipsize="end"
            android:id="@id/detail_post_item_card_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lines="2"
            android:fontFamily="@string/appgallery_text_font_family_regular"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/padding_m"
            android:paddingEnd="@dimen/padding_m" />
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@id/detail_post_item_card_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_12_dp"
            android:layout_marginBottom="@dimen/padding_m"
            android:paddingStart="@dimen/padding_m"
            android:paddingEnd="@dimen/padding_m">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_post_item_card_user_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/detail_post_item_card_comment_layout"
                android:layout_alignParentStart="true">
                <ImageView
                    android:id="@id/detail_post_item_card_avatar"
                    android:layout_width="@dimen/margin_l"
                    android:layout_height="@dimen/margin_l"
                    android:layout_marginEnd="@dimen/component_detail_card_elements_margin_s" />
                <TextView
                    android:textSize="@dimen/appgallery_text_size_caption_fixed"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/detail_post_item_card_nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:fontFamily="@string/appgallery_text_font_family_regular"
                    android:layout_marginEnd="@dimen/ui_12_dp" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/detail_post_item_card_comment_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@id/detail_post_item_card_comment_icon"
                    android:background="@drawable/aguikit_ic_public_comments"
                    android:layout_width="@dimen/ui_10_dp"
                    android:layout_height="@dimen/ui_10_dp"
                    android:layout_marginEnd="@dimen/margin_s" />
                <com.huawei.uikit.hwtextview.widget.HwTextView
                    android:textSize="@dimen/appgallery_text_size_caption_fixed"
                    android:textColor="@color/appgallery_text_color_secondary"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@id/detail_post_item_card_comment_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/appgallery_text_font_family_regular" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</com.huawei.appmarket.framework.widget.RoundCornerLayout>