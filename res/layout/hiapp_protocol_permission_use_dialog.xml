<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/emui_text_size_subtitle3"
                android:textColor="@color/appgallery_color_secondary"
                android:id="@id/desc_dlg_subtitle"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_m" />
            <View
                android:id="@id/phone_use_separator"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_marginTop="@dimen/appgallery_text_size_caption_fixed"
                style="@style/AppGallery.Widget.Divider" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_color_primary"
                android:id="@id/phone_use"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_size_caption_fixed"
                android:text="@string/appgallery_permission_use_device" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_color_secondary"
                android:id="@id/phone_use_desc"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_s"
                android:text="@string/gallery_permission_reason_phone_new" />
            <View
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_marginTop="@dimen/appgallery_text_size_caption_fixed"
                style="@style/AppGallery.Widget.Divider" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_color_primary"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_size_caption_fixed"
                android:text="@string/hiappbase_permission_storage" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_color_secondary"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_s"
                android:layout_marginBottom="@dimen/appgallery_text_size_caption_fixed"
                android:text="@string/gallery_permission_reason_storage_v1" />
            <View
                android:id="@id/installed_app_separator"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_marginTop="@dimen/appgallery_text_size_caption_fixed"
                style="@style/AppGallery.Widget.Divider" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body1"
                android:textColor="@color/appgallery_color_primary"
                android:id="@id/installed_app_name"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appgallery_text_size_caption_fixed" />
            <TextView
                android:textSize="@dimen/appgallery_text_size_body2"
                android:textColor="@color/appgallery_color_secondary"
                android:id="@id/installed_app_desc"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_s"
                android:layout_marginBottom="@dimen/appgallery_text_size_caption_fixed"
                android:text="@string/appcommon_get_installed_apps_permission_reason_storage" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>