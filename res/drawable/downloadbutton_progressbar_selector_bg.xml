<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:drawable="@drawable/hwprogressbutton_progressbar_bg_normal_shape" />
    <item
        android:id="@android:id/progress"
        android:drawable="@drawable/hwprogressbutton_progressbar_progress_normal_shape" />
    <item>
        <selector>
            <item
                android:state_pressed="true"
                android:drawable="@drawable/hwprogressbutton_progressbar_pressed_bg_shape" />
            <item
                android:drawable="@drawable/hwprogressbutton_progressbar_bg_normal_shape" />
        </selector>
    </item>
</layer-list>