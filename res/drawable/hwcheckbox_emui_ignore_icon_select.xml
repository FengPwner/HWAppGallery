<?xml version="1.0" encoding="utf-8"?>
<animated-selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:drawable="@drawable/hwcheckbox_vector_on_disable_normal" />
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:drawable="@drawable/ic_checkbox_off_icon_select" />
    <item
        android:state_checked="true"
        android:id="@id/checked"
        android:drawable="@drawable/hwcheckbox_vector_on_normal" />
    <item
        android:id="@id/unchecked"
        android:drawable="@drawable/ic_checkbox_off_icon_select" />
</animated-selector>