<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background">
        <shape
            android:shape="rectangle">
            <corners
                android:radius="14.0dip" />
            <size
                android:height="28.0dip" />
            <solid
                android:color="@color/transparent" />
            <stroke
                android:width="@dimen/stroke_line_width"
                android:color="@color/category_button_select_stroke" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress">
        <shape
            android:shape="rectangle">
            <corners
                android:radius="14.0dip" />
            <size
                android:height="28.0dip" />
            <solid
                android:color="@color/detail_downloadbutton_processing" />
        </shape>
    </item>
</layer-list>