<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:right="2.0dip">
        <shape
            android:shape="rectangle">
            <corners
                android:topLeftRadius="20.0dip"
                android:topRightRadius="20.0dip"
                android:bottomLeftRadius="20.0dip"
                android:bottomRightRadius="20.0dip" />
            <gradient
                android:startColor="@color/welfare_center_checkin_btn_start_color"
                android:endColor="@color/welfare_center_checkin_btn_end_color"
                android:angle="0.0" />
            <size
                android:height="28.0dip"
                android:width="72.0dip" />
        </shape>
    </item>
    <item
        android:right="2.0dip">
        <selector
            xmlns:android="http://schemas.android.com/apk/res/android">
            <item
                android:state_pressed="true">
                <shape
                    android:shape="rectangle">
                    <corners
                        android:topLeftRadius="20.0dip"
                        android:topRightRadius="20.0dip"
                        android:bottomLeftRadius="20.0dip"
                        android:bottomRightRadius="20.0dip" />
                    <solid
                        android:color="@color/welfare_center_checkin_btn_pressed_color" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>