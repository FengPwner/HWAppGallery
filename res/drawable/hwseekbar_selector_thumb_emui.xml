<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/hwseekbar_oval_hover_emui" />
    <item
        android:gravity="center">
        <selector>
            <item
                android:state_enabled="false"
                android:drawable="@drawable/hwseekbar_default_thumb_disable_emui" />
            <item
                android:state_pressed="true"
                android:drawable="@drawable/hwseekbar_default_thumb_pressed_emui" />
            <item
                android:drawable="@drawable/hwseekbar_default_thumb_normal_emui" />
        </selector>
    </item>
    <item
        android:gravity="center">
        <selector>
            <item
                android:state_focused="true"
                android:state_window_focused="true">
                <inset
                    android:drawable="@drawable/hwseekbar_default_oval_focused_emui"
                    android:insetLeft="@dimen/hwseekbar_default_oval_focused_inset_padding"
                    android:insetRight="@dimen/hwseekbar_default_oval_focused_inset_padding"
                    android:insetTop="@dimen/hwseekbar_default_oval_focused_inset_padding"
                    android:insetBottom="@dimen/hwseekbar_default_oval_focused_inset_padding" />
            </item>
        </selector>
    </item>
</layer-list>