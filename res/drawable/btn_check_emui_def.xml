<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:drawable="@drawable/checkbox_on_disable_def" />
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:drawable="@drawable/checkbox_off_disable_def" />
    <item
        android:state_checked="true"
        android:id="@id/checked"
        android:drawable="@drawable/checkbox_on_def" />
    <item
        android:id="@id/unchecked"
        android:drawable="@drawable/checkbox_off_def" />
</selector>