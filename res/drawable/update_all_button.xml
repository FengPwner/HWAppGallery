<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_pressed="true">
        <layer-list
            xmlns:android="http://schemas.android.com/apk/res/android">
            <item>
                <shape>
                    <corners
                        android:radius="40.0dip" />
                    <solid
                        android:color="@color/emui_accent" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners
                        android:radius="40.0dip" />
                    <solid
                        android:color="@color/appgallery_color_card_stroke_on_clicked" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/btn_emphasis_normal_layer" />
        </layer-list>
    </item>
    <item
        android:state_enabled="true"
        android:state_pressed="false">
        <layer-list
            xmlns:android="http://schemas.android.com/apk/res/android">
            <item>
                <shape>
                    <corners
                        android:radius="40.0dip" />
                    <solid
                        android:color="@color/emui_accent" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/btn_emphasis_normal_layer" />
        </layer-list>
    </item>
    <item
        android:state_enabled="false"
        android:state_pressed="false">
        <layer-list
            xmlns:android="http://schemas.android.com/apk/res/android">
            <item>
                <shape
                    android:tint="@color/emui_accent">
                    <corners
                        android:radius="40.0dip" />
                    <stroke
                        android:width="1.0px"
                        android:color="@color/category_button_select_stroke" />
                    <solid
                        android:color="@color/blue_text_007dff_alpha_20" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>