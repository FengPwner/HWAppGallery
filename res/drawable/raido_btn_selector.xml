<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:drawable="@drawable/hwradiobutton_on" />
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:drawable="@drawable/hwradiobutton_off" />
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:drawable="@drawable/hwradiobutton_on_disable" />
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:drawable="@drawable/hwradiobutton_off_disable" />
</selector>