<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background">
        <shape>
            <corners
                android:radius="3.0dip" />
            <gradient
                android:startColor="@color/appcomment_default_bg"
                android:endColor="@color/appcomment_default_bg"
                android:angle="0.0" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress">
        <scale
            android:drawable="@drawable/appcomment_comments_score_bg"
            android:scaleWidth="100%" />
    </item>
</layer-list>