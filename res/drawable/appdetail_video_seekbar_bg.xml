<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background">
        <shape>
            <corners
                android:radius="5.0dip" />
            <solid
                android:color="@color/appdetail_video_seekbar_bg_ff9d9e9d" />
        </shape>
    </item>
    <item
        android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners
                    android:radius="5.0dip" />
                <solid
                    android:color="@color/detail_dowanload_progressbar_color_alpha_60" />
            </shape>
        </clip>
    </item>
    <item
        android:id="@android:id/progress">
        <clip>
            <shape>
                <corners
                    android:radius="5.0dip" />
                <solid
                    android:color="@color/emui_accent" />
            </shape>
        </clip>
    </item>
</layer-list>