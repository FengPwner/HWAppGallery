<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_hovered="true">
        <shape
            android:shape="oval">
            <solid
                android:color="@color/emui_control_hover_translucent" />
            <size
                android:height="@dimen/hwsearchview_stroke_cancel_size"
                android:width="@dimen/hwsearchview_stroke_cancel_size" />
        </shape>
    </item>
    <item
        android:state_pressed="true"
        android:drawable="@drawable/hwsearchview_cancel_pressed_translucent" />
</selector>