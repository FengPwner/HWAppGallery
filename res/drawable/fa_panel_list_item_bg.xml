<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true">
        <shape>
            <solid
                android:color="@color/fa_panel_ic_bg_color_primary_pressed" />
            <corners
                android:radius="@dimen/fa_list_icon_corner_radius" />
        </shape>
    </item>
    <item
        android:state_pressed="false">
        <shape>
            <solid
                android:color="@color/fa_panel_ic_bg_color_primary" />
            <corners
                android:radius="@dimen/fa_list_icon_corner_radius" />
        </shape>
    </item>
</selector>