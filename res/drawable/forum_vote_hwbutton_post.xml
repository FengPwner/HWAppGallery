<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item
                android:state_enabled="true"
                android:drawable="@drawable/forum_hwbutton_default_post_vote" />
            <item
                android:state_enabled="false"
                android:drawable="@drawable/forum_hwbutton_default_post_vote" />
            <item
                android:drawable="@drawable/hwbutton_default_emui_drawable" />
        </selector>
    </item>
    <item>
        <selector
            android:enterFadeDuration="@integer/hwanimations_hover_animation_duration"
            android:exitFadeDuration="@integer/hwanimations_hover_animation_duration">
            <item
                android:state_pressed="true"
                android:drawable="@drawable/forum_hwbutton_default_post_vote" />
            <item
                android:drawable="@android:color/transparent" />
        </selector>
    </item>
</layer-list>