<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/guide_layout"
    android:background="@color/bigbuoy_backgroud"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1.0">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="8.0">
            <ImageView
                android:id="@id/guide_img"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/margin_xl"
        android:layout_weight="1.0"
        android:paddingStart="@dimen/padding_xl"
        android:paddingEnd="@dimen/padding_xl">
        <com.huawei.uikit.phone.hwbutton.widget.HwButton
            android:textColor="#ffffffff"
            android:id="@id/know_button"
            android:layout_width="160.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_l"
            android:layout_marginBottom="@dimen/margin_l"
            android:text="@string/buoy_guidewindow_gamecontrol_key_button"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="HwChinese-medium"
            style="@style/Widget.Emui.HwButton.Dark" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@id/know_button">
            <View
                android:id="@id/empty_view"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="72.0dip" />
            <ScrollView
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="top"
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <TextView
                        android:textSize="@dimen/emui_master_title_1"
                        android:textColor="#ffffffff"
                        android:layout_gravity="center_horizontal"
                        android:id="@id/guide_title"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="HwChinese-medium" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="#7fffffff"
                        android:id="@id/guide_content_first"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_m" />
                    <TextView
                        android:textSize="@dimen/appgallery_text_size_body2"
                        android:textColor="#7fffffff"
                        android:id="@id/guide_content_second"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>